  "WebApi": {
    "BaseUrl": "https://localhost:61091/"
  },
  "AllowedHosts": "*",

  // ── Serilog ─────────────────────────────────────────────────────────
  // 062: MinimumLevel is now an object rather than the bare string
  // "Information", so it can carry an Override. Both shapes are valid;
  // only the object form takes per-source levels.
  //
  // BOTH OVERRIDES EXIST TO KEEP PUBLIC QUOTE TOKENS OUT OF THE LOG.
  // 061 masked the four places OUR code logged a token. These two sources
  // are framework logging, and they print the whole URL — which is where
  // the token lives:
  //
  //   Microsoft.AspNetCore.Hosting.Diagnostics
  //       "Request starting HTTP/2 GET https://localhost:5093/q/9JGgq…"
  //       "Request finished HTTP/2 GET https://localhost:5093/q/9JGgq…"
  //     Nothing is lost: UseSerilogRequestLogging() already writes one
  //     line per completed request with method, path, status and elapsed.
  //     These were duplicates of it.
  //
  //   System.Net.Http.HttpClient
  //       "Start processing HTTP request GET
  //        https://localhost:61091/api/quotes/public/9JGgq…"
  //     This host has ONE outbound client and it is the API client, whose
  //     URLs carry the token. The API's own appsettings deliberately does
  //     NOT override this, because its outbound calls go to Resend and
  //     Meta, carry no secrets in the URL, and are worth seeing.
  //
  // That token is the entire security of the customer's link: anyone who
  // can read the log can open the quote and accept it as them.
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  }
}
