@* =====================================================================
   LEAD DETAIL - Updated with role-based permissions + plan features
   Location: MerkaiTrial.Admin.Web/Pages/Leads/Detail.cshtml
   CHANGES:
     1. Alert messages — uncommented, using TempData pattern
     2. Status dropdown — disabled if locked OR no update permission
     3. Edit button — requires Model.IsEditableState AND Model.CanUpdate
     4. Delete button — requires Model.IsDeletableState AND Model.CanDelete
     5. Score display — feature-gated by HasFeature("lead_scoring")

   MIGRATION FIX (this pass): CanEdit/CanDelete renamed to
   IsEditableState/IsDeletableState (business-rule state, e.g. "not
   converted") to stop colliding with AuthorizedPageModel's own
   permission-based CanUpdate/CanDelete properties. Also fixed
   Model.CanUpdate("Leads") / Model.CanDelete("Leads") — those were method
   calls valid under the old AppPageModel base class; AuthorizedPageModel's
   CanUpdate/CanDelete are parameterless properties, not methods.

   083: an "Emails" tab (the shared _RecordEmails partial) between
   Activities and Timeline.

   093: a "Merge" button beside Edit — merge this lead with another one.
   Shown only for a lead that is still a lead (not converted) and to
   someone who can both update and delete leads, because a merge changes
   this lead and removes the other.

   094 — PHONES:
   • The header wraps. Edit, Merge, Delete and Back sat on one line that
     could not wrap, about 420px wide, so on a phone the whole page
     scrolled sideways. They wrap now, and below 576px they show their
     icons only (each keeps its name for screen readers and as a tooltip).
   • A bar of the four things a rep does on the road, under the header,
     on screens narrower than 992px (where the sidebar's Quick Actions
     card has dropped to the very bottom): Call, Log activity, Add task,
     Note. The last three open their tab and put the cursor in the form
     (data-open-tab, handled in _Layout). Each only appears when the form
     it opens is there for this person on this lead.
   ===================================================================== *@
@page "{id:guid}"
@model MerkaiTrial.Admin.Web.Pages.Leads.DetailModel
@{
    ViewData["Title"] = "Lead Details - " + Model.Lead.FullName;
    ViewData["SuppressBrowserReload"] = true;
}

<div class="container-fluid py-4">

    @* Alert messages are rendered once, globally, by _Layout.cshtml — do not duplicate here. *@

    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div class="min-width-0">
                    <h2 class="mb-2 text-break">@Model.Lead.FullName</h2>
                    <div class="d-flex align-items-center gap-3 flex-wrap">

                        @* ✅ Status dropdown — disabled if locked (Converted) OR no update permission *@
                        <form method="post" asp-page-handler="ChangeStatus"
                              asp-route-id="@Model.Lead.Id"
                              id="statusChangeForm" class="d-inline">
                            <select name="status" aria-label="Lead status"
                                    class="form-select form-select-sm d-inline-block w-auto"
                                    onchange="this.form.submit()"
                                    @((!Model.IsEditableState || !Model.CanUpdate) ? "disabled" : "")>
                                @foreach (var status in Model.StatusOptions)
                                {
                                    <option value="@status.Value" selected="@status.Selected">
                                        @status.Text
                                    </option>
                                }
                            </select>
                        </form>

                        <span class="text-muted">•</span>

                        @* ✅ Score — feature-gated for lead_scoring *@
                        @if (Model.HasFeature("lead_scoring"))
                        {
                            <span class="text-muted">Score: @Model.Lead.Score/100</span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Score: <span class="badge bg-light text-muted border ms-1"
                                             title="@Model.UpgradePrompt to unlock lead scoring">
                                    <i class="bi bi-lock-fill me-1" style="font-size:10px;"></i>Pro
                                </span>
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Lead.OwnerName) ||
                                                !string.IsNullOrWhiteSpace(Model.Lead.OwnerJobTitle))
                        {
                            <span class="text-muted">•</span>
                            <span class="text-muted">
                                <i class="bi bi-person me-1"></i>
                                <strong>@(Model.Lead.OwnerName ?? "Owner")</strong>
                                @if (!string.IsNullOrWhiteSpace(Model.Lead.OwnerJobTitle))
                                {
                                    <span class="ms-1">(@Model.Lead.OwnerJobTitle)</span>
                                }
                            </span>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.Lead.OwnerUserId))
                        {
                            <span class="text-muted">•</span>
                            <span class="text-muted">
                                <i class="bi bi-person me-1"></i>@Model.Lead.OwnerUserId
                            </span>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap ld-actions">

                    @* ✅ Edit — requires record not locked AND role has update permission *@
                    @if (Model.IsEditableState && Model.CanUpdate)
                    {
                        <a asp-page="./Edit" asp-route-id="@Model.Lead.Id"
                           class="btn btn-primary" title="Edit" aria-label="Edit">
                            <i class="bi bi-pencil me-2"></i><span class="ld-label">Edit</span>
                        </a>
                    }
                    else if (!Model.IsEditableState)
                    {
                        @* Record is locked (Converted) — show lock badge regardless of role *@
                        <span class="badge bg-success align-self-center px-3 py-2"
                              style="font-size:12px;">
                            <i class="bi bi-lock-fill me-1"></i>Converted — View Only
                        </span>
                    }
                    @* If IsEditableState=true but CanUpdate=false → user has no update
                       permission, button is simply hidden (viewer/sales_rep with read-only) *@

                    @* 093 — Merge: needs update AND delete, and a lead that is still a lead *@
                    @if (Model.IsEditableState && Model.CanUpdate && Model.CanDelete)
                    {
                        <a asp-page="./Merge" asp-route-keepId="@Model.Lead.Id"
                           class="btn btn-outline-secondary" id="leadMerge" title="Merge" aria-label="Merge">
                            <i class="bi bi-intersect me-2"></i><span class="ld-label">Merge</span>
                        </a>
                    }

                    @* ✅ Delete — requires record not locked AND role has delete permission *@
                    @if (Model.IsDeletableState && Model.CanDelete)
                    {
                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-id="@Model.Lead.Id"
                              onsubmit="return confirm('Are you sure you want to delete this lead?');"
                              class="d-inline">
                            <button type="submit" class="btn btn-outline-danger" title="Delete" aria-label="Delete">
                                <i class="bi bi-trash me-2"></i><span class="ld-label">Delete</span>
                            </button>
                        </form>
                    }

                    <a asp-page="./Index" class="btn btn-outline-secondary" title="Back to leads" aria-label="Back to leads">
                        <i class="bi bi-arrow-left me-2"></i><span class="ld-label">Back</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* ── 094: on the road ─────────────────────────────────────────────
       Narrower than 992px only: from there down the sidebar (and its Quick
       Actions) sits below every tab. Each button appears only when what it
       opens is there — the forms are drawn for CanUpdate, and Log / Task
       only while the lead is still a lead. *@
    @{
        var canWork = Model.CanUpdate && Model.IsEditableState;
        var hasPhone = !string.IsNullOrWhiteSpace(Model.Lead.Phone);
    }
    @if (hasPhone || Model.CanUpdate)
    {
        <div class="ld-quick d-lg-none mb-3" role="group" aria-label="Quick actions">
            @if (hasPhone)
            {
                <a href="tel:@Model.Lead.Phone" class="btn btn-outline-success" id="qaCall">
                    <i class="bi bi-telephone-fill"></i><span>Call</span>
                </a>
            }
            @if (canWork)
            {
                <button type="button" class="btn btn-outline-primary" id="qaLog" data-open-tab="activities">
                    <i class="bi bi-activity"></i><span>Log activity</span>
                </button>
                <button type="button" class="btn btn-outline-primary" id="qaTask" data-open-tab="tasks">
                    <i class="bi bi-calendar-plus"></i><span>Add task</span>
                </button>
            }
            @if (Model.CanUpdate)
            {
                <button type="button" class="btn btn-outline-primary" id="qaNote" data-open-tab="notes">
                    <i class="bi bi-chat-left-text"></i><span>Note</span>
                </button>
            }
        </div>
    }

    <!-- Main Content with Tabs -->
    <div class="row">
        <div class="col-lg-8">

            <!-- Navigation Tabs -->
            <ul class="nav nav-tabs mb-4" id="leadDetailTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="overview-tab"
                            data-bs-toggle="tab" data-bs-target="#overview"
                            type="button" role="tab">
                        <i class="bi bi-info-circle me-2"></i>Overview
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tasks-tab"
                            data-bs-toggle="tab" data-bs-target="#tasks"
                            type="button" role="tab">
                        <i class="bi bi-list-check me-2"></i>Tasks
                        @if (Model.OpenTasks.Any())
                        {
                            <span class="badge @(Model.OpenTasks.Any(t => Model.IsOverdue(t)) ? "bg-danger" : "bg-secondary") ms-1">
                                @Model.OpenTasks.Count
                            </span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="notes-tab"
                            data-bs-toggle="tab" data-bs-target="#notes"
                            type="button" role="tab">
                        <i class="bi bi-chat-left-text me-2"></i>Notes
                        <span class="badge bg-secondary ms-1">@Model.Notes.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="activities-tab"
                            data-bs-toggle="tab" data-bs-target="#activities"
                            type="button" role="tab">
                        <i class="bi bi-activity me-2"></i>Activities
                        <span class="badge bg-secondary ms-1">@Model.Activities.Count</span>
                    </button>
                </li>                
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="emails-tab"
                            data-bs-toggle="tab" data-bs-target="#emails"
                            type="button" role="tab">
                        <i class="bi bi-envelope me-2"></i>Emails
                        @if (Model.RecordEmails.Count > 0)
                        {
                            <span class="badge bg-secondary ms-1">@Model.RecordEmails.Count</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="timeline-tab"
                            data-bs-toggle="tab" data-bs-target="#timeline"
                            type="button" role="tab">
                        <i class="bi bi-clock-history me-2"></i>Timeline
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="attachments-tab"
                            data-bs-toggle="tab" data-bs-target="#attachments"
                            type="button" role="tab">
                        <i class="bi bi-paperclip me-2"></i>Attachments
                        <span class="badge bg-secondary ms-1">@Model.Attachments.Count</span>
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="leadDetailTabContent">
                <div class="tab-pane fade show active" id="overview" role="tabpanel">
                    @await Html.PartialAsync("_OverviewTab", Model)
                </div>
                <div class="tab-pane fade" id="notes" role="tabpanel">
                    @await Html.PartialAsync("_NotesTab", Model)
                </div>
                <div class="tab-pane fade" id="activities" role="tabpanel">
                    @await Html.PartialAsync("_ActivitiesTab", Model)
                </div>
                <div class="tab-pane fade" id="tasks" role="tabpanel">
                    @await Html.PartialAsync("_TasksTab", Model)
                </div>
                <div class="tab-pane fade" id="emails" role="tabpanel">
                    <partial name="_RecordEmails" model="Model.RecordEmails" />
                </div>
                <div class="tab-pane fade" id="timeline" role="tabpanel">
                    @await Html.PartialAsync("_TimelineTab", Model)
                </div>
                <div class="tab-pane fade" id="attachments" role="tabpanel">
                    @await Html.PartialAsync("_AttachmentsTab", Model)
                </div>
            </div>
        </div>

        <!-- Right Sidebar -->
        <div class="col-lg-4">
            @await Html.PartialAsync("_RightSidebar", Model)
        </div>
    </div>
</div>

<style>
    /* 094 — the quick bar: four equal buttons, icon over label. */
    .ld-quick { display: grid; grid-template-columns: repeat(auto-fit, minmax(72px, 1fr)); gap: .5rem; }
    .ld-quick .btn { display: flex; flex-direction: column; align-items: center; gap: .15rem;
                     font-size: .78rem; font-weight: 600; padding: .5rem .25rem; }
    .ld-quick .btn i { font-size: 1.1rem; }

    /* 094 — header buttons show icons only on a phone. */
    @@media (max-width: 575.98px) {
        .ld-actions .ld-label { display: none; }
        .ld-actions .btn i { margin-right: 0 !important; }
    }
</style>

@section Scripts {
    <script>
        // Alert auto-dismiss is handled globally by _Layout.cshtml — do not duplicate here.

        // Tab activation from URL hash
        var hash = window.location.hash;
        if (hash) {
            var tab = document.querySelector('button[data-bs-target="' + hash + '"]');
            if (tab) { new bootstrap.Tab(tab).show(); }
        }

        // Push hash on tab change
        document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(function (tab) {
            tab.addEventListener('shown.bs.tab', function (e) {
                history.pushState(null, null, e.target.getAttribute('data-bs-target'));
            });
        });
    </script>
}
