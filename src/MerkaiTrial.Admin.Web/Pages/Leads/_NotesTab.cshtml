@* =====================================================================
   NOTES TAB - FIXED with proper form binding
   Location: MerkaiTrial.Admin.Web/Pages/Leads/_NotesTab.cshtml
   ===================================================================== *@
@model MerkaiTrial.Admin.Web.Pages.Leads.DetailModel

<!-- Add New Note Section -->
@if (Model.CanUpdate)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h6 class="mb-0">
                <i class="bi bi-plus-circle me-2"></i>Add New Note
            </h6>
        </div>
        <div class="card-body">
            @* ✅ CRITICAL: Must have asp-page-handler and asp-route-id *@
            <form method="post" asp-page-handler="AddNote" asp-route-id="@Model.Lead.Id">

                @* ✅ Show validation errors *@
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="NoteInput.Note" class="form-label">Note</label>
                    <textarea asp-for="NoteInput.Note"
                              class="form-control"
                              rows="4"
                              placeholder="Enter your note here..."
                              required></textarea>
                    <span asp-validation-for="NoteInput.Note" class="text-danger"></span>
                    <small class="text-muted">Maximum 2000 characters</small>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-2"></i>Add Note
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Notes History Section -->
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
            <i class="bi bi-chat-left-text me-2"></i>Notes History
        </h6>
        <span class="badge bg-secondary">@Model.Notes.Count</span>
    </div>
    <div class="card-body">
        @if (!Model.Notes.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-chat-left-text-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mb-0 mt-2">No notes yet. Add your first note above.</p>
            </div>
        }
        else
        {
            <div class="list-group">
                @foreach (var note in Model.Notes)
                {
                    <div class="list-group-item">
                        <div class="d-flex w-100 justify-content-between align-items-start mb-2">
                            <div>
                                <small class="text-muted">
                                    <i class="bi bi-person me-1"></i>@note.CreatedBy
                                </small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>@Model.GetRelativeTime(note.CreatedAtUtc)
                                </small>
                                @if (Model.CanUpdate)
                                {
                                    @* ✅ Delete button with proper form *@
                                    <form method="post"
                                          asp-page-handler="DeleteNote"
                                          asp-route-id="@Model.Lead.Id"
                                          asp-route-noteId="@note.Id"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this note?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                        <p class="mb-0" style="white-space: pre-wrap;">@note.Note</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
