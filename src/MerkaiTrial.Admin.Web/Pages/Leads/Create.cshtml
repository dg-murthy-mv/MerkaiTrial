@* =====================================================================
   FIXED CREATE LEAD - View
   Location: MerkaiTrial.Admin.Web/Pages/Leads/Create.cshtml
   
   FIXES APPLIED:
     1. currency-symbol id added to span
     2. All scripts moved OUT of form, into @section Scripts
     3. countryCodeMap moved into @section Scripts alongside sync script
     4. Constants moved to module scope (outside DOMContentLoaded)

   079:
     • "Additional details" — the workspace's Lead custom fields, through
       the shared _CustomFieldInputs partial.
     • Errors (plan limit, a refused field, an unexpected failure) reach
       the validation summary on THIS response; they were [TempData] and
       showed on the next page. A summary line when any field needs
       attention.
     • The country → currency sync uses each country's own currency and
       the app's currency table, not two hardcoded lists. Choosing a
       currency by hand updates the symbol too (it did not before), and
       the page no longer overrides that choice on load.
   ===================================================================== *@
@page
@model MerkaiTrial.Admin.Web.Pages.Leads.CreateModel
@{
    ViewData["Title"] = "Create New Lead";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-0">Create New Lead</h2>
                    <p class="text-muted mb-0">Add a new lead to your pipeline</p>
                </div>
                <a asp-page="./Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to Leads
                </a>
            </div>

            @* (031) Removed an in-page render of Model.ErrorMessage. It is
               [TempData]-backed and _Layout.cshtml renders TempData alerts once,
               globally, so a failure produced two identical red banners. The
               validation summary below still shows field-level problems. *@

            <!-- Form Card -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-warning py-2 px-3 small d-flex gap-2 align-items-start mb-3" role="alert">
                                <i class="bi bi-exclamation-circle-fill mt-1"></i>
                                <span>Some fields need attention — they are marked below.</span>
                            </div>
                        }

                        <!-- Basic Information -->
                        <div class="mb-4">
                            <h5 class="card-title mb-3">
                                <i class="bi bi-person-fill me-2"></i>Basic Information
                            </h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Input.FullName" class="form-label">
                                        Full Name <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Input.FullName" class="form-control" placeholder="John Doe" />
                                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Email" class="form-label">Email</label>
                                    <input asp-for="Input.Email" class="form-control" placeholder="john@example.com" />
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Phone" class="form-label">Phone</label>
                                    <input asp-for="Input.Phone" class="form-control" placeholder="+1 234 567 8900" />
                                    <span asp-validation-for="Input.Phone" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.CompanyName" class="form-label">Company Name</label>
                                    <input asp-for="Input.CompanyName" class="form-control" placeholder="Acme Corp" />
                                    <span asp-validation-for="Input.CompanyName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Address & Location -->
                        <div class="mb-4">
                            <h5 class="card-title mb-3">
                                <i class="bi bi-geo-alt-fill me-2"></i>Address & Location
                            </h5>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="Input.Address" class="form-label">Address</label>
                                    <textarea asp-for="Input.Address" class="form-control" rows="2"
                                              placeholder="123 Main Street, Suite 100"></textarea>
                                    <span asp-validation-for="Input.Address" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.CountryId" class="form-label">
                                        Country <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="Input.CountryId" class="form-select"
                                            asp-items="Model.CountryOptions">
                                        <option value="">-- Select Country --</option>
                                    </select>
                                    <span asp-validation-for="Input.CountryId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.CurrencyId" class="form-label">
                                        Currency <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="Input.CurrencyId" class="form-select"
                                            asp-items="Model.CurrencyOptions">
                                        <option value="">-- Select Currency --</option>
                                    </select>
                                    <span asp-validation-for="Input.CurrencyId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Lead Details -->
                        <div class="mb-4">
                            <h5 class="card-title mb-3">
                                <i class="bi bi-funnel-fill me-2"></i>Lead Details
                            </h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Input.ChannelId" class="form-label">
                                        Channel <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="Input.ChannelId" class="form-select"
                                            asp-items="Model.ChannelOptions">
                                        <option value="">-- Select Channel --</option>
                                    </select>
                                    <span asp-validation-for="Input.ChannelId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.SourceId" class="form-label">Source</label>
                                    <select asp-for="Input.SourceId" class="form-select"
                                            asp-items="Model.SourceOptions">
                                        <option value="">-- Select Source --</option>
                                    </select>
                                    <span asp-validation-for="Input.SourceId" class="text-danger"></span>
                                </div>
                                @* ✅ NEW: Vertical/Industry — informational, not enforced *@
                                <div class="col-md-6">
                                    <label asp-for="Input.VerticalId" class="form-label">
                                        Industry / Vertical
                                        <span class="text-muted small ms-1">(optional)</span>
                                    </label>
                                    <select asp-for="Input.VerticalId" class="form-select"
                                            asp-items="Model.VerticalOptions">
                                        <option value="">-- Select Industry --</option>
                                    </select>
                                    <span asp-validation-for="Input.VerticalId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.EstimatedValue" class="form-label">Estimated Value</label>
                                    <div class="input-group">
                                        @* FIX 1: id="currency-symbol" added so JS can update it *@
                                        <span class="input-group-text" id="currency-symbol">@Model.CurrencySymbol</span>
                                        <input asp-for="Input.EstimatedValue" type="number" step="0.01"
                                               class="form-control" placeholder="10000.00" />
                                    </div>
                                    <span asp-validation-for="Input.EstimatedValue" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.OwnerUserId" class="form-label">Assign To</label>
                                    <select asp-for="Input.OwnerUserId" class="form-select"
                                            asp-items="Model.SalesTeamOptions">
                                        <option value="">-- Unassigned --</option>
                                    </select>
                                    <span asp-validation-for="Input.OwnerUserId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        @* 079 — the workspace's own Lead fields. Shared with Edit. *@
                        <partial name="_CustomFieldInputs" model="Model.CustomFieldInputs" />

                        <!-- Actions -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="bi bi-x-lg me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-2"></i>Create Lead
                            </button>
                        </div>

                    </form>  @* FIX 2: form closes here — scripts are BELOW in @section Scripts *@
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Choosing a country picks its currency and updates the symbol
        // beside Estimated Value. 079: both maps come from the server —
        // each country's own currency, and symbols from the app's one
        // currency table — instead of two hardcoded lists in this script.
        (function () {
            'use strict';
            var countryCurrency = @Html.Raw(Model.CountryCurrencyJson);
            var symbols         = @Html.Raw(Model.SymbolsJson);

            var countrySelect  = document.getElementById('Input_CountryId');
            var currencySelect = document.getElementById('Input_CurrencyId');
            var symbolSpan     = document.getElementById('currency-symbol');
            if (!countrySelect || !currencySelect) return;

            function showSymbol() {
                if (!symbolSpan) return;
                var code = currencySelect.value;
                if (code) symbolSpan.textContent = symbols[code] || code;
            }

            countrySelect.addEventListener('change', function () {
                var currency = countryCurrency[countrySelect.value];
                if (!currency) return;
                for (var i = 0; i < currencySelect.options.length; i++) {
                    if (currencySelect.options[i].value === currency) {
                        currencySelect.selectedIndex = i;
                        break;
                    }
                }
                showSymbol();
            });

            currencySelect.addEventListener('change', showSymbol);
        })();
    </script>
}
