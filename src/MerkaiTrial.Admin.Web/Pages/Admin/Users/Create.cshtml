@* =====================================================================
   USER CREATE PAGE
   ===================================================================== *@
@page "/Admin/Users/Create"
@model MerkaiTrial.Admin.Web.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Create User";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-person-plus" style="color: #007bff;"></i> Create New User</h2>
            <p class="text-muted mb-0">Add a new user to @Model.TenantName</p>
        </div>
        <div>
            <a asp-page="./Index" asp-route-tenantId="@Model.TenantId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Users
            </a>
        </div>
    </div>

    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="TenantId" />
        
        <div class="row">
            <!-- Main Form -->
            <div class="col-lg-8">
                <!-- Basic Information -->
                <div class="card mb-4">
                    <div class="card-header" style="background-color: #007bff; color: white;">
                        <h5 class="mb-0"><i class="bi bi-person"></i> Basic Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.FirstName" class="form-label">
                                    First Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.FirstName" class="form-control" />
                                <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.LastName" class="form-label">
                                    Last Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.LastName" class="form-control" />
                                <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Email" class="form-label">
                                    Email <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Email" class="form-control" type="email" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Phone" class="form-label">Phone</label>
                                <input asp-for="Input.Phone" class="form-control" />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Department" class="form-label">Department</label>
                                <input asp-for="Input.Department" class="form-control" />
                                <span asp-validation-for="Input.Department" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.JobTitle" class="form-label">Job Title</label>
                                <input asp-for="Input.JobTitle" class="form-control" />
                                <span asp-validation-for="Input.JobTitle" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Roles & Permissions -->
                <div class="card mb-4">
                    <div class="card-header" style="background-color: #007bff; color: white;">
                        <h5 class="mb-0"><i class="bi bi-shield-check"></i> Roles & Permissions</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="Input.IsTenantAdmin" class="form-check-input" />
                                <label asp-for="Input.IsTenantAdmin" class="form-check-label">
                                    Tenant Administrator
                                </label>
                                <small class="form-text text-muted d-block">
                                    Admin users have full access to all features within this tenant
                                </small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Assign Roles</label>
                            @if (Model.AvailableRoles.Any())
                            {
                                <div class="row">
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        <div class="col-md-6 mb-2">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" 
                                                       name="Input.RoleIds" value="@role.Id" />
                                                <label class="form-check-label">
                                                    <strong>@role.DisplayName</strong>
                                                    <small class="text-muted d-block">@role.Name</small>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No roles available</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Side Panel -->
            <div class="col-lg-4">
                <!-- Actions -->
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-check-circle"></i> Actions</h5>
                    </div>
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-person-plus"></i> Create User
                        </button>
                        <a asp-page="./Index" asp-route-tenantId="@Model.TenantId" 
                           class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>

                <!-- Tips -->
                <div class="card">
                    <div class="card-header" style="background-color: #007bff; color: white;">
                        <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Quick Tips</h6>
                    </div>
                    <div class="card-body small">
                        <ul class="mb-0">
                            <li class="mb-2">Email must be unique within tenant</li>
                            <li class="mb-2">Admin users can manage all tenant data</li>
                            <li class="mb-2">Roles can be assigned now or later</li>
                            <li class="mb-0">New users are active by default</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
