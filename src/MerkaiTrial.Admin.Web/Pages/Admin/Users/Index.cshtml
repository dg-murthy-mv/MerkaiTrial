@* =====================================================================
   USERS INDEX - Mobile Optimized with Uniform Design
   ===================================================================== *@
@page "/Admin/Users"
@model MerkaiTrial.Admin.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-people text-primary"></i> User Management</h2>
            <p class="text-muted mb-0">Manage users and their roles</p>
        </div>
        <div>
            @if (Model.TenantId.HasValue)
            {
                <a asp-page="./Create" asp-route-tenantId="@Model.TenantId" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> <span class="d-none d-sm-inline">Create New User</span>
                </a>
            }
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 12px;">
                        <i class="bi bi-people text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.TotalUsers</h3>
                    <p class="text-muted mb-0 small fw-semibold">Total Users</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 12px;">
                        <i class="bi bi-person-check text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.ActiveUsers</h3>
                    <p class="text-muted mb-0 small fw-semibold">Active Users</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 12px;">
                        <i class="bi bi-shield-check text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.AdminUsers</h3>
                    <p class="text-muted mb-0 small fw-semibold">Admin Users</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #8b5cf6, #7c3aed); border-radius: 12px;">
                        <i class="bi bi-clock-history text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.RecentLogins</h3>
                    <p class="text-muted mb-0 small fw-semibold">Recent Logins</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tenant Selector -->
    <div class="card border-primary shadow-sm mb-4" style="border-width: 2px;">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-building"></i> Select Tenant</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label class="form-label fw-semibold"><i class="bi bi-building"></i> Organization</label>
                    <select name="TenantId" class="form-select form-select-lg" onchange="this.form.submit()">
                        <option value="">-- Select a Tenant --</option>
                        @foreach (var tenant in Model.Tenants)
                        {
                            <option value="@tenant.Id" selected="@(tenant.Id == Model.TenantId)">@tenant.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    @if (Model.TenantId.HasValue)
                    {
                        <a href="@Url.Page("/Admin/Users/Index")" class="btn btn-outline-secondary btn-lg w-100">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (!Model.TenantId.HasValue)
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle me-2"></i>Please select a tenant to view and manage users
        </div>
    }
    else
    {
        <!-- Search & Filter -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <input type="hidden" name="TenantId" value="@Model.TenantId" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />

                    <div class="col-md-9">
                        <label class="form-label"><i class="bi bi-search"></i> Search</label>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm"
                               class="form-control" placeholder="Search by name or email...">
                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search"></i> <span class="d-none d-sm-inline">Search</span>
                        </button>
                        <a href="?TenantId=@Model.TenantId&PageSize=@Model.PageSize" class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-x-circle"></i> <span class="d-none d-sm-inline">Clear</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
        <!-- Users List -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-list"></i> Users List
                    <span class="badge bg-light text-dark ms-2">@Model.Users.TotalCount</span>
                </h5>
                @if (Model.Users.TotalPages > 1)
                {
                    <span class="badge bg-light text-dark">Page @Model.Page of @Model.Users.TotalPages</span>
                }
            </div>

            @if (!Model.Users.Items.Any())
            {
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="text-muted mt-3 mb-0">No users found</p>
                </div>
            }
            else
            {
                <!-- DESKTOP VIEW: Table -->
                <div class="d-none d-md-block">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>User</th>
                                    <th>Contact</th>
                                    <th>Department / Job Title</th>
                                    <th>Roles</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-2">@user.FullName[0]</div>
                                                <div>
                                                    <div class="fw-semibold">@user.FullName</div>
                                                    @if (user.IsTenantAdmin)
                                                    {
                                                        <span class="badge bg-warning text-dark">Admin</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>@user.Email</div>
                                            @if (!string.IsNullOrEmpty(user.Phone))
                                            {
                                                <small class="text-muted">@user.Phone</small>
                                            }
                                        </td>
                                        <td>
                                            <div>@(user.Department ?? "-")</div>
                                            @if (!string.IsNullOrEmpty(user.JobTitle))
                                            {
                                                <small class="text-muted">@user.JobTitle</small>
                                            }
                                        </td>
                                        <td>
                                            @if (user.Roles.Any())
                                            {
                                                @foreach (var role in user.Roles.Take(2))
                                                {
                                                    <span class="badge bg-secondary me-1">@role</span>
                                                }
                                                @if (user.Roles.Count > 2)
                                                {
                                                    <span class="badge bg-light text-dark">+@(user.Roles.Count - 2)</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">No roles</span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-page="./Detail" asp-route-tenantId="@Model.TenantId" asp-route-id="@user.Id" 
                                               class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                            <a asp-page="./Edit" asp-route-tenantId="@Model.TenantId" asp-route-id="@user.Id" 
                                               class="btn btn-sm btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                            <form method="post" asp-page-handler="Delete" asp-route-tenantId="@Model.TenantId" asp-route-userId="@user.Id" 
                                                  class="d-inline" onsubmit="return confirm('Delete this user?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- MOBILE VIEW: Cards -->
                <div class="d-md-none">
                    @foreach (var user in Model.Users.Items)
                    {
                        <div class="card m-3 border">
                            <div class="card-body">
                                <div class="d-flex align-items-start mb-3">
                                    <div class="avatar-md me-3">@user.FullName[0]</div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">@user.FullName</h6>
                                        <div class="mb-2">
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                            @if (user.IsTenantAdmin)
                                            {
                                                <span class="badge bg-warning text-dark">Admin</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="small mb-2">
                                    <i class="bi bi-envelope text-muted"></i> @user.Email
                                </div>
                                @if (!string.IsNullOrEmpty(user.Phone))
                                {
                                    <div class="small mb-2">
                                        <i class="bi bi-telephone text-muted"></i> @user.Phone
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(user.Department) || !string.IsNullOrEmpty(user.JobTitle))
                                {
                                    <div class="small mb-2">
                                        <i class="bi bi-briefcase text-muted"></i> 
                                        @(user.Department ?? "-") @(user.JobTitle != null ? " / " + user.JobTitle : "")
                                    </div>
                                }
                                @if (user.Roles.Any())
                                {
                                    <div class="small mb-3">
                                        <i class="bi bi-person-badge text-muted"></i>
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge bg-secondary me-1">@role</span>
                                        }
                                    </div>
                                }

                                <div class="d-grid gap-2">
                                    <a asp-page="./Detail" asp-route-tenantId="@Model.TenantId" asp-route-id="@user.Id" 
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye"></i> View Details
                                    </a>
                                    <div class="d-flex gap-2">
                                        <a asp-page="./Edit" asp-route-tenantId="@Model.TenantId" asp-route-id="@user.Id" 
                                           class="btn btn-sm btn-outline-warning flex-fill">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form method="post" asp-page-handler="Delete" asp-route-tenantId="@Model.TenantId" asp-route-userId="@user.Id" 
                                              class="flex-fill" onsubmit="return confirm('Delete this user?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Shared Pagination Component -->
                <partial name="_Pagination" model="Model.Users" />
            }
        </div>
    }
</div>

<style>
    /* Avatar Styles */
    .avatar-sm {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .avatar-md {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 1.25rem;
    }
</style>
