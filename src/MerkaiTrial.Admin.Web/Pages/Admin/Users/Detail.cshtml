@* =====================================================================
   USER DETAIL PAGE

   086: a "Sign-in" card — Send reset email, Copy reset link (shown once,
   not emailed), Send invite — plus error messages, which the page never
   displayed, and initials that cannot crash on an empty name.
   ===================================================================== *@
@page "/Admin/Users/Detail/{id:guid}"
@model MerkaiTrial.Admin.Web.Pages.Admin.Users.DetailModel
@{
    ViewData["Title"] = $"User: {Model.User.FirstName} {Model.User.LastName}";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <div style="background-color: #007bff; color: white; width: 50px; height: 50px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 15px;">
                    @Model.Initials
                </div>
                @Model.User.FirstName @Model.User.LastName
                @if (Model.User.IsTenantAdmin)
                {
                    <span class="badge bg-warning">Admin</span>
                }
                @if (Model.User.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }
            </h2>
            <p class="text-muted mb-0">@Model.User.Email</p>
        </div>
        <div>
            <a asp-page="./Edit" asp-route-tenantId="@Model.TenantId" asp-route-id="@Model.Id" 
               class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit User
            </a>
            <a asp-page="./Index" asp-route-tenantId="@Model.TenantId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Users
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* 086 — a link shown ONCE. Only its hash is stored, so this response is
       the only place it exists. *@
    @if (!string.IsNullOrEmpty(Model.IssuedLink))
    {
        <div class="card border-success mb-4">
            <div class="card-header bg-success text-white">
                <i class="bi bi-link-45deg"></i>
                @(Model.IssuedLinkKind == "invite" ? "New invite link" : "New password reset link")
                for @Model.User.Email
            </div>
            <div class="card-body">
                <p class="mb-2 small">
                    @if (Model.IssuedLinkEmailed)
                    {
                        <text>It has been emailed to them. Here it is as well, in case the email doesn't arrive.</text>
                    }
                    else
                    {
                        <text><strong>Not emailed.</strong> Send it to them yourself — WhatsApp, LINE or a chat they trust.</text>
                    }
                    It works once and expires in @Model.IssuedLinkLifetime.
                    @if (Model.IssuedLinkKind == "reset")
                    {
                        <text>Any older reset link has stopped working.</text>
                    }
                </p>
                <div class="input-group mb-2">
                    <input type="text" id="issuedLink" class="form-control font-monospace"
                           value="@Model.IssuedLink" readonly onclick="this.select();" />
                    <button class="btn btn-primary" type="button" id="copyIssued">
                        <i class="bi bi-clipboard"></i> Copy
                    </button>
                </div>
                <div id="copyConfirm" class="text-success small" style="display:none;">
                    <i class="bi bi-check-circle"></i> Copied.
                </div>
                <div class="alert alert-warning small mt-3 mb-0">
                    <i class="bi bi-shield-lock me-1"></i>
                    Anyone with this link can set this person's password. Send it only to them,
                    and don't paste it into a group chat. It is shown once and not stored.
                </div>
            </div>
        </div>
    }

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overview">
                <i class="bi bi-info-circle"></i> Overview
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#roles">
                <i class="bi bi-person-badge"></i> Roles 
                <span class="badge bg-secondary">@Model.User.Roles.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#activity">
                <i class="bi bi-clock-history"></i> Activity
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Overview Tab -->
        <div class="tab-pane fade show active" id="overview">
            <div class="row">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header" style="background-color: #007bff; color: white;">
                            <h5 class="mb-0"><i class="bi bi-person"></i> User Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">First Name</label>
                                    <p class="form-control-plaintext">@Model.User.FirstName</p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Last Name</label>
                                    <p class="form-control-plaintext">@Model.User.LastName</p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Email</label>
                                    <p class="form-control-plaintext">@Model.User.Email</p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Phone</label>
                                    <p class="form-control-plaintext">@(Model.User.Phone ?? "-")</p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Department</label>
                                    <p class="form-control-plaintext">@(Model.User.Department ?? "-")</p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Job Title</label>
                                    <p class="form-control-plaintext">@(Model.User.JobTitle ?? "-")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card mb-3">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0"><i class="bi bi-shield-check"></i> Permissions</h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <strong>Tenant Admin:</strong>
                                @if (Model.User.IsTenantAdmin)
                                {
                                    <span class="badge bg-warning">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </div>
                            <div>
                                <strong>Status:</strong>
                                @if (Model.User.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </div>
                        </div>
                    </div>

                    @* 086 — getting this person (back) in. *@
                    <div class="card mb-3">
                        <div class="card-header bg-primary text-white">
                            <h6 class="mb-0"><i class="bi bi-key"></i> Sign-in</h6>
                        </div>
                        <div class="card-body">
                            @if (!Model.User.IsActive)
                            {
                                <p class="small text-muted mb-0">
                                    Deactivated — they can't sign in. Reactivate them on
                                    <a asp-page="./Edit" asp-route-tenantId="@Model.TenantId" asp-route-id="@Model.Id">Edit</a>
                                    before sending a link.
                                </p>
                            }
                            else
                            {
                                @if (Model.NeverSignedIn)
                                {
                                    <p class="small text-muted mb-2">
                                        <i class="bi bi-hourglass-split"></i> Hasn't signed in yet — the invite was probably never used.
                                    </p>
                                    <form method="post" asp-page-handler="SendInvite"
                                          asp-route-tenantId="@Model.TenantId" asp-route-id="@Model.Id" class="mb-2 js-once">
                                        <button type="submit" class="btn btn-primary btn-sm w-100">
                                            <i class="bi bi-envelope"></i> Send a new invite
                                        </button>
                                    </form>
                                }

                                <form method="post" asp-page-handler="SendReset"
                                      asp-route-tenantId="@Model.TenantId" asp-route-id="@Model.Id" class="mb-2 js-once">
                                    <button type="submit" class="btn @(Model.NeverSignedIn ? "btn-outline-primary" : "btn-primary") btn-sm w-100">
                                        <i class="bi bi-envelope-arrow-up"></i> Send reset email
                                    </button>
                                </form>

                                <form method="post" asp-page-handler="CopyResetLink"
                                      asp-route-tenantId="@Model.TenantId" asp-route-id="@Model.Id" class="js-once">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100"
                                            title="Creates a link without emailing it — for when the email isn't arriving">
                                        <i class="bi bi-link-45deg"></i> Copy reset link instead
                                    </button>
                                </form>

                                <p class="small text-muted mt-2 mb-0">
                                    Reset links work once, for 2 hours. A new one cancels the old.
                                </p>

                                @if (!Model.LinkBaseConfigured)
                                {
                                    <p class="small text-warning-emphasis mt-2 mb-0">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        <code>Email:AppBaseUrl</code> isn't set on Admin.Web, so links use this
                                        page's address. Set it before production (SETUP 086).
                                    </p>
                                }
                            }
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header bg-secondary text-white">
                            <h6 class="mb-0"><i class="bi bi-info-circle"></i> Metadata</h6>
                        </div>
                        <div class="card-body small">
                            <p class="mb-2">
                                <strong>Created:</strong><br />
                                @Model.User.CreatedAtUtc.ToString("MMM dd, yyyy h:mm tt")
                            </p>
                            <p class="mb-0">
                                <strong>Last Login:</strong><br />
                                @(Model.User.LastLoginUtc?.ToString("MMM dd, yyyy h:mm tt") ?? "Never")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Roles Tab -->
        <div class="tab-pane fade" id="roles">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center" 
                     style="background-color: #007bff; color: white;">
                    <h5 class="mb-0"><i class="bi bi-person-badge"></i> Assigned Roles</h5>
                    <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#assignRolesModal">
                        <i class="bi bi-plus-circle"></i> Assign Roles
                    </button>
                </div>
                <div class="card-body">
                    @if (Model.User.Roles.Any())
                    {
                        <div class="row">
                            @foreach (var role in Model.User.Roles)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card">
                                        <div class="card-body">
                                            <h6 class="card-title" style="color: #007bff;">
                                                <i class="bi bi-shield-check"></i> @role
                                            </h6>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">No roles assigned</p>
                    }
                </div>
            </div>
        </div>

        <!-- Activity Tab -->
        <div class="tab-pane fade" id="activity">
            <div class="card">
                <div class="card-header" style="background-color: #007bff; color: white;">
                    <h5 class="mb-0"><i class="bi bi-clock-history"></i> Activity History</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Activity tracking coming soon...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Assign Roles Modal -->
<div class="modal fade" id="assignRolesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AssignRoles">
                <input type="hidden" name="tenantId" value="@Model.TenantId" />
                <input type="hidden" name="userId" value="@Model.Id" />
                
                <div class="modal-header" style="background-color: #007bff; color: white;">
                    <h5 class="modal-title"><i class="bi bi-person-badge"></i> Assign Roles</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @if (Model.AvailableRoles.Any())
                    {
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <div class="form-check mb-2">
                                <input type="checkbox" class="form-check-input" id="role-@role.Id"
                                       name="roleIds" value="@role.Id"
                                       checked="@Model.User.Roles.Contains(role.DisplayName)" />
                                <label class="form-check-label" for="role-@role.Id">
                                    <strong>@role.DisplayName</strong>
                                    <small class="text-muted d-block">@role.Name</small>
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No roles available</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Save Roles
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 086 — copy the one-time link, and one submit per press on the
        // sign-in buttons (each press really does issue a new link).
        (function () {
            var copy = document.getElementById('copyIssued');
            if (copy) {
                copy.addEventListener('click', function () {
                    var el = document.getElementById('issuedLink');
                    el.select();
                    navigator.clipboard.writeText(el.value).then(function () {
                        document.getElementById('copyConfirm').style.display = 'block';
                    });
                });
            }
            document.querySelectorAll('form.js-once').forEach(function (f) {
                f.addEventListener('submit', function () {
                    var b = f.querySelector('button[type=submit]');
                    if (b) { b.disabled = true; }
                });
            });
        })();
    </script>
}
