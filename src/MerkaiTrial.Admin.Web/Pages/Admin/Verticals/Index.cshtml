<!-- Statistics Cards -->
<div class="row g-3 mb-4">
    <!-- Total Verticals (Blue) -->
    <div class="col-xl-3 col-md-6 col-sm-12">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px; background: linear-gradient(135deg, #3b82f6, #2563eb);">
                            <i class="bi bi-briefcase text-white fs-4"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 small">Total Verticals</h6>
                        <h3 class="mb-0">@Model.Stats.TotalVerticals</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Verticals (Purple) -->
    <div class="col-xl-3 col-md-6 col-sm-12">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px; background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                            <i class="bi bi-star-fill text-white fs-4"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 small">System</h6>
                        <h3 class="mb-0">@Model.Stats.SystemVerticals</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Custom Verticals (Orange) -->
    <div class="col-xl-3 col-md-6 col-sm-12">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px; background: linear-gradient(135deg, #f59e0b, #d97706);">
                            <i class="bi bi-building text-white fs-4"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 small">Custom</h6>
                        <h3 class="mb-0">@Model.Stats.CustomVerticals</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Tenants (Green) -->
    <div class="col-xl-3 col-md-6 col-sm-12">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px; background: linear-gradient(135deg, #10b981, #059669);">
                            <i class="bi bi-people text-white fs-4"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 small">Active Tenants</h6>
                        <h3 class="mb-0">@Model.Stats.ActiveTenants</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Filters Card -->
<!-- Search & Filter -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <input type="hidden" name="PageSize" value="@Model.PageSize" />

            <!-- Search -->
            <div class="col-lg-4 col-md-6 col-sm-12">
                <label class="form-label small fw-semibold">
                    <i class="bi bi-search me-1"></i>Search
                </label>
                <input type="text" class="form-control" name="SearchTerm"
                       value="@Model.SearchTerm" placeholder="Search verticals..." />
            </div>

            <!-- Type Filter -->
            <div class="col-lg-3 col-md-6 col-sm-12">
                <label class="form-label small fw-semibold">
                    <i class="bi bi-funnel me-1"></i>Type
                </label>
                <select class="form-select" name="VerticalTypeFilter"
                        asp-items="Model.GetVerticalTypeFilterOptions()">
                </select>
            </div>

            <!-- Tenant Filter -->
            <div class="col-lg-3 col-md-6 col-sm-12">
                <label class="form-label small fw-semibold">
                    <i class="bi bi-building me-1"></i>Tenant
                </label>
                <select class="form-select" name="TenantFilter"
                        asp-items="Model.GetTenantFilterOptions()">
                </select>
            </div>

            <!-- Buttons -->
            <div class="col-lg-2 col-md-12 col-sm-12">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search d-md-none"></i>
                        <span class="d-none d-md-inline">Search</span>
                    </button>
                    <a asp-page="./Index" asp-route-pagesize="@Model.PageSize"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span class="d-none d-sm-inline">Clear</span>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Verticals Grid -->
<!-- Desktop Table -->
<div class="card border-0 shadow-sm d-none d-md-block">
    <div class="card-header bg-primary text-white">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>Verticals List
                <span class="badge bg-white text-primary ms-2">@Model.PaginatedVerticals.TotalCount</span>
            </h5>
            <span class="badge bg-light text-dark">
                Page @Model.Page of @Model.PaginatedVerticals.TotalPages
            </span>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Icon</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Tenant</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vertical in Model.PaginatedVerticals.Items)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="bg-@(vertical.Color ?? "primary") bg-opacity-10 rounded p-2"
                                     style="display: inline-block;">
                                    <i class="bi bi-@(vertical.Icon ?? "briefcase")
                                           text-@(vertical.Color ?? "primary") fs-5"></i>
                                </div>
                            </td>
                            <td>
                                <strong>@vertical.Name</strong>
                            </td>
                            <td>
                                @if (vertical.IsSystem)
                                {
                                    <span class="badge bg-primary">System</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Custom</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(vertical.TenantName))
                                {
                                    <span class="text-muted">@vertical.TenantName</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">All Tenants</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="./Detail" asp-route-id="@vertical.Id"
                                       class="btn btn-outline-primary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="./Edit" asp-route-id="@vertical.Id"
                                       class="btn btn-outline-warning" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (!vertical.IsSystem)
                                    {
                                        <button type="button" class="btn btn-outline-danger"
                                                onclick="confirmDelete('@vertical.Id', '@vertical.Name')"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Mobile Cards -->
<div class="d-md-none">
    @foreach (var vertical in Model.PaginatedVerticals.Items)
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <!-- Header -->
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-@(vertical.Color ?? "primary") bg-opacity-10 rounded p-3 me-3">
                        <i class="bi bi-@(vertical.Icon ?? "briefcase")
                               text-@(vertical.Color ?? "primary") fs-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="mb-0">@vertical.Name</h5>
                        <small class="text-muted">
                            @if (!string.IsNullOrEmpty(vertical.TenantName))
                            {
                                @vertical.TenantName
                            }
                            else
                            {
                                <span>All Tenants</span>
                            }
                        </small>
                    </div>
                </div>

                <!-- Type Badge -->
                <div class="mb-3">
                    @if (vertical.IsSystem)
                    {
                        <span class="badge bg-primary">System</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Custom</span>
                    }
                </div>

                <!-- Actions -->
                <div class="d-grid gap-2">
                    <a asp-page="./Detail" asp-route-id="@vertical.Id"
                       class="btn btn-primary btn-sm">
                        <i class="bi bi-eye me-1"></i>View Details
                    </a>
                    <div class="btn-group">
                        <a asp-page="./Edit" asp-route-id="@vertical.Id"
                           class="btn btn-outline-warning btn-sm">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        @if (!vertical.IsSystem)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm"
                                    onclick="confirmDelete('@vertical.Id', '@vertical.Name')">
                                <i class="bi bi-trash me-1"></i>Delete
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>      
    }
</div>
@if (Model.PaginatedVerticals.Items.Any())
{
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body">
            <!-- Page Size Selector -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <form method="get" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                    <input type="hidden" name="VerticalTypeFilter" value="@Model.VerticalTypeFilter" />
                    <input type="hidden" name="TenantFilter" value="@Model.TenantFilter" />
                    <input type="hidden" name="Page" value="1" />

                    <label class="col-form-label small mb-0">Items per page:</label>
                    <select name="PageSize" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                        <option value="5" selected="@(Model.PageSize == 5)">5</option>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    </select>
                </form>

                <span class="text-muted small">
                    Showing @((Model.Page - 1) * Model.PageSize + 1)
                    to @Math.Min(Model.Page * Model.PageSize, Model.PaginatedVerticals.TotalCount)
                    of @Model.PaginatedVerticals.TotalCount items
                </span>
            </div>

            <!-- Pagination -->
            <nav>
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(!Model.PaginatedVerticals.HasPrevious ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pagesize="@Model.PageSize"
                           asp-route-searchterm="@Model.SearchTerm"
                           asp-route-verticaltypefilter="@Model.VerticalTypeFilter"
                           asp-route-tenantfilter="@Model.TenantFilter">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>

                    @{
                        var startPage = Math.Max(1, Model.Page - 2);
                        var endPage = Math.Min(Model.PaginatedVerticals.TotalPages, Model.Page + 2);

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-page="@i"
                                   asp-route-pagesize="@Model.PageSize"
                                   asp-route-searchterm="@Model.SearchTerm"
                                   asp-route-verticaltypefilter="@Model.VerticalTypeFilter"
                                   asp-route-tenantfilter="@Model.TenantFilter">
                                    @i
                                </a>
                            </li>
                        }
                    }

                    <li class="page-item @(!Model.PaginatedVerticals.HasNext ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pagesize="@Model.PageSize"
                           asp-route-searchterm="@Model.SearchTerm"
                           asp-route-verticaltypefilter="@Model.VerticalTypeFilter"
                           asp-route-tenantfilter="@Model.TenantFilter">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}
<!-- Delete Confirmation Modal -->
<form method="post" id="deleteForm">
    <input type="hidden" name="id" id="deleteId" />
</form>

@section Scripts {
    <script>
        // Auto-dismiss alerts
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);

        // Delete confirmation
        function confirmDelete(id, name) {
            if (confirm(`Are you sure you want to delete vertical "${name}"? This action cannot be undone.`)) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').action = '?handler=Delete&id=' + id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}