@page
@model MerkaiTrial.Admin.Web.Pages.Verticals.IndexModel
@{
    ViewData["Title"] = "Company Verticals Management";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">
            <i class="bi bi-briefcase me-2"></i>Company Verticals
        </h2>
        <p class="text-muted mb-0">Manage industry verticals and business categories</p>
    </div>
    <div>
        <a asp-page="./Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Add Vertical
        </a>
    </div>
</div>

