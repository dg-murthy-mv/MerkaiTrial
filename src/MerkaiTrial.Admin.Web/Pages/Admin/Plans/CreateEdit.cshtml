@page "/Admin/Plans/{planId:guid?}"
@model MerkaiTrial.Admin.Web.Pages.Admin.Plans.CreateEditModel
@{
    var isEdit = Model.PlanId.HasValue;
    ViewData["Title"] = isEdit ? $"Edit Plan — {Model.Input.DisplayName}" : "Create New Plan";

    var currencySymbols = new Dictionary<string, string>
    {
        ["USD"] = "$",
        ["THB"] = "฿",
        ["INR"] = "₹",
        ["PHP"] = "₱",
        ["AED"] = "AED "
    };
}

<div class="page-content">

    <!-- ── Page Header ──────────────────────────────────────────── -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item">
                        <a asp-page="./Index" class="text-decoration-none">Subscription Plans</a>
                    </li>
                    <li class="breadcrumb-item active">@(isEdit ? "Edit Plan" : "Create Plan")</li>
                </ol>
            </nav>
            <h1 class="page-title">
                <i class="bi bi-@(isEdit ? "pencil-square" : "plus-circle") me-2"></i>
                @(isEdit ? $"Edit {Model.Input.DisplayName}" : "Create New Plan")
                @if (Model.Input.IsTrial)
                {
                    <span class="badge bg-warning text-dark ms-2">
                        <i class="bi bi-hourglass-split me-1"></i>Trial
                    </span>
                }
            </h1>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Plans
        </a>
    </div>

    <!-- ── Form ─────────────────────────────────────────────────── -->
    <form method="post">
        <input type="hidden" asp-for="PlanId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-4">

            <!-- ── LEFT COLUMN: Identity + Pricing ──────────────── -->
            <div class="col-12 col-xl-8">

                <!-- Identity card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-tag me-2 text-primary"></i>Plan Identity
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Input.Name" class="form-label fw-semibold">
                                    Plan Key <span class="text-danger">*</span>
                                </label>
                                @if (isEdit)
                                {
                                    <!-- Name is immutable on edit — it's the join key to Tenants.Plan -->
                                    <input type="text" class="form-control bg-light"
                                           value="@Model.Input.Name" readonly />
                                    <input type="hidden" asp-for="Input.Name" />
                                    <div class="form-text text-warning">
                                        <i class="bi bi-lock me-1"></i>Plan key cannot be changed — it links to tenant records.
                                    </div>
                                }
                                else
                                {
                                    <input asp-for="Input.Name" class="form-control"
                                           placeholder="e.g. starter, professional"
                                           oninput="this.value = this.value.toLowerCase().replace(/[^a-z0-9_-]/g,'')" />
                                    <div class="form-text">Lowercase, no spaces. Used internally.</div>
                                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                                }
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.DisplayName" class="form-label fw-semibold">
                                    Display Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.DisplayName" class="form-control"
                                       placeholder="e.g. Professional" />
                                <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Input.Description" class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Input.Description" class="form-control" rows="2"
                                          placeholder="Brief description shown on pricing page…"></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Trial Plan card -->
                <div class="card mb-4">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-hourglass-split me-2 text-warning"></i>Trial Plan
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <input asp-for="Input.IsTrial" class="form-check-input"
                                   type="checkbox" role="switch" id="isTrial" />
                            <label class="form-check-label" for="isTrial">
                                <strong>This is a trial plan</strong>
                                <div class="text-muted small">
                                    Time-limited, typically free. Tenants are auto-downgraded or prompted
                                    to upgrade when the trial period ends.
                                </div>
                            </label>
                        </div>

                        <div id="trialDurationWrap" class="@(Model.Input.IsTrial ? "" : "d-none")">
                            <label asp-for="Input.TrialDurationDays" class="form-label fw-semibold">
                                Trial Duration
                            </label>
                            <div class="input-group" style="max-width: 220px;">
                                <input asp-for="Input.TrialDurationDays" type="number" min="1" max="365"
                                       class="form-control" placeholder="45" />
                                <span class="input-group-text">days</span>
                            </div>
                            <div class="form-text">Default is 45 days. Pricing below is typically all zeros for trial plans.</div>
                            <span asp-validation-for="Input.TrialDurationDays" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Pricing card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-currency-dollar me-2 text-success"></i>Base Pricing (USD)
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.MonthlyPrice" class="form-label fw-semibold">Monthly Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Input.MonthlyPrice" type="number" step="0.01" min="0"
                                           class="form-control" placeholder="0.00" />
                                </div>
                                <div class="form-text">Set to 0 for free tier. Also used as the fallback price if a country isn't priced below.</div>
                                <span asp-validation-for="Input.MonthlyPrice" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.AnnualPrice" class="form-label fw-semibold">Annual Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Input.AnnualPrice" type="number" step="0.01" min="0"
                                           class="form-control" placeholder="0.00" id="annualPrice" />
                                </div>
                                <div class="form-text" id="annualDiscount"></div>
                                <span asp-validation-for="Input.AnnualPrice" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Country pricing card -->
                <div class="card mb-4">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-globe2 me-2 text-primary"></i>Country Pricing
                        </h6>
                        <span class="text-muted small">India · Thailand · Philippines · UAE · International (USD)</span>
                    </div>
                    <div class="card-body">
                        <input asp-for="Input.PlanPricingsJson" type="hidden" id="pricingJson" />
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0" id="pricingTable">
                                <thead>
                                    <tr class="text-muted small text-uppercase">
                                        <th style="width:120px">Currency</th>
                                        <th>Monthly Price</th>
                                        <th>Annual Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.PricingRows)
                                    {
                                        <tr data-currency="@row.CurrencyCode">
                                            <td>
                                                <span class="badge bg-light text-dark border fs-6">@row.CurrencyCode</span>
                                            </td>
                                            <td>
                                                <div class="input-group input-group-sm" style="max-width:180px;">
                                                    <span class="input-group-text">@currencySymbols[row.CurrencyCode]</span>
                                                    <input type="number" step="0.01" min="0"
                                                           class="form-control pricing-monthly"
                                                           value="@row.MonthlyPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                                                </div>
                                            </td>
                                            <td>
                                                <div class="input-group input-group-sm" style="max-width:180px;">
                                                    <span class="input-group-text">@currencySymbols[row.CurrencyCode]</span>
                                                    <input type="number" step="0.01" min="0"
                                                           class="form-control pricing-annual"
                                                           value="@row.AnnualPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="form-text mt-2">
                            <i class="bi bi-info-circle me-1"></i>
                            Leave a row at 0 to fall back to the base USD price for that market.
                        </div>
                    </div>
                </div>

                <!-- Limits card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-sliders me-2 text-warning"></i>Usage Limits
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">

                            <div class="col-6 col-md-4">
                                <label asp-for="Input.MaxUsers" class="form-label fw-semibold">
                                    <i class="bi bi-people me-1 text-primary"></i>Max Users
                                </label>
                                <input asp-for="Input.MaxUsers" type="number" min="1"
                                       class="form-control" />
                                <span asp-validation-for="Input.MaxUsers" class="text-danger small"></span>
                            </div>

                            <div class="col-6 col-md-4">
                                <label asp-for="Input.MaxLeads" class="form-label fw-semibold">
                                    <i class="bi bi-person-lines-fill me-1 text-success"></i>Max Leads
                                </label>
                                <input asp-for="Input.MaxLeads" type="number" min="1"
                                       class="form-control" />
                                <span asp-validation-for="Input.MaxLeads" class="text-danger small"></span>
                            </div>

                            <div class="col-6 col-md-4">
                                <label asp-for="Input.MaxDeals" class="form-label fw-semibold">
                                    <i class="bi bi-briefcase me-1 text-warning"></i>Max Deals
                                </label>
                                <input asp-for="Input.MaxDeals" type="number" min="1"
                                       class="form-control" />
                                <span asp-validation-for="Input.MaxDeals" class="text-danger small"></span>
                            </div>

                            <div class="col-6 col-md-4">
                                <label asp-for="Input.MaxContacts" class="form-label fw-semibold">
                                    <i class="bi bi-person-vcard me-1 text-info"></i>Max Contacts
                                </label>
                                <input asp-for="Input.MaxContacts" type="number" min="1"
                                       class="form-control" />
                                <span asp-validation-for="Input.MaxContacts" class="text-danger small"></span>
                            </div>

                            <div class="col-6 col-md-4">
                                <label asp-for="Input.MaxCompanies" class="form-label fw-semibold">
                                    <i class="bi bi-buildings me-1 text-secondary"></i>Max Companies
                                </label>
                                <input asp-for="Input.MaxCompanies" type="number" min="1"
                                       class="form-control" />
                                <span asp-validation-for="Input.MaxCompanies" class="text-danger small"></span>
                            </div>

                            <div class="col-6 col-md-4">
                                <label asp-for="Input.StorageLimitGB" class="form-label fw-semibold">
                                    <i class="bi bi-hdd me-1 text-danger"></i>Storage Limit
                                </label>
                                <div class="input-group">
                                    <input asp-for="Input.StorageLimitGB" type="number" min="1"
                                           class="form-control" />
                                    <span class="input-group-text">GB</span>
                                </div>
                                <span asp-validation-for="Input.StorageLimitGB" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Features card -->
                <div class="card mb-4">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-toggles me-2 text-purple"></i>Feature Access
                        </h6>
                        <span class="badge bg-primary" id="featureCount">0 selected</span>
                    </div>
                    <div class="card-body">
                        <input asp-for="Input.Features" type="hidden" id="featuresJson" />
                        <div class="row g-2" id="featureToggles">
                            @foreach (var feature in Model.AvailableFeatures)
                            {
                                <div class="col-6 col-md-4">
                                    <label class="feature-toggle @(Model.SelectedFeatures.Contains(feature.Key) ? "feature-toggle--on" : "")">
                                        <input type="checkbox"
                                               class="feature-check"
                                               value="@feature.Key"
                                               @(Model.SelectedFeatures.Contains(feature.Key) ? "checked" : "") />
                                        <i class="bi bi-@feature.Icon me-2"></i>
                                        <span>@feature.Label</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- ── RIGHT COLUMN: Display + Status ───────────────── -->
            <div class="col-12 col-xl-4">

                <!-- Display options -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-palette me-2 text-info"></i>Display Options
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Input.SortOrder" class="form-label fw-semibold">Sort Order</label>
                            <input asp-for="Input.SortOrder" type="number" min="1" class="form-control" />
                            <div class="form-text">Lower = shown first on pricing page.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.BadgeText" class="form-label fw-semibold">Badge Text</label>
                            <input asp-for="Input.BadgeText" class="form-control"
                                   placeholder="e.g. Most Popular, Best Value" />
                            <div class="form-text">Optional label shown on plan card.</div>
                        </div>

                        <div class="d-flex flex-column gap-3 mt-3">
                            <div class="form-check form-switch">
                                <input asp-for="Input.IsHighlighted" class="form-check-input"
                                       type="checkbox" role="switch" id="isHighlighted" />
                                <label class="form-check-label" for="isHighlighted">
                                    <strong>Highlighted Plan</strong>
                                    <div class="text-muted small">Shown with accent border on pricing page</div>
                                </label>
                            </div>

                            <div class="form-check form-switch">
                                <input asp-for="Input.IsPublic" class="form-check-input"
                                       type="checkbox" role="switch" id="isPublic" />
                                <label class="form-check-label" for="isPublic">
                                    <strong>Public (visible to new signups)</strong>
                                    <div class="text-muted small">Uncheck to hide from pricing page</div>
                                </label>
                            </div>

                            <div class="form-check form-switch">
                                <input asp-for="Input.IsActive" class="form-check-input"
                                       type="checkbox" role="switch" id="isActive" />
                                <label class="form-check-label" for="isActive">
                                    <strong>Active</strong>
                                    <div class="text-muted small">Inactive plans cannot be assigned to new tenants</div>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Live preview card -->
                <div class="card mb-4 sticky-top" style="top: 1rem;">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-eye me-2 text-secondary"></i>Preview
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="plan-preview" id="planPreview">
                            <div class="plan-preview__header">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="plan-preview__name" id="previewName">Plan Name</div>
                                        <span class="badge bg-warning text-dark d-none" id="previewBadge"></span>
                                        <span class="badge bg-warning text-dark d-none" id="previewTrialBadge">
                                            <i class="bi bi-hourglass-split me-1"></i><span id="previewTrialDays">45</span>-day trial
                                        </span>
                                    </div>
                                    <div class="plan-preview__price">
                                        <span id="previewPrice">Free</span>
                                        <span class="plan-preview__per" id="previewPer"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="plan-preview__limits" id="previewLimits">
                                <div class="limit-row"><span><i class="bi bi-people me-1"></i>Users</span> <strong id="previewUsers">—</strong></div>
                                <div class="limit-row"><span><i class="bi bi-person-lines-fill me-1"></i>Leads</span> <strong id="previewLeads">—</strong></div>
                                <div class="limit-row"><span><i class="bi bi-briefcase me-1"></i>Deals</span> <strong id="previewDeals">—</strong></div>
                                <div class="limit-row"><span><i class="bi bi-hdd me-1"></i>Storage</span> <strong id="previewStorage">—</strong></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Save buttons -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-@(isEdit ? "check-circle" : "plus-circle") me-2"></i>
                        @(isEdit ? "Save Changes" : "Create Plan")
                    </button>
                    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                </div>

            </div>
        </div>
    </form>

</div>

@section Styles {
<style>
.page-title  { font-size: 1.5rem; font-weight: 700; color: #1e293b; margin: 0; }
.card-header { background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: .85rem 1.25rem; }
.card-title  { font-size: .9rem; font-weight: 600; color: #475569; }

/* Feature toggles */
.feature-toggle {
    display: flex;
    align-items: center;
    padding: .5rem .75rem;
    border-radius: 8px;
    border: 1.5px solid #e2e8f0;
    cursor: pointer;
    font-size: .82rem;
    color: #64748b;
    transition: all .15s;
    user-select: none;
    gap: .25rem;
}
.feature-toggle input { display: none; }
.feature-toggle:hover { border-color: #93c5fd; background: #eff6ff; color: #2563eb; }
.feature-toggle--on   { border-color: #3b82f6; background: #eff6ff; color: #1d4ed8; font-weight: 600; }

/* Plan preview */
.plan-preview { border-radius: 0 0 12px 12px; overflow: hidden; }
.plan-preview__header {
    padding: 1rem 1.25rem .85rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}
.plan-preview__name  { font-size: 1rem; font-weight: 700; color: #1e293b; }
.plan-preview__price { font-size: 1.4rem; font-weight: 800; color: #1e293b; text-align: right; }
.plan-preview__per   { font-size: .75rem; color: #94a3b8; display: block; }
.plan-preview__limits { padding: .85rem 1.25rem; display: flex; flex-direction: column; gap: .4rem; }
.limit-row { display: flex; justify-content: space-between; font-size: .82rem; color: #475569; }

.bg-purple { background: #7c3aed !important; }
.text-purple { color: #7c3aed !important; }

/* Trial + pricing */
#pricingTable td, #pricingTable th { vertical-align: middle; }
</style>
}

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
// ── Feature toggles → hidden JSON field ──────────────────────────
function syncFeatures() {
    const checked = [...document.querySelectorAll('.feature-check:checked')]
        .map(el => el.value);
    document.getElementById('featuresJson').value = JSON.stringify(checked);
    document.getElementById('featureCount').textContent = `${checked.length} selected`;
}

document.querySelectorAll('.feature-check').forEach(cb => {
    cb.addEventListener('change', function() {
        this.closest('.feature-toggle').classList.toggle('feature-toggle--on', this.checked);
        syncFeatures();
    });
});
syncFeatures(); // init on load

// ── Country pricing → hidden JSON field ───────────────────────────
// Field names must match PlanPricingInput: CurrencyCode, MonthlyPrice, AnnualPrice
function syncPricing() {
    const rows = [...document.querySelectorAll('#pricingTable tbody tr')].map(tr => ({
        CurrencyCode: tr.dataset.currency,
        MonthlyPrice: parseFloat(tr.querySelector('.pricing-monthly').value) || 0,
        AnnualPrice:  parseFloat(tr.querySelector('.pricing-annual').value) || 0
    }));
    document.getElementById('pricingJson').value = JSON.stringify(rows);
}

document.querySelectorAll('.pricing-monthly, .pricing-annual').forEach(el =>
    el.addEventListener('input', syncPricing));
syncPricing(); // init on load

// ── Trial plan toggle ──────────────────────────────────────────────
function syncTrial() {
    const isTrial = document.getElementById('isTrial')?.checked;
    document.getElementById('trialDurationWrap').classList.toggle('d-none', !isTrial);
    updatePreview();
}
document.getElementById('isTrial')?.addEventListener('change', syncTrial);

// ── Live preview ──────────────────────────────────────────────────
function updatePreview() {
    const name      = document.querySelector('[name="Input.DisplayName"]')?.value || 'Plan Name';
    const monthly   = parseFloat(document.querySelector('[name="Input.MonthlyPrice"]')?.value) || 0;
    const users     = document.querySelector('[name="Input.MaxUsers"]')?.value || '—';
    const leads     = document.querySelector('[name="Input.MaxLeads"]')?.value || '—';
    const deals     = document.querySelector('[name="Input.MaxDeals"]')?.value || '—';
    const storage   = document.querySelector('[name="Input.StorageLimitGB"]')?.value || '—';
    const badge     = document.querySelector('[name="Input.BadgeText"]')?.value || '';
    const highlight = document.getElementById('isHighlighted')?.checked;
    const isTrial   = document.getElementById('isTrial')?.checked;
    const trialDays = document.querySelector('[name="Input.TrialDurationDays"]')?.value || '45';

    document.getElementById('previewName').textContent    = name;
    document.getElementById('previewPrice').textContent   = monthly === 0 ? 'Free' : `$${monthly.toFixed(0)}`;
    document.getElementById('previewPer').textContent     = monthly > 0 ? '/mo' : '';
    document.getElementById('previewUsers').textContent   = parseInt(users).toLocaleString() || '—';
    document.getElementById('previewLeads').textContent   = parseInt(leads).toLocaleString() || '—';
    document.getElementById('previewDeals').textContent   = parseInt(deals).toLocaleString() || '—';
    document.getElementById('previewStorage').textContent = storage ? `${storage} GB` : '—';

    const badgeEl = document.getElementById('previewBadge');
    badgeEl.textContent = badge;
    badgeEl.classList.toggle('d-none', !badge);

    const trialBadgeEl = document.getElementById('previewTrialBadge');
    trialBadgeEl.classList.toggle('d-none', !isTrial);
    document.getElementById('previewTrialDays').textContent = trialDays;

    const header = document.querySelector('.plan-preview__header');
    header.style.background    = highlight ? 'linear-gradient(135deg,#1d4ed8,#3b82f6)' : '';
    document.getElementById('previewName').style.color  = highlight ? '#fff' : '';
    document.getElementById('previewPrice').style.color = highlight ? '#fff' : '';
}

document.querySelectorAll('[name^="Input."]').forEach(el =>
    el.addEventListener('input', updatePreview));
document.getElementById('isHighlighted')
    ?.addEventListener('change', updatePreview);
updatePreview();

// ── Annual discount helper ────────────────────────────────────────
function showDiscount() {
    const monthly = parseFloat(document.querySelector('[name="Input.MonthlyPrice"]')?.value) || 0;
    const annual  = parseFloat(document.getElementById('annualPrice')?.value) || 0;
    const hint    = document.getElementById('annualDiscount');
    if (monthly > 0 && annual > 0) {
        const saving  = (monthly * 12) - annual;
        const pct     = ((saving / (monthly * 12)) * 100).toFixed(0);
        hint.innerHTML = saving > 0
            ? `<span class="text-success">Saves $${saving.toFixed(0)}/yr (${pct}% off)</span>`
            : '';
    }
}
document.querySelector('[name="Input.MonthlyPrice"]')?.addEventListener('input', showDiscount);
document.getElementById('annualPrice')?.addEventListener('input', showDiscount);
showDiscount();
</script>
}
