@page "/Admin/Plans"
@model MerkaiTrial.Admin.Web.Pages.Admin.Plans.IndexModel
@{
    ViewData["Title"] = "Subscription Plans";
    
}

<div class="page-content">

    <!-- ── Page Header ──────────────────────────────────────────── -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="page-title">
                <i class="bi bi-diagram-3 me-2"></i>Subscription Plans
            </h1>
            <p class="page-subtitle">Manage plan catalog, limits, and pricing</p>
        </div>
        <a asp-page="./CreateEdit" class="btn btn-primary btn-lg px-4">
            <i class="bi bi-plus-circle me-2"></i>Create New Plan
        </a>
    </div>

    <!-- ── Summary Stats ────────────────────────────────────────── -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon bg-primary">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <div class="stat-value">@Model.Stats.TotalPlans</div>
                <div class="stat-label">Total Plans</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon bg-success">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="stat-value">@Model.Stats.ActivePlans</div>
                <div class="stat-label">Active Plans</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon bg-warning">
                    <i class="bi bi-buildings"></i>
                </div>
                <div class="stat-value">@Model.Stats.TotalTenantsOnPlans</div>
                <div class="stat-label">Total Tenants</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon bg-purple">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div class="stat-value">$@Model.Stats.MonthlyRevenue.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</div>
                <div class="stat-label">Est. Monthly Revenue</div>
            </div>
        </div>
    </div>

    <!-- ── Plan breakdown per plan (revenue widget) ─────────────── -->
    @if (Model.PlanSummary.Any())
    {
        <div class="card mb-4">
            <div class="card-body py-3">
                <div class="row g-0 text-center divide-x">
                    @foreach (var s in Model.PlanSummary)
                    {
                        <div class="col">
                            <div class="px-3">
                                <div class="fw-semibold text-muted small text-uppercase ls-1">@s.DisplayName</div>
                                <div class="fs-4 fw-bold mt-1">@s.TenantCount <span class="fs-6 fw-normal text-muted">tenants</span></div>
                                <div class="small text-success mt-1">$@s.MonthlyRevenue.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)/mo</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ── Alert messages ───────────────────────────────────────── -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ── Filter bar ────────────────────────────────────────────── -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small fw-semibold">SHOW:</span>
                <div class="btn-group btn-group-sm" role="group">
                    <a asp-page="./Index" asp-route-filter="active"
                       class="btn @(Model.Filter == "active" ? "btn-primary" : "btn-outline-secondary")">
                        Active
                    </a>
                    <a asp-page="./Index" asp-route-filter="all"
                       class="btn @(Model.Filter == "all" ? "btn-primary" : "btn-outline-secondary")">
                        All Plans
                    </a>
                </div>
                <span class="ms-auto text-muted small">
                    @Model.Plans.Count plan(s)
                </span>
            </div>
        </div>
    </div>

    <!-- ── Plans Grid ────────────────────────────────────────────── -->
    @if (!Model.Plans.Any())
    {
        <div class="empty-state">
            <i class="bi bi-diagram-3"></i>
            <h5>No Plans Found</h5>
            <p>Create your first subscription plan to get started.</p>
            <a asp-page="./CreateEdit" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Create Plan
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var plan in Model.Plans.OrderBy(p => p.SortOrder))
            {
                <div class="col-12 col-lg-6 col-xl-4">
                    <div class="plan-card @(plan.IsHighlighted ? "plan-card--highlighted" : "") @(!plan.IsActive ? "plan-card--inactive" : "")">

                        <!-- Card header -->
                        <div class="plan-card__header">
                            <div class="d-flex align-items-start justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h5 class="plan-card__name mb-0">@plan.DisplayName</h5>
                                        @if (plan.IsTrial)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-hourglass-split me-1"></i>@(plan.TrialDurationDays)-Day Trial
                                            </span>
                                        }
                                        @if (!plan.IsActive)
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                        @if (!plan.IsPublic)
                                        {
                                            <span class="badge bg-info text-dark">Hidden</span>
                                        }
                                    </div>
                                    <code class="plan-card__key">@plan.Name</code>
                                </div>
                                <div class="plan-card__price">
                                    <span class="plan-card__price-amount">
                                        @(plan.MonthlyPrice == 0 ? "Free" : $"${plan.MonthlyPrice:N0}")
                                    </span>
                                    @if (plan.MonthlyPrice > 0)
                                    {
                                        <span class="plan-card__price-period">/mo</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Country pricing mini-display -->
                        @if (plan.PlanPricings.Any(p => p.MonthlyPrice > 0))
                        {
                            <div class="plan-card__country-pricing">
                                @foreach (var pricing in plan.PlanPricings.Where(p => p.MonthlyPrice > 0).OrderBy(p => p.SortOrder).ThenBy(p => p.CurrencyCode))
                                {
                                    <span class="country-price-chip" title="@pricing.CountryName">
                                        @pricing.CurrencySymbol@pricing.MonthlyPrice.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
                                    </span>
                                }
                            </div>
                        }

                        <!-- Limits grid -->
                        <div class="plan-card__limits">
                            <div class="limit-row">
                                <span><i class="bi bi-people me-1 text-primary"></i>Users</span>
                                <strong>@plan.MaxUsers.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</strong>
                            </div>
                            <div class="limit-row">
                                <span><i class="bi bi-person-lines-fill me-1 text-success"></i>Leads</span>
                                <strong>@plan.MaxLeads.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</strong>
                            </div>
                            <div class="limit-row">
                                <span><i class="bi bi-briefcase me-1 text-warning"></i>Deals</span>
                                <strong>@plan.MaxDeals.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</strong>
                            </div>
                            <div class="limit-row">
                                <span><i class="bi bi-hdd me-1 text-info"></i>Storage</span>
                                <strong>@plan.StorageLimitDisplay</strong>
                            </div>
                        </div>

                        <!-- Tenant count bar -->
                        <div class="plan-card__tenants">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted">
                                    <i class="bi bi-buildings me-1"></i>Tenants on this plan
                                </span>
                                <span class="fw-bold text-primary">@plan.TenantCount</span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="plan-card__actions">
                            <a asp-page="./CreateEdit" asp-route-planId="@plan.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <a asp-page="./Detail" asp-route-id="@plan.Id"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                            @if (plan.IsActive && plan.TenantCount == 0)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger ms-auto"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deactivateModal"
                                        data-plan-id="@plan.Id"
                                        data-plan-name="@plan.DisplayName">
                                    <i class="bi bi-pause-circle me-1"></i>Deactivate
                                </button>
                            }
                            @if (plan.IsActive && plan.TenantCount > 0)
                            {
                                <span class="ms-auto small text-muted" title="Migrate tenants before deactivating">
                                    <i class="bi bi-lock me-1"></i>@plan.TenantCount active tenant(s)
                                </span>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>

<!-- ── Deactivate Confirmation Modal ────────────────────────────── -->
<div class="modal fade" id="deactivateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">
                    <i class="bi bi-pause-circle text-warning me-2"></i>Deactivate Plan
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to deactivate <strong id="deactivatePlanName"></strong>?</p>
                <div class="alert alert-warning py-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Existing tenants on this plan will keep their settings. The plan will be hidden from new signups.
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Deactivate">
                    <input type="hidden" name="planId" id="deactivatePlanId" />
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-pause-circle me-1"></i>Deactivate
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
/* ── Page layout ─────────────────────────────────────────────────── */
.page-title  { font-size: 1.6rem; font-weight: 700; color: #1e293b; margin: 0; }
.page-subtitle { color: #64748b; margin: 0; font-size: .9rem; }

/* ── Stat cards (matches Tenant Management style) ────────────────── */
.stat-card {
    background: #fff;
    border-radius: 12px;
    padding: 1.25rem 1.25rem 1rem;
    box-shadow: 0 1px 4px rgba(0,0,0,.07);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: .35rem;
}
.stat-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; color: #fff;
    margin-bottom: .25rem;
}
.bg-purple { background: #7c3aed !important; }
.stat-value { font-size: 1.75rem; font-weight: 700; color: #1e293b; line-height: 1; }
.stat-label { font-size: .78rem; color: #64748b; text-transform: uppercase; letter-spacing: .05em; }

/* ── Revenue breakdown bar ───────────────────────────────────────── */
.divide-x > .col + .col { border-left: 1px solid #e2e8f0; }
.ls-1 { letter-spacing: .05em; }

/* ── Plan cards ──────────────────────────────────────────────────── */
.plan-card {
    background: #fff;
    border-radius: 14px;
    border: 2px solid #e2e8f0;
    overflow: hidden;
    transition: box-shadow .2s, border-color .2s;
    height: 100%;
    display: flex;
    flex-direction: column;
}
.plan-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,.1);
    border-color: #cbd5e1;
}
.plan-card--highlighted {
    border-color: #3b82f6;
    box-shadow: 0 4px 16px rgba(59,130,246,.15);
}
.plan-card--highlighted .plan-card__header {
    background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
    color: #fff;
}
.plan-card--highlighted .plan-card__name,
.plan-card--highlighted .plan-card__key,
.plan-card--highlighted .plan-card__price-amount,
.plan-card--highlighted .plan-card__price-period { color: #fff !important; }
.plan-card--inactive { opacity: .6; }

.plan-card__header {
    padding: 1.25rem 1.25rem 1rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}
.plan-card__name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1e293b;
}
.plan-card__key {
    font-size: .75rem;
    color: #94a3b8;
    background: transparent;
    padding: 0;
}
.plan-card__price { text-align: right; }
.plan-card__price-amount {
    font-size: 1.6rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1;
}
.plan-card__price-period {
    font-size: .8rem;
    color: #94a3b8;
}

.plan-card__limits {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    flex: 1;
}
.limit-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: .875rem;
    color: #475569;
}
.limit-row strong { color: #1e293b; font-weight: 600; }

.plan-card__country-pricing {
    padding: 0 1.25rem .85rem;
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    background: #f8fafc;
}
.country-price-chip {
    font-size: .7rem;
    font-weight: 600;
    color: #475569;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    padding: .15rem .55rem;
}

.plan-card__tenants {
    padding: .75rem 1.25rem;
    background: #f8fafc;
    border-top: 1px solid #f1f5f9;
}
.plan-card__actions {
    padding: .75rem 1.25rem;
    background: #fff;
    border-top: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    gap: .5rem;
}

/* ── Empty state ─────────────────────────────────────────────────── */
.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: #94a3b8;
}
.empty-state i { font-size: 3rem; display: block; margin-bottom: 1rem; }
.empty-state h5 { color: #475569; }
</style>
}

@section Scripts {
<script>
// Wire deactivate modal
document.getElementById('deactivateModal')?.addEventListener('show.bs.modal', e => {
    const btn = e.relatedTarget;
    document.getElementById('deactivatePlanId').value   = btn.dataset.planId;
    document.getElementById('deactivatePlanName').textContent = btn.dataset.planName;
});
</script>
}
