@page "/Admin/TaxRates/Detail/{id}"
@model MerkaiTrial.Admin.Web.Pages.TaxRates.DetailModel
@{
    ViewData["Title"] = "Tax Rate Details";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" 
                 style="width: 80px; height: 80px; background: linear-gradient(135deg, #3b82f6, #2563eb);">
                <i class="bi bi-receipt text-white" style="font-size: 2.5rem;"></i>
            </div>
            <div>
                <h2 class="mb-1">
                    @Model.TaxRate.Name
                    @if (Model.TaxRate.IsDefault)
                    {
                        <span class="badge bg-warning ms-2">Default</span>
                    }
                </h2>
                <p class="text-muted mb-0">
                    <i class="bi bi-globe me-1"></i>@Model.Country.Name (@Model.TaxRate.CountryCode)
                </p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Edit" asp-route-id="@Model.TaxRate.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> <span class="d-none d-sm-inline">Edit</span>
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" 
                    data-bs-target="#overview" type="button" role="tab">
                <i class="bi bi-info-circle"></i> Overview
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="settings-tab" data-bs-toggle="tab" 
                    data-bs-target="#settings" type="button" role="tab">
                <i class="bi bi-gear"></i> Settings
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="overview" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-receipt"></i> Tax Rate Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Country</label>
                                    <div class="fw-semibold">
                                        @Model.Country.Name (@Model.TaxRate.CountryCode)
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Tax Type</label>
                                    <div><span class="badge bg-info fs-6">@Model.TaxRate.TaxType</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Rate Name</label>
                                    <div class="fw-semibold">@Model.TaxRate.Name</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Tax Rate</label>
                                    <div class="fw-semibold text-primary fs-5">@Model.TaxRate.Rate.ToString("0.##")%</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Default Rate</label>
                                    <div>
                                        @if (Model.TaxRate.IsDefault)
                                        {
                                            <span class="badge bg-warning fs-6">Yes - Default for @Model.Country.Name</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-6">No</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Status</label>
                                    <div>
                                        @if (Model.TaxRate.IsActive)
                                        {
                                            <span class="badge bg-success fs-6">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-6">Inactive</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-shield-check"></i> Rate Type</h5>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3">
                                <div class="mb-3">
                                    <i class="bi bi-receipt text-primary" style="font-size: 3rem;"></i>
                                </div>
                                <h5 class="mb-2">@Model.TaxRate.TaxType</h5>
                                <p class="text-muted small mb-0">Tax calculation type</p>
                            </div>

                            <hr />

                            <div class="mb-3">
                                <label class="text-muted small">Default</label>
                                <div>
                                    @if (Model.TaxRate.IsDefault)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        <span class="fw-semibold ms-2">Yes</span>
                                        <br />
                                        <small class="text-muted">Used as default for @Model.Country.Name</small>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-secondary"></i>
                                        <span class="fw-semibold ms-2">No</span>
                                        <br />
                                        <small class="text-muted">Not a default rate</small>
                                    }
                                </div>
                            </div>

                            <div>
                                <label class="text-muted small">Status</label>
                                <div>
                                    @if (Model.TaxRate.IsActive)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        <span class="fw-semibold ms-2">Active</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                        <span class="fw-semibold ms-2">Inactive</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="settings" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-sliders"></i> Tax Rate Settings</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Country Code</label>
                                    <div class="fw-semibold fs-5">@Model.TaxRate.CountryCode</div>
                                    <small class="text-muted">Cannot be changed</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Tax Type</label>
                                    <div class="fw-semibold fs-5">@Model.TaxRate.TaxType</div>
                                    <small class="text-muted">Cannot be changed</small>
                                </div>
                                <div class="col-12">
                                    <hr />
                                    <p class="text-muted mb-0">
                                        <i class="bi bi-info-circle"></i>
                                        Country and tax type cannot be changed after creation. You can update the rate name, percentage, and default status.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a asp-page="./Edit" asp-route-id="@Model.TaxRate.Id" class="btn btn-outline-warning">
                                    <i class="bi bi-pencil"></i> Edit Tax Rate
                                </a>
                                <a asp-page="./Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-list"></i> View All Rates
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm mt-3">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Guidelines</h6>
                        </div>
                        <div class="card-body">
                            <ul class="small mb-0 ps-3">
                                <li class="mb-2">Tax rates can be <strong>edited</strong> anytime</li>
                                <li class="mb-2"><strong>Country and type</strong> are locked after creation</li>
                                <li class="mb-2">Only <strong>one default</strong> rate per country</li>
                                <li>Setting as default <strong>updates</strong> previous default</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
