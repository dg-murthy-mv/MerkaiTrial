@page
@model MerkaiTrial.Admin.Web.Pages.Admin.TaxRates.CreateModel
@{
    ViewData["Title"] = "Create Tax Rate";
}
@* =====================================================================
   Admin/TaxRates/Create.cshtml — MOVED IN 054 from Pages/TaxRates/.
   The @@page route override is gone: the folder gives the URL now, and
   living under Pages/Admin is what puts the page behind
   AuthorizeFolder("/Admin", "SuperAdmin"). Create.cshtml.cs has the detail.
   Re-themed for the dark console at the same time, because
   Pages/Admin/_ViewStart.cshtml selects _SuperAdminLayout.
   ===================================================================== *@

<style>
/* 054 — see Index.cshtml for the full note. Same two problems: Bootstrap's
   -emphasis pairs resolve to their LIGHT values without
   data-bs-theme="dark", and bg-primary / bg-light on a .card-header are
   !important utilities that beat the layout's own rule. */
.sa-main {
    --bs-success-text-emphasis:   #86efac;
    --bs-danger-text-emphasis:    #fca5a5;
    --bs-warning-text-emphasis:   #fcd34d;
    --bs-info-text-emphasis:      #67e8f9;
    --bs-secondary-text-emphasis: #cbd5e1;

    --bs-success-bg-subtle:   rgba(34,197,94,.14);
    --bs-danger-bg-subtle:    rgba(239,68,68,.14);
    --bs-warning-bg-subtle:   rgba(245,158,11,.14);
    --bs-info-bg-subtle:      rgba(34,211,238,.14);
    --bs-secondary-bg-subtle: rgba(148,163,184,.14);
}
.tr-title    { font-size: 1.6rem; font-weight: 700; color: #f1f5f9; margin: 0; }
.tr-subtitle { color: #64748b; margin: 0; font-size: .9rem; }
.tr-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .05em;
            color: #94a3b8; font-weight: 600; }
.tr-value { color: #e2e8f0; }
.sa-main .card-header .bi { color: #22d3ee; }

/* 057. A native date input paints its own white box and its calendar
   glyph is black — both invisible on a navy card. */
.sa-main input[type="date"] {
    color-scheme: dark;
}
.sa-main input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(1) opacity(.65);
    cursor: pointer;
}
.tr-window { font-size: .78rem; color: #94a3b8; }


/* Bootstrap paints a disabled input with its own light background; the
   layout's .form-control rule does not cover [disabled]. Both Edit fields
   that are locked after creation land here. */
.sa-main .form-control:disabled,
.sa-main .form-select:disabled {
    background: rgba(255,255,255,.02);
    border-color: rgba(34,211,238,.08);
    color: #94a3b8;
}
.sa-main .nav-tabs { border-color: rgba(34,211,238,.15); }
.sa-main .nav-tabs .nav-link { color: #94a3b8; border-color: transparent; }
.sa-main .nav-tabs .nav-link:hover { color: #e2e8f0; border-color: rgba(34,211,238,.2); }
.sa-main .nav-tabs .nav-link.active {
    color: #22d3ee; background: var(--card-bg, #0d1933);
    border-color: rgba(34,211,238,.25) rgba(34,211,238,.25) var(--card-bg, #0d1933);
}
.sa-main hr { border-color: rgba(255,255,255,.08); }
</style>


<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="tr-title"><i class="bi bi-plus-circle" style="color:#22d3ee"></i> Create Tax Rate</h2>
            <p class="tr-subtitle">A SYSTEM rate — every tenant in this country will see it</p>
        </div>
        <div>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Tax Rate Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.CountryCode" class="form-label">
                                    Country <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.CountryCode" asp-items="Model.CountryOptions" class="form-select">
                                    <option value="">-- Select Country --</option>
                                </select>
                                <span asp-validation-for="Input.CountryCode" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.TaxType" class="form-label">
                                    Tax Type <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.TaxType" asp-items="Model.TaxTypeOptions" class="form-select">
                                    <option value="">-- Select Type --</option>
                                </select>
                                <span asp-validation-for="Input.TaxType" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.Name" class="form-label">
                                    Rate Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Name" class="form-control" 
                                       placeholder="e.g., Standard VAT" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.Rate" class="form-label">
                                    Tax Rate (%) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Rate" type="number" step="0.01" class="form-control" 
                                       placeholder="e.g., 7.00" />
                                <span asp-validation-for="Input.Rate" class="text-danger small"></span>
                            </div>

                            @* 057. EFFECTIVE DATING — the reason this round
                               exists. Both columns have been on the entity since
                               it was written and GetDefaultTaxRateAsync has always
                               honoured them, but no form could set them, so the one
                               place that respects a scheduled rate change never saw
                               anything but nulls. *@
                            <div class="col-md-6">
                                <label asp-for="Input.EffectiveFrom" class="form-label">In force from</label>
                                <input asp-for="Input.EffectiveFrom" type="date" class="form-control" />
                                <small class="text-muted">
                                    Leave empty if it applies from today. Set a future date to
                                    <strong>schedule</strong> a change.
                                </small>
                                <span asp-validation-for="Input.EffectiveFrom" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.EffectiveTo" class="form-label">In force until</label>
                                <input asp-for="Input.EffectiveTo" type="date" class="form-control" />
                                <small class="text-muted">
                                    Leave empty if it has no end date. The rate still applies
                                    <em>on</em> the day you pick.
                                </small>
                                <span asp-validation-for="Input.EffectiveTo" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="Input.IsDefault" class="form-check-input" type="checkbox" />
                                    <label asp-for="Input.IsDefault" class="form-check-label">
                                        Set as default rate for this country
                                    </label>
                                </div>
                                <small class="text-muted">
                                    If enabled, this will become the default tax rate for the selected country
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-lightning"></i> Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Create Tax Rate
                            </button>
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Quick Tips</h6>
                    </div>
                    <div class="card-body">
                        <ul class="small mb-0 ps-3">
                            <li class="mb-2">Select the <strong>country</strong> this rate applies to</li>
                            <li class="mb-2">Choose appropriate <strong>tax type</strong> (VAT, GST, etc.)</li>
                            <li class="mb-2">Enter rate as a <strong>percentage</strong> (e.g., 7 for 7%)</li>
                            <li class="mb-2">Only <strong>one default</strong> rate per country</li>
                            <li class="mb-2">This is a <strong>system</strong> rate — it applies to every tenant in that country</li>
                            <li>
                                To change a rate, <strong>don't edit the old one</strong>. Create the new
                                rate with a start date and give the old one an end date the day before —
                                the switch then happens on its own, and a quote raised last month still
                                shows the rate that applied then.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
