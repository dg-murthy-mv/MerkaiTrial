@* =====================================================================
   ROLE EDIT PAGE
   ===================================================================== *@
@page "/Admin/Roles/Edit/{id:guid}"
@model MerkaiTrial.Admin.Web.Pages.Admin.Roles.EditModel
@{
    ViewData["Title"] = $"Edit Role: {Model.Input.DisplayName}";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-pencil" style="color: #ff6b35;"></i> Edit Role</h2>
            <p class="text-muted mb-0">Update role information and permissions</p>
        </div>
        <div>
            <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-eye"></i> View Details
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post">
        <div class="row">
            <!-- Basic Info -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header" style="background-color: #ff6b35; color: white;">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Basic Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Name" class="form-label">
                                    Role Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Name" class="form-control" placeholder="sales-rep" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.DisplayName" class="form-label">
                                    Display Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.DisplayName" class="form-control" placeholder="Sales Representative" />
                                <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="Input.Description" class="form-label">Description</label>
                                <textarea asp-for="Input.Description" class="form-control" rows="3" 
                                          placeholder="Describe the role's purpose..."></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Permissions -->
                <div class="card mb-4">
                    <div class="card-header" style="background-color: #ff6b35; color: white;">
                        <h5 class="mb-0"><i class="bi bi-key"></i> Permissions</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-3">Select which actions this role can perform in each module</p>
                        <div class="row g-3">
                            @foreach (var module in Model.AvailableModules)
                            {
                                <div class="col-md-6">
                                    <div class="border rounded p-3">
                                        <h6 style="color: #ff6b35;">
                                            <i class="bi bi-@module.Icon"></i> @module.DisplayName
                                        </h6>
                                        <div class="mt-2">
                                            @foreach (var permission in module.Permissions)
                                            {
                                                var fieldName = $"Permissions_{module.Name}_{permission}";
                                                var isChecked = Model.SelectedPermissions.ContainsKey(module.Name) && 
                                                               Model.SelectedPermissions[module.Name].Contains(permission);
                                                
                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input" 
                                                           name="@fieldName" value="true" checked="@isChecked" />
                                                    <label class="form-check-label">
                                                        @permission.ToUpper()
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Side Panel -->
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-check-circle"></i> Actions</h5>
                    </div>
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                        <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Information</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0 small">
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success"></i>
                                System roles cannot be edited
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success"></i>
                                Role name must be unique
                            </li>
                            <li class="mb-0">
                                <i class="bi bi-exclamation-triangle text-warning"></i>
                                Changes affect all assigned users
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
