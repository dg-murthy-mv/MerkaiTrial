@* =====================================================================
   ROLES INDEX - Mobile Optimized with Uniform Design
   ===================================================================== *@
@page "/Admin/Roles"
@model MerkaiTrial.Admin.Web.Pages.Admin.Roles.IndexModel
@{
    ViewData["Title"] = "Roles & Permissions";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-shield text-primary"></i> Roles & Permissions</h2>
            <p class="text-muted mb-0">Manage user roles and permissions</p>
        </div>
        <div>
            <a asp-page="./Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> <span class="d-none d-sm-inline">Create New Role</span>
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 12px;">
                        <i class="bi bi-shield text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.TotalRoles</h3>
                    <p class="text-muted mb-0 small fw-semibold">Total Roles</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #06b6d4, #0891b2); border-radius: 12px;">
                        <i class="bi bi-gear text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.SystemRoles</h3>
                    <p class="text-muted mb-0 small fw-semibold">System Roles</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 12px;">
                        <i class="bi bi-star text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.CustomRoles</h3>
                    <p class="text-muted mb-0 small fw-semibold">Custom Roles</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 12px;">
                        <i class="bi bi-people text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.TotalUsers</h3>
                    <p class="text-muted mb-0 small fw-semibold">Assigned Users</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <input type="hidden" name="PageSize" value="@Model.PageSize" />

                <div class="col-md-6">
                    <label class="form-label"><i class="bi bi-search"></i> Search</label>
                    <input type="text" name="Search" value="@Model.Search"
                           class="form-control" placeholder="Search by name or description...">
                </div>

                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-funnel"></i> Type</label>
                    <select name="IsSystemRole" class="form-select">
                        <option value="">All Types</option>
                        <option value="true" selected="@(Model.IsSystemRole == true)">System Roles</option>
                        <option value="false" selected="@(Model.IsSystemRole == false)">Custom Roles</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search"></i> <span class="d-none d-sm-inline">Search</span>
                    </button>
                    <a href="?PageSize=@Model.PageSize" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-x-circle"></i> <span class="d-none d-sm-inline">Clear</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
    <!-- Roles List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list"></i> Roles List
                <span class="badge bg-light text-dark ms-2">@Model.Roles.TotalCount</span>
            </h5>
            @if (Model.Roles.TotalPages > 1)
            {
                <span class="badge bg-light text-dark">Page @Model.Page of @Model.Roles.TotalPages</span>
            }
        </div>

        @if (!Model.Roles.Items.Any())
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <p class="text-muted mt-3 mb-0">No roles found</p>
            </div>
        }
        else
        {
            <!-- DESKTOP VIEW: Table -->
            <div class="d-none d-md-block">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Role</th>
                                <th>Description</th>
                                <th>Type</th>
                                <th>Users</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model.Roles.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-2" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
                                                @role.DisplayName[0]
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@role.DisplayName</div>
                                                <small class="text-muted">@role.Name</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@role.Description</td>
                                    <td>
                                        @if (role.IsSystemRole)
                                        {
                                            <span class="badge bg-info">System</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Custom</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-people"></i> @role.UserCount
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="./Detail" asp-route-id="@role.Id" 
                                           class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                        @if (!role.IsSystemRole)
                                        {
                                            <a asp-page="./Edit" asp-route-id="@role.Id" 
                                               class="btn btn-sm btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@role.Id" 
                                                  class="d-inline" onsubmit="return confirm('Delete this role?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">System role</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MOBILE VIEW: Cards -->
            <div class="d-md-none">
                @foreach (var role in Model.Roles.Items)
                {
                    <div class="card m-3 border">
                        <div class="card-body">
                            <div class="d-flex align-items-start mb-3">
                                <div class="avatar-md me-3" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
                                    @role.DisplayName[0]
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@role.DisplayName</h6>
                                    <small class="text-muted d-block mb-2">@role.Name</small>
                                    <div>
                                        @if (role.IsSystemRole)
                                        {
                                            <span class="badge bg-info">System</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Custom</span>
                                        }
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-people"></i> @role.UserCount users
                                        </span>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(role.Description))
                            {
                                <p class="text-muted small mb-3">@role.Description</p>
                            }

                            <div class="d-grid gap-2">
                                <a asp-page="./Detail" asp-route-id="@role.Id" 
                                   class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye"></i> View Details
                                </a>
                                @if (!role.IsSystemRole)
                                {
                                    <div class="d-flex gap-2">
                                        <a asp-page="./Edit" asp-route-id="@role.Id" 
                                           class="btn btn-sm btn-outline-warning flex-fill">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@role.Id" 
                                              class="flex-fill" onsubmit="return confirm('Delete this role?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled>
                                        <i class="bi bi-lock"></i> System Role (Cannot Edit)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Shared Pagination Component -->
            <partial name="_Pagination" model="Model.Roles" />
        }
    </div>
</div>

<style>
    /* Avatar Styles */
    .avatar-sm {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .avatar-md {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 1.25rem;
    }
</style>
