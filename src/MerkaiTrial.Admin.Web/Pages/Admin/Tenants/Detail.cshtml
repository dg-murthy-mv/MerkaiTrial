@* =====================================================================
   TENANT DETAIL PAGE - Frontend (REFACTORED)
   Location: MerkaiTrial.Admin.Web/Pages/Admin/Tenants/Detail.cshtml
   
   CHANGE 1 (line ~24): Plan badge now shows Model.ChangePlanModel.CurrentPlanDisplayName
                         instead of raw Model.Tenant.Plan string
   CHANGE 2 (line ~162): <partial name="_ChangePlanPartial"> added before Danger Zone
   CHANGE 3: TempData alert block added at top (SuccessMessage / ErrorMessage)
   Everything else is identical to original.
   ===================================================================== *@

@page "/Admin/Tenants/Detail/{id:guid}"
@model MerkaiTrial.Admin.Web.Pages.Admin.Tenants.DetailModel
@{
    ViewData["Title"] = $"{Model.Tenant.Name} - Tenant Details";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-building"></i> @Model.Tenant.Name
            </h2>
            <p class="text-muted mb-0">
                <span class="badge @(Model.Tenant.IsActive ? "bg-success" : "bg-danger")">
                    @(Model.Tenant.IsActive ? "Active" : "Inactive")
                </span>
                @* CHANGE 1: show DisplayName from Plans table, not raw Tenant.Plan string *@
                <span class="badge bg-primary ms-2">
                    @Model.ChangePlanModel.CurrentPlanDisplayName
                </span>
            </p>
        </div>
        <div class="btn-group">
            <a asp-page="./Edit"     asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-page="./Settings" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-gear"></i> Settings
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @* 118 — success / error messages are shown by _SuperAdminLayout; this page showed them a second time. *@

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs mb-4" id="tenantTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab"
                    data-bs-target="#overview" type="button" role="tab" aria-selected="true">
                <i class="bi bi-info-circle"></i> Overview
            </button>
        </li>
        @* 118 — People is its own page now, with what support may do for each person. *@
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="people-link" asp-page="./People" asp-route-id="@Model.Id">
                <i class="bi bi-people"></i> People
                <span class="badge bg-secondary ms-1">@Model.Stats.TotalUsers</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="statistics-tab" data-bs-toggle="tab"
                    data-bs-target="#statistics" type="button" role="tab" aria-selected="false">
                <i class="bi bi-graph-up"></i> Statistics
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="tenantTabsContent">

        <!-- ==================== OVERVIEW TAB ==================== -->
        <div class="tab-pane fade show active" id="overview" role="tabpanel" aria-labelledby="overview-tab">
            <div class="row">

                <!-- Basic Information Card -->
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-building"></i> Basic Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Tenant Name:</div>
                                <div class="col-7">@Model.Tenant.Name</div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Email:</div>
                                <div class="col-7">
                                    <a href="mailto:@Model.Tenant.FromEmail">@Model.Tenant.FromEmail</a>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Phone:</div>
                                <div class="col-7">@(Model.Tenant.Phone ?? "Not provided")</div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Status:</div>
                                <div class="col-7">
                                    <span class="badge @(Model.Tenant.IsActive ? "bg-success" : "bg-danger")">
                                        @(Model.Tenant.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Plan:</div>
                                <div class="col-7">
                                    <span class="badge bg-primary">
                                        @Model.ChangePlanModel.CurrentPlanDisplayName
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Location & Settings Card -->
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-globe"></i> Location & Settings</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Country:</div>
                                <div class="col-7">
                                    @if (!string.IsNullOrEmpty(Model.Tenant.CountryName))
                                    {
                                        <i class="bi bi-flag"></i> @Model.Tenant.CountryName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Currency:</div>
                                <div class="col-7">
                                    <i class="bi bi-currency-exchange"></i> @Model.Tenant.DefaultCurrency
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Timezone:</div>
                                <div class="col-7">
                                    <i class="bi bi-clock"></i> @Model.Tenant.TimeZone
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Created:</div>
                                <div class="col-7">@Model.Tenant.CreatedAtUtc.ToString("MMM dd, yyyy")</div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-5 fw-bold">Last Updated:</div>
                                <div class="col-7">@Model.Tenant.UpdatedAtUtc.ToString("MMM dd, yyyy")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Statistics Card -->
                <div class="col-12 mb-4">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="bi bi-graph-up"></i> Quick Statistics</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-3 col-6 mb-3">
                                    <div class="border rounded p-3">
                                        <div class="display-4 text-primary">@Model.Stats.TotalUsers</div>
                                        <div class="text-muted">Total Users</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6 mb-3">
                                    <div class="border rounded p-3">
                                        <div class="display-4 text-success">@Model.Stats.ActiveUsers</div>
                                        <div class="text-muted">Active Users</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6 mb-3">
                                    <div class="border rounded p-3">
                                        <div class="display-4 text-info">@Model.Stats.TotalLeads</div>
                                        <div class="text-muted">Total Leads</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6 mb-3">
                                    <div class="border rounded p-3">
                                        <div class="display-4 text-warning">@Model.Stats.TotalDeals</div>
                                        <div class="text-muted">Total Deals</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── CHANGE 2: Change Plan partial ──────────────────────────────
                   Placed here so Super Admin can change plan from the Detail page.
                   Feeds from Model.ChangePlanModel — populated in LoadChangePlanModelAsync().
                   Form posts to OnPostChangePlanAsync via asp-page-handler="ChangePlan".
                ──────────────────────────────────────────────────────────────── *@
                <div class="col-12 mb-4">
                    <partial name="_ChangePlanPartial" model="@Model.ChangePlanModel" />
                </div>

                <!-- Danger Zone -->
                <div class="col-12 mb-4">
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-exclamation-triangle"></i> Danger Zone
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-8">
                                    <h6>Toggle Tenant Status</h6>
                                    <p class="text-muted mb-0 small">
                                        @(Model.Tenant.IsActive
                                            ? "Deactivating will prevent all users of this tenant from logging in."
                                            : "Activating will restore access for all users of this tenant.")
                                    </p>
                                </div>
                                <div class="col-md-4 text-end">
                                    <form method="post" asp-page-handler="ToggleStatus" id="toggleWorkspaceForm"
                                          data-confirm="@(Model.Tenant.IsActive
                                              ? $"Switch off {Model.Tenant.Name}? Nobody in it can sign in until it is switched on again."
                                              : $"Switch {Model.Tenant.Name} back on? Its people can sign in again.")">
                                        <input type="hidden" name="id"       value="@Model.Id" />
                                        <input type="hidden" name="isActive" value="@(!Model.Tenant.IsActive)" />
                                        <button type="submit"
                                                class="btn @(Model.Tenant.IsActive ? "btn-warning" : "btn-success")">
                                            <i class="bi bi-@(Model.Tenant.IsActive ? "pause-circle" : "play-circle")"></i>
                                            @(Model.Tenant.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <hr />
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h6 class="text-danger">Delete Tenant</h6>
                                    <p class="text-muted mb-0 small">
                                        Soft-deletes the tenant. Data is retained but inaccessible.
                                    </p>
                                </div>
                                <div class="col-md-4 text-end">
                                    @* 119 — type the name to delete; checked on the server. *@
                                    @if (Model.IsOwnWorkspace)
                                    {
                                        <span class="small text-muted">MadeeVision's own workspace can't be deleted.</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Delete" id="deleteWorkspaceForm" class="text-start"
                                              data-confirm="Delete @(Model.Tenant.Name)? Its people can no longer sign in. This can't be undone from the console.">
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <label for="confirmName" class="form-label small">Type <strong>@Model.Tenant.Name</strong> to delete it</label>
                                            <input type="text" id="confirmName" name="confirmName" class="form-control form-control-sm mb-2" autocomplete="off" required />
                                            <button type="submit" class="btn btn-danger" id="deleteWorkspaceButton">
                                                <i class="bi bi-trash"></i> Delete workspace
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ==================== STATISTICS TAB ==================== -->
        <div class="tab-pane fade" id="statistics" role="tabpanel" aria-labelledby="statistics-tab">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-people"></i> Users Statistics</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-6 mb-4">
                                    <div class="border rounded p-3">
                                        <div class="display-4 text-primary">@Model.Stats.TotalUsers</div>
                                        <div class="text-muted">Total Users</div>
                                    </div>
                                </div>
                                <div class="col-6 mb-4">
                                    <div class="border rounded p-3">
                                        <div class="display-4 text-success">@Model.Stats.ActiveUsers</div>
                                        <div class="text-muted">Active</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="border rounded p-3 bg-light">
                                        <div class="display-6 text-danger">@Model.Stats.InactiveUsers</div>
                                        <div class="text-muted">Inactive Users</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="bi bi-graph-up"></i> Sales Statistics</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-6 mb-4">
                                    <div class="border rounded p-3">
                                        <div class="display-4 text-info">@Model.Stats.TotalLeads</div>
                                        <div class="text-muted">Total Leads</div>
                                    </div>
                                </div>
                                <div class="col-6 mb-4">
                                    <div class="border rounded p-3">
                                        <div class="display-4 text-warning">@Model.Stats.TotalDeals</div>
                                        <div class="text-muted">Total Deals</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Activity Overview</h5>
                        </div>
                        <div class="card-body text-center py-5">
                            <i class="bi bi-bar-chart-line display-1 text-muted"></i>
                            <p class="text-muted mt-3">Activity charts can be added here</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
