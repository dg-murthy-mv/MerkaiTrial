@* =====================================================================
   FILE: MerkaiTrial.Admin.Web/Pages/Admin/Tenants/Result.cshtml
   ===================================================================== *@
@page "/Admin/Tenants/Result"
@model MerkaiTrial.Admin.Web.Pages.Admin.Tenants.ResultModel
@{
    ViewData["Title"] = "Workspace created";
}

<div class="container-fluid py-4" style="max-width: 60rem;">

    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill fs-4"></i>
        <div>
            <strong>@Model.TenantName is ready.</strong>
            @if (Model.TrialExpiresUtc.HasValue)
            {
                <span> Trial runs until @Model.TrialExpiresUtc.Value.ToString("d MMMM yyyy").</span>
            }
        </div>
    </div>

    @* 087: the invite is EMAILED to the administrator now (IAccountEmails,
       queued like every other invite since 086). The link is still shown
       here once, as the backup for an email that doesn't arrive. Only its
       hash is stored, so if this page is closed and the email is lost,
       send a new invite from Admin → Users. *@
    <div class="card border-primary mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-link-45deg"></i>
                @(Model.InviteEmailed ? "Invite emailed — the link is here as well" : "Invite link — send it yourself")
            </h5>
        </div>
        <div class="card-body">
            <p class="mb-2">
                @if (Model.InviteEmailed)
                {
                    <text>We've emailed <strong>@Model.AdminEmail</strong> a link to set their password.
                    Here it is too, in case the email doesn't arrive — send it by WhatsApp or LINE.</text>
                }
                else
                {
                    <text><strong>The invite was not emailed</strong>@(Model.EmailSkippedReason is null ? "" : " (" + Model.EmailSkippedReason + ")").
                    Send this link to <strong>@Model.AdminEmail</strong> yourself.</text>
                }
                It expires
                @if (Model.InviteExpiresUtc.HasValue)
                {
                    <text>on @Model.InviteExpiresUtc.Value.ToString("d MMMM yyyy 'at' HH:mm") UTC</text>
                }
                else
                {
                    <text>in 72 hours</text>
                }
                and can be used once.
            </p>

            <div class="input-group mb-2">
                <input type="text" id="inviteUrl" class="form-control font-monospace"
                       value="@Model.InviteUrl" readonly onclick="this.select();" />
                <button class="btn btn-primary" type="button" onclick="copyInvite()">
                    <i class="bi bi-clipboard"></i> Copy
                </button>
            </div>
            <div id="copyConfirm" class="text-success small" style="display:none;">
                <i class="bi bi-check-circle"></i> Copied.
            </div>

            <div class="alert alert-warning mt-3 mb-0 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                This link is shown once and is not stored anywhere. If it's lost and the email
                didn't arrive, open the administrator in Admin → Users and use
                <strong>Send a new invite</strong>.
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0"><i class="bi bi-chat-text"></i> Message to send another way (WhatsApp, LINE)</h6>
        </div>
        <div class="card-body">
            @* 087: the invite email goes automatically. This is for sending the
               same link another way — WhatsApp, LINE — if it doesn't arrive. *@
            <textarea class="form-control font-monospace" rows="9" id="messageText" readonly>Hi,

Your Merkai workspace for @Model.TenantName is ready.

Set your password here (the link works once and expires in 72 hours):
@Model.InviteUrl

Sign in afterwards with: @Model.AdminEmail
@if (Model.TrialExpiresUtc.HasValue)
{
@:
@:Your trial runs until @Model.TrialExpiresUtc.Value.ToString("d MMMM yyyy"). Everything stays readable and exportable after that; only editing pauses.
}

Any questions, just reply.</textarea>
            <button class="btn btn-outline-secondary btn-sm mt-2" type="button" onclick="copyMessage()">
                <i class="bi bi-clipboard"></i> Copy message
            </button>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-page="./Detail" asp-route-id="@Model.TenantId" class="btn btn-primary">
            <i class="bi bi-eye"></i> Open workspace
        </a>
        <a asp-page="./Index" class="btn btn-outline-secondary">Back to tenants</a>
        <a asp-page="./Create" class="btn btn-outline-secondary">Create another</a>
    </div>
</div>

@section Scripts {
    <script>
        function copyInvite() {
            const el = document.getElementById('inviteUrl');
            el.select();
            navigator.clipboard.writeText(el.value).then(() => {
                document.getElementById('copyConfirm').style.display = 'block';
            });
        }
        function copyMessage() {
            const el = document.getElementById('messageText');
            el.select();
            navigator.clipboard.writeText(el.value);
        }
    </script>
}