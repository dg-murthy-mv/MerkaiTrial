@* =====================================================================
   TENANT EDIT PAGE - Frontend
   Location: MerkaiTrial.Admin.Web/Pages/Admin/Tenants/Edit.cshtml
   ===================================================================== *@

@page "/Admin/Tenants/Edit/{id:guid}"
@model MerkaiTrial.Admin.Web.Pages.Admin.Tenants.EditModel
@{
    ViewData["Title"] = "Edit Tenant";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-pencil"></i> Edit Tenant
            </h2>
            <p class="text-muted mb-0">Update tenant information</p>
        </div>
        <div>
            <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-eye"></i> View Details
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
    <!-- Success Alert (from TempData) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <form method="post">
        <div class="row">
            <!-- Basic Information -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-building"></i> Basic Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Tenant Name -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Name" class="form-label">
                                    Tenant Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Name" class="form-control" placeholder="Enter tenant name" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.FromEmail" class="form-label">
                                    Email Address <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.FromEmail" class="form-control" type="email" 
                                       placeholder="contact@company.com" />
                                <span asp-validation-for="Input.FromEmail" class="text-danger small"></span>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Phone" class="form-label">
                                    Phone Number
                                </label>
                                <input asp-for="Input.Phone" class="form-control" type="tel" 
                                       placeholder="+1 234 567 8900" />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>

                            <!-- Country -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.CountryId" class="form-label">
                                    <i class="bi bi-flag"></i> Country
                                </label>
                                <select asp-for="Input.CountryId" class="form-select" asp-items="Model.CountryOptions">
                                </select>
                                <span asp-validation-for="Input.CountryId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Regional Settings -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-globe"></i> Regional Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Currency -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.DefaultCurrency" class="form-label">
                                    <i class="bi bi-currency-exchange"></i> Default Currency <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.DefaultCurrency" class="form-select" asp-items="Model.CurrencyOptions">
                                    <option value="">-- Select Currency --</option>
                                </select>
                                <span asp-validation-for="Input.DefaultCurrency" class="text-danger small"></span>
                            </div>

                            <!-- Timezone -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.TimeZone" class="form-label">
                                    <i class="bi bi-clock"></i> Timezone <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.TimeZone" class="form-select" asp-items="Model.TimezoneOptions">
                                    <option value="">-- Select Timezone --</option>
                                </select>
                                <span asp-validation-for="Input.TimeZone" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Side Panel -->
            <div class="col-lg-4">
                <!-- Actions Card -->
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-check-circle"></i> Actions</h5>
                    </div>
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                        <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100 mb-2">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>

                <!-- Help Card -->
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Information</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success"></i>
                                <small>Update basic tenant information</small>
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success"></i>
                                <small>Set country and timezone</small>
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success"></i>
                                <small>Configure default currency</small>
                            </li>
                            <li class="mb-0">
                                <i class="bi bi-exclamation-triangle text-warning"></i>
                                <small>Changes take effect immediately</small>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    <!-- Load jQuery FIRST -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Then load validation scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
