@* =====================================================================
   TENANTS INDEX - Mobile Optimized with Uniform Design
   ===================================================================== *@
@page "/Admin/Tenants"
@model MerkaiTrial.Admin.Web.Pages.Admin.Tenants.IndexModel
@{
    ViewData["Title"] = "Tenants";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-building text-primary"></i> Tenant Management</h2>
            <p class="text-muted mb-0">Manage tenant organizations</p>
        </div>
        <div>
            <a asp-page="./Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> <span class="d-none d-sm-inline">Create New Tenant</span>
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 12px;">
                        <i class="bi bi-building text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Tenants.TotalCount</h3>
                    <p class="text-muted mb-0 small fw-semibold">Total Tenants</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 12px;">
                        <i class="bi bi-check-circle text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.ActiveUsers</h3>
                    <p class="text-muted mb-0 small fw-semibold">Active Tenants</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 12px;">
                        <i class="bi bi-pause-circle text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.InactiveUsers</h3>
                    <p class="text-muted mb-0 small fw-semibold">Inactive Tenants</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="avatar-icon mb-3 mx-auto" style="width: 60px; height: 60px; background: linear-gradient(135deg, #8b5cf6, #7c3aed); border-radius: 12px;">
                        <i class="bi bi-funnel text-white" style="font-size: 1.75rem; line-height: 60px;"></i>
                    </div>
                    <h3 class="mb-1">@Model.Stats.TotalLeads</h3>
                    <p class="text-muted mb-0 small fw-semibold">Total Leads</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                <div class="col-md-6">
                    <label class="form-label"><i class="bi bi-search"></i> Search</label>
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" 
                           class="form-control" placeholder="Search by name or email...">
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-funnel"></i> Status</label>
                    <select name="IsActive" class="form-select">
                        <option value="">All Status</option>
                        <option value="true" selected="@(Model.IsActive == true)">Active</option>
                        <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search"></i> <span class="d-none d-sm-inline">Search</span>
                    </button>
                    <a href="?PageSize=@Model.PageSize" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-x-circle"></i> <span class="d-none d-sm-inline">Clear</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tenants List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list"></i> Tenants List
                <span class="badge bg-light text-dark ms-2">@Model.Tenants.TotalCount</span>
            </h5>
            @if (Model.Tenants.TotalPages > 1)
            {
                <span class="badge bg-light text-dark">Page @Model.Page of @Model.Tenants.TotalPages</span>
            }
        </div>

        @if (!Model.Tenants.Items.Any())
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <p class="text-muted mt-3 mb-0">No tenants found</p>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.IsActive.HasValue)
                {
                    <p class="text-muted small">Try adjusting your search or filters</p>
                    <a href="?PageSize=@Model.PageSize" class="btn btn-outline-primary mt-2">Clear Filters</a>
                }
                else
                {
                    <a asp-page="./Create" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Create First Tenant
                    </a>
                }
            </div>
        }
        else
        {
            <!-- DESKTOP VIEW: Table -->
            <div class="d-none d-md-block">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tenant</th>
                                <th>Contact</th>
                                <th>Currency</th>
                                <th>Country</th>
                                <th class="text-center">Users</th>
                                <th class="text-center">Leads</th>
                                <th class="text-center">Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tenant in Model.Tenants.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-2">@tenant.Name[0]</div>
                                            <div>
                                                <div class="fw-semibold">@tenant.Name</div>
                                                <small class="text-muted">@tenant.CreatedAtUtc.ToString("MMM dd, yyyy")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <i class="bi bi-envelope text-muted"></i>
                                        <a href="mailto:@tenant.FromEmail">@tenant.FromEmail</a>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(tenant.DefaultCurrency))
                                        {
                                            <span class="badge bg-light text-dark">@tenant.DefaultCurrency</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(tenant.CountryName))
                                        {
                                            <div>@tenant.CountryName</div>
                                            @if (!string.IsNullOrEmpty(tenant.CountryCode))
                                            {
                                                <small class="text-muted">@tenant.CountryCode</small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">
                                            <i class="bi bi-people"></i> @tenant.UserCount
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary">
                                            <i class="bi bi-funnel"></i> @tenant.LeadCount
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (tenant.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="./Detail" asp-route-id="@tenant.Id" 
                                           class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                        <a asp-page="./Edit" asp-route-id="@tenant.Id" 
                                           class="btn btn-sm btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-page="./Settings" asp-route-id="@tenant.Id" 
                                           class="btn btn-sm btn-outline-info" title="Settings"><i class="bi bi-gear"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MOBILE VIEW: Cards -->
            <div class="d-md-none">
                @foreach (var tenant in Model.Tenants.Items)
                {
                    <div class="card m-3 border">
                        <div class="card-body">
                            <div class="d-flex align-items-start mb-3">
                                <div class="avatar-md me-3">@tenant.Name[0]</div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@tenant.Name</h6>
                                    <small class="text-muted d-block mb-2">@tenant.CreatedAtUtc.ToString("MMM dd, yyyy")</small>
                                    <div>
                                        @if (tenant.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="small mb-2">
                                <i class="bi bi-envelope text-muted"></i> @tenant.FromEmail
                            </div>
                            @if (!string.IsNullOrEmpty(tenant.CountryName))
                            {
                                <div class="small mb-2">
                                    <i class="bi bi-geo-alt text-muted"></i> 
                                    @tenant.CountryName @(tenant.CountryCode != null ? $"({tenant.CountryCode})" : "")
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(tenant.DefaultCurrency))
                            {
                                <div class="small mb-2">
                                    <i class="bi bi-currency-exchange text-muted"></i> @tenant.DefaultCurrency
                                </div>
                            }
                            <div class="small mb-3">
                                <span class="badge bg-info me-1">
                                    <i class="bi bi-people"></i> @tenant.UserCount users
                                </span>
                                <span class="badge bg-primary">
                                    <i class="bi bi-funnel"></i> @tenant.LeadCount leads
                                </span>
                            </div>

                            <div class="d-grid gap-2">
                                <a asp-page="./Detail" asp-route-id="@tenant.Id" 
                                   class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye"></i> View Details
                                </a>
                                <div class="d-flex gap-2">
                                    <a asp-page="./Edit" asp-route-id="@tenant.Id" 
                                       class="btn btn-sm btn-outline-warning flex-fill">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-page="./Settings" asp-route-id="@tenant.Id" 
                                       class="btn btn-sm btn-outline-info flex-fill">
                                        <i class="bi bi-gear"></i> Settings
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Shared Pagination Component -->
            <partial name="_Pagination" model="Model.Tenants" />
        }
    </div>
</div>

<style>
    /* Avatar Styles */
    .avatar-sm {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .avatar-md {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 1.25rem;
    }
</style>
