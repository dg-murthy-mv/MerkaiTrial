@* =====================================================================
   TENANTS INDEX
   Location: Pages/Admin/Tenants/Index.cshtml

   120 — search (also by a person's email), status, plan, order, and the
   shared pager; every link keeps every filter. Success / error messages
   come from _SuperAdminLayout (this page showed them a second time).
   Test hooks: #tenantFilters, #tSearch, #tStatus, #tPlan, #tSort,
   #tenantsTable, tr[data-tenant="<name>"], [data-col=plan|users|leads|status],
   #tenantsEmpty, #tenantCount.
   ===================================================================== *@
@page "/Admin/Tenants"
@model MerkaiTrial.Admin.Web.Pages.Admin.Tenants.IndexModel
@{
    ViewData["Title"] = "Tenants";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-building text-primary" aria-hidden="true"></i> Workspaces</h1>
            <p class="text-muted mb-0">Every customer workspace on the platform.</p>
        </div>
        <a asp-page="./Create" class="btn btn-primary">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> <span>New workspace</span>
        </a>
    </div>

    @if (Model.LoadError is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.LoadError</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
                <div class="h3 mb-1">@Model.AllWorkspaces</div>
                <div class="text-muted small fw-semibold">All workspaces</div>
            </div></div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
                <div class="h3 mb-1 text-success">@Model.Stats.ActiveUsers</div>
                <div class="text-muted small fw-semibold">Active</div>
            </div></div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
                <div class="h3 mb-1 text-warning">@Model.Stats.InactiveUsers</div>
                <div class="text-muted small fw-semibold">Switched off</div>
            </div></div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body text-center">
                <div class="h3 mb-1">@Model.Stats.TotalLeads.ToString("N0")</div>
                <div class="text-muted small fw-semibold">Leads, all workspaces</div>
            </div></div>
        </div>
    </div>

    <form method="get" id="tenantFilters" class="card border-0 shadow-sm mb-3" role="search">
        <div class="card-body row g-2 align-items-end">
            <input type="hidden" name="PageSize" value="@Model.PageSize" />
            <div class="col-12 col-lg-4">
                <label for="tSearch" class="form-label small mb-1">Search</label>
                <input type="search" id="tSearch" name="SearchTerm" value="@Model.SearchTerm" maxlength="100"
                       class="form-control" placeholder="Workspace name or email, or anyone's email in it" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label for="tStatus" class="form-label small mb-1">Status</label>
                <select id="tStatus" name="IsActive" class="form-select">
                    <option value="">Any</option>
                    <option value="true" selected="@(Model.IsActive == true ? "selected" : null)">Active</option>
                    <option value="false" selected="@(Model.IsActive == false ? "selected" : null)">Switched off</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label for="tPlan" class="form-label small mb-1">Plan</label>
                <select id="tPlan" name="Plan" class="form-select">
                    <option value="">Any</option>
                    @foreach (var p in Model.Plans)
                    {
                        <option value="@p" selected="@(string.Equals(p, Model.Plan, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@p</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label for="tSort" class="form-label small mb-1">Order</label>
                <select id="tSort" name="Sort" class="form-select">
                    @foreach (var (value, label) in MerkaiTrial.Admin.Web.Pages.Admin.Tenants.IndexModel.Sorts)
                    {
                        <option value="@value" selected="@(value == Model.Sort ? "selected" : null)">@label</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill" id="tApply"><i class="bi bi-search" aria-hidden="true"></i> Show</button>
                @if (Model.Filtered)
                {
                    <a asp-page="./Index" asp-route-PageSize="@Model.PageSize" class="btn btn-outline-secondary" title="Clear the filters">
                        <i class="bi bi-x-circle" aria-hidden="true"></i><span class="visually-hidden">Clear the filters</span>
                    </a>
                }
            </div>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="h6 mb-0">Workspaces <span class="badge bg-secondary ms-1" id="tenantCount">@Model.Tenants.TotalCount</span></h2>
            @if (Model.Tenants.TotalPages > 1)
            {
                <span class="small text-muted">Page @Model.PageNumber of @Model.Tenants.TotalPages</span>
            }
        </div>

        @if (Model.Tenants.Items.Count == 0)
        {
            <div class="card-body text-center py-5" id="tenantsEmpty">
                <i class="bi bi-inbox display-4 text-muted" aria-hidden="true"></i>
                @if (Model.Filtered)
                {
                    <p class="text-muted mt-3 mb-2">No workspace matches these filters.</p>
                    <a asp-page="./Index" asp-route-PageSize="@Model.PageSize" class="btn btn-outline-primary btn-sm">Clear the filters</a>
                }
                else
                {
                    <p class="text-muted mt-3 mb-2">No workspaces yet.</p>
                    <a asp-page="./Create" class="btn btn-primary btn-sm">Create the first one</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tenantsTable">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Workspace</th>
                            <th scope="col" class="d-none d-lg-table-cell">Country</th>
                            <th scope="col">Plan</th>
                            <th scope="col" class="text-end">People</th>
                            <th scope="col" class="text-end d-none d-md-table-cell">Leads</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end"><span class="visually-hidden">Open</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Tenants.Items)
                        {
                            <tr data-tenant="@t.Name">
                                <td>
                                    <a asp-page="./Detail" asp-route-id="@t.Id" class="fw-semibold text-decoration-none">@t.Name</a>
                                    <div class="small text-muted text-break">@t.FromEmail</div>
                                    <div class="small text-muted">Since @t.CreatedAtUtc.ToString("d MMM yyyy")</div>
                                </td>
                                <td class="d-none d-lg-table-cell small">
                                    @(string.IsNullOrEmpty(t.CountryName) ? "—" : t.CountryName)
                                    @if (!string.IsNullOrEmpty(t.DefaultCurrency))
                                    {
                                        <div class="text-muted">@t.DefaultCurrency</div>
                                    }
                                </td>
                                <td data-col="plan"><span class="badge bg-light text-dark border">@(t.Plan ?? "—")</span></td>
                                <td data-col="users" class="text-end">@t.UserCount</td>
                                <td data-col="leads" class="text-end d-none d-md-table-cell">@t.LeadCount.ToString("N0")</td>
                                <td data-col="status">
                                    @if (t.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Switched off</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-page="./Detail" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye" aria-hidden="true"></i><span class="d-none d-sm-inline"> Open</span><span class="visually-hidden"> @t.Name</span>
                                    </a>
                                    <a asp-page="./People" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary" title="People">
                                        <i class="bi bi-people" aria-hidden="true"></i><span class="visually-hidden">People in @t.Name</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <partial name="_Pager" model="Model.Pager" />
    </div>
</div>
