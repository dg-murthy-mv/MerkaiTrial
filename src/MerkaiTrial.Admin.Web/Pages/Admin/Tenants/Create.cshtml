@* =====================================================================
   FILE: MerkaiTrial.Admin.Web/Pages/Admin/Tenants/Create.cshtml
   Replaces the existing file.
   ===================================================================== *@
@page "/Admin/Tenants/Create"
@model MerkaiTrial.Admin.Web.Pages.Admin.Tenants.CreateModel
@{
    ViewData["Title"] = "New Workspace";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-plus-circle"></i> New Workspace</h2>
            <p class="text-muted mb-0">
                Creates the tenant, its reference data, roles, and the administrator's invite link.
            </p>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to tenants
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    @* ── Duplicate trial warnings ─────────────────────────────────────
       Shown after the first submit when the check finds something. The
       form redisplays with everything filled in; only the confirmation
       is missing. Nothing has been created at this point. *@
    @if (Model.DuplicateWarnings.Any())
    {
        <div class="alert alert-warning">
            <h5 class="alert-heading">
                <i class="bi bi-exclamation-triangle me-2"></i>This may be a repeat trial
            </h5>
            <ul class="mb-3">
                @foreach (var w in Model.DuplicateWarnings)
                {
                    <li>@w</li>
                }
            </ul>
            <p class="mb-3 small">
                Nothing has been created yet. A second trial is sometimes the right answer —
                tick below to go ahead, or change the details above.
            </p>
            <div class="form-check">
                <input asp-for="Input.ConfirmDespiteWarnings" class="form-check-input" type="checkbox" />
                <label asp-for="Input.ConfirmDespiteWarnings" class="form-check-label fw-semibold">
                    I have reviewed these and want to create the workspace anyway
                </label>
            </div>
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="Input.ConfirmDespiteWarnings" />

        <div class="row">
            <div class="col-lg-8">

                <!-- Workspace -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-building"></i> Workspace</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Name" class="form-label">
                                    Company name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Name" class="form-control" placeholder="Sathorn Prestige Interiors" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.FromEmail" class="form-label">
                                    Company email <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.FromEmail" type="email" class="form-control" placeholder="info@company.co.th" />
                                <div class="form-text"><small>Used on quotes and invoices.</small></div>
                                <span asp-validation-for="Input.FromEmail" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Phone" class="form-label">Phone</label>
                                <input asp-for="Input.Phone" type="tel" class="form-control" />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.ReplyToEmail" class="form-label">Reply-to email</label>
                                <input asp-for="Input.ReplyToEmail" type="email" class="form-control" />
                                <span asp-validation-for="Input.ReplyToEmail" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Region & plan -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-globe"></i> Region &amp; plan</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.CountryId" class="form-label">
                                    Country <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.CountryId" class="form-select" asp-items="Model.CountryOptions"></select>
                                @* Country drives more than a label: tax rates come from
                                   Country.DefaultTaxRate, and the seeded lead sources and
                                   channels differ per market — LINE in Thailand, WhatsApp
                                   in India and the UAE, Messenger in the Philippines. *@
                                <div class="form-text">
                                    <small>Sets tax rates, and the lead sources and channels seeded for this market.</small>
                                </div>
                                <span asp-validation-for="Input.CountryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.DefaultCurrency" class="form-label">
                                    Currency <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.DefaultCurrency" class="form-select" asp-items="Model.CurrencyOptions"></select>
                                <div class="form-text">
                                    <small class="text-warning">
                                        <i class="bi bi-lock"></i> Cannot be changed once there are quotes or invoices.
                                    </small>
                                </div>
                                <span asp-validation-for="Input.DefaultCurrency" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.TimeZone" class="form-label">
                                    Time zone <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.TimeZone" class="form-select" asp-items="Model.TimezoneOptions"></select>
                                <span asp-validation-for="Input.TimeZone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Plan" class="form-label">
                                    Plan <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.Plan" class="form-select" asp-items="Model.PlanOptions"></select>
                                <div class="form-text">
                                    <small>Trial plans expire automatically; paid plans do not.</small>
                                </div>
                                <span asp-validation-for="Input.Plan" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.PreferredLanguage" class="form-label">Language</label>
                                <select asp-for="Input.PreferredLanguage" class="form-select">
                                    <option value="en">English</option>
                                    <option value="th">Thai</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Domain" class="form-label">Custom subdomain</label>
                                <input asp-for="Input.Domain" class="form-control" placeholder="sathorn" />
                                <span asp-validation-for="Input.Domain" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Administrator -->
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-person-badge"></i> Workspace administrator</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">
                            The person at the client who receives the invite link. They set their own
                            password — no password is created here.
                        </p>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.AdminFirstName" class="form-label">
                                    First name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.AdminFirstName" class="form-control" />
                                <span asp-validation-for="Input.AdminFirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.AdminLastName" class="form-label">
                                    Last name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.AdminLastName" class="form-control" />
                                <span asp-validation-for="Input.AdminLastName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.AdminEmail" class="form-label">
                                    Email <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.AdminEmail" type="email" class="form-control" />
                                @* Email is globally unique among live users — one person
                                   belongs to one workspace. *@
                                <div class="form-text"><small>Their sign-in address. Must not already exist.</small></div>
                                <span asp-validation-for="Input.AdminEmail" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Side panel -->
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-check-circle"></i> Create workspace
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary w-100">Cancel</a>
                    </div>
                </div>

                @* Live plan data. The old page had a hardcoded comparison card
                   claiming Starter was 100 leads while the database said 500 —
                   the same class of bug as PlanHelper. *@
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-bar-chart"></i> Plans</h6>
                    </div>
                    <div class="card-body">
                        @foreach (var p in Model.PlanDetails.OrderBy(p => p.SortOrder))
                        {
                            <div class="mb-3 pb-2 border-bottom">
                                <div class="d-flex justify-content-between">
                                    <strong>@p.DisplayName</strong>
                                    <span class="text-muted small">
                                        @(p.MonthlyPrice == 0 ? "Free" : $"${p.MonthlyPrice:N0}/mo")
                                    </span>
                                </div>
                                <ul class="small text-muted mb-0 ps-3">
                                    <li>@p.MaxUsers users</li>
                                    <li>@p.MaxLeads.ToString("N0") leads</li>
                                    <li>@p.MaxDeals.ToString("N0") deals</li>
                                    <li>@p.StorageLimitDisplay</li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-list-check"></i> What gets created</h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled small mb-0">
                            <li class="mb-2"><i class="bi bi-check text-success"></i> The workspace, with trial dates if the plan is a trial</li>
                            <li class="mb-2"><i class="bi bi-check text-success"></i> Plan limits and feature flags</li>
                            <li class="mb-2"><i class="bi bi-check text-success"></i> Sales Manager, Sales Rep and Viewer roles</li>
                            <li class="mb-2"><i class="bi bi-check text-success"></i> Tax rates for the chosen country</li>
                            <li class="mb-2"><i class="bi bi-check text-success"></i> Lead sources and channels for that market</li>
                            <li class="mb-2"><i class="bi bi-check text-success"></i> The administrator account</li>
                            <li class="mb-0"><i class="bi bi-check text-success"></i> A 72-hour invite link</li>
                        </ul>
                        <hr />
                        <p class="small text-muted mb-0">
                            All in one transaction. If any step fails, nothing is created.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}