@page "/Admin/Countries/Detail/{code}"
@model MerkaiTrial.Admin.Web.Pages.Admin.Countries.DetailModel
@* =====================================================================
   COUNTRY DETAIL PAGE
   117: the Tax Settings tab lists the country's standard tax rates (they
   were the separate Admin → Tax Rates menu), with Add / Edit / Delete.
   ?tab=tax opens that tab. #countryTaxRates / tr[data-rate] for the tests.
   ===================================================================== *@
@{
    ViewData["Title"] = "Country Details";
    var taxTab = Model.TaxTab;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="avatar-lg me-3" style="width: 80px; height: 80px; font-size: 2rem;">
                @(Model.Country.Name.Length >= 2 ? Model.Country.Name.Substring(0, 2).ToUpper() : Model.Country.Code)
            </div>
            <div>
                <h2 class="mb-1">
                    @Model.Country.Name
                    @if (Model.Country.IsActive)
                    {
                        <span class="badge bg-success ms-2">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger ms-2">Inactive</span>
                    }
                </h2>
                <p class="text-muted mb-0">@Model.Country.Code</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Edit" asp-route-code="@Model.Country.Code" class="btn btn-warning">
                <i class="bi bi-pencil"></i> <span class="d-none d-sm-inline">Edit Country</span>
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back to Countries</span>
            </a>
        </div>
    </div>

    @* 117-update1: success and error messages are shown by _SuperAdminLayout; showing them here too made two. *@

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(taxTab ? "" : "active")" id="overview-tab" data-bs-toggle="tab" 
                    data-bs-target="#overview" type="button" role="tab">
                <i class="bi bi-info-circle"></i> Overview
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(taxTab ? "active" : "")" id="settings-tab" data-bs-toggle="tab" 
                    data-bs-target="#settings" type="button" role="tab">
                <i class="bi bi-gear"></i> Tax Settings
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Overview Tab -->
        <div class="tab-pane fade @(taxTab ? "" : "show active")" id="overview" role="tabpanel">
            <div class="row g-4">
                <!-- Country Information -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-person"></i> Country Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Country Code</label>
                                    <div class="fw-semibold">@Model.Country.Code</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Country Name</label>
                                    <div class="fw-semibold">@Model.Country.Name</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Dial Code</label>
                                    <div class="fw-semibold">
                                        @if (!string.IsNullOrEmpty(Model.Country.DialCode))
                                        {
                                            <span>@Model.Country.DialCode</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Currency Code</label>
                                    <div class="fw-semibold">
                                        @if (!string.IsNullOrEmpty(Model.Country.CurrencyCode))
                                        {
                                            <span class="badge bg-info">@Model.Country.CurrencyCode</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Tax Label</label>
                                    <div class="fw-semibold">
                                        @if (!string.IsNullOrEmpty(Model.Country.TaxLabel))
                                        {
                                            <span>@Model.Country.TaxLabel</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Default Tax Rate</label>
                                    <div class="fw-semibold">
                                        @if (Model.Country.DefaultTaxRate.HasValue)
                                        {
                                            <span>@Model.Country.DefaultTaxRate.Value%</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Display Order</label>
                                    <div class="fw-semibold">@Model.Country.DisplayOrder</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Status</label>
                                    <div>
                                        @if (Model.Country.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Permissions Card -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-shield-check"></i> Status</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="text-muted small">Active Status</label>
                                <div>
                                    @if (Model.Country.IsActive)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        <span class="fw-semibold ms-2">Active</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                        <span class="fw-semibold ms-2">Inactive</span>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small">Has Tax Settings</label>
                                <div>
                                    @if (!string.IsNullOrEmpty(Model.Country.TaxLabel) && Model.Country.DefaultTaxRate.HasValue)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        <span class="fw-semibold ms-2">Yes</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-warning"></i>
                                        <span class="fw-semibold ms-2">No</span>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small">Has Currency</label>
                                <div>
                                    @if (!string.IsNullOrEmpty(Model.Country.CurrencyCode))
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        <span class="fw-semibold ms-2">Yes</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-warning"></i>
                                        <span class="fw-semibold ms-2">No</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tax Settings Tab -->
        <div class="tab-pane fade @(taxTab ? "show active" : "")" id="settings" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-percent"></i> Tax Configuration</h5>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(Model.Country.TaxLabel) && Model.Country.DefaultTaxRate.HasValue)
                            {
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="text-muted small">Tax Type</label>
                                        <div class="fw-semibold fs-5">@Model.Country.TaxLabel</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="text-muted small">Default Rate</label>
                                        <div class="fw-semibold fs-5">@Model.Country.DefaultTaxRate.Value%</div>
                                    </div>
                                    <div class="col-12">
                                        <hr />
                                        <p class="text-muted mb-0">
                                            <i class="bi bi-info-circle"></i>
                                            This is the default tax rate applied for transactions in @Model.Country.Name.
                                        </p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-exclamation-triangle display-1 text-warning"></i>
                                    <p class="lead mt-3">No tax settings configured</p>
                                    <p class="text-muted">Configure tax settings for this country to enable automatic tax calculations.</p>
                                    <a asp-page="./Edit" asp-route-code="@Model.Country.Code" class="btn btn-primary mt-2">
                                        <i class="bi bi-gear"></i> Configure Tax Settings
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    @* 117 — the country's standard tax rates (were Admin → Tax Rates) *@
                    <div class="card border-0 shadow-sm mt-4" id="countryTaxRates">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <h5 class="mb-0"><i class="bi bi-receipt" aria-hidden="true"></i> Standard tax rates</h5>
                            <a asp-page="/Admin/TaxRates/Create" asp-route-forCountry="@Model.Country.Code" class="btn btn-primary btn-sm" id="addTaxRate">
                                <i class="bi bi-plus-circle" aria-hidden="true"></i> Add a tax rate
                            </a>
                        </div>
                        <div class="card-body p-0">
                            <p class="text-muted small px-3 pt-3 mb-2">
                                Every workspace in @Model.Country.Name starts from these rates on its quotes and invoices.
                                A workspace can add its own on top (its Settings &rarr; Tax Rates).
                            </p>
                            @if (Model.RatesFailed)
                            {
                                <div class="alert alert-warning m-3 mb-3">The tax rates could not be loaded. Please reload the page.</div>
                            }
                            else if (Model.Rates.Count == 0)
                            {
                                <div class="text-center text-muted py-4">
                                    No standard tax rates for @Model.Country.Name yet.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col">Name</th>
                                                <th scope="col">Type</th>
                                                <th scope="col" class="text-end">Rate</th>
                                                <th scope="col">In force</th>
                                                <th scope="col">Status</th>
                                                <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in Model.Rates)
                                            {
                                                var state = MerkaiTrial.Application.Common.TaxRateStatus.Of(r.IsActive, r.EffectiveFrom, r.EffectiveTo);
                                                <tr data-rate="@r.Id">
                                                    <td>
                                                        <a asp-page="/Admin/TaxRates/Detail" asp-route-id="@r.Id" class="fw-semibold text-decoration-none">@r.Name</a>
                                                        @if (r.IsDefault)
                                                        {
                                                            <span class="badge bg-primary ms-1">Default</span>
                                                        }
                                                    </td>
                                                    <td>@r.TaxType</td>
                                                    <td class="text-end" data-col="rate">@r.Rate.ToString("0.##")%</td>
                                                    <td class="small text-muted">
                                                        @(r.EffectiveFrom?.ToString("d MMM yyyy") ?? "always")
                                                        &ndash;
                                                        @(r.EffectiveTo?.ToString("d MMM yyyy") ?? "no end")
                                                    </td>
                                                    <td><span class="badge @MerkaiTrial.Application.Common.TaxRateStatus.BadgeClass(state)">@MerkaiTrial.Application.Common.TaxRateStatus.Label(state)</span></td>
                                                    <td class="text-end text-nowrap">
                                                        <a asp-page="/Admin/TaxRates/Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-pencil" aria-hidden="true"></i><span class="visually-hidden">Edit @r.Name</span>
                                                        </a>
                                                        <form method="post" asp-page-handler="DeleteRate" asp-route-code="@Model.Country.Code" class="d-inline"
                                                              onsubmit="return confirm('Delete this tax rate? Quotes and invoices already made keep their tax.');">
                                                            <input type="hidden" name="rateId" value="@r.Id" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                <i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">Delete @r.Name</span>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a asp-page="./Edit" asp-route-code="@Model.Country.Code" class="btn btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit Country
                                </a>
                                <a asp-page="/Admin/TaxRates/Create" asp-route-forCountry="@Model.Country.Code" class="btn btn-outline-primary">
                                    <i class="bi bi-plus-circle" aria-hidden="true"></i> Add a tax rate
                                </a>
                                <button type="button" class="btn btn-outline-secondary" disabled>
                                    <i class="bi bi-building"></i> View Tenants
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Tips Card -->
                    <div class="card border-0 shadow-sm mt-3">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Quick Tips</h6>
                        </div>
                        <div class="card-body">
                            <ul class="small mb-0 ps-3">
                                <li class="mb-2">Tax settings apply to all tenants using this country</li>
                                <li class="mb-2">Currency code should be ISO 4217 format (e.g., USD, EUR, THB)</li>
                                <li>Dial code should include the "+" prefix</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-lg {
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }
</style>
