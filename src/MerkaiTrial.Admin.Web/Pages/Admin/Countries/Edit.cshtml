@* =====================================================================
   COUNTRY EDIT PAGE
   ===================================================================== *@
@page "/Admin/Countries/Edit/{code}"
@model MerkaiTrial.Admin.Web.Pages.Admin.Countries.EditModel
@{
    ViewData["Title"] = "Edit Country";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-pencil text-warning"></i> Edit Country</h2>
            <p class="text-muted mb-0">@Model.Country.Name (@Model.Country.Code)</p>
        </div>
        <div>
            <a asp-page="./Detail" asp-route-code="@Model.Country.Code" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back to Details</span>
            </a>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Code" />
        
        <div class="row g-4">
            <!-- Main Form -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Country Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Country Code</label>
                                <input type="text" class="form-control" value="@Model.Country.Code" disabled />
                                <small class="text-muted">Country code cannot be changed</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Name" class="form-label">Country Name <span class="text-danger">*</span></label>
                                <input asp-for="Input.Name" class="form-control" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.DialCode" class="form-label">Dial Code</label>
                                <input asp-for="Input.DialCode" class="form-control" placeholder="e.g., +1, +44, +66" />
                                <span asp-validation-for="Input.DialCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.CurrencyCode" class="form-label">Currency Code</label>
                                <input asp-for="Input.CurrencyCode" class="form-control" placeholder="e.g., USD, GBP, THB" maxlength="3" />
                                <span asp-validation-for="Input.CurrencyCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tax Settings -->
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="bi bi-percent"></i> Tax Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.TaxLabel" class="form-label">Tax Label</label>
                                <input asp-for="Input.TaxLabel" class="form-control" placeholder="e.g., VAT, GST, Sales Tax" />
                                <span asp-validation-for="Input.TaxLabel" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.DefaultTaxRate" class="form-label">Default Tax Rate (%)</label>
                                <input asp-for="Input.DefaultTaxRate" type="number" step="0.01" min="0" max="100" class="form-control" />
                                <span asp-validation-for="Input.DefaultTaxRate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status -->
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-toggle-on"></i> Status</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch">
                            <input asp-for="Input.IsActive" class="form-check-input" role="switch" style="width: 3em; height: 1.5em;" />
                            <label asp-for="Input.IsActive" class="form-check-label">
                                Country is active
                            </label>
                        </div>
                        <small class="text-muted">Inactive countries are hidden from selection dropdowns</small>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Actions -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-lightning"></i> Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                            <a asp-page="./Detail" asp-route-code="@Model.Country.Code" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Info Card -->
                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-info-circle"></i> Current Info</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label class="text-muted small">Country Code</label>
                            <div class="fw-semibold">@Model.Country.Code</div>
                        </div>
                        <div class="mb-2">
                            <label class="text-muted small">Display Order</label>
                            <div class="fw-semibold">@Model.Country.DisplayOrder</div>
                        </div>
                        <div>
                            <label class="text-muted small">Current Status</label>
                            <div>
                                @if (Model.Country.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Tips -->
                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Quick Tips</h6>
                    </div>
                    <div class="card-body">
                        <ul class="small mb-0 ps-3">
                            <li class="mb-2">Changes affect all tenants using this country</li>
                            <li class="mb-2">Deactivating hides the country from dropdowns</li>
                            <li>Tax rate changes don't affect existing transactions</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
