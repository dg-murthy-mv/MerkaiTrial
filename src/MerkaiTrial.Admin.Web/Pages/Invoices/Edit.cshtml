@page
@using System.Globalization
@using System.Text.Json
@using MerkaiTrial.Admin.Web.Pages.Quotes
@using MerkaiTrial.Application.Configuration
@model MerkaiTrial.Admin.Web.Pages.Invoices.EditModel
@{
    ViewData["Title"] = $"Edit Invoice - {Model.ExistingInvoice?.Number}";

    var inv       = Model.ExistingInvoice;
    var lines     = inv?.Lines ?? new List<MerkaiTrial.Application.DTOs.InvoiceLineDto>();
    var symbol    = Model.GetSymbol(inv?.Currency);
    var taxCodeLabel = TaxCodes.ColumnHeaderFor(inv?.Currency);
    var showTaxCode  = TaxCodes.AnyPresent(lines.Select(l => l.TaxCode));

    // 074. The issue date as the <input type="date"> spells it, for the
    // due-date check in the script section. Computed here, where inv's
    // nullability is handled once, rather than dereferenced inside the
    // section — an empty string there means "no invoice, nothing to
    // check", which is the same page that renders nothing anyway.
    var issueIso = inv != null ? inv.IssueDateUtc.ToString("yyyy-MM-dd") : "";

    // The existing lines, in the shape _QuoteItemsEditor seeds from.
    // camelCase because that is what the editor's script reads; the
    // PascalCase default loaded every line blank, which this page learned
    // the hard way in 018.
    //
    // TaxRate goes out as a PERCENTAGE: the editor works in percent and
    // the page model divides by 100 once, where the DTO is built. Three
    // conventions exist in this codebase and this is the boundary between
    // two of them.
    var seed = lines.Select(l => new
    {
        itemId          = l.Id,
        productId       = l.ProductId,
        name            = l.Name,
        description     = l.Description,
        quantity        = l.Quantity,
        unitOfMeasure   = UnitsOfMeasure.Normalise(l.UnitOfMeasure),
        unitPrice       = l.UnitPrice,
        lineDiscount    = l.LineDiscount,
        discountPercent = l.DiscountPercent,
        taxRate         = l.TaxRate * 100m,
        taxCode         = l.TaxCode ?? string.Empty
    }).ToList();

    // Catalogue prices in THIS INVOICE's currency, for the editor's
    // "price changed since" hint. Products with no price in it are left
    // out — HasPriceInCurrency false means ListPrice is a zero
    // placeholder, not a price.
    var listPrices = (Model.Products ?? new())
        .Where(p => p.HasPriceInCurrency)
        .GroupBy(p => p.Id.ToString())
        .ToDictionary(g => g.Key, g => g.First().ListPrice);

    var editor = new QuoteItemsEditorVm
    {
        FormId                = "editInvoiceForm",
        CurrencyCode          = inv?.Currency ?? Model.TenantCurrencyCode,
        DefaultTaxRate        = Model.DefaultTaxRate,
        TaxLabel              = Model.DefaultTaxRateName,
        // Quote approval rules do not apply to an invoice. Disabled is
        // also this property's default; it is spelled out so nobody
        // wonders later whether it was forgotten.
        ApprovalRulesJson     = "{\"enabled\":false}",
        Products              = Model.Products ?? new(),
        InitialItemsJson      = JsonSerializer.Serialize(seed),
        ListPricesJson        = JsonSerializer.Serialize(listPrices),
        StartWithOneBlankLine = false
    };
}
@* =====================================================================
   Invoices/Edit.cshtml (074 — rebuild)
   Location: MerkaiTrial.Admin.Web/Pages/Invoices/Edit.cshtml

   COMPLETE FILE.

   WHAT WAS WRONG WITH THE OLD PAGE

   1. IT LOADED BOOTSTRAP AND BOOTSTRAP ICONS AGAIN from a CDN, both the
      CSS in the body and the JS bundle at the bottom, on top of the
      copies _Layout.cshtml already loads. Two Bootstrap JS bundles means
      every modal gets two sets of handlers. Round 029 removed exactly
      this from the quote pages.

   2. THE CATALOGUE BUILT JAVASCRIPT OUT OF PRODUCT NAMES:

        onclick="addProductFromCatalog('@@product.Id',
                 '@@Html.Raw(product.Name.Replace("'", "\\'"))', …)"

      A product called O'Brien's Kit could not be added at all — the
      handler was a SyntaxError — and a double quote in a name broke out
      of the attribute entirely. Html.Raw on user data inside an
      event attribute is the pattern 029 removed from the quote editor
      and 031 from the leads list. This was the last one.

   3. THE LINE EDITOR WAS A FOURTH COPY, and the thinnest: no unit of
      measure (052), no percentage discount (055), no tax code (067), no
      bundle breakdown (070), integer quantities, and catalogue prices in
      the workspace's currency rather than the invoice's (069). It is now
      _QuoteItemsEditor.cshtml, the same partial both quote pages use.

   4. THE READ-ONLY TABLE for a quote's invoice printed a bare quantity
      with no unit and no tax code, so the one screen that shows what was
      actually agreed showed less than the PDF does.

   TempData alerts are rendered once, globally, by _Layout.cshtml — this
   page used to draw its own on top.
   ===================================================================== *@

<style>
    .iv-wrap { max-width: 1200px; margin: 0 auto; }
    .iv-head { display: flex; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .iv-title { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0; line-height: 1.2;
                display: flex; align-items: center; gap: .5rem; }
    .iv-title i { color: #4f46e5; font-size: 1.15rem; }
    .iv-sub { font-size: .84rem; color: #64748b; margin: .25rem 0 0; }

    .iv-card { border: 1px solid #e9ecef; border-radius: 12px; background: #fff;
               padding: 1.1rem 1.2rem; margin-bottom: 1rem; }
    .iv-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
                gap: .75rem; font-size: .85rem; }
    .iv-facts .k { color: #64748b; font-size: .72rem; text-transform: uppercase;
                   letter-spacing: .04em; display: block; }
    .iv-facts .v { font-weight: 600; color: #0f172a; }

    .iv-ro { width: 100%; border-collapse: separate; border-spacing: 0; }
    .iv-ro th { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b;
                font-weight: 650; padding: .5rem .7rem; background: #fbfcfd;
                border-bottom: 1px solid #eceff2; white-space: nowrap; }
    .iv-ro td { padding: .5rem .7rem; border-bottom: 1px solid #f4f6f8; font-size: .85rem;
                vertical-align: top; }
    .iv-ro tbody tr:last-child td { border-bottom: 0; }
    .iv-ro .n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>

<div class="iv-wrap">

    <div class="iv-head">
        <div>
            <h1 class="iv-title"><i class="bi bi-pencil-square"></i>Edit invoice</h1>
            <p class="iv-sub">@inv?.Number · @inv?.DealTitle</p>
        </div>
        <div class="ms-auto d-flex gap-2">
            <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
            <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-list me-1"></i>All invoices
            </a>
        </div>
    </div>

    @* No alert blocks here. _Layout renders TempData["SuccessMessage"]
       and ["ErrorMessage"] globally, and [TempData] properties populate
       exactly those keys. *@

    @if (!Model.IsEditable && !string.IsNullOrEmpty(Model.StatusWarning))
    {
        <div class="alert alert-warning">
            <div class="fw-bold mb-1">
                <i class="bi bi-exclamation-triangle me-2"></i>Status: @inv?.Status
            </div>
            <div class="small mb-0">@Model.StatusWarning</div>
        </div>
    }

    @if (inv != null)
    {
        <div class="iv-card">
            <div class="iv-facts">
                <div>
                    <span class="k">Number</span>
                    <span class="v">@inv.Number</span>
                </div>
                <div>
                    <span class="k">Status</span>
                    <span class="v">
                        <span class="badge bg-@(inv.Status == "Draft" ? "secondary" : "primary")">@inv.Status</span>
                    </span>
                </div>
                <div>
                    <span class="k">Amount</span>
                    <span class="v">@symbol@inv.GrandTotal.ToString("N2", CultureInfo.InvariantCulture)</span>
                </div>
                <div>
                    <span class="k">Issue date</span>
                    <span class="v">@Model.FormatDate(inv.IssueDateUtc)</span>
                </div>
                <div>
                    <span class="k">Items</span>
                    <span class="v">@inv.Lines.Count</span>
                </div>
            </div>

            @if (inv.IsMilestoneInvoice)
            {
                @* 071: this invoice bills one stage of a quote's schedule,
                   so its unit prices are a share of the quote's and will
                   not match the catalogue. *@
                <div class="alert alert-primary py-2 px-3 small mt-3 mb-0">
                    <i class="bi bi-calendar2-check me-1"></i>
                    <strong>@inv.MilestoneLabel</strong>
                    @if (!string.IsNullOrWhiteSpace(inv.MilestoneBasisNote))
                    {
                        <span>— @inv.MilestoneBasisNote</span>
                    }
                </div>
            }
        </div>

        <form method="post" id="editInvoiceForm">
            @* 074. ONLY on the from-quote path.

               A manual invoice renders the shared line editor further down,
               and that partial brings its OWN hidden field — also called
               itemsJson, because that is the handler's parameter name. Two
               fields with one name in one form post twice, and the model
               binder hands the handler "[{...}],[{...}]": two JSON documents
               joined by a comma, which parses as neither, so every save of
               every manual invoice would have failed with "Failed to update".

               On the from-quote path the editor is not on the page at all
               and the handler ignores this value, but it is bound as a
               parameter, so the field stays and the script below sets it to
               an empty list. *@
            @if (Model.IsFromQuote)
            {
                <input type="hidden" name="itemsJson" id="itemsJson" />
            }

            <div class="iv-card">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.DueDate" class="form-label small fw-semibold">
                            Due date <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.DueDate" type="date" class="form-control" min="@issueIso" />
                        <span asp-validation-for="Input.DueDate" class="text-danger small"></span>
                        @* 074. min= gives the date picker itself the rule, so
                           the earlier dates are greyed out before anything is
                           typed. It is not a guarantee — a date can still be
                           typed into the text part in some browsers, and the
                           field can be edited away entirely — so the script
                           below checks it on submit and the handler checks it
                           again on the server. *@
                        <div id="invDateErr" class="invalid-feedback d-block d-none">
                            The due date cannot be before the issue date (@Model.FormatDate(inv.IssueDateUtc)).
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Notes" class="form-label small fw-semibold">Notes</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>

            @if (Model.IsFromQuote)
            {
                @* ── A quote's invoice: lines are read-only ────────── *@
                <div class="alert alert-info py-2 px-3 small">
                    <i class="bi bi-lock me-1"></i>
                    These lines come from the accepted quote and can't be changed here.
                    To invoice different items, delete this draft and raise a manual
                    invoice — or revise the quote.
                </div>

                <div class="iv-card p-0" style="overflow:hidden;">
                    <div class="table-responsive">
                        <table class="iv-ro">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    @if (showTaxCode)
                                    {
                                        <th>@taxCodeLabel</th>
                                    }
                                    <th class="n">Qty</th>
                                    <th class="n">Unit price</th>
                                    <th class="n">@Model.DefaultTaxRateName</th>
                                    <th class="n">Discount</th>
                                    <th class="n">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var line in lines)
                            {
                                <tr>
                                    <td>
                                        <strong>@line.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(line.Description))
                                        {
                                            <div class="text-muted small">@line.Description</div>
                                        }
                                    </td>
                                    @if (showTaxCode)
                                    {
                                        <td>
                                            @if (line.HasTaxCode)
                                            {
                                                <code class="small">@line.TaxCode</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    }
                                    @* 052: the quantity WITH its unit. The old
                                       table printed a bare number, so the one
                                       screen showing what was agreed showed
                                       less than the PDF did. *@
                                    <td class="n">@line.QuantityDisplay</td>
                                    <td class="n">@symbol@line.UnitPrice.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td class="n">@((line.TaxRate * 100).ToString("0.##"))%</td>
                                    <td class="n">
                                        @if (!string.IsNullOrWhiteSpace(line.DiscountLabel))
                                        {
                                            @* 055: the percentage, when that is
                                               what was agreed. *@
                                            <span>@line.DiscountLabel</span>
                                        }
                                        else if (line.LineDiscount > 0)
                                        {
                                            <span>@symbol@line.LineDiscount.ToString("N2", CultureInfo.InvariantCulture)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="n fw-semibold">
                                        @symbol@line.LineGrandTotal.ToString("N2", CultureInfo.InvariantCulture)
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                @* ── A manual invoice: the shared line editor ───────── *@
                @* The same partial the two quote pages render. Referenced
                   by path because it lives in Pages/Quotes; its name says
                   "Quote" but it takes a QuoteItemsEditorVm and nothing
                   else, and renaming it would touch four working pages
                   for a word. *@
                <partial name="/Pages/Quotes/_QuoteItemsEditor.cshtml" model="editor" />
            }

            <div class="d-flex justify-content-between mt-4">
                <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Update invoice
                </button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // A quote's invoice sends NO lines — the API keeps the quote's,
        // and the editor is not on the page to sync anything.
        //
        // For a manual invoice the editor owns the itemsJson field and
        // hooks this form's submit itself (that is what FormId is for), so
        // there is nothing to do here but the due-date check.
        (function () {
            'use strict';

            var fromQuote = @(Model.IsFromQuote ? "true" : "false");
            var form = document.getElementById('editInvoiceForm');
            var json = document.getElementById('itemsJson');

            if (fromQuote && form && json) {
                form.addEventListener('submit', function () { json.value = '[]'; });
            }

            // ── 074: due date must not precede the issue date ────────
            // The issue date is not editable here, so it is a constant
            // rendered from the invoice. Capture phase with
            // stopImmediatePropagation, so on a manual invoice this runs
            // before the editor serialises its lines — the same order
            // Quotes/Create.cshtml uses for its expiry-date check.
            var ISSUE   = '@issueIso';
            var dueEl   = document.getElementById('Input_DueDate');
            var dateErr = document.getElementById('invDateErr');

            function datesOk() {
                if (!ISSUE || !dueEl || !dueEl.value) return true;
                // Both yyyy-MM-dd, so a string compare is a date compare.
                return dueEl.value >= ISSUE;
            }

            function showDateError(bad) {
                if (dateErr) dateErr.classList.toggle('d-none', !bad);
                if (dueEl) dueEl.classList.toggle('is-invalid', bad);
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    var bad = !datesOk();
                    showDateError(bad);
                    if (bad) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        if (dueEl) dueEl.focus();
                    }
                }, true);
            }

            if (dueEl) dueEl.addEventListener('change', function () { showDateError(!datesOk()); });
        })();
    </script>
}
