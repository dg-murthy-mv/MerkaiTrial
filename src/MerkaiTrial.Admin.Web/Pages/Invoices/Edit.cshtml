@page
@model MerkaiTrial.Admin.Web.Pages.Invoices.EditModel
@using System.Text.Json
@{
    ViewData["Title"] = $"Edit Invoice - {Model.ExistingInvoice?.Number}";
    
    // ✅ Prepare items for JavaScript
    var itemsForJson = Model.ExistingInvoice?.Lines ?? new List<MerkaiTrial.Application.DTOs.InvoiceLineDto>();
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem 0;
        margin: -1rem -1rem 2rem -1rem;
        border-radius: 0 0 1rem 1rem;
    }

    .form-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        padding: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .invoice-info-box {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-left: 4px solid #667eea;
        padding: 1.5rem;
        border-radius: 0.5rem;
        margin-bottom: 2rem;
    }

    .line-items-table thead {
        background: #f8f9fa;
    }

    .totals-section {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 1.5rem;
        margin-top: 2rem;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
    }

    .total-row.grand-total {
        border-top: 2px solid #dee2e6;
        margin-top: 0.5rem;
        padding-top: 1rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: #667eea;
    }

    .btn-remove-item {
        color: #dc3545;
        cursor: pointer;
    }
</style>

<div class="container-fluid">
    <div class="page-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="bi bi-pencil-square me-2"></i>Edit Invoice
                    </h1>
                    <p class="mb-0 opacity-75">@Model.ExistingInvoice?.Number</p>
                </div>
                <div>
                    <a href="/Invoices/Detail?id=@Model.Id" class="btn btn-outline-light me-2">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                    <a href="/Invoices/Index" class="btn btn-outline-light">
                        <i class="bi bi-list me-2"></i>All Invoices
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="form-container">

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!Model.IsEditable && !string.IsNullOrEmpty(Model.StatusWarning))
        {
            <div class="alert alert-warning">
                <h5><i class="bi bi-exclamation-triangle me-2"></i>Invoice Status: @Model.ExistingInvoice?.Status</h5>
                <p class="mb-0">@Model.StatusWarning</p>
            </div>
        }

        @if (Model.ExistingInvoice != null)
        {
            <div class="invoice-info-box">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="mb-3"><i class="bi bi-info-circle me-2"></i>Current Invoice Information</h5>
                        <p class="mb-2"><strong>Number:</strong> @Model.ExistingInvoice.Number</p>
                        <p class="mb-2"><strong>Deal:</strong> @Model.ExistingInvoice.DealTitle</p>
                        <p class="mb-0">
                            <strong>Status:</strong>
                            <span class="badge bg-@(Model.ExistingInvoice.Status == "Draft" ? "secondary" : "primary")">
                                @Model.ExistingInvoice.Status
                            </span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-2"><strong>Amount:</strong> @Model.FormatCurrency(Model.ExistingInvoice.GrandTotal)</p>
                        <p class="mb-2"><strong>Issue Date:</strong> @Model.FormatDate(Model.ExistingInvoice.IssueDateUtc)</p>
                        <p class="mb-0"><strong>Items:</strong> @Model.ExistingInvoice.Lines.Count</p>
                    </div>
                </div>
            </div>

            <form method="post" id="editInvoiceForm">
                <input type="hidden" name="itemsJson" id="itemsJson" />

                <!-- Due Date & Notes -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="Input.DueDate" class="form-label">
                            Due Date <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.DueDate" type="date" class="form-control" />
                        <span asp-validation-for="Input.DueDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Notes" class="form-label">
                            Notes
                        </label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Line Items -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5><i class="bi bi-list-ul me-2"></i>Line Items</h5>
                    <div>
                        <button type="button" class="btn btn-outline-primary btn-sm me-2" onclick="showAddFromCatalog()">
                            <i class="bi bi-plus-circle me-2"></i>Add from Catalog
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" onclick="addCustomItem()">
                            <i class="bi bi-plus-circle me-2"></i>Add Custom Item
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered line-items-table">
                        <thead>
                            <tr>
                                <th style="width: 25%;">Item Name</th>
                                <th style="width: 25%;">Description</th>
                                <th style="width: 8%;">Qty</th>
                                <th style="width: 12%;">Unit Price</th>
                                <th style="width: 8%;">Tax %</th>
                                <th style="width: 12%;">Discount</th>
                                <th style="width: 8%;">Total</th>
                                <th style="width: 2%;"></th>
                            </tr>
                        </thead>
                        <tbody id="lineItemsBody">
                            <!-- Populated by JavaScript -->
                        </tbody>
                    </table>
                </div>

                <div id="emptyState" class="text-center py-4 text-muted" style="display: none;">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-2">No items yet. Add items to the invoice.</p>
                </div>

                <!-- Totals -->
                <div class="row">
                    <div class="col-md-6 offset-md-6">
                        <div class="totals-section">
                            <div class="total-row">
                                <span>Subtotal:</span>
                                <strong><span id="subtotalDisplay">@Model.TenantCurrencySymbol 0.00</span></strong>
                            </div>
                            <div class="total-row">
                                <span>Discount:</span>
                                <strong><span id="discountDisplay">@Model.TenantCurrencySymbol 0.00</span></strong>
                            </div>
                            <div class="total-row">
                                <span>Tax:</span>
                                <strong><span id="taxDisplay">@Model.TenantCurrencySymbol 0.00</span></strong>
                            </div>
                            <div class="total-row grand-total">
                                <span>Grand Total:</span>
                                <strong><span id="grandTotalDisplay">@Model.TenantCurrencySymbol 0.00</span></strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <a href="/Invoices/Detail?id=@Model.Id" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-2"></i>Cancel
                    </a>
                    <button type="button" class="btn btn-success btn-lg" onclick="submitInvoice()">
                        <i class="bi bi-save me-2"></i>Update Invoice
                    </button>
                </div>
            </form>
        }
    </div>
</div>

<!-- Add from Catalog Modal -->
<div class="modal fade" id="catalogModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add from Product Catalog</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" class="form-control" id="productSearch" 
                           placeholder="Search products..." onkeyup="filterProducts()" />
                </div>
                <div style="max-height: 400px; overflow-y: auto;" id="productList">
                    @foreach (var product in Model.Products)
                    {
                        <div class="product-item border-bottom py-2" data-name="@product.Name.ToLower()">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@product.Name</strong>
                                    <div class="text-muted small">@product.Description</div>
                                    <div class="small">Price: @Model.FormatCurrency(product.ListPrice)</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-primary"
                                        onclick="addProductFromCatalog('@product.Id', '@Html.Raw(product.Name.Replace("'", "\\'"))', '@Html.Raw((product.Description ?? "").Replace("'", "\\'"))', @product.ListPrice)">
                                    <i class="bi bi-plus"></i> Add
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ==================== GLOBAL STATE ====================
    let lineItems = [];
    let nextId = 1;
    // ✅ was: const currency = '...'  +  `${currency} ${x.toFixed(2)}`
    //    toFixed() does NO grouping, so client-computed totals rendered
    //    ungrouped ("255000.00") while the server rendered "฿255,000.00".
    //    MerkaiCurrency (see _Layout) uses Intl.NumberFormat with the tenant's
    //    culture, so client and server now agree by construction.
    const fmtMoney = (x) => window.MerkaiCurrency.format(x);

    // ==================== LOAD EXISTING ITEMS ====================
    console.log('=== Loading Existing Items ===');
    
    const existingItemsJson = @Html.Raw(JsonSerializer.Serialize(itemsForJson));
    console.log('Existing items:', existingItemsJson);

    if (existingItemsJson && Array.isArray(existingItemsJson)) {
        existingItemsJson.forEach(item => {
            lineItems.push({
                id: nextId++,
                productId: item.productId,
                name: item.name || '',
                description: item.description || '',
                quantity: item.quantity || 1,
                unitPrice: item.unitPrice || 0,
                lineDiscount: item.lineDiscount || 0,
                taxRate: (item.taxRate * 100) || 0
            });
        });
        console.log('✅ Loaded', lineItems.length, 'items');
    }

    // ==================== ADD/REMOVE ITEMS ====================
    function addCustomItem() {
        lineItems.push({
            id: nextId++,
            productId: null,
            name: '',
            description: '',
            quantity: 1,
            unitPrice: 0,
            lineDiscount: 0,
            taxRate: 0
        });
        renderLineItems();
    }

    function addProductFromCatalog(productId, name, description, price) {
        lineItems.push({
            id: nextId++,
            productId: productId,
            name: name,
            description: description || '',
            quantity: 1,
            unitPrice: parseFloat(price),
            lineDiscount: 0,
            taxRate: 0
        });
        renderLineItems();
        bootstrap.Modal.getInstance(document.getElementById('catalogModal')).hide();
    }

    function removeItem(index) {
        if (confirm('Remove this item?')) {
            lineItems.splice(index, 1);
            renderLineItems();
        }
    }

    function updateItem(index, field, value) {
        if (!lineItems[index]) return;
        if (['quantity', 'unitPrice', 'lineDiscount', 'taxRate'].includes(field)) {
            value = parseFloat(value) || 0;
        }
        lineItems[index][field] = value;
        updateItemTotal(index);
        calculateTotals();
    }

    // ==================== CALCULATIONS ====================
    function calculateItemTotal(item) {
        const qty = parseFloat(item.quantity) || 0;
        const unit = parseFloat(item.unitPrice) || 0;
        const disc = parseFloat(item.lineDiscount) || 0;
        const rate = parseFloat(item.taxRate) || 0;
        const subtotal = qty * unit;
        const afterDiscount = Math.max(0, subtotal - disc);
        const tax = afterDiscount * (rate / 100);
        return afterDiscount + tax;
    }

    function updateItemTotal(index) {
        const item = lineItems[index];
        if (!item) return;
        const total = calculateItemTotal(item);
        const el = document.getElementById(`total-${item.id}`);
        if (el) el.textContent = fmtMoney(total);
    }

    function calculateTotals() {
        let subtotal = 0, discount = 0, tax = 0;
        lineItems.forEach(item => {
            const qty = parseFloat(item.quantity) || 0;
            const unit = parseFloat(item.unitPrice) || 0;
            const disc = parseFloat(item.lineDiscount) || 0;
            const rate = parseFloat(item.taxRate) || 0;
            const itemSubtotal = qty * unit;
            subtotal += itemSubtotal;
            discount += disc;
            const afterDiscount = Math.max(0, itemSubtotal - disc);
            tax += afterDiscount * (rate / 100);
        });
        const grandTotal = Math.max(0, subtotal - discount + tax);
        document.getElementById('subtotalDisplay').textContent = fmtMoney(subtotal);
        document.getElementById('discountDisplay').textContent = fmtMoney(discount);
        document.getElementById('taxDisplay').textContent = fmtMoney(tax);
        document.getElementById('grandTotalDisplay').textContent = fmtMoney(grandTotal);
    }

    // ==================== RENDER ====================
    function escapeHtml(str) {
        return (str ?? '').toString().replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
    }

    function renderLineItems() {
        const tbody = document.getElementById('lineItemsBody');
        const emptyState = document.getElementById('emptyState');
        if (lineItems.length === 0) {
            tbody.innerHTML = '';
            emptyState.style.display = 'block';
            calculateTotals();
            return;
        }
        emptyState.style.display = 'none';
        tbody.innerHTML = lineItems.map((item, index) => `
            <tr>
                <td><input type="text" class="form-control form-control-sm" value="${escapeHtml(item.name)}" oninput="updateItem(${index}, 'name', this.value)" placeholder="Item name" required /></td>
                <td><input type="text" class="form-control form-control-sm" value="${escapeHtml(item.description)}" oninput="updateItem(${index}, 'description', this.value)" placeholder="Description" /></td>
                <td><input type="number" class="form-control form-control-sm" value="${item.quantity}" oninput="updateItem(${index}, 'quantity', this.value)" min="1" required /></td>
                <td><input type="number" class="form-control form-control-sm" value="${item.unitPrice}" oninput="updateItem(${index}, 'unitPrice', this.value)" step="0.01" min="0" required /></td>
                <td><input type="number" class="form-control form-control-sm" value="${item.taxRate}" oninput="updateItem(${index}, 'taxRate', this.value)" step="0.01" min="0" max="100" /></td>
                <td><input type="number" class="form-control form-control-sm" value="${item.lineDiscount}" oninput="updateItem(${index}, 'lineDiscount', this.value)" step="0.01" min="0" /></td>
                <td class="text-end"><strong id="total-${item.id}">${fmtMoney(calculateItemTotal(item))}</strong></td>
                <td class="text-center"><i class="bi bi-trash btn-remove-item" onclick="removeItem(${index})"></i></td>
            </tr>
        `).join('');
        calculateTotals();
    }

    // ==================== SUBMIT ====================
    function submitInvoice() {
        if (lineItems.length === 0) {
            alert('⚠️ Please add at least one item');
            return;
        }
        const invalidItems = lineItems.filter(i => !i.name || i.name.trim() === '');
        if (invalidItems.length > 0) {
            alert(`⚠️ All items must have a name. ${invalidItems.length} item(s) missing names.`);
            return;
        }
        const itemsToSend = lineItems.map(item => ({
            productId: item.productId,
            name: item.name,
            description: item.description,
            unitPrice: item.unitPrice,
            quantity: item.quantity,
            lineDiscount: item.lineDiscount,
            taxRate: item.taxRate
        }));
        document.getElementById('itemsJson').value = JSON.stringify(itemsToSend);
        document.getElementById('editInvoiceForm').submit();
    }

    function showAddFromCatalog() {
        new bootstrap.Modal(document.getElementById('catalogModal')).show();
    }

    function filterProducts() {
        const search = document.getElementById('productSearch').value.toLowerCase();
        document.querySelectorAll('.product-item').forEach(item => {
            const name = item.getAttribute('data-name');
            item.style.display = name.includes(search) ? 'block' : 'none';
        });
    }

    // ==================== INIT ====================
    document.addEventListener('DOMContentLoaded', function () {
        renderLineItems();
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
