@page
@using System.Text.Json
@using MerkaiTrial.Admin.Web.Pages.Quotes
@model MerkaiTrial.Admin.Web.Pages.Invoices.CreateModel
@* (018) "Create & Issue" (was "Create & Send"); catalog prices/tax rendered
   culture-proof; new custom lines use the tenant's tax rate. *@
@{
    ViewData["Title"] = Model.Mode == "FromQuote" ? "Create Invoice from Quote" : "Create Invoice";
}

<div class="page-header mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; border-radius: 12px;">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-2">
                <i class="bi bi-receipt-cutoff me-2"></i>@ViewData["Title"]
            </h2>
            @if (Model.Mode == "FromQuote" && Model.Quote != null)
            {
                <p class="mb-0 opacity-75">
                    <i class="bi bi-file-earmark-text me-2"></i>Quote: @Model.Quote.Number
                    <span class="mx-2">|</span>
                    <i class="bi bi-building me-2"></i>@Model.Quote.CompanyName
                </p>
            }
            else if (Model.Deal != null)
            {
                <p class="mb-0 opacity-75">
                    <i class="bi bi-briefcase me-2"></i>Deal: @Model.Deal.Title
                    <span class="mx-2">|</span>
                    <i class="bi bi-building me-2"></i>@Model.Deal.CompanyName
                </p>
            }
        </div>
        <div>
            <a href="@(Model.QuoteId.HasValue ? $"/Quotes/Detail?id={Model.QuoteId}" : "/Pipeline")" class="btn btn-light">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>Invoice Details
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Issue Date *</label>
                        <input type="date" class="form-control" name="IssueDate" id="IssueDate" value="@Model.IssueDate.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Due Date *</label>
                        <input type="date" class="form-control" name="DueDate" id="DueDate" value="@Model.DueDate.ToString("yyyy-MM-dd")" required />
                        @* 074. Nothing checked that the due date was on or
                           after the issue date, on the client or the server.
                           An invoice raised due before it was issued came out
                           Overdue the moment it was sent, which reads as a
                           billing error to whoever receives it. *@
                        <div id="invDateErr" class="invalid-feedback d-block d-none">
                            The due date cannot be before the issue date.
                        </div>
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDueDays(30)">Net 30</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDueDays(60)">Net 60</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDueDays(90)">Net 90</button>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Currency</label>
                        @* ✅ BUGFIX: every <option> previously carried selected="@(...)", which
                           renders the literal string "False" — and in HTML `selected` is a
                           BOOLEAN attribute, so selected="False" still selects. All six options
                           were selected and the browser fell back to the first (USD), showing
                           "USD - US Dollar" on an AED tenant. Same bug on disabled="@(...)",
                           which left the field disabled in Manual mode too.
                           The hardcoded 6-currency list also had no AED at all.
                           Now: exactly one option — the tenant/quote currency — so the wrong
                           currency cannot be displayed or posted. Uses Razor conditional
                           rendering for `disabled` rather than an interpolated attribute. *@
                        @{
                            var invoiceCurrency = !string.IsNullOrWhiteSpace(Model.Currency)
                                ? Model.Currency
                                : Model.TenantCurrencyCode;
                            var currencyLabel = string.IsNullOrWhiteSpace(Model.TenantCurrencySymbol)
                                ? invoiceCurrency
                                : $"{invoiceCurrency} ({Model.TenantCurrencySymbol})";
                        }
                        @if (Model.Mode == "FromQuote")
                        {
                            <select class="form-select" name="Currency" id="Currency" disabled>
                                <option value="@invoiceCurrency" selected>@currencyLabel</option>
                            </select>
                            @* NOTE: these Invoice Details fields sit OUTSIDE both post forms.
                               Each form in the sidebar carries its own hidden mirrors
                               (IssueDateHidden / DueDateHidden / NotesHidden). Currency is
                               not posted on the FromQuote path at all — the API takes it
                               from the quote — so no hidden mirror is needed here. *@
                            <div class="form-text">Set by the quote and cannot be changed.</div>
                        }
                        else
                        {
                            @* 074. Disabled, like the FromQuote path, and for a
                               reason that only became true this round: the line
                               editor now loads the catalogue AT THIS CURRENCY —
                               each product's price list is read for it, and a
                               product with no price in it is shown as having
                               none. A dropdown offering a change the catalogue
                               would not follow is a dropdown that lies.

                               There is one option either way (the deal's
                               currency, or the workspace's), so nothing is
                               being taken away. The form posts the hidden
                               mirror below, not this. *@
                            <select class="form-select" name="CurrencyDisplay" id="Currency" disabled>
                                <option value="@invoiceCurrency" selected>@currencyLabel</option>
                            </select>
                            <div class="form-text">Set by the deal and cannot be changed.</div>
                        }
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Notes (Optional)</label>
                        <textarea class="form-control" name="Notes" rows="3" placeholder="Add any notes or payment instructions...">@Model.Notes</textarea>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Mode == "FromQuote" && Model.Quote != null)
        {
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-list-ul me-2"></i>Invoice Items
                        <span class="badge bg-primary ms-2">@Model.Quote.Items.Count items</span>
                    </h5>
                </div>
                <div class="card-body">
                    @* 071. The amounts below are the QUOTE's. On a
                       milestone invoice every one of them is billed at
                       the stage's share, which is said here rather than
                       left for somebody to work out from a total that
                       does not match. *@
                    @if (Model.Stage != null)
                    {
                        <div class="alert alert-light border py-2 px-3 small">
                            <i class="bi bi-info-circle me-1 text-primary"></i>
                            Every line below is billed at
                            <strong>@Model.Stage.EffectivePercent.ToString("0.##")%</strong>
                            for this stage, keeping its own tax rate and tax code.
                            The figures shown are the quote's.
                        </div>
                    }

                    @foreach (var item in Model.Quote.Items)
                    {
                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="mb-1">@item.Name</h6>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <small class="text-muted">@item.Description</small>
                                    }
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-primary" style="font-size: 1.1rem;">
                                        @Model.FormatCurrency(item.LineGrandTotal)
                                    </div>
                                </div>
                            </div>
                            <div class="row text-muted small">
                                <div class="col">
                                    <strong>Qty:</strong> @item.Quantity
                                </div>
                                <div class="col">
                                    <strong>Unit Price:</strong> @Model.FormatCurrency(item.UnitPrice)
                                </div>
                                @if (item.LineDiscount > 0)
                                {
                                    <div class="col">
                                        <strong>Discount:</strong> -@Model.FormatCurrency(item.LineDiscount)
                                    </div>
                                }
                                <div class="col">
                                    <strong>Tax:</strong> @((item.TaxRate * 100).ToString("N0"))% (@Model.FormatCurrency(item.LineTax))
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            @* ── 074: the SHARED line editor ─────────────────────────
               The same partial both quote pages render. What it replaces
               was the thinnest of the four copies: a <select> of product
               names with the price formatted in the WORKSPACE's currency,
               no unit of measure, no tax code, no percentage discount, no
               bundle breakdown, and integer quantities.

               Referenced by path because it lives in Pages/Quotes. Its
               name says "Quote"; it takes a QuoteItemsEditorVm and nothing
               else, and renaming it would touch four working pages for a
               word.

               Rendered BARE, not inside a card — the partial brings its
               own "Line items" heading, the Add-line and catalogue
               buttons, and its own totals strip. The card around it used
               to supply a header reading "Invoice Items", which would now
               be a second heading saying the same thing two lines above
               the first. Both quote pages render it bare for the same
               reason. *@
            <div class="mb-4">
                @{
                    var listPrices = (Model.Products ?? new())
                        .Where(p => p.HasPriceInCurrency)
                        .GroupBy(p => p.Id.ToString())
                        .ToDictionary(g => g.Key, g => g.First().ListPrice);

                    var editor = new QuoteItemsEditorVm
                    {
                        // The form is in the sticky card in the RIGHT
                        // column, further down the page than this partial.
                        // That used to matter — see the hidden field and
                        // bindForm() in the editor; as of 074 it does not.
                        FormId                = "manualInvoiceForm",
                        CurrencyCode          = invoiceCurrency,
                        DefaultTaxRate        = Model.DefaultTaxRate,
                        TaxLabel              = Model.DefaultTaxRateName,
                        // Quote approval rules do not apply to an invoice.
                        // Disabled is also this property's default; spelled
                        // out so nobody wonders whether it was forgotten.
                        ApprovalRulesJson     = "{\"enabled\":false}",
                        Products              = Model.Products ?? new(),
                        InitialItemsJson      = "[]",
                        ListPricesJson        = JsonSerializer.Serialize(listPrices),
                        StartWithOneBlankLine = true
                    };
                }
                <partial name="/Pages/Quotes/_QuoteItemsEditor.cshtml" model="editor" />
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-4 position-sticky" style="top: 20px;">
            <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <h5 class="mb-0">
                    <i class="bi bi-calculator me-2"></i>Invoice Summary
                </h5>
            </div>
            <div class="card-body">
                @if (Model.Mode == "FromQuote" && Model.Quote != null)
                {
                    @* 071. A MILESTONE invoice is not for the quote's
                       total, and showing the quote's total as "Grand
                       Total" with a Create button under it would be the
                       page telling somebody they are about to bill four
                       lakh when they are about to bill one-and-a-half.

                       So when a stage is being billed, the stage's own
                       figure leads, and the quote's breakdown is shown
                       below it, labelled as the quote's. The stage amount
                       is the one the SERVER computed (including the
                       last-stage remainder) — not re-derived here, which
                       would be a second copy of the rounding rule. *@
                    @if (Model.Stage != null)
                    {
                        <div class="alert alert-primary py-2 px-3 mb-3">
                            <div class="small text-uppercase" style="letter-spacing:.03em;opacity:.8;">
                                Stage @Model.Stage.Sequence of @Model.Stage.Count
                            </div>
                            <div class="fw-bold">@Model.Stage.Name</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Stage.DueCondition))
                            {
                                <div class="small">@Model.Stage.DueCondition</div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-end mb-3">
                            <span class="fs-5 fw-bold">This invoice:</span>
                            <span class="fs-4 fw-bold text-primary">@Model.FormatCurrency(Model.Stage.Amount)</span>
                        </div>

                        <div class="small text-muted mb-2">
                            @Model.Stage.EffectivePercent.ToString("0.##")% of the accepted quote
                            @if (Model.Stage.IsFinal && Model.Stage.Count > 1)
                            {
                                <text>— the final stage, so it bills whatever is left and the invoices add up to exactly the quote.</text>
                            }
                        </div>
                        <hr>
                        <div class="small text-muted mb-2">
                            Accepted quote @Model.Quote.Number
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span class="fw-bold">@Model.FormatCurrency(Model.Quote.Subtotal)</span>
                    </div>
                    @if (Model.Quote.DiscountTotal > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Discount:</span>
                            <span class="fw-bold">-@Model.FormatCurrency(Model.Quote.DiscountTotal)</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax:</span>
                        <span class="fw-bold">@Model.FormatCurrency(Model.Quote.TaxTotal)</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fs-5 fw-bold">@(Model.Stage != null ? "Quote total:" : "Grand Total:")</span>
                        <span class="@(Model.Stage != null ? "fs-5 fw-bold text-muted" : "fs-4 fw-bold text-primary")">
                            @Model.FormatCurrency(Model.Quote.GrandTotal)
                        </span>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span class="fw-bold" id="subtotalDisplay">@Model.FormatCurrency(0)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-success" id="discountRow" style="display: none;">
                        <span>Discount:</span>
                        <span class="fw-bold" id="discountDisplay">@Model.FormatCurrency(0)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax:</span>
                        <span class="fw-bold" id="taxDisplay">@Model.FormatCurrency(0)</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fs-5 fw-bold">Grand Total:</span>
                        <span class="fs-4 fw-bold text-primary" id="grandTotalDisplay">@Model.FormatCurrency(0)</span>
                    </div>
                }
            </div>

            <div class="card-footer bg-light">
                @if (Model.Mode == "FromQuote")
                {
                    @* ✅ id added — the script below used to select this form by
                       [asp-page-handler], a TAG HELPER attribute that Razor consumes
                       and strips at render time. It never exists in the DOM, so the
                       selector always returned null and the submit hook never bound. *@
                    <form method="post" asp-page-handler="CreateFromQuote" id="fromQuoteInvoiceForm">
                        <input type="hidden" name="QuoteId" value="@Model.QuoteId" />
                        @* 071. Which stage of the schedule this invoice is.
                           Rendered only when there IS one, so a quote
                           without a schedule posts exactly what it posted
                           before this round — nothing. The handler
                           re-reads the schedule and refuses a stage that
                           has gone away, so a stale value here cannot
                           bill the wrong thing. *@
                        @if (Model.Stage != null)
                        {
                            <input type="hidden" name="MilestoneId" value="@Model.Stage.Id" />
                        }
                        <input type="hidden" name="IssueDate" id="IssueDateHidden" value="@Model.IssueDate.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="DueDate" id="DueDateHidden" value="@Model.DueDate.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="Notes" id="NotesHidden" value="@Model.Notes" />
                        
                        <button type="submit" name="sendImmediately" value="false" class="btn btn-outline-primary w-100 mb-2">
                            <i class="bi bi-save me-2"></i>Save as Draft
                        </button>
                        <button type="submit" name="sendImmediately" value="true" class="btn btn-success w-100">
                            <i class="bi bi-send-check me-2"></i>Create &amp; Issue Invoice
                        </button>
                        <div class="small text-muted mt-2">Issuing gives it its invoice number and locks it.</div>
                    </form>
                }
                else
                {
                    @* 074. onsubmit="return validateForm()" is gone, and so is
                       the page's own itemsJson field.

                       The shared editor owns both now: it writes its own
                       hidden itemsJson, associates it with this form by id
                       (form="manualInvoiceForm"), and validates on submit.
                       A second field with the same name would post twice and
                       the model binder would hand the handler "[...],[...]" —
                       two JSON documents separated by a comma, which parses
                       as neither. *@
                    <form method="post" asp-page-handler="CreateManual" id="manualInvoiceForm">
                        <input type="hidden" name="DealId" value="@Model.DealId" />
                        <input type="hidden" name="IssueDate" id="IssueDateHidden2" value="@Model.IssueDate.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="DueDate" id="DueDateHidden2" value="@Model.DueDate.ToString("yyyy-MM-dd")" />
                        @* 074. invoiceCurrency, not Model.Currency — the same
                           value the dropdown shows and the same one the line
                           editor priced the catalogue in. Model.Currency can
                           be blank on a deal that never had one set, and this
                           used to post that blank. *@
                        <input type="hidden" name="Currency" value="@invoiceCurrency" />
                        <input type="hidden" name="Notes" id="NotesHidden2" value="@Model.Notes" />

                        <button type="submit" name="sendImmediately" value="false" class="btn btn-outline-primary w-100 mb-2">
                            <i class="bi bi-save me-2"></i>Save as Draft
                        </button>
                        <button type="submit" name="sendImmediately" value="true" class="btn btn-success w-100">
                            <i class="bi bi-send-check me-2"></i>Create &amp; Issue Invoice
                        </button>
                        <div class="small text-muted mt-2">
                            Issuing gives it its invoice number and locks it. If it's over your workspace's
                            discount limits it is saved as a draft for a manager to issue.
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
@if (Model.Mode == "Manual")
{
<script>
    // ─────────────────────────────────────────────────────────────────
    // 074. WHAT USED TO BE HERE
    //
    // About 220 lines: addProductToInvoice(), addCustomItem(),
    // removeItem(), updateItem(), calculateLineItemTotal(),
    // updateLineItemTotal(), calculateTotals(), renderLineItems() and
    // validateForm() — the fourth hand-rolled line-item editor in the
    // solution, and the thinnest. Integer quantities, no unit of
    // measure, no tax code, no percentage discount, no bundle
    // breakdown, catalogue prices in the workspace's currency whatever
    // the invoice was in, and onclick="" handlers built by string
    // concatenation around values the user types.
    //
    // All of it is now _QuoteItemsEditor.cshtml, which is where those
    // nine features already worked. What is left here is the three
    // things that are genuinely this page's: the due-date buttons, the
    // summary card, and copying the date and notes boxes into the
    // hidden fields the handler binds.
    // ─────────────────────────────────────────────────────────────────
    (function () {
        'use strict';

        // ── Net 30 / 60 / 90 ────────────────────────────────────────
        // Still a global: the buttons are onclick="setDueDays(30)" in
        // markup above, which can only reach a global. Writing the
        // hidden field as well as the visible one is belt-and-braces —
        // the submit handler below copies it anyway.
        window.setDueDays = function (days) {
            var issueEl = document.getElementById('IssueDate');
            var base = (issueEl && issueEl.value) ? new Date(issueEl.value) : new Date();
            if (isNaN(base.getTime())) base = new Date();

            base.setDate(base.getDate() + days);
            var iso = base.toISOString().split('T')[0];

            var due = document.getElementById('DueDate');
            if (due) due.value = iso;
            var hidden = document.getElementById('DueDateHidden2');
            if (hidden) hidden.value = iso;
        };

        // ── the summary card ────────────────────────────────────────
        // The editor publishes its totals; this page displays them in
        // the sticky card next to the Create button. Formatted with
        // MerkaiCurrency (Intl.NumberFormat, the tenant's culture), the
        // same helper the editor and _Layout use, so the two panels
        // cannot disagree about grouping or symbol placement.
        function money(x) {
            if (window.MerkaiCurrency && window.MerkaiCurrency.format) {
                return window.MerkaiCurrency.format(x);
            }
            return (Math.round(x * 100) / 100).toFixed(2);
        }

        function set(id, text) {
            var el = document.getElementById(id);
            if (el) el.textContent = text;
        }

        document.addEventListener('quote-items:totals', function (e) {
            var d = e.detail || {};

            set('subtotalDisplay', money(d.subtotal || 0));
            set('discountDisplay', '-' + money(d.discount || 0));
            set('taxDisplay', money(d.tax || 0));
            set('grandTotalDisplay', money(d.grand || 0));

            var row = document.getElementById('discountRow');
            if (row) row.style.display = (d.discount > 0) ? 'flex' : 'none';
        });

        // ── dates and notes into the hidden fields ──────────────────
        // The visible Issue Date, Due Date and Notes boxes are in the
        // left column, outside this form. The handler binds IssueDate,
        // DueDate and Notes, so the form carries hidden copies and this
        // listener fills them in at submit time.
        //
        // These three could have had form="manualInvoiceForm" and no
        // script at all — but then the hidden copies would post TOO,
        // two values per name, and the binder would take the first. The
        // copies are what the handler reads, so they are what gets
        // written.
        //
        // Bubble phase, registered here: the editor's own submit
        // listener may call preventDefault() when a line is invalid.
        // That stops the POST; it does not stop this listener, so the
        // hidden fields are written for a submit that never leaves. No
        // harm — the user fixes the line and submits again, and these
        // are rewritten from the same boxes.
        var form = document.getElementById('manualInvoiceForm');
        if (form) {
            form.addEventListener('submit', function () {
                var issue = document.getElementById('IssueDate');
                var due   = document.getElementById('DueDate');
                var notes = document.querySelector('textarea[name="Notes"]');

                if (issue) set2('IssueDateHidden2', issue.value);
                if (due)   set2('DueDateHidden2', due.value);
                if (notes) set2('NotesHidden2', notes.value);
            });
        } else if (window.console && console.warn) {
            console.warn('manualInvoiceForm not found — dates and notes will not sync.');
        }

        function set2(id, value) {
            var el = document.getElementById(id);
            if (el) el.value = value;
        }

        // ── due date must not precede issue date ────────────────────
        // Nothing checked this, here or on the server: you could raise
        // an invoice that fell due before it was issued, which then
        // showed up Overdue the moment it was sent.
        //
        // Capture phase with stopImmediatePropagation, exactly as
        // Quotes/Create.cshtml does it: capture runs before the
        // editor's bubble-phase listener whichever was registered
        // first, so a bad date stops the post before the lines are
        // serialised.
        var issueEl = document.getElementById('IssueDate');
        var dueEl   = document.getElementById('DueDate');
        var dateErr = document.getElementById('invDateErr');

        function datesOk() {
            if (!issueEl || !dueEl || !issueEl.value || !dueEl.value) return true;
            // Both are yyyy-MM-dd from <input type="date">, so a string
            // compare is a correct date compare — no parsing, no timezone.
            return dueEl.value >= issueEl.value;
        }

        function showDateError(bad) {
            if (dateErr) dateErr.classList.toggle('d-none', !bad);
            if (dueEl) dueEl.classList.toggle('is-invalid', bad);
        }

        if (form) {
            form.addEventListener('submit', function (e) {
                var bad = !datesOk();
                showDateError(bad);
                if (bad) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    if (dueEl) dueEl.focus();
                }
            }, true);
        }

        // min= on the due date, kept in step with the issue date. The date
        // picker then greys out the impossible days instead of letting one
        // be chosen and rejected afterwards. Not a guarantee — hence the
        // submit check above and the handler's check on the server.
        function syncMin() {
            if (dueEl && issueEl) dueEl.min = issueEl.value || '';
        }

        if (dueEl)   dueEl.addEventListener('change', function () { showDateError(!datesOk()); });
        if (issueEl) issueEl.addEventListener('change', function () {
            syncMin();
            showDateError(!datesOk());
        });

        syncMin();
    })();
</script>
}
@if (Model.Mode == "FromQuote")
{
<script>
    function setDueDays(days) {
        const issueDate = new Date(document.getElementById('IssueDate').value || new Date());
        const dueDate = new Date(issueDate);
        dueDate.setDate(dueDate.getDate() + days);
        document.getElementById('DueDate').value = dueDate.toISOString().split('T')[0];
        document.getElementById('DueDateHidden').value = dueDate.toISOString().split('T')[0];
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        // ✅ BUGFIX: was document.querySelector('form[asp-page-handler="CreateFromQuote"]').
        // asp-page-handler is a Razor TAG HELPER attribute — the server consumes it to
        // build the form action and REMOVES it from the rendered HTML. The selector
        // therefore matched nothing, `form` was always null, and this submit handler
        // was never attached.
        //
        // Consequence: IssueDateHidden / DueDateHidden / NotesHidden kept whatever the
        // server rendered on page load. Editing the issue date, due date or notes and
        // submitting silently posted the ORIGINAL values — no error, wrong data saved.
        // (setDueDays() above happened to write DueDateHidden directly, so the quick
        // +15/+30/+60 buttons worked while typing a date by hand did not. That is why
        // this went unnoticed.)
        const form = document.getElementById('fromQuoteInvoiceForm');
        if (form) {
            form.addEventListener('submit', function() {
                const issue = document.getElementById('IssueDate');
                const due   = document.getElementById('DueDate');
                const notes = document.querySelector('textarea[name="Notes"]');

                if (issue) document.getElementById('IssueDateHidden').value = issue.value;
                if (due)   document.getElementById('DueDateHidden').value   = due.value;
                if (notes) document.getElementById('NotesHidden').value     = notes.value;
            });

            // 074. The same due-date check the manual path got. There is no
            // line editor on this path and nothing else listens for submit,
            // so an ordinary bubble-phase listener is enough — but it is
            // registered AFTER the sync above, and preventDefault here does
            // not un-write those hidden fields. That is harmless: they are
            // rewritten from the same boxes on the next submit.
            form.addEventListener('submit', function (e) {
                if (!datesOk()) {
                    showDateError(true);
                    e.preventDefault();
                    if (dueEl) dueEl.focus();
                }
            });
        } else {
            console.warn('fromQuoteInvoiceForm not found — invoice hidden fields will not sync.');
        }

        var issueEl = document.getElementById('IssueDate');
        var dueEl   = document.getElementById('DueDate');
        var dateErr = document.getElementById('invDateErr');

        function datesOk() {
            if (!issueEl || !dueEl || !issueEl.value || !dueEl.value) return true;
            // Both are yyyy-MM-dd, so a string compare is a date compare.
            return dueEl.value >= issueEl.value;
        }

        function showDateError(bad) {
            if (dateErr) dateErr.classList.toggle('d-none', !bad);
            if (dueEl) dueEl.classList.toggle('is-invalid', bad);
        }

        function syncMin() {
            if (dueEl && issueEl) dueEl.min = issueEl.value || '';
        }

        if (dueEl)   dueEl.addEventListener('change', function () { showDateError(!datesOk()); });
        if (issueEl) issueEl.addEventListener('change', function () {
            syncMin();
            showDateError(!datesOk());
        });

        syncMin();
    });
</script>
}
}
