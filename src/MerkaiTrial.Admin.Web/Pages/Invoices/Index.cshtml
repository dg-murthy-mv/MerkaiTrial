@page
@using MerkaiTrial.Admin.Web.Pages.Invoices
@using MerkaiTrial.Admin.Web.Pages.Shared
@using MerkaiTrial.Application.Configuration
@model MerkaiTrial.Admin.Web.Pages.Invoices.IndexModel
@{
    ViewData["Title"] = "Invoices";

    var sorter = Model.Sorter;
    var state  = Model.StateRoute();   // posted by Delete and Issue, so the redirect lands here
}
@* =====================================================================
   FILE: MerkaiTrial.Admin.Web/Pages/Invoices/Index.cshtml

   096 — THE INVOICES LIST JOINS THE OTHER LISTS
     • _ListToolbar: search (number, customer, deal, quote, custom text),
       Status, and the issued From / To dates, with the "1–10 of 340"
       count. _CustomFieldFilterPanel beneath it. _Pager at the foot —
       10 a page by default, remembered per browser. All in the URL.
     • Sorting: the strip above the cards (Invoice · Customer · Issued ·
       Due · Amount · Balance) is a row of links that sort the whole list
       on the server; click again to flip. On a phone, a Sort menu.
     • Delete and Issue post the whole list state, so you land back on
       the same page of the same filtered, sorted list.
     • An empty list says which empty it is: nothing matches (with Clear),
       the load failed (with Try again), or there are no invoices yet.
     • The status icon on each card shows now: the class was "bi file-…"
       rather than "bi-file-…", so it never drew.

   081
     • Invoice custom fields marked "Show on the list" appear on each card
       under the customer, as "Label: value" (set values only).
     • Issue / Delete buttons carry data- attributes read by one delegated
       listener, instead of onclick="…" strings built around values.

   018 — INVOICE WORKFLOW
     • Draft → "Issue" button: gives the INV number, locks it.
     • Delete only on drafts; issued invoices show a lock (void them from
       the invoice page).
     • Stats: Total/Unpaid/Overdue count ISSUED invoices; drafts are
       mentioned under the Issued card.
     • Labels: "Issued" for Sent, "Void" for Cancelled; drafts show "Draft".

   074b — no TempData banners here (_Layout renders them once) and no
   auto-dismiss timer of its own. A failed load is Model.PageError, shown
   on this response.
   ===================================================================== *@

<style>
    .inv-head { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b;
                font-weight: 650; padding: .45rem 1rem; }
    .inv-head .sep { opacity: .4; margin: 0 .35rem; }
    .inv-card { transition: box-shadow .2s ease; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .inv-card:hover { box-shadow: 0 4px 12px rgba(0,0,0,.12); }
    .inv-number { font-family: 'Courier New', monospace; }
    .page-header { box-shadow: 0 4px 12px rgba(102,126,234,.3); }
</style>

<!-- Page Header -->
<div class="page-header mb-4"
     style="background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:white;padding:2rem;border-radius:12px;">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-2">
                <i class="bi bi-receipt me-2"></i>Invoices
            </h2>
            <p class="mb-0 opacity-75">Manage your sales invoices and payments</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @Model.PlanBadgeClass fs-6 px-3 py-2">
                @Model.PlanDisplayName
            </span>

            <a href="/Pipeline" class="btn btn-light">
                <i class="bi bi-funnel me-2"></i>Go to Pipeline
            </a>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.PageError))
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div>
            <strong>@Model.PageError</strong>
            <div class="small">
                The list below is empty because the load failed, not because there are no invoices.
            </div>
        </div>
    </div>
}

<!-- Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card border-start border-primary border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted text-uppercase mb-1" style="font-size:0.75rem;font-weight:600;">Issued Invoices</p>
                        <h3 class="mb-0">@Model.Statistics.TotalInvoices</h3>
                        <small class="text-muted">@Model.FormatCurrency(Model.Statistics.TotalAmount)</small>
                        @if (Model.Statistics.DraftInvoices > 0)
                        {
                            <div><small class="text-muted">+ @Model.Statistics.DraftInvoices @(Model.Statistics.DraftInvoices == 1 ? "draft" : "drafts") not issued</small></div>
                        }
                    </div>
                    <div class="text-primary" style="font-size:2.5rem;opacity:0.3;">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-start border-success border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted text-uppercase mb-1" style="font-size:0.75rem;font-weight:600;">Paid</p>
                        <h3 class="mb-0 text-success">@Model.Statistics.PaidInvoices</h3>
                        <small class="text-muted">@Model.FormatCurrency(Model.Statistics.PaidAmount)</small>
                    </div>
                    <div class="text-success" style="font-size:2.5rem;opacity:0.3;">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-start border-warning border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted text-uppercase mb-1" style="font-size:0.75rem;font-weight:600;">Unpaid</p>
                        <h3 class="mb-0 text-warning">@(Model.Statistics.TotalInvoices - Model.Statistics.PaidInvoices)</h3>
                        <small class="text-muted">@Model.FormatCurrency(Model.Statistics.UnpaidAmount)</small>
                    </div>
                    <div class="text-warning" style="font-size:2.5rem;opacity:0.3;">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-start border-danger border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted text-uppercase mb-1" style="font-size:0.75rem;font-weight:600;">Overdue</p>
                        <h3 class="mb-0 text-danger">@Model.Statistics.OverdueInvoices</h3>
                        <small class="text-muted">@Model.FormatCurrency(Model.Statistics.OverdueAmount)</small>
                    </div>
                    <div class="text-danger" style="font-size:2.5rem;opacity:0.3;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── 096: search, status, dates, count — one GET form ──────────────── *@
<partial name="_ListToolbar" model="Model.Toolbar" />

@if (!string.IsNullOrEmpty(Model.DateWarning))
{
    <div class="alert alert-warning py-2 px-3 small d-flex gap-2 align-items-center" role="alert">
        <i class="bi bi-calendar-x"></i>
        <span>@Model.DateWarning</span>
    </div>
}

@* 096 — custom field filters; their inputs post with the toolbar's form. *@
<partial name="_CustomFieldFilterPanel" model="Model.CustomFilters" />

<!-- Invoices List -->
@if (Model.Invoices.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            @if (!string.IsNullOrEmpty(Model.PageError))
            {
                <i class="bi bi-cloud-slash" style="font-size:4rem;opacity:0.3;"></i>
                <h5 class="mt-3">The list could not be loaded</h5>
                <a asp-page="./Index" asp-all-route-data="state" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise me-1"></i>Try again
                </a>
            }
            else if (Model.IsFiltered)
            {
                <i class="bi bi-search" style="font-size:4rem;opacity:0.3;"></i>
                <h5 class="mt-3">No invoice matches these filters</h5>
                <a asp-page="./Index" asp-all-route-data="Model.ClearAllRoute()" class="btn btn-outline-secondary">
                    Clear the search and filters
                </a>
            }
            else
            {
                <i class="bi bi-inbox" style="font-size:4rem;opacity:0.3;"></i>
                <h5 class="mt-3">No invoices yet</h5>
                <p class="text-muted">Create invoices from accepted quotes in the Pipeline.</p>
                <a href="/Pipeline" class="btn btn-primary">
                    <i class="bi bi-funnel me-2"></i>Go to Pipeline
                </a>
            }
        </div>
    </div>
}
else
{
    @* ── 096: the sort strip ───────────────────────────────────────
       The cards are four columns wide; each label here sits over its
       column and sorts by it. Two keys share a column where the card
       shows two values (number + status are one block; issued + due). *@
    @* aria-sort belongs to table column headers; these are plain links
       whose titles say what they do, and the active one is marked. *@
    <div class="row inv-head d-none d-md-flex align-items-center" role="group" aria-label="Sort invoices">
        <div class="col-md-3">
            <partial name="_SortHeader" model="@(new SortHeaderVm(sorter, "number", "Invoice"))" />
        </div>
        <div class="col-md-3">
            <partial name="_SortHeader" model="@(new SortHeaderVm(sorter, "customer", "Customer"))" />
        </div>
        <div class="col-md-3">
            <partial name="_SortHeader" model="@(new SortHeaderVm(sorter, "issued", "Issued"))" /><span class="sep">·</span><partial name="_SortHeader" model="@(new SortHeaderVm(sorter, "due", "Due"))" />
        </div>
        <div class="col-md-3 text-end">
            <partial name="_SortHeader" model="@(new SortHeaderVm(sorter, "total", "Amount"))" /><span class="sep">·</span><partial name="_SortHeader" model="@(new SortHeaderVm(sorter, "balance", "Balance"))" />
        </div>
    </div>

    @if (Model.TotalCount > 1)
    {
        @* Phones: no strip, a menu. *@
        <div class="mb-2 d-md-none"><partial name="_SortMenu" model="sorter" /></div>
    }

    <div class="row g-3" id="invoiceList">
        @foreach (var invoice in Model.Invoices)
        {
            <div class="col-12">
                <div class="card inv-card @(Model.IsOverdue(invoice) ? "border-danger" : "")" data-invoice-number="@invoice.Number">
                    <div class="card-body">
                        <div class="row align-items-center">

                            <!-- Invoice Number and Status -->
                            <div class="col-md-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi @Model.GetStatusIcon(invoice.Status) me-2 text-muted" aria-hidden="true"></i>
                                    <h5 class="mb-0 inv-number">@IndexModel.DisplayNumber(invoice.Number)</h5>
                                </div>
                                <span class="badge @Model.GetStatusBadgeClass(invoice.Status)">
                                    @Model.GetStatusDisplay(invoice.Status)
                                </span>
                                @if (Model.IsOverdue(invoice))
                                {
                                    <span class="badge bg-danger ms-1">OVERDUE</span>
                                }
                            </div>

                            <!-- Company and Deal Info -->
                            <div class="col-md-3">
                                <div class="mb-1">
                                    <i class="bi bi-building me-1 text-muted"></i>
                                    <strong>@invoice.CompanyName</strong>
                                </div>
                                @if (!string.IsNullOrEmpty(invoice.DealTitle))
                                {
                                    <div class="text-muted small">
                                        <i class="bi bi-briefcase me-1"></i>@invoice.DealTitle
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(invoice.QuoteNumber))
                                {
                                    <div class="text-muted small">
                                        <i class="bi bi-file-earmark-text me-1"></i>@invoice.QuoteNumber
                                    </div>
                                }
                                @* 071. Which stage of the quote this is. Nothing
                                   renders for an ordinary invoice. *@
                                @if (invoice.IsMilestoneInvoice)
                                {
                                    <div class="small">
                                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle">
                                            <i class="bi bi-calendar2-check me-1"></i>@invoice.MilestoneBadge
                                        </span>
                                    </div>
                                }
                                @* 081 — the "Show on the list" custom fields that are set. *@
                                @foreach (var cv in Model.CustomValues(invoice))
                                {
                                    <div class="text-muted small text-truncate" title="@cv.Field.Label: @cv.Text">
                                        <i class="bi @CustomFieldTypes.Icon(cv.Field.FieldType) me-1" aria-hidden="true"></i>@cv.Field.Label:
                                        <span class="text-body">@cv.Text</span>
                                    </div>
                                }
                            </div>

                            <!-- Dates and Amounts -->
                            <div class="col-md-3">
                                <div class="mb-1">
                                    <i class="bi bi-calendar3 me-1 text-muted"></i>
                                    <small>Issued: @Model.FormatDate(invoice.IssueDateUtc)</small>
                                </div>
                                <div class="mb-1 @(Model.IsOverdue(invoice) ? "text-danger fw-bold" : "")">
                                    <i class="bi bi-calendar-check me-1"></i>
                                    <small>@Model.GetRelativeDate(invoice.DueDateUtc)</small>
                                </div>
                                <div>
                                    <span class="badge bg-light text-dark">@invoice.ItemCount items</span>
                                </div>
                            </div>

                            <!-- Amount and Actions -->
                            <div class="col-md-3 text-md-end mt-2 mt-md-0">
                                <div class="mb-2">
                                    <div class="text-primary fw-bold" style="font-size:1.5rem;">
                                        @Model.FormatCurrency(invoice.GrandTotal)
                                    </div>
                                    @if (invoice.Balance < invoice.GrandTotal)
                                    {
                                        <small class="text-muted">
                                            Balance: @Model.FormatCurrency(invoice.Balance)
                                        </small>
                                    }
                                </div>

                                <div class="btn-group" role="group">

                                    @* View — always visible *@
                                    <a href="/Invoices/Detail?id=@invoice.Id"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>

                                    @* Payment — issued (not draft/void), money owed, update permission *@
                                    @if (invoice.Balance > 0
                                         && invoice.Status != "Cancelled"
                                         && invoice.Status != "Draft"
                                         && Model.CanUpdate)
                                    {
                                        <a href="/Invoices/Detail?id=@invoice.Id#payment"
                                           class="btn btn-sm btn-success">
                                            <i class="bi bi-cash-coin me-1"></i>Payment
                                        </a>
                                    }

                                    @* (018) Issue — only a Draft, with update permission *@
                                    @if (invoice.Status == "Draft" && Model.CanUpdate)
                                    {
                                        <button type="button" class="btn btn-sm btn-info js-issue"
                                                data-invoice-id="@invoice.Id">
                                            <i class="bi bi-send-check me-1"></i>Issue
                                        </button>
                                    }

                                    @* (018) Delete — drafts only (issued invoices are voided) *@
                                    @if (invoice.Status == "Draft")
                                    {
                                        @if (Model.CanDelete)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger js-delete"
                                                    data-invoice-id="@invoice.Id" data-label="this draft"
                                                    aria-label="Delete this draft">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="btn btn-sm btn-outline-secondary disabled pe-none"
                                              title="@(invoice.Status == "Cancelled" ? "Void invoices stay on record" : "Issued invoices can't be deleted — void it from the invoice page")">
                                            <i class="bi bi-lock"></i>
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ── 096: one pager, for every screen size ──────────────────────── *@
    <div class="card border-0 shadow-sm mt-3">
        <partial name="_Pager" model="Model.Pager" />
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Delete Invoice
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Delete <strong id="deleteInvoiceNumber"></strong>? It was never issued, so no invoice number is lost.</p>
                <p class="text-danger mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                @if (Model.CanDelete)
                {
                    @* 096 — carries the list state, so the redirect lands back here. *@
                    <form id="deleteForm" method="post" asp-page-handler="Delete" class="d-inline">
                        <input type="hidden" name="id" id="deleteInvoiceId" />
                        @foreach (var keep in state)
                        {
                            <input type="hidden" name="@keep.Key" value="@keep.Value" />
                        }
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-2"></i>Delete Invoice
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<!-- (018) Issue Form (Hidden). 096 — carries the list state too. -->
<form id="issueForm" method="post" asp-page-handler="Issue" style="display:none;">
    <input type="hidden" name="invoiceId" id="issueInvoiceId" />
    @foreach (var keep in state)
    {
        <input type="hidden" name="@keep.Key" value="@keep.Value" />
    }
</form>

@section Scripts {
    <script>
        // ⚠ 074b: no auto-dismiss timer here — _Layout.cshtml already does it
        // for every page, and a second timer over the same alerts closed one
        // Bootstrap Alert twice (TypeError in Alert._destroyElement). If a
        // page needs a different schedule, call the layout's lfDismissAlert(el).

        // 081 — one delegated listener reading data- attributes, instead
        // of onclick="…" strings built around values in the markup.
        (function () {
            'use strict';

            function confirmDelete(invoiceId, label) {
                var idField = document.getElementById('deleteInvoiceId');
                if (!idField) return;   // no delete permission → no form
                idField.value = invoiceId;
                document.getElementById('deleteInvoiceNumber').textContent = label;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteModal')).show();
            }

            function issueInvoice(invoiceId) {
                if (!confirm('Issue this invoice? It gets its invoice number now and can no longer be edited.')) return;
                document.getElementById('issueInvoiceId').value = invoiceId;
                document.getElementById('issueForm').submit();
            }

            document.addEventListener('click', function (e) {
                var t = e.target && e.target.closest ? e.target.closest('.js-issue, .js-delete') : null;
                if (!t) return;
                var id = t.getAttribute('data-invoice-id');
                if (!id) return;
                if (t.classList.contains('js-issue')) issueInvoice(id);
                else confirmDelete(id, t.getAttribute('data-label') || 'this draft');
            });
        })();
    </script>
}
