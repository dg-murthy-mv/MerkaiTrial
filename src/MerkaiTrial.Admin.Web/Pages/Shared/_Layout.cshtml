@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Linq
@using MerkaiTrial.Admin.Web.Services
@inject MerkaiTrial.Application.Services.Tenants.ICurrentTenantService Ui

@{
    var routeVals = ViewContext.RouteData.Values;
    var currentPage = (string)(routeVals.ContainsKey("page") ? routeVals["page"] : "/Index") ?? "/Index";

    var tenantName = Ui.GetTenantName();
    var userEmail = Ui.GetUserEmail();

    var _emailLocal = (userEmail ?? "admin").Split('@')[0];
    var _parts = _emailLocal.Split('.');
    var userInitials = _parts.Length >= 2
        ? $"{char.ToUpper(_parts[0][0])}{char.ToUpper(_parts[1][0])}"
        : _emailLocal.Length >= 2 ? _emailLocal[..2].ToUpper() : "AD";
    var displayName = _parts.Length >= 2
        ? $"{char.ToUpper(_parts[0][0])}{_parts[0][1..]} {char.ToUpper(_parts[1][0])}{_parts[1][1..]}"
        : _emailLocal;

    // ✅ Plan info — from ICurrentTenantService
    var planName = Ui.GetPlanName();           // "starter" / "professional" / "enterprise"
    var planDisplayName = Ui.GetPlanDisplayName();    // "Starter" / "Professional" / "Enterprise"
    var planBadgeColor = planName switch
    {
        "starter" => "rgba(100,116,139,.5)",
        "professional" => "rgba(99,102,241,.5)",
        "enterprise" => "rgba(245,158,11,.5)",
        _ => "rgba(100,116,139,.5)"
    };

    // ✅ FIX: ViewingAs — a SuperAdmin previewing a tenant still carries
    // IsSuperAdmin=true (by design, so they keep access to /Admin/* and the
    // Exit control) but that must NOT leak the SuperAdmin-only nav items
    // (Admin Home / System Admin) into what's supposed to be a faithful
    // preview of what the impersonated user actually sees.
    var isViewingAs = Context.User.HasClaim("ViewingAs", "true");
}

@functions {
    private string CurrentPage() =>
        (string)(ViewContext.RouteData.Values.ContainsKey("page")
            ? ViewContext.RouteData.Values["page"] : "/Dashboard/Index") ?? "/Dashboard/Index";

    bool IsActive(string page) =>
        CurrentPage().StartsWith(page, StringComparison.OrdinalIgnoreCase);

    bool IsActiveSingle(string page) =>
        string.Equals(CurrentPage(), page, StringComparison.OrdinalIgnoreCase);

    // ✅ Permission helper — reads claims set by DemoAuthenticationHandler
    // IsTenantAdmin bypasses all checks (full access)
    bool CanNav(string module, string action = "read")
    {
        if (Context.User.HasClaim("IsTenantAdmin", "true")) return true;
        return Context.User.HasClaim("permission", $"{module}.{action}");
    }

    // ✅ Feature helper — reads from TenantSettings.FeatureFlags via ICurrentTenantService
    // Injected as Ui in page scope — accessible here
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>@ViewData["Title"] — Merkai CRM</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">

    <style>
        /* ── Variables ───────────────────────────────────────────── */
        :root {
            --sidebar-w: 260px;
            --sidebar-bg: #0f172a;
            --sidebar-hover: rgba(255,255,255,.06);
            --sidebar-active: rgba(99,102,241,.18);
            --sidebar-active-border: #6366f1;
            --sidebar-text: #94a3b8;
            --sidebar-text-hov: #e2e8f0;
            --sidebar-text-act: #fff;
            --sidebar-section: #475569;
            --topbar-h: 56px;
            --topbar-bg: #fff;
            --topbar-border: #e2e8f0;
            --accent: #6366f1;
            --accent-soft: #eef2ff;
            --body-bg: #f8fafc;
            --font-body: 'Inter', system-ui, sans-serif;
            --font-display: 'Plus Jakarta Sans', system-ui, sans-serif;
            --radius: 10px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-body);
            background: var(--body-bg);
            color: #1e293b;
            margin: 0;
            overflow-x: hidden;
        }

        .lf-shell {
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ──────────────────────────────────────────────── */
        .lf-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            z-index: 1030;
            transition: transform .28s cubic-bezier(.4,0,.2,1);
            overflow-y: auto;
            overflow-x: hidden;
        }

            .lf-sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .lf-sidebar::-webkit-scrollbar-track {
                background: rgba(255,255,255,.03);
            }

            .lf-sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.18);
                border-radius: 4px;
            }

                .lf-sidebar::-webkit-scrollbar-thumb:hover {
                    background: rgba(255,255,255,.32);
                }

        .lf-sidebar {
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.18) transparent;
        }

        /* Brand */
        .lf-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 18px 20px 16px;
            border-bottom: 1px solid rgba(255,255,255,.07);
            text-decoration: none;
            flex-shrink: 0;
        }

        .lf-brand-icon {
            width: 36px;
            height: 36px;
            background: var(--accent);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: #fff;
            flex-shrink: 0;
        }

        .lf-brand-name {
            font-family: var(--font-display);
            font-size: 17px;
            font-weight: 700;
            color: #fff;
            line-height: 1.1;
        }

        .lf-brand-sub {
            font-size: 10px;
            color: var(--sidebar-text);
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        /* Tenant section */
        .lf-tenant-section {
            margin: 0 10px 4px;
            padding: 10px 12px;
            border-radius: 9px;
            background: linear-gradient(135deg, rgba(99,102,241,.22) 0%, rgba(139,92,246,.14) 100%);
            border: 1px solid rgba(99,102,241,.3);
            flex-shrink: 0;
        }

        .lf-tenant-label {
            font-size: 9px;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: rgba(165,180,252,.7);
            margin-bottom: 4px;
        }

        .lf-tenant-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
        }

        .lf-tenant-title {
            font-size: 12.5px;
            font-weight: 600;
            color: #e2e8f0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .lf-tenant-currency {
            font-size: 11px;
            font-weight: 700;
            color: #a5b4fc;
            background: rgba(99,102,241,.25);
            padding: 2px 7px;
            border-radius: 5px;
            flex-shrink: 0;
            letter-spacing: .02em;
        }

        .lf-online-dot {
            width: 7px;
            height: 7px;
            background: #10b981;
            border-radius: 50%;
            flex-shrink: 0;
            box-shadow: 0 0 0 2px rgba(16,185,129,.3);
        }

        /* ✅ Plan pill */
        .lf-plan-pill {
            margin: 4px 10px 0;
            padding: 3px 10px;
            border-radius: 6px;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            text-align: center;
            flex-shrink: 0;
        }

        /* Nav */
        .lf-nav {
            padding: 12px 0;
            flex: 1;
        }

        .lf-nav-section {
            padding: 14px 20px 4px;
            font-size: 10px;
            font-weight: 600;
            color: var(--sidebar-section);
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .lf-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 16px;
            margin: 1px 8px;
            border-radius: 8px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 400;
            transition: background .15s, color .15s;
            border-left: 3px solid transparent;
            cursor: pointer;
        }

            .lf-nav-item:hover {
                background: var(--sidebar-hover);
                color: var(--sidebar-text-hov);
            }

            .lf-nav-item.active {
                background: var(--sidebar-active);
                color: var(--sidebar-text-act);
                border-left-color: var(--sidebar-active-border);
                font-weight: 500;
            }

            .lf-nav-item i {
                font-size: 15px;
                width: 18px;
                text-align: center;
                flex-shrink: 0;
            }

        .lf-badge {
            margin-left: auto;
            background: var(--accent);
            color: #fff;
            font-size: 10px;
            font-weight: 600;
            padding: 1px 6px;
            border-radius: 10px;
            min-width: 18px;
            text-align: center;
        }

        .lf-badge-new {
            background: #10b981;
        }

        /* ✅ Locked nav item */
        .lf-nav-item-locked {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 7px 16px;
            margin: 1px 8px;
            border-radius: 8px;
            color: rgba(148,163,184,.35);
            font-size: 13.5px;
            cursor: not-allowed;
            border-left: 3px solid transparent;
        }

            .lf-nav-item-locked i {
                font-size: 15px;
                width: 18px;
                text-align: center;
                flex-shrink: 0;
            }

        .lf-lock-icon {
            margin-left: auto;
            font-size: 10px;
            opacity: .5;
        }

        /* Sub-nav */
        .lf-subnav {
            overflow: hidden;
        }

        .lf-subnav-label {
            padding: 6px 16px 2px 42px;
            font-size: 9px;
            font-weight: 600;
            color: var(--sidebar-section);
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .lf-subnav-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 16px 6px 40px;
            margin: 1px 8px;
            border-radius: 7px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 400;
            transition: background .15s, color .15s;
            border-left: 2px solid transparent;
        }

            .lf-subnav-item:hover {
                background: var(--sidebar-hover);
                color: var(--sidebar-text-hov);
            }

            .lf-subnav-item.active {
                background: var(--sidebar-active);
                color: var(--sidebar-text-act);
                border-left-color: var(--sidebar-active-border);
                font-weight: 500;
            }

            .lf-subnav-item .lf-soon {
                margin-left: auto;
                font-size: 9px;
                font-weight: 600;
                background: rgba(245,158,11,.2);
                color: #f59e0b;
                padding: 1px 5px;
                border-radius: 4px;
            }

        /* Sidebar footer */
        .lf-sidebar-footer {
            padding: 12px 16px;
            border-top: 1px solid rgba(255,255,255,.07);
            flex-shrink: 0;
        }

        .lf-tenant-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 8px;
            background: rgba(255,255,255,.05);
        }

        .lf-tenant-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10b981;
            flex-shrink: 0;
        }

        .lf-tenant-name {
            font-size: 12px;
            color: #e2e8f0;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .lf-tenant-plan {
            font-size: 10px;
            color: var(--sidebar-text);
            margin-left: auto;
            flex-shrink: 0;
        }

        /* ── Topbar ───────────────────────────────────────────────── */
        .lf-topbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-w);
            right: 0;
            height: var(--topbar-h);
            background: var(--topbar-bg);
            border-bottom: 1px solid var(--topbar-border);
            display: flex;
            align-items: center;
            padding: 0 20px 0 24px;
            gap: 12px;
            z-index: 1020;
            transition: left .28s cubic-bezier(.4,0,.2,1);
        }

        .lf-search {
            flex: 1;
            max-width: 440px;
            position: relative;
        }

            .lf-search input {
                width: 100%;
                height: 36px;
                padding: 0 12px 0 36px;
                border: 1px solid #e2e8f0;
                border-radius: 8px;
                background: #f8fafc;
                font-size: 13px;
                color: #1e293b;
                outline: none;
                transition: border .15s, background .15s;
            }

                .lf-search input:focus {
                    border-color: var(--accent);
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(99,102,241,.12);
                }

                .lf-search input::placeholder {
                    color: #94a3b8;
                }

        .lf-search-icon {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 14px;
            pointer-events: none;
        }

        .lf-topbar-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-left: auto;
        }

        .lf-icon-btn {
            width: 36px;
            height: 36px;
            border: none;
            background: transparent;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            font-size: 16px;
            cursor: pointer;
            transition: background .15s, color .15s;
            position: relative;
        }

            .lf-icon-btn:hover {
                background: #f1f5f9;
                color: #1e293b;
            }

        .lf-notif-dot {
            position: absolute;
            top: 5px;
            right: 5px;
            width: 8px;
            height: 8px;
            background: #ef4444;
            border-radius: 50%;
            border: 2px solid #fff;
        }

        .lf-user-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 10px 4px 4px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: transparent;
            cursor: pointer;
            transition: background .15s;
        }

            .lf-user-btn:hover {
                background: #f8fafc;
            }

        .lf-avatar {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: var(--accent);
            color: #fff;
            font-size: 11px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .lf-user-name {
            font-size: 13px;
            font-weight: 500;
            color: #1e293b;
        }

        .lf-user-role {
            font-size: 11px;
            color: #94a3b8;
        }

        .lf-hamburger {
            display: none;
            width: 36px;
            height: 36px;
            border: none;
            background: transparent;
            border-radius: 8px;
            cursor: pointer;
            align-items: center;
            justify-content: center;
            color: #64748b;
            font-size: 18px;
        }

            .lf-hamburger:hover {
                background: #f1f5f9;
            }

        /* Main content */
        .lf-main {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            min-height: calc(100vh - var(--topbar-h));
            padding: 24px 28px;
            transition: margin-left .28s cubic-bezier(.4,0,.2,1);
            width: calc(100% - var(--sidebar-w));
            box-sizing: border-box;
        }

            .lf-main .container, .lf-main .container-fluid {
                max-width: 100%;
                padding: 0;
            }

        /* Overlay */
        .lf-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            z-index: 1025;
        }

        /* Responsive */
        @@media (max-width: 991.98px) {
            .lf-sidebar {
                transform: translateX(-100%);
            }

                .lf-sidebar.open {
                    transform: translateX(0);
                }

            .lf-topbar {
                left: 0;
            }

            .lf-main {
                margin-left: 0;
                padding: 16px;
            }

            .lf-hamburger {
                display: flex;
            }

            .lf-overlay.open {
                display: block;
            }

            .lf-search {
                max-width: 200px;
            }
        }

        @@media (max-width: 575.98px) {
            .lf-search {
                display: none;
            }

            .lf-user-name, .lf-user-role {
                display: none;
            }

            .lf-main {
                padding: 12px;
            }
        }

        /* Utility */
        .lf-page-title {
            font-family: var(--font-display);
            font-size: 22px;
            font-weight: 700;
            color: #0f172a;
        }

        .card {
            border: 1px solid #e2e8f0;
            border-radius: var(--radius);
            box-shadow: none;
        }

        .card-header {
            background: #fff;
            border-bottom: 1px solid #f1f5f9;
            font-weight: 500;
        }

        .btn-primary {
            background: var(--accent);
            border-color: var(--accent);
        }

            .btn-primary:hover {
                background: #4f46e5;
                border-color: #4f46e5;
            }

        .badge.bg-primary {
            background: var(--accent) !important;
        }

        a {
            color: var(--accent);
        }

            a:hover {
                color: #4f46e5;
            }

        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        .alert {
            border-radius: var(--radius);
            border: none;
        }

        .alert-success {
            background: #f0fdf4;
            color: #166534;
        }

        .alert-danger {
            background: #fef2f2;
            color: #991b1b;
        }

        .alert-warning {
            background: #fffbeb;
            color: #92400e;
        }

        .alert-info {
            background: #eff6ff;
            color: #1e40af;
        }

        .table {
            font-size: 13.5px;
        }

            .table thead th {
                background: #f8fafc;
                border-bottom: 1px solid #e2e8f0;
                font-weight: 600;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: .04em;
                color: #64748b;
            }

            .table td {
                vertical-align: middle;
                border-color: #f1f5f9;
            }

        .form-control, .form-select {
            border-color: #e2e8f0;
            border-radius: 8px;
            font-size: 13.5px;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(99,102,241,.12);
            }

        .form-label {
            font-size: 13px;
            font-weight: 500;
            color: #374151;
            margin-bottom: 5px;
        }
    </style>
</head>
@* ✅ Tenant culture published to the client so JS money formatting matches the
   server. Read by window.MerkaiCurrency below. Guarded with `as AuthorizedPageModel`
   because a few pages (Public/QuoteView, error pages) are plain PageModels. *@
@{
    var __apm = Model as MerkaiTrial.Admin.Web.Pages.AuthorizedPageModel;
}
<body data-culture="@(__apm?.CultureName ?? "")"
      data-currency-symbol="@(__apm?.CurrencySymbol ?? "")"
      data-currency-code="@(__apm?.CurrencyCode ?? "")"
      data-currency-decimals="@(__apm?.CurrencyDecimals ?? 2)">

    <div class="lf-overlay" id="lfOverlay" onclick="closeSidebar()"></div>

    <div class="lf-shell">

        <!-- ── SIDEBAR ──────────────────────────────────────────────────── -->
        <aside class="lf-sidebar" id="lfSidebar">

            <!-- Brand -->
            <a class="lf-brand" asp-page="/Dashboard/Index">
                <div class="lf-brand-icon" style="background:linear-gradient(135deg,#6366f1,#4f46e5);overflow:hidden;position:relative;">
                    <svg width="22" height="22" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" style="position:relative;z-index:1;">
                        <circle cx="14" cy="14" r="10" stroke="white" stroke-width="1.5" stroke-dasharray="3 2" opacity=".35" />
                        <path d="M8 18L12 13L16 16L20 10" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="20" cy="10" r="2.5" fill="white" />
                    </svg>
                </div>
                <div>
                    <div class="lf-brand-name">mer<span style="color:#a5b4fc;">kai</span></div>
                    <div class="lf-brand-sub">CRM for every market</div>
                </div>
            </a>

            <!-- Tenant + Plan section -->
            <div class="lf-tenant-section">
                <div class="lf-tenant-label">Active Workspace</div>
                <div class="lf-tenant-row">
                    <div class="lf-online-dot"></div>
                    <div class="lf-tenant-title">@tenantName</div>
                    <span class="lf-tenant-currency">@Ui.GetCurrencyCode()</span>
                </div>
            </div>

            @* ✅ Plan pill — shows current plan below tenant name *@
            <div class="lf-plan-pill" style="background:@planBadgeColor;color:#e2e8f0;">
                @planDisplayName Plan
            </div>

            <!-- Navigation -->
            <nav class="lf-nav" role="navigation">

                <!-- Main -->
                <div class="lf-nav-section">Main</div>
                @* ✅ FIX: added "&& !isViewingAs" — a SuperAdmin previewing a tenant
                   should see the tenant's own Dashboard, not Admin Home, so the
                   preview actually reflects what the impersonated user sees. *@
                @if (Context.User.HasClaim("IsSuperAdmin", "true") && !isViewingAs)
                {
                    <a class="lf-nav-item @(IsActive("/Admin") ? "active" : "")"
                       asp-page="/Admin/Index">
                        <i class="bi bi-house"></i> Admin Home
                    </a>
                }
                else
                {
                    <a class="lf-nav-item @(IsActiveSingle("/Dashboard/Index") || IsActiveSingle("/Index") || IsActiveSingle("/") ? "active" : "")"
                       asp-page="/Dashboard/Index">
                        <i class="bi bi-house"></i> Dashboard
                    </a>
                }

                <!-- Contacts & Accounts -->
                @if (CanNav("Companies") || CanNav("Contacts") || CanNav("Products") || CanNav("Leads"))
                {
                    <div class="lf-nav-section">Contacts &amp; Accounts</div>

                    @* ✅ Companies — gated by read permission *@
                    @if (CanNav("Companies"))
                    {
                        <a class="lf-nav-item @(IsActive("/Companies") ? "active" : "")"
                           asp-page="/Companies/Index">
                            <i class="bi bi-building"></i> Companies
                        </a>
                    }

                    @* ✅ Contacts — gated by read permission *@
                    @if (CanNav("Contacts"))
                    {
                        <a class="lf-nav-item @(IsActive("/Contacts") ? "active" : "")"
                           asp-page="/Contacts/Index">
                            <i class="bi bi-people"></i> Contacts
                        </a>
                    }

                    @* ✅ Products — gated by read permission *@
                    @if (CanNav("Products"))
                    {
                        <a class="lf-nav-item @(IsActive("/Products") ? "active" : "")"
                           asp-page="/Products/Index">
                            <i class="bi bi-box-seam"></i> Products
                        </a>
                    }

                    @* ✅ Leads — gated by read permission *@
                    @if (CanNav("Leads"))
                    {
                        <a class="lf-nav-item @(IsActive("/Leads") ? "active" : "")"
                           asp-page="/Leads/Index">
                            <i class="bi bi-funnel"></i> Leads
                        </a>
                    }
                }

                <!-- Sales Pipeline -->
                @if (CanNav("Deals"))
                {
                    <div class="lf-nav-section">Sales Pipeline</div>

                    @* ✅ Pipeline — gated by Deals read *@
                    <a class="lf-nav-item @(IsActive("/Pipeline") ? "active" : "")"
                       asp-page="/Pipeline/Index">
                        <i class="bi bi-kanban"></i> Pipeline
                    </a>

                    @* ✅ Quotes — gated by Deals read *@
                    <a class="lf-nav-item @(IsActive("/Quotes") ? "active" : "")"
                       asp-page="/Quotes/Index">
                        <i class="bi bi-file-earmark-text"></i> Quotes
                    </a>

                    @* ✅ Invoices — gated by Deals read *@
                    <a class="lf-nav-item @(IsActive("/Invoices") ? "active" : "")"
                       asp-page="/Invoices/Index">
                        <i class="bi bi-receipt"></i> Invoices
                    </a>
                }

                <!-- ✅ Reports — gated by plan feature AND Reports read permission -->
                @if (CanNav("Reports") && (Ui.HasFeature("basic_reports") || Ui.HasFeature("advanced_reports")))
                {
                    <div class="lf-nav-section">Reports</div>
                    <a class="lf-nav-item @(IsActive("/Reports") ? "active" : "")"
                       asp-page="/Reports/Index">
                        <i class="bi bi-bar-chart-line"></i> Reports
                        @* ✅ Show Basic label for Starter plan *@
                        @if (!Ui.HasFeature("advanced_reports"))
                        {
                            <span class="lf-badge" style="background:rgba(100,116,139,.5);font-size:9px;">Basic</span>
                        }
                    </a>

                    @if (IsActive("/Reports"))
                    {
                        var activeReport = ViewData["ActiveReport"]?.ToString() ?? "";
                        <div class="lf-subnav">

                            @* Core reports — available to all plans with reports feature *@
                            <div class="lf-subnav-label">Core</div>
                            <a class="lf-subnav-item @(activeReport == "funnel" ? "active" : "")" asp-page="/Reports/SalesFunnel/Index">
                                <i class="bi bi-funnel" style="font-size:13px;width:14px;"></i>Sales Funnel
                            </a>
                            <a class="lf-subnav-item @(activeReport == "pipeline" ? "active" : "")" asp-page="/Reports/Pipeline/Index">
                                <i class="bi bi-kanban" style="font-size:13px;width:14px;"></i>Pipeline
                            </a>
                            <a class="lf-subnav-item @(activeReport == "revenue" ? "active" : "")" asp-page="/Reports/Revenue/Index">
                                <i class="bi bi-cash-stack" style="font-size:13px;width:14px;"></i>Revenue
                            </a>
                            <a class="lf-subnav-item @(activeReport == "winloss" ? "active" : "")" asp-page="/Reports/WinLoss/Index">
                                <i class="bi bi-trophy" style="font-size:13px;width:14px;"></i>Win / Loss
                            </a>
                            <a class="lf-subnav-item @(activeReport == "outstanding" ? "active" : "")" asp-page="/Reports/Outstanding/Index">
                                <i class="bi bi-receipt-cutoff" style="font-size:13px;width:14px;"></i>Outstanding
                            </a>
                            <a class="lf-subnav-item @(activeReport == "vertical" ? "active" : "")" asp-page="/Reports/ByVertical/Index">
                                <i class="bi bi-grid" style="font-size:13px;width:14px;"></i>By Vertical
                            </a>

                            @* ✅ Advanced reports — Professional and Enterprise only *@
                            @if (Ui.HasFeature("advanced_reports"))
                            {
                                <div class="lf-subnav-label" style="margin-top:4px;">Advanced</div>
                                <a class="lf-subnav-item @(activeReport == "repperformance" ? "active" : "")" asp-page="/Reports/RepPerformance/Index">
                                    <i class="bi bi-person-check" style="font-size:13px;width:14px;"></i>Rep Performance
                                </a>
                                <a class="lf-subnav-item @(activeReport == "leadsources" ? "active" : "")" asp-page="/Reports/LeadSources/Index">
                                    <i class="bi bi-megaphone" style="font-size:13px;width:14px;"></i>Lead Sources
                                </a>
                                <a class="lf-subnav-item @(activeReport == "dealvelocity" ? "active" : "")" asp-page="/Reports/DealVelocity/Index">
                                    <i class="bi bi-speedometer2" style="font-size:13px;width:14px;"></i>Deal Velocity
                                </a>
                                <a class="lf-subnav-item @(activeReport == "activityleaderboard" ? "active" : "")" asp-page="/Reports/ActivityLeaderboard/Index">
                                    <i class="bi bi-list-check" style="font-size:13px;width:14px;"></i>Activities
                                </a>
                            }
                            else
                            {
                                @* ✅ Starter plan — show Advanced as locked with upgrade prompt *@
                                <div class="lf-subnav-label" style="margin-top:4px;">Advanced</div>
                                <div class="lf-nav-item-locked" title="Upgrade to Professional to unlock advanced reports">
                                    <i class="bi bi-bar-chart-steps" style="font-size:13px;width:14px;"></i>
                                    <span style="font-size:12px;">Rep Performance</span>
                                    <i class="bi bi-lock-fill lf-lock-icon"></i>
                                </div>
                                <div class="lf-nav-item-locked" title="Upgrade to Professional to unlock advanced reports">
                                    <i class="bi bi-megaphone" style="font-size:13px;width:14px;"></i>
                                    <span style="font-size:12px;">Lead Sources</span>
                                    <i class="bi bi-lock-fill lf-lock-icon"></i>
                                </div>
                                <div class="lf-subnav-item" style="padding-left:16px;">
                                    <a href="/pricing" class="btn btn-outline-warning btn-sm w-100" style="font-size:10px;padding:2px 6px;">
                                        <i class="bi bi-arrow-up-circle me-1"></i>Upgrade to Pro
                                    </a>
                                </div>
                            }
                            
                        </div>
                    }
                }
                @if (CanNav("roles"))
                {
                    <div class="lf-nav-section">Workspace Settings</div>

                    <a class="lf-nav-item @(IsActive("/Settings/Roles") ? "active" : "")"
                       asp-page="/Settings/Roles/Index">
                        <i class="bi bi-shield-lock"></i> Roles &amp; Permissions
                    </a>
                }

                @* ✅ SuperAdmin — visible to tenant admins only, links to SuperAdmin layout *@
                @* ✅ FIX: added "&& !isViewingAs" — same reasoning as the Admin Home link above *@
                @if (Context.User.HasClaim("IsSuperAdmin", "true") && !isViewingAs)
                {
                    <div class="lf-nav-section">Administration</div>
                    <a class="lf-nav-item @(IsActive("/Admin") ? "active" : "")"
                       asp-page="/Admin/Index">
                        <i class="bi bi-gear"></i> System Admin
                        <span class="lf-badge" style="background:rgba(245,158,11,.4);font-size:9px;">Admin</span>
                    </a>
                }

            </nav>

            <!-- Sidebar Footer -->
            <div class="lf-sidebar-footer">
                <div class="lf-tenant-chip">
                    <div class="lf-tenant-dot"></div>
                    <div class="lf-tenant-name">@tenantName</div>
                    @* ✅ Plan name in footer *@
                    <span class="lf-tenant-plan">@planDisplayName</span>
                </div>
            </div>

        </aside>

        <!-- ── TOPBAR ──────────────────────────────────────────────────── -->
        <header class="lf-topbar">

            <button class="lf-hamburger" id="lfHamburger" onclick="openSidebar()" aria-label="Open menu">
                <i class="bi bi-list"></i>
            </button>

            <div class="lf-search">
                <i class="bi bi-search lf-search-icon"></i>
                <input type="search" placeholder="Search contacts, companies, deals..." />
            </div>

            <div class="lf-topbar-actions">

                <button class="lf-icon-btn" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="lf-notif-dot"></span>
                </button>

                @* ✅ Settings gear — only for tenant admins *@
                @if (CanNav("roles"))
                {
                <a class="lf-icon-btn" asp-page="/Settings/Roles/Index"
                   aria-label="Workspace settings" title="Workspace settings">
                    <i class="bi bi-gear"></i>
                </a>
                }

                @* ✅ Exit View As — quick way back to the SuperAdmin console
                   directly from the topbar, right next to the role display,
                   without needing to scroll up to the orange banner. Only
                   ever shown during an active ViewAs session. *@
                @if (isViewingAs)
                {
                    <form method="post" asp-page="/Admin/ViewAs/ViewAsIndex" asp-page-handler="Exit" class="mb-0">
                        <button type="submit" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                                style="font-size:12px;padding:5px 10px;" title="Return to SuperAdmin console">
                            <i class="bi bi-box-arrow-left"></i> Exit View As
                        </button>
                    </form>
                }

                <div class="dropdown">
                    <button class="lf-user-btn" data-bs-toggle="dropdown">
                        <div class="lf-avatar">@userInitials</div>
                        <div>
                            <div class="lf-user-name">@displayName</div>
                            @* ✅ Show role in topbar *@
                            <div class="lf-user-role">
                                @if (Context.User.HasClaim("IsTenantAdmin", "true"))
                                {
                                    <span>Tenant Admin</span>
                                }
                                else if (Context.User.IsInRole("sales_manager"))
                                {

                                    <span>Sales Manager</span>
                                }
                                else if (Context.User.IsInRole("sales_rep"))
                                {

                                    <span>Sales Rep</span>
                                }
                                else if (Context.User.IsInRole("viewer"))
                                {

                                    <span>Viewer</span>
                                }
                                else
                                {

                                    <span>@userEmail</span>
                                }
                            </div>
                        </div>
                        <i class="bi bi-chevron-down" style="font-size:10px;color:#94a3b8;margin-left:2px;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" style="font-size:13px;min-width:200px;">
                        <li>
                            <div class="px-3 py-2 border-bottom">
                                <div class="small fw-semibold">@displayName</div>
                                <div class="text-muted" style="font-size:11px;">@userEmail</div>
                                <div class="text-muted" style="font-size:11px;">@planDisplayName Plan</div>
                            </div>
                        </li>

                        @* Roles reachable from here too — the sidebar section is
                           easy to miss on a first visit. *@
                        @if (CanNav("roles"))
                        {
                            <li>
                                <a class="dropdown-item" asp-page="/Settings/Roles/Index">
                                    <i class="bi bi-shield-lock me-2"></i>Roles &amp; Permissions
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                        }

                        <li>
                            <a class="dropdown-item" asp-page="/Account/ChangePassword">
                                <i class="bi bi-key me-2"></i>Change password
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item text-danger" asp-page="/Account/Logout">
                                <i class="bi bi-box-arrow-right me-2"></i>Sign out
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

        </header>

        <!-- ── MAIN CONTENT ────────────────────────────────────────────── -->
        <main class="lf-main">
            @if (__apm is not null && __apm.TrialBannerMessage is string trialMsg)
            {
                @if (__apm.IsTrialExpired)
                {
                    @* EXPIRED — not dismissible. The client can still read and
                       export everything; only writing is blocked. Saying so
                       plainly matters: silence here reads as "they deleted my
                       data", which is the last impression you want while you
                       are still trying to close the deal. *@
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                        <div class="flex-grow-1">
                            <strong>@trialMsg</strong>
                            <div style="font-size:12.5px;opacity:.85;">
                                Your data is safe and still available to view and export.
                                Contact your MadeeVision account contact to continue.
                            </div>
                        </div>
                    </div>
                }
                else if (__apm.TrialDaysRemaining <= 7)
                {
                    @* FINAL WEEK — amber, not dismissible. This is the window
                       where a prospect either decides or drifts. *@
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-hourglass-split"></i>
                        <div class="flex-grow-1">@trialMsg</div>
                    </div>
                }
                else
                {
                    @* NORMAL COUNTDOWN — dismissible, so it does not nag
                       someone doing real work on day 3. It returns on the next
                       page load, which is enough presence. *@
                    <div class="alert alert-info alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-info-circle"></i>
                        <div class="flex-grow-1">@trialMsg</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
                    </div>
                }
            }
            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@successMsg</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string errorMsg)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@errorMsg</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function openSidebar() {
            document.getElementById('lfSidebar').classList.add('open');
            document.getElementById('lfOverlay').classList.add('open');
        }
        function closeSidebar() {
            document.getElementById('lfSidebar').classList.remove('open');
            document.getElementById('lfOverlay').classList.remove('open');
        }
        document.querySelectorAll('.lf-nav-item').forEach(el => {
            el.addEventListener('click', () => {
                if (window.innerWidth < 992) closeSidebar();
            });
        });
        // Auto-dismiss alerts
        setTimeout(function () {
            document.querySelectorAll('.alert-dismissible').forEach(function (el) {
                new bootstrap.Alert(el).close();
            });
        }, 5000);
    </script>

    @* ✅ SHARED CLIENT-SIDE MONEY FORMATTER
       Mirrors ICurrentTenantService.FormatCurrency. Every page that recalculates
       totals in JS should call MerkaiCurrency.format(x) instead of
       `${symbol} ${x.toFixed(2)}` — toFixed does no grouping at all, so large
       totals rendered ungrouped while the server rendered them grouped.
       Intl and .NET share CLDR data, so en-IN gives lakh grouping in both. *@
    <script>
        window.MerkaiCurrency = (function () {
            const b        = document.body.dataset;
            const symbol   = b.currencySymbol || '';
            const decimals = parseInt(b.currencyDecimals || '2', 10);

            // Countries.NumberFormat may legacily hold a .NET pattern ("#,##0.00")
            // rather than a culture name. Intl would throw on that, so fall back
            // to the browser default — same spirit as FormatCurrency's
            // InvariantCulture fallback.
            let nf;
            try {
                nf = new Intl.NumberFormat(b.culture || undefined, {
                    minimumFractionDigits: decimals,
                    maximumFractionDigits: decimals
                });
            } catch (e) {
                console.warn('MerkaiCurrency: bad culture "' + b.culture + '", using browser default.');
                nf = new Intl.NumberFormat(undefined, {
                    minimumFractionDigits: decimals,
                    maximumFractionDigits: decimals
                });
            }

            return {
                symbol: symbol,
                /** Symbol + grouped amount, e.g. "฿255,000.00" / "₹2,55,000.00" */
                format: function (amount) {
                    const n = Number(amount);
                    return symbol + nf.format(isNaN(n) ? 0 : n);
                },
                /** Grouped amount with no symbol. */
                number: function (amount) {
                    const n = Number(amount);
                    return nf.format(isNaN(n) ? 0 : n);
                }
            };
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
