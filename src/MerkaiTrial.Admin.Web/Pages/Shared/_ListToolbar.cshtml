@model MerkaiTrial.Admin.Web.Pages.Shared.ListToolbarVm
@* =====================================================================
   Pages/Shared/_ListToolbar.cshtml — NEW (072).

   The search + filter strip at the top of every list page. One line:

       <partial name="_ListToolbar" model="Model.Toolbar" />

   ── IT IS A GET FORM, ON PURPOSE ────────────────────────────────────

   Submitting puts the search and the filters in the URL, which is what
   makes a filtered list bookmarkable, shareable and survivable across
   the back button. A POST would need a redirect to achieve the same and
   would lose the filters on a refresh.

   ── THE PAGE NUMBER IS NOT IN THIS FORM ─────────────────────────────

   Deliberately. Carrying it would land a fresh search on page 7 of a
   two-page result, which renders empty and reads to the user as "no
   matches" — see the note on ListToolbarVm.Carry. Submitting this form
   always starts at page 1 because the field simply is not here.

   ── 076: FormId ─────────────────────────────────────────────────────

   When the page sets Model.FormId the form gets that id, so inputs
   outside it (the custom field filter panel) can submit with it through
   form="…". A null id renders no attribute at all.

   ── 094: ON A PHONE ─────────────────────────────────────────────────

   575px and narrower: the search box takes the whole first line (the
   page asks for a fixed width — 320px on Contacts — which left a few
   pixels to spare at best), the filters share the next line, and the
   count drops under them instead of squeezing beside the form.

   095: a dropdown is never wider than the bar. A select is as wide as
   its longest choice, and the Contacts Company filter lists every
   company by name — one long name pushed the toolbar, and the page,
   wider than a phone. The form may now shrink to the bar (min-width 0)
   and each filter to the form (max-width 100%); the browser shortens a
   long choice in the closed box and shows it whole when opened.

   096: DATES. Model.Dates draws <input type="date"> boxes after the
   dropdowns (the Invoices page's issued-from / issued-to), each with a
   short word before it. They post yyyy-MM-dd whatever the browser's
   language, which is what the page binds. Carry now also holds the
   list's Sort/Dir, so a search keeps the order you chose.

   ── NO NESTED FORMS ─────────────────────────────────────────────────

   The count on the right is a span, not a control, and the Clear link is
   an anchor. The pager below is a separate sibling form. Nothing here
   wraps anything else.
   ===================================================================== *@

<style>
    .lt-bar { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap;
              padding: .6rem .75rem; border: 1px solid #e9ecef; border-radius: 12px;
              background: #fff; margin-bottom: 1rem; }
    .lt-count { font-size: .78rem; color: #64748b; white-space: nowrap; }
    .lt-bar .form-select, .lt-bar .form-control { font-size: .84rem; }

    /* 095 — see the header. */
    .lt-bar > form { min-width: 0; max-width: 100%; }
    .lt-bar .lt-filter { max-width: 100%; min-width: 0; }

    /* 094 — the widths come from the page as inline styles, so they are
       overridden here with !important, on a phone only. */
    @@media (max-width: 575.98px) {
        .lt-bar .lt-search { width: 100% !important; }
        .lt-bar .lt-filter { flex: 1 1 40%; width: auto !important; min-width: 0; }
        .lt-bar .lt-count { margin-left: 0 !important; width: 100%; }
        .lt-bar .lt-date { flex: 1 1 45%; min-width: 0; }
        .lt-bar .lt-date .lt-count { width: auto; }
        .lt-bar .lt-date input { flex: 1 1 auto; min-width: 0; width: 100% !important; }
    }
</style>

<div class="lt-bar">
    <form method="get" id="@Model.FormId" class="d-flex align-items-center gap-2 flex-wrap flex-grow-1">

        @* Carried through so a search does not reset the page size or
           move the user off the tab they were on. The page number is
           deliberately absent — see the header. *@
        @foreach (var keep in Model.Carry)
        {
            <input type="hidden" name="@keep.Key" value="@keep.Value" />
        }

        <div class="input-group input-group-sm lt-search" style="width:@Model.SearchWidth;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search"
                   name="@Model.SearchName"
                   value="@Model.SearchValue"
                   class="form-control"
                   placeholder="@Model.SearchPlaceholder"
                   autocomplete="off"
                   aria-label="@Model.SearchLabel" />
        </div>

        @foreach (var filter in Model.Filters)
        {
            <select name="@filter.Name"
                    class="form-select form-select-sm lt-filter"
                    style="width:@filter.Width;"
                    aria-label="@filter.Label">
                @foreach (var option in filter.Options)
                {
                    @* selected="@bool" is the Razor form: it renders the
                       attribute when true and omits it when false. Writing
                       selected="selected" by hand inside a loop is how a
                       dropdown ends up with two selected options. *@
                    <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                }
            </select>
        }

        @foreach (var date in Model.Dates)
        {
            @* 096. ISO in and out — see the header. The word is visible
               (a date box alone does not say which end of the range it
               is) and doubles as the accessible name. *@
            <label class="lt-date d-flex align-items-center gap-1 mb-0">
                <span class="lt-count">@date.Label</span>
                <input type="date" name="@date.Name" value="@date.Value"
                       class="form-control form-control-sm" style="width:auto;"
                       min="1900-01-01" max="2199-12-31" />
            </label>
        }

        <button class="btn btn-sm btn-outline-secondary" type="submit">
            <i class="bi bi-funnel me-1"></i>Filter
        </button>

        @if (Model.IsFiltered)
        {
            <a asp-page="@Model.PageRoute" asp-all-route-data="@Model.ClearRoute"
               class="btn btn-sm btn-link px-1">Clear</a>
        }
    </form>

    <span class="lt-count ms-auto">@Model.CountLabel</span>
</div>
