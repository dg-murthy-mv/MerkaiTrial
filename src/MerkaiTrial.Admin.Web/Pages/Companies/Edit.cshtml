@page "/Companies/Edit/{id}"
@model MerkaiTrial.Admin.Web.Pages.Companies.EditModel
@{
    ViewData["Title"] = "Edit Company";
}
@* =====================================================================
   Companies/Edit.cshtml

   078:
   • "Additional details" — the workspace's custom fields for Companies,
     through the shared _CustomFieldInputs partial, pre-filled from what
     is stored. Retired fields are not on the form, and their values are
     left untouched by a save.
   • The error banner is an ordinary property shown on THIS response (it
     was [TempData]). Not dismissible, no timer of its own.
   • A summary line when any field needs attention.
   • A vertical or country the lists no longer contain is still offered,
     marked "(as saved)", so saving never changes it unasked.
   ===================================================================== *@

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-page="./Index">Companies</a></li>
                    <li class="breadcrumb-item"><a asp-page="./Detail" asp-route-id="@Model.Id">Details</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit</li>
                </ol>
            </nav>
            <h2 class="mb-1"><i class="bi bi-pencil text-warning"></i> Edit Company</h2>
            <p class="text-muted mb-0">@Model.Input.Name</p>
        </div>
        <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back</span>
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Company Information</h5>
                    </div>
                    <div class="card-body">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-warning py-2 px-3 small d-flex gap-2 align-items-start mb-3" role="alert">
                                <i class="bi bi-exclamation-circle-fill mt-1"></i>
                                <span>Some fields need attention — they are marked below.</span>
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Input.Name" class="form-label">
                                    Company Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Name" class="form-control" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Vertical" class="form-label">
                                    Vertical <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.Vertical" asp-items="Model.VerticalOptions" class="form-select">
                                    <option value="">-- Select Vertical --</option>
                                </select>
                                <span asp-validation-for="Input.Vertical" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Country" class="form-label">
                                    Country <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.Country" asp-items="Model.CountryOptions" class="form-select">
                                    <option value="">-- Select Country --</option>
                                </select>
                                <span asp-validation-for="Input.Country" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.TaxId" class="form-label">Tax ID</label>
                                <input asp-for="Input.TaxId" class="form-control" />
                                <span asp-validation-for="Input.TaxId" class="text-danger small"></span>
                            </div>
                        </div>

                        @* 078 — the workspace's own fields. Shared with Create. *@
                        <partial name="_CustomFieldInputs" model="Model.CustomFieldInputs" />
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-lightning"></i> Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                            <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Guidelines</h6>
                    </div>
                    <div class="card-body">
                        <ul class="small mb-0 ps-3">
                            <li class="mb-2">All company fields can be <strong>updated</strong> anytime</li>
                            <li class="mb-2">Changes apply <strong>immediately</strong> across the system</li>
                            <li class="mb-2">Update <strong>vertical</strong> if business focus changes</li>
                            <li>Tax ID helps with <strong>invoicing</strong> and compliance</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
