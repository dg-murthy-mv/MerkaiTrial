@page "/Companies/Create"
@model MerkaiTrial.Admin.Web.Pages.Companies.CreateModel
@{
    ViewData["Title"] = "Create Company";
}
@* =====================================================================
   Companies/Create.cshtml

   078:
   • "Additional details" — the workspace's custom fields for Companies,
     through the shared _CustomFieldInputs partial (the same one Edit,
     Contacts and Deals render).
   • The error banner is an ordinary property shown on THIS response (it
     was [TempData], so it appeared on the NEXT page instead). It is not
     dismissible and has no timer of its own — the layout owns every
     auto-dismiss, and an error you can close before reading is no help.
   • A summary line when any field needs attention.
   • A vertical or country the lists no longer contain is still offered
     (CompanyFormOptions).
   ===================================================================== *@

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-page="./Index">Companies</a></li>
                    <li class="breadcrumb-item active" aria-current="page">New</li>
                </ol>
            </nav>
            <h2 class="mb-1"><i class="bi bi-plus-circle text-primary"></i> Create Company</h2>
            <p class="text-muted mb-0">Add a new company account</p>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back</span>
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <form method="post">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Company Information</h5>
                    </div>
                    <div class="card-body">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-warning py-2 px-3 small d-flex gap-2 align-items-start mb-3" role="alert">
                                <i class="bi bi-exclamation-circle-fill mt-1"></i>
                                <span>Some fields need attention — they are marked below.</span>
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Input.Name" class="form-label">
                                    Company Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Name" class="form-control" placeholder="e.g., Acme Corporation" autofocus />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Vertical" class="form-label">
                                    Vertical <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.Vertical" asp-items="Model.VerticalOptions" class="form-select">
                                    <option value="">-- Select Vertical --</option>
                                </select>
                                <span asp-validation-for="Input.Vertical" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Country" class="form-label">
                                    Country <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.Country" asp-items="Model.CountryOptions" class="form-select">
                                    <option value="">-- Select Country --</option>
                                </select>
                                <span asp-validation-for="Input.Country" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.TaxId" class="form-label">Tax ID</label>
                                <input asp-for="Input.TaxId" class="form-control" placeholder="Optional" />
                                <span asp-validation-for="Input.TaxId" class="text-danger small"></span>
                            </div>
                        </div>

                        @* 078 — the workspace's own fields. Shared with Edit. *@
                        <partial name="_CustomFieldInputs" model="Model.CustomFieldInputs" />
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-lightning"></i> Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Create Company
                            </button>
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Quick Tips</h6>
                    </div>
                    <div class="card-body">
                        <ul class="small mb-0 ps-3">
                            <li class="mb-2">Enter the <strong>company name</strong> as it appears officially</li>
                            <li class="mb-2">Select the <strong>industry vertical</strong> that best matches</li>
                            <li class="mb-2">Choose the <strong>country</strong> where the company operates</li>
                            <li>Tax ID is <strong>optional</strong> but helps with invoicing</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
