@page "/Companies"
@using MerkaiTrial.Application.Configuration
@model MerkaiTrial.Admin.Web.Pages.Companies.IndexModel
@{
    ViewData["Title"] = "Companies";
}
@* =====================================================================
   Companies/Index.cshtml

   078 — custom fields on the list, and the shared list components from
   072 (the rebuild Contacts got in 076):

   • _ListToolbar for search, Vertical, Country and the count; _Pager for
     paging. The hand-built search card and pager are gone. Everything is
     in the URL.
   • Up to four custom fields as columns ("Show on the list" in
     Settings → Custom Fields → Companies), and as extra lines on the
     mobile cards.
   • _CustomFieldFilterPanel under the toolbar: filter on any active
     custom field. Its inputs join the toolbar's form (FormId), so one
     Filter button applies everything.
   • An empty FILTERED list says so and offers to clear, instead of
     "No companies found" with an Add button.
   • The company name is a link to its page.

   SECURITY FIX — the delete buttons were
       onclick="confirmDelete('@company.Id', '@company.Name')"
   Razor HTML-encodes an apostrophe as &#x27;, and the browser DECODES the
   attribute before running it — so a company named
       x'); alert(document.cookie); ('
   ran as script for anyone who opened the list. The name now travels in a
   data- attribute and the dialog writes it with textContent: it is only
   ever data. (The confirm() box also showed "O&#x27;Brien" for O'Brien.)

   Delete is a Bootstrap dialog that says what happens to the company's
   contacts and deals, and posts the list state so the redirect comes back
   to the same page of the same filtered list.

   Kept: no TempData banners here (_Layout renders SuccessMessage and
   ErrorMessage once for every page), no auto-dismiss timer of its own.
   ===================================================================== *@

<style>
    .co-cf { max-width: 14rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .co-cf-head { white-space: nowrap; }
    .co-cf-head i { opacity: .55; }
    .co-min0 { min-width: 0; }
    .co-avatar { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1"><i class="bi bi-building text-primary"></i> Companies</h2>
            <p class="text-muted mb-0">
                @if (string.IsNullOrEmpty(Model.TenantCountryName))
                {
                    <text>The accounts you sell to</text>
                }
                else
                {
                    <text>Accounts you sell to in @Model.TenantCountryName</text>
                }
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">

            <span class="badge @Model.PlanBadgeClass fs-6 px-3 py-2">@Model.PlanDisplayName</span>

            @* Create is gated on BOTH quota and permission. A button that
               always fails is worse than no button. *@
            @if (!AuthorizedPageModel.IsAtLimit(Model.Stats.TotalCompanies, Model.MaxCompanies) && Model.CanCreate)
            {
                <a asp-page="./Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    <span class="d-none d-sm-inline"> Add Company</span>
                </a>
            }
            else if (Model.CanCreate && AuthorizedPageModel.IsAtLimit(Model.Stats.TotalCompanies, Model.MaxCompanies))
            {
                <button class="btn btn-outline-secondary" disabled
                        title="Company limit reached. @Model.UpgradePrompt">
                    <i class="bi bi-lock me-1"></i>Company Limit Reached
                </button>
            }
        </div>
    </div>

    @* A failed load, for THIS response only. Success and error messages
       from a redirect are rendered by _Layout, once. *@
    @if (!string.IsNullOrEmpty(Model.PageError))
    {
        <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <span>@Model.PageError</span>
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-3">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#3b82f6,#2563eb);">
                            <i class="bi bi-building text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Total Companies</h6>
                            <h3 class="mb-0">@Model.Stats.TotalCompanies</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#10b981,#059669);">
                            <i class="bi bi-people text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Contacts</h6>
                            <h3 class="mb-0">@Model.Stats.TotalContacts</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#f59e0b,#d97706);">
                            <i class="bi bi-briefcase text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Deals</h6>
                            <h3 class="mb-0">@Model.Stats.TotalDeals</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#8b5cf6,#7c3aed);">
                            <i class="bi bi-grid text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Verticals</h6>
                            <h3 class="mb-0">@Model.Stats.ActiveVerticals</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Company quota -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-2">
            <div class="row align-items-center g-2">
                <div class="col-auto">
                    <small class="text-muted fw-semibold text-uppercase" style="font-size:10px;letter-spacing:.06em;">
                        Company Quota
                    </small>
                </div>
                <div class="col">
                    @{
                        var companyPct = AuthorizedPageModel.QuotaPercent(Model.Stats.TotalCompanies, Model.MaxCompanies);
                        var companyBarClass = AuthorizedPageModel.QuotaBarClass(Model.Stats.TotalCompanies, Model.MaxCompanies);
                    }
                    <div class="progress" style="height:8px;">
                        <div class="progress-bar @companyBarClass" role="progressbar"
                             style="width:@companyPct%"
                             aria-valuenow="@Model.Stats.TotalCompanies"
                             aria-valuemin="0" aria-valuemax="@Model.MaxCompanies"></div>
                    </div>
                </div>
                <div class="col-auto">
                    <small class="@(companyPct >= 90 ? "text-danger fw-bold" : "text-muted")">
                        @Model.Stats.TotalCompanies / @Model.MaxCompanies used
                    </small>
                </div>
                @if (!string.IsNullOrEmpty(Model.UpgradePrompt))
                {
                    <div class="col-auto">
                        <a href="/pricing" class="btn btn-sm btn-outline-primary py-0">
                            <i class="bi bi-arrow-up-circle me-1"></i>@Model.UpgradePrompt
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── 078: search, filters, count ───────────────────────────────── *@
    <partial name="_ListToolbar" model="Model.Toolbar" />
    <partial name="_CustomFieldFilterPanel" model="Model.CustomFilters" />

    @if (!Model.PaginatedCompanies.Items.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                @if (Model.IsFiltered)
                {
                    <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-2">No company matches these filters.</p>
                    <a asp-page="./Index" asp-route-PageSize="@Model.PageSize" class="btn btn-outline-secondary btn-sm">
                        Clear the search and filters
                    </a>
                }
                else if (string.IsNullOrEmpty(Model.PageError))
                {
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-3">No companies yet.</p>
                    @if (Model.CanCreate && !AuthorizedPageModel.IsAtLimit(Model.Stats.TotalCompanies, Model.MaxCompanies))
                    {
                        <a asp-page="./Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>Add First Company
                        </a>
                    }
                }
                else
                {
                    <i class="bi bi-cloud-slash fs-1 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-2">The list could not be loaded.</p>
                    <a asp-page="./Index" asp-all-route-data="Model.StateRoute()" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-clockwise me-1"></i>Try again
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Desktop table -->
        <div class="card border-0 shadow-sm d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Company</th>
                            <th>Vertical</th>
                            <th>Country</th>
                            <th>Tax ID</th>
                            <th class="text-center">Contacts</th>
                            <th class="text-center">Deals</th>
                            @foreach (var col in Model.ListColumns)
                            {
                                <th class="co-cf-head">
                                    <i class="bi @CustomFieldTypes.Icon(col.FieldType) me-1" aria-hidden="true"></i>@col.Label
                                </th>
                            }
                            <th>Added</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var company in Model.PaginatedCompanies.Items)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 rounded-circle me-3 co-avatar">
                                            <span class="fw-bold text-primary">@Model.Initial(company.Name)</span>
                                        </div>
                                        <a asp-page="./Detail" asp-route-id="@company.Id"
                                           class="fw-semibold text-decoration-none text-reset">@company.Name</a>
                                    </div>
                                </td>
                                <td><span class="badge bg-info">@company.Vertical</span></td>
                                <td>@Model.GetCountryName(company.Country)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(company.TaxId))
                                    {
                                        <code>@company.TaxId</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center"><span class="badge bg-secondary">@company.ContactCount</span></td>
                                <td class="text-center"><span class="badge bg-secondary">@company.DealCount</span></td>
                                @foreach (var col in Model.ListColumns)
                                {
                                    var shown = Model.ColumnValue(company, col);
                                    <td class="co-cf" title="@shown">
                                        @if (string.IsNullOrEmpty(shown))
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else if (col.FieldType == CustomFieldTypes.Checkbox)
                                        {
                                            <i class="bi bi-check-lg text-success" aria-label="Yes"></i>
                                        }
                                        else
                                        {
                                            @shown
                                        }
                                    </td>
                                }
                                @* Tenant timezone and date format, not the server's. *@
                                <td><small class="text-muted">@Model.FormatDate(company.CreatedAtUtc)</small></td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-page="./Detail" asp-route-id="@company.Id"
                                           class="btn btn-outline-primary" title="View" aria-label="View @company.Name">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (Model.CanUpdate)
                                        {
                                            <a asp-page="./Edit" asp-route-id="@company.Id"
                                               class="btn btn-outline-warning" title="Edit" aria-label="Edit @company.Name">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        @if (Model.CanDelete)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    data-delete-company
                                                    data-company-id="@company.Id"
                                                    data-company-name="@company.Name"
                                                    data-company-contacts="@company.ContactCount"
                                                    data-company-deals="@company.DealCount"
                                                    title="Delete" aria-label="Delete @company.Name">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Mobile cards -->
        <div class="d-md-none">
            @foreach (var company in Model.PaginatedCompanies.Items)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 rounded-circle me-3 co-avatar">
                                <span class="fw-bold text-primary">@Model.Initial(company.Name)</span>
                            </div>
                            <div class="flex-grow-1 co-min0">
                                <h6 class="mb-1 text-truncate">@company.Name</h6>
                                <div class="d-flex gap-2 flex-wrap">
                                    <span class="badge bg-info">@company.Vertical</span>
                                    <span class="badge bg-light text-dark">@Model.GetCountryName(company.Country)</span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <small class="text-muted">Contacts</small>
                                <div><strong>@company.ContactCount</strong></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted">Deals</small>
                                <div><strong>@company.DealCount</strong></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted">Tax ID</small>
                                <div class="text-truncate"><code>@(company.TaxId ?? "-")</code></div>
                            </div>
                            @foreach (var col in Model.ListColumns)
                            {
                                var shown = Model.ColumnValue(company, col);
                                if (string.IsNullOrEmpty(shown)) { continue; }
                                <div class="col-6">
                                    <small class="text-muted">@col.Label</small>
                                    <div class="text-truncate">@shown</div>
                                </div>
                            }
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-page="./Detail" asp-route-id="@company.Id" class="btn btn-primary btn-sm">
                                <i class="bi bi-eye me-1"></i>View Details
                            </a>
                            @if (Model.CanUpdate || Model.CanDelete)
                            {
                                <div class="btn-group">
                                    @if (Model.CanUpdate)
                                    {
                                        <a asp-page="./Edit" asp-route-id="@company.Id" class="btn btn-outline-warning btn-sm">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>
                                    }
                                    @if (Model.CanDelete)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                data-delete-company
                                                data-company-id="@company.Id"
                                                data-company-name="@company.Name"
                                                data-company-contacts="@company.ContactCount"
                                                data-company-deals="@company.DealCount">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ONE pager for both layouts. Rendering it inside each would put
           two copies of its page-size select (id="lpPageSize") on the
           page, and a label binds to the FIRST matching id. *@
        <div class="card border-0 shadow-sm mt-2">
            <partial name="_Pager" model="Model.Pager" />
        </div>
    }
</div>

@if (Model.CanDelete)
{
    <div class="modal fade" id="deleteCompanyModal" tabindex="-1" aria-labelledby="deleteCompanyLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page-handler="Delete" class="modal-content">
                <input type="hidden" name="id" id="deleteCompanyId" />
                @* The list state, so the redirect returns to the same page
                   of the same filtered list. *@
                @foreach (var keep in Model.StateRoute())
                {
                    <input type="hidden" name="@keep.Key" value="@keep.Value" />
                }
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteCompanyLabel">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete company
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Delete <strong id="deleteCompanyName"></strong>?</p>
                    <div class="alert alert-warning small py-2 mb-2 d-none" id="deleteCompanyLinked">
                        <i class="bi bi-info-circle me-1"></i>
                        <span id="deleteCompanyLinkedText"></span>
                    </div>
                    <p class="text-muted small mb-0">The company is removed from lists and searches.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete company
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        // One delegated listener. The id, name and counts come from data-
        // attributes and are written with textContent, so a company's name
        // is only ever data, never script.
        (function () {
            'use strict';
            var modalEl = document.getElementById('deleteCompanyModal');
            if (!modalEl) return;

            function plural(n, one, many) { return n + ' ' + (n === 1 ? one : many); }

            document.addEventListener('click', function (e) {
                var btn = e.target.closest ? e.target.closest('[data-delete-company]') : null;
                if (!btn) return;

                document.getElementById('deleteCompanyId').value = btn.getAttribute('data-company-id') || '';
                document.getElementById('deleteCompanyName').textContent = btn.getAttribute('data-company-name') || 'this company';

                var contacts = parseInt(btn.getAttribute('data-company-contacts') || '0', 10) || 0;
                var deals    = parseInt(btn.getAttribute('data-company-deals') || '0', 10) || 0;
                var linked   = document.getElementById('deleteCompanyLinked');
                if (contacts > 0 || deals > 0) {
                    document.getElementById('deleteCompanyLinkedText').textContent =
                        'It has ' + plural(contacts, 'contact', 'contacts') + ' and ' +
                        plural(deals, 'deal', 'deals') + '. Deleting the company does not delete them.';
                    linked.classList.remove('d-none');
                } else {
                    linked.classList.add('d-none');
                }

                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });
        })();
    </script>
}
