@page
@model MerkaiTrial.Admin.Web.Pages.Reports.InvoiceCollections.IndexModel
@{ ViewData["Title"] = "Invoice & Collections"; }
@* =====================================================================
   FILE: Pages/Reports/InvoiceCollections/Index.cshtml                         (Round 112)
   How fast invoices are paid, how much comes in, and who is late
   ===================================================================== *@

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-page="/Reports/Index" class="btn btn-sm btn-outline-secondary" aria-label="Back to reports"><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
        <div>
            <h2 class="mb-0"><i class="bi bi-wallet2 me-2 text-primary" aria-hidden="true"></i>Invoice &amp; Collections</h2>
            <p class="text-muted mb-0 small">How fast invoices are paid, how much comes in, and who is late</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    <partial name="Shared/_ReportFilter" model="@Model.Filter" />
    @if (Model.Data != null) { <partial name="Shared/_ReportNote" model="Model.Data" /> }

    @if (Model.Data != null)
    {
        var d = Model.Data;
        <div class="row g-3 mb-4" id="collectionsTotals">
            <div class="col-6 col-md"><div class="card border-0 shadow-sm p-3 text-center h-100"><div class="fw-bold fs-4" data-figure="invoiced">@Model.FormatCurrency(d.Invoiced)</div><div class="text-muted small">Invoiced (@d.InvoicesIssued invoices)</div></div></div>
            <div class="col-6 col-md"><div class="card border-0 shadow-sm p-3 text-center h-100"><div class="fw-bold fs-4" data-figure="collection-rate">@d.CollectionRate%</div><div class="text-muted small">Of that, paid so far</div></div></div>
            <div class="col-6 col-md"><div class="card border-0 shadow-sm p-3 text-center h-100"><div class="fw-bold fs-4" data-figure="collected">@Model.FormatCurrency(d.Collected)</div><div class="text-muted small">Money received in the period</div></div></div>
            <div class="col-6 col-md"><div class="card border-0 shadow-sm p-3 text-center h-100"><div class="fw-bold fs-4" data-figure="days-to-pay">@d.AvgDaysToPay d</div><div class="text-muted small">Average days to pay</div></div></div>
            <div class="col-6 col-md"><div class="card border-0 shadow-sm p-3 text-center h-100"><div class="fw-bold fs-4" data-figure="on-time">@d.PaidOnTimePct%</div><div class="text-muted small">Paid by the due date</div></div></div>
            <div class="col-6 col-md"><div class="card border-0 shadow-sm p-3 text-center h-100"><div class="fw-bold fs-4" data-figure="overdue">@Model.FormatCurrency(d.OverdueAmount)</div><div class="text-muted small">Overdue today (@d.OverdueCount)</div></div></div>
        </div>

        <div class="row g-3">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-semibold">Money received, by method</div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0" id="paymentMethods">
                            <thead class="table-light"><tr><th scope="col">Method</th><th scope="col" class="text-end">Payments</th><th scope="col" class="text-end">Amount</th></tr></thead>
                            <tbody>
                                @foreach (var x in d.ByMethod)
                                {
                                    <tr data-method="@x.Method"><td>@x.Method</td><td class="text-end">@x.Count</td><td class="text-end" data-col="amount">@Model.FormatCurrency(x.Amount)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-semibold">Overdue today, by customer</div>
                    <div class="card-body p-0">
                        @if (d.OverdueCustomers.Count == 0)
                        {
                            <p class="p-3 mb-0 text-muted">Nothing is overdue.</p>
                        }
                        else
                        {
                            <table class="table table-sm mb-0" id="overdueCustomers">
                                <thead class="table-light"><tr><th scope="col">Customer</th><th scope="col" class="text-end">Invoices</th><th scope="col" class="text-end">Overdue</th><th scope="col" class="text-end">Oldest (days)</th></tr></thead>
                                <tbody>
                                    @foreach (var x in d.OverdueCustomers)
                                    {
                                        <tr><td>@x.CustomerName</td><td class="text-end">@x.Invoices</td><td class="text-end">@Model.FormatCurrency(x.Amount)</td><td class="text-end">@x.OldestDaysOverdue</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
