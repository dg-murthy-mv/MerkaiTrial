@page
@model MerkaiTrial.Admin.Web.Pages.Reports.IndexModel
@{ ViewData["Title"] = "Reports"; }

<style>
.rep-card {
    background:#fff; border-radius:12px;
    border:1px solid #e2e8f0; padding:1.25rem;
    transition:box-shadow .2s, transform .15s;
    height:100%;
    text-decoration:none; color:inherit; display:block;
}
.rep-card:hover {
    box-shadow:0 6px 24px rgba(0,0,0,.09);
    transform:translateY(-2px);
}
.rep-icon {
    width:48px; height:48px; border-radius:12px;
    display:flex; align-items:center; justify-content:center;
    font-size:1.4rem; margin-bottom:1rem;
}
.rep-name  { font-size:15px; font-weight:600; color:#0f172a; margin-bottom:4px; }
.rep-desc  { font-size:12px; color:#64748b; line-height:1.5; margin-bottom:12px; }
.rep-meta  { font-size:11px; color:#5f6c7f; }
.section-label {
    font-size:11px; line-height:1.4; font-weight:600; letter-spacing:.06em;
    text-transform:uppercase; color:#64748b;
    padding-bottom:10px; border-bottom:1px solid #f1f5f9;
    margin-bottom:16px;
}
.badge-soon {
    font-size:10px; font-weight:500; padding:2px 8px;
    border-radius:4px; background:#fef3c7; color:#92400e;
}
</style>

<div class="container-fluid py-4">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-bar-chart-line me-2 text-primary" aria-hidden="true"></i>Reports &amp; Analytics</h2>
            <p class="text-muted mb-0">@Model.TenantName &nbsp;·&nbsp; amounts in @Model.CurrencyCode (@Model.CurrencySymbol)</p>
        </div>
    </div>

    @* 111 — five categories, from ReportCatalog (the sidebar uses the same list). *@
    @foreach (var category in Model.Categories)
    {
        <section class="mb-5" data-category="@category.Name">
            <h3 class="section-label"><i class="bi @category.Icon me-1" aria-hidden="true"></i>@category.Name</h3>
            <div class="row g-3">
                @foreach (var r in category.Reports)
                {
                    var locked = r.Advanced && !Model.HasAdvanced;
                    <div class="col-sm-6 col-lg-4">
                        <a class="rep-card" asp-page="@r.Page" data-report="@r.Key">
                            <div class="rep-icon" style="background:@r.IconBackground;color:@r.IconColour;" aria-hidden="true">
                                <i class="bi @r.Icon"></i>
                            </div>
                            <div class="rep-name">
                                @r.Title
                                @if (locked)
                                {
                                    <span class="badge-soon ms-1"><i class="bi bi-lock-fill me-1" aria-hidden="true"></i>Professional</span>
                                }
                            </div>
                            <div class="rep-desc">@r.Description</div>
                        </a>
                    </div>
                }
            </div>
        </section>
    }
</div>
