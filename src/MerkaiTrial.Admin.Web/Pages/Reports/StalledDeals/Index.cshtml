@page
@model MerkaiTrial.Admin.Web.Pages.Reports.StalledDeals.IndexModel
@{ ViewData["Title"] = "Stalled Deals"; }
@* =====================================================================
   FILE: Pages/Reports/StalledDeals/Index.cshtml                         (Round 112)
   Open deals going nowhere — and why
   ===================================================================== *@

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-page="/Reports/Index" class="btn btn-sm btn-outline-secondary" aria-label="Back to reports"><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
        <div>
            <h2 class="mb-0"><i class="bi bi-hourglass-split me-2 text-primary" aria-hidden="true"></i>Stalled Deals</h2>
            <p class="text-muted mb-0 small">Open deals going nowhere — and why</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    <partial name="Shared/_ReportFilter" model="@Model.Filter" />
    @if (Model.Data != null) { <partial name="Shared/_ReportNote" model="Model.Data" /> }

    @if (Model.Data != null)
    {
        var d = Model.Data;
        <div class="row g-3 mb-4" id="stalledTotals">
            <div class="col-6 col-md"><div class="card border-0 shadow-sm p-3 text-center h-100"><div class="fw-bold fs-4" data-figure="stalled-count">@d.StalledCount</div><div class="text-muted small">Stalled deals</div></div></div>
            <div class="col-6 col-md"><div class="card border-0 shadow-sm p-3 text-center h-100"><div class="fw-bold fs-4" data-figure="stalled-value">@Model.FormatCurrency(d.StalledValue)</div><div class="text-muted small">Value at risk</div></div></div>
            <div class="col-6 col-md"><div class="card border-0 shadow-sm p-3 text-center h-100"><div class="fw-bold fs-4" data-figure="open-count">@d.OpenDeals</div><div class="text-muted small">Open deals</div></div></div>
            <div class="col-6 col-md"><div class="card border-0 shadow-sm p-3 text-center h-100"><div class="fw-bold fs-4" data-figure="overdue-close">@d.OverdueCloseCount</div><div class="text-muted small">Past their close date</div></div></div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Stalled deals @(d.Deals.Count < d.StalledCount ? $"(the {d.Deals.Count} biggest)" : "")</div>
            <div class="card-body p-0">
                @if (d.Deals.Count == 0)
                {
                    <p class="p-3 mb-0 text-muted">No open deal is stalled. Every one moved, or had something logged, in the last @d.StalledDays days.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0" id="stalledDeals">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Deal</th><th scope="col">Owner</th><th scope="col">Stage</th>
                                    <th scope="col" class="text-end">Value</th><th scope="col" class="text-end">Days in stage</th>
                                    <th scope="col" class="text-end">Days since anything logged</th><th scope="col">Expected close</th><th scope="col">Why</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var x in d.Deals)
                                {
                                    <tr data-deal="@x.DealId">
                                        <td><a asp-page="/Pipeline/Detail" asp-route-id="@x.DealId">@x.Title</a></td>
                                        <td>@x.OwnerName</td>
                                        <td>@x.StageName</td>
                                        <td class="text-end">@Model.FormatCurrency(x.Value)</td>
                                        <td class="text-end" data-col="days-in-stage">@x.DaysInStage</td>
                                        <td class="text-end">@x.DaysSinceTouch</td>
                                        <td>@x.ExpectedCloseDateUtc.ToString("dd MMM yyyy")</td>
                                        <td class="small">@string.Join(" · ", x.Reasons)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (d.ByOwner.Count > 0)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">By owner</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th scope="col">Owner</th><th scope="col" class="text-end">Stalled deals</th><th scope="col" class="text-end">Value</th></tr></thead>
                        <tbody>
                            @foreach (var o in d.ByOwner)
                            {
                                <tr><td>@o.OwnerName</td><td class="text-end">@o.Count</td><td class="text-end">@Model.FormatCurrency(o.Value)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
