@* FILE: Pages/Reports/WinLoss/Index.cshtml *@
@page
@model MerkaiTrial.Admin.Web.Pages.Reports.WinLoss.IndexModel
@{ ViewData["Title"] = "Win / Loss Analysis"; }

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-page="/Reports/Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h2 class="mb-0"><i class="bi bi-trophy-fill me-2 text-warning"></i>Win / Loss Analysis</h2>
            <p class="text-muted mb-0 small">Win rate and revenue by sales owner</p>
        </div>
        @if (Model.Data != null)
        {
            <a asp-page-handler="Export"
               asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-vertical="@Model.Vertical"
               class="btn btn-sm btn-outline-success ms-auto">
                <i class="bi bi-file-earmark-excel me-1"></i>Export
            </a>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    <partial name="Shared/_ReportFilter" model="@Model.Filter" />

    @if (Model.Data != null)
    {
        var d = Model.Data;
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3"><div class="card border-0 shadow-sm p-3 text-center">
                <div class="fw-bold fs-4 text-success">@d.TotalWon</div><div class="text-muted small">Total Won</div>
            </div></div>
            <div class="col-6 col-md-3"><div class="card border-0 shadow-sm p-3 text-center">
                <div class="fw-bold fs-4 text-danger">@d.TotalLost</div><div class="text-muted small">Total Lost</div>
            </div></div>
            <div class="col-6 col-md-3"><div class="card border-0 shadow-sm p-3 text-center">
                <div class="fw-bold fs-4 text-primary">@d.OverallWinRate%</div><div class="text-muted small">Win Rate</div>
            </div></div>
            <div class="col-6 col-md-3"><div class="card border-0 shadow-sm p-3 text-center">
                <div class="fw-bold fs-4 text-warning">@Model.FormatCurrency(d.TotalWonValue)</div><div class="text-muted small">Won Value</div>
            </div></div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body"><canvas id="chart" height="100"></canvas></div>
        </div>
    }
    else { <div class="text-center py-5 text-muted"><i class="bi bi-trophy fs-1 d-block mb-3"></i>No closed deals in selected period.</div> }
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
const d = @Html.Raw(Model.DataJson);
if (d) {
    new Chart(document.getElementById('chart'), {
        type: 'bar',
        data: {
            labels: d.byOwner.map(o => o.ownerName),
            datasets: [
                { label: 'Won',  data: d.byOwner.map(o => o.won),  backgroundColor: '#16a34a', borderRadius: 4 },
                { label: 'Lost', data: d.byOwner.map(o => o.lost), backgroundColor: '#dc2626', borderRadius: 4 }
            ]
        },
        options: { plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
    });
}
</script>
}
