@* =====================================================================
   FILE: Pages/Reports/LeadSources/Index.cshtml
   ===================================================================== *@
@page
@model MerkaiTrial.Admin.Web.Pages.Reports.LeadSources.IndexModel
@{ ViewData["Title"] = "Lead Source Analysis"; }

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-page="/Reports/Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h2 class="mb-0"><i class="bi bi-megaphone-fill me-2 text-success"></i>Lead Source Analysis</h2>
            <p class="text-muted mb-0 small">Which channels and sources bring the most leads and best conversion</p>
        </div>
        @if (Model.Data != null)
        {
            <a asp-page-handler="Export" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-vertical="@Model.Vertical" class="btn btn-sm btn-outline-success ms-auto">
                <i class="bi bi-file-earmark-excel me-1"></i>Export
            </a>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    <partial name="Shared/_ReportFilter" model="@Model.Filter" />

    @if (Model.Data != null)
    {
        var d = Model.Data;
        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="card border-0 shadow-sm p-3 text-center"><div class="fw-bold fs-4 text-primary">@d.TotalLeads</div><div class="text-muted small">Total Leads</div></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm p-3 text-center"><div class="fw-bold fs-4 text-success">@d.TotalConverted</div><div class="text-muted small">Converted</div></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm p-3 text-center"><div class="fw-bold fs-4 text-warning">@d.OverallConversionRate%</div><div class="text-muted small">Conversion Rate</div></div></div>
        </div>
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom fw-semibold small"><i class="bi bi-broadcast me-1 text-primary"></i>By Channel</div>
                    <div class="card-body"><canvas id="channelChart" height="160"></canvas></div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom fw-semibold small"><i class="bi bi-signpost me-1 text-success"></i>By Source</div>
                    <div class="card-body"><canvas id="sourceChart" height="160"></canvas></div>
                </div>
            </div>
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom fw-semibold small"><i class="bi bi-table me-1"></i>Channel Breakdown</div>
                    <div class="card-body p-0">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr><th>Channel</th><th class="text-center">Leads</th><th class="text-center">Qualified</th><th class="text-center">Converted</th><th class="text-center">Conv Rate</th><th class="text-end">Est Value</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in d.ByChannel)
                                {
                                    <tr>
                                        <td class="small fw-semibold">@c.Name</td>
                                        <td class="text-center small">@c.TotalLeads</td>
                                        <td class="text-center small text-info">@c.Qualified</td>
                                        <td class="text-center small text-success">@c.Converted</td>
                                        <td class="text-center small"><span class="badge @(c.ConversionRate >= 30 ? "bg-success" : "bg-warning text-dark")">@c.ConversionRate%</span></td>
                                        <td class="text-end small">@Model.FormatCurrency(c.EstimatedValue)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else { <div class="text-center py-5 text-muted"><i class="bi bi-megaphone fs-1 d-block mb-3"></i>No lead data for selected filters.</div> }
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
const d = @Html.Raw(Model.DataJson);
if (d) {
    const palette = ['#3b82f6','#16a34a','#f59e0b','#dc2626','#6366f1','#0ea5e9','#f97316','#84cc16'];
    new Chart(document.getElementById('channelChart'), {
        type: 'doughnut',
        data: { labels: d.byChannel.map(c => c.name), datasets: [{ data: d.byChannel.map(c => c.totalLeads), backgroundColor: palette, hoverOffset: 6 }] },
        options: { plugins: { legend: { position: 'bottom' } } }
    });
    new Chart(document.getElementById('sourceChart'), {
        type: 'bar',
        data: {
            labels: d.bySource.map(s => s.name),
            datasets: [
                { label: 'Total',     data: d.bySource.map(s => s.totalLeads), backgroundColor: '#3b82f688', borderRadius: 4 },
                { label: 'Converted', data: d.bySource.map(s => s.converted),  backgroundColor: '#16a34a',   borderRadius: 4 }
            ]
        },
        options: { plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
    });
}
</script>
}
