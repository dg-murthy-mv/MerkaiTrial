@* FILE: Pages/Reports/Revenue/Index.cshtml *@
@page
@model MerkaiTrial.Admin.Web.Pages.Reports.Revenue.IndexModel
@{ ViewData["Title"] = "Revenue by Period"; }

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-page="/Reports/Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h2 class="mb-0"><i class="bi bi-cash-stack me-2 text-success"></i>Revenue by Period</h2>
            <p class="text-muted mb-0 small">Monthly invoiced vs collected with outstanding balance</p>
        </div>
        @if (Model.Data != null)
        {
            <a asp-page-handler="Export"
               asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-vertical="@Model.Vertical"
               class="btn btn-sm btn-outline-success ms-auto">
                <i class="bi bi-file-earmark-excel me-1"></i>Export
            </a>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
    <partial name="Shared/_ReportFilter" model="@Model.Filter" />

    @if (Model.Data != null)
    {
        var d = Model.Data;
        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="card border-0 shadow-sm p-3 text-center">
                <div class="fw-bold fs-4" style="color:#0ea5e9;">@Model.FormatCurrency(d.TotalInvoiced)</div><div class="text-muted small">Total Invoiced</div>
            </div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm p-3 text-center">
                <div class="fw-bold fs-4 text-success">@Model.FormatCurrency(d.TotalCollected)</div><div class="text-muted small">Total Collected</div>
            </div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm p-3 text-center">
                <div class="fw-bold fs-4 text-warning">@Model.FormatCurrency(d.TotalOutstanding)</div><div class="text-muted small">Outstanding</div>
            </div></div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body"><canvas id="chart" height="80"></canvas></div>
        </div>
    }
    else { <div class="text-center py-5 text-muted"><i class="bi bi-cash-stack fs-1 d-block mb-3"></i>No data for selected filters.</div> }
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
const d = @Html.Raw(Model.DataJson);
if (d) {
    new Chart(document.getElementById('chart'), {
        type: 'bar',
        data: {
            labels: d.periods.map(p => p.label),
            datasets: [
                { label: 'Invoiced',  data: d.periods.map(p => p.invoiced),  backgroundColor: '#0ea5e988', borderColor: '#0ea5e9', borderWidth:1, borderRadius:4 },
                { label: 'Collected', data: d.periods.map(p => p.collected), backgroundColor: '#16a34a88', borderColor: '#16a34a', borderWidth:1, borderRadius:4 }
            ]
        },
        options: { plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true } } }
    });
}
</script>
}
