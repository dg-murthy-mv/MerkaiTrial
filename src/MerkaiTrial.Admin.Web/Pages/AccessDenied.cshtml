@page
@model MerkaiTrial.Admin.Web.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow-lg">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-shield-exclamation me-2"></i>
                        Access Denied
                    </h4>
                </div>
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-lock-fill text-danger" style="font-size: 80px;"></i>
                    </div>
                    
                    <h2 class="mb-3">You Don't Have Permission</h2>
                    
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>@TempData["ErrorMessage"]</strong>
                        </div>
                    }
                    
                    @if (TempData["RequiredPermission"] != null)
                    {
                        <div class="mb-4">
                            <p class="text-muted mb-2">Required Permission:</p>
                            <code class="fs-5">@TempData["RequiredPermission"]</code>
                        </div>
                    }
                    
                    <p class="text-muted mb-4">
                        You don't have the necessary permissions to access this page or perform this action.
                        <br />
                        Please contact your system administrator if you believe this is an error.
                    </p>
                    
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Go Back
                        </a>
                        <a asp-page="/Admin/Index" class="btn btn-primary">
                            <i class="bi bi-house me-1"></i>Go to Dashboard
                        </a>
                    </div>
                    
                    <div class="mt-4 pt-4 border-top">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            To request access, contact your administrator with the permission code above.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
