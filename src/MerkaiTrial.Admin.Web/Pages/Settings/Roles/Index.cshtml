@page "/Settings/Roles"
@model MerkaiTrial.Admin.Web.Pages.Settings.Roles.IndexModel
@{
    ViewData["Title"] = "Roles & Permissions";
    var state = Model.StateRoute();   // 096 — the delete form carries it
}

@*
    FILE: MerkaiTrial.Admin.Web/Pages/Settings/Roles/Index.cshtml

    Tenant-facing role management. Uses the default _Layout (the CRM
    shell), not _SuperAdminLayout — the folder is outside /Admin so
    Pages/_ViewStart picks _Layout automatically.

    System roles render read-only. tenant_admin is a shared row owned by
    MadeeVision; a tenant editing it would be editing every tenant's copy,
    which is exactly what the role split removed.

    096: the shared _ListToolbar and _Pager (no more _Pagination here).
    Delete returns to the same page and search, and its confirm text is a
    data-confirm attribute — a role name with an apostrophe broke the old
    inline confirm('…') and posted without asking.
    096b — the record id (activityId / userId / id) is a hidden field, NOT
    asp-route-…: on a form that also has asp-all-route-data, ASP.NET sets
    the asp-route value first and then REPLACES the whole route list with
    the state, so the id was silently dropped and the handler got an empty
    one (the first full test run caught it on Tasks → Reassign).
*@

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="lf-page-title mb-1">Roles &amp; Permissions</h1>
        <p class="text-muted mb-0" style="font-size:13.5px;">
            Control what each person in your workspace can see and change.
        </p>
    </div>
    @if (Model.CanCreate)
    {
        <a asp-page="./Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> New role
        </a>
        <a asp-page="/Settings/Visibility/Index" class="btn btn-outline-secondary me-2">
            <i class="bi bi-eye me-1"></i> Record visibility
        </a>

    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;">Total roles</div>
                <div class="fs-4 fw-semibold">@Model.Stats.TotalRoles</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;">Built-in</div>
                <div class="fs-4 fw-semibold">@Model.Stats.SystemRoles</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;">Your roles</div>
                <div class="fs-4 fw-semibold">@Model.Stats.CustomRoles</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;">People assigned</div>
                <div class="fs-4 fw-semibold">@Model.Stats.TotalUsers</div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.PageError))
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <span>@Model.PageError</span>
    </div>
}

@* 096 — the shared search strip, filter and count. *@
<partial name="_ListToolbar" model="Model.Toolbar" />

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-shield me-2"></i>Roles <span class="badge bg-primary ms-1">@Model.Roles.TotalCount</span></span>
        @if (Model.Roles.TotalPages > 1)
        {
            <span class="text-muted" style="font-size:12px;">Page @Model.PageNumber of @Model.Roles.TotalPages</span>
        }
    </div>

    @if (!Model.Roles.Items.Any())
    {
        <div class="card-body text-center py-5 text-muted">
            @if (!string.IsNullOrEmpty(Model.PageError))
            {
                <i class="bi bi-cloud-slash" style="font-size:2rem;opacity:.4;"></i>
                <p class="mt-3 mb-2">The list could not be loaded.</p>
                <a asp-page="./Index" asp-all-route-data="state" class="btn btn-sm btn-outline-secondary">Try again</a>
            }
            else
            {
                <i class="bi bi-shield" style="font-size:2rem;opacity:.4;"></i>
                <p class="mt-3 mb-2">No roles match that search.</p>
                <a asp-page="./Index" asp-route-PageSize="@Model.PageSize" class="btn btn-sm btn-outline-secondary">Clear the search</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>People</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model.Roles.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@role.DisplayName</div>
                                <small class="text-muted">@role.Name</small>
                            </td>
                            <td class="text-muted">@role.Description</td>
                            <td>
                                @if (role.IsSystemRole)
                                {
                                    <span class="badge bg-secondary">Built-in</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Custom</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark">@role.UserCount</span></td>
                            <td class="text-end">
                                <a asp-page="./Detail" asp-route-id="@role.Id"
                                   class="btn btn-sm btn-outline-secondary" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @* Built-in roles are shared across every tenant and
                                   are deliberately not editable here. *@
                                @if (!role.IsSystemRole && Model.CanUpdate)
                                {
                                    <a asp-page="./Edit" asp-route-id="@role.Id"
                                       class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }

                                @if (!role.IsSystemRole && Model.CanDelete)
                                {
                                    @* 096 — data-confirm, read by one listener below. *@
                                    <form method="post" asp-page-handler="Delete"
                                          asp-all-route-data="state"
                                          class="d-inline"
                                          data-confirm="Delete the @role.DisplayName role? People assigned to it will lose those permissions.">
                                        <input type="hidden" name="id" value="@role.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }

                                @if (role.IsSystemRole)
                                {
                                    <span class="text-muted ms-1" style="font-size:12px;">
                                        <i class="bi bi-lock"></i> Built-in
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-md-none">
            @foreach (var role in Model.Roles.Items)
            {
                <div class="border-bottom p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="fw-semibold">@role.DisplayName</div>
                            <small class="text-muted">@role.Name</small>
                        </div>
                        @if (role.IsSystemRole)
                        {
                            <span class="badge bg-secondary">Built-in</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">Custom</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(role.Description))
                    {
                        <p class="text-muted small mb-2">@role.Description</p>
                    }

                    <div class="d-flex gap-2">
                        <a asp-page="./Detail" asp-route-id="@role.Id"
                           class="btn btn-sm btn-outline-secondary flex-fill">View</a>

                        @if (!role.IsSystemRole && Model.CanUpdate)
                        {
                            <a asp-page="./Edit" asp-route-id="@role.Id"
                               class="btn btn-sm btn-outline-primary flex-fill">Edit</a>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* 096 — the shared pager (was the old _Pagination partial). *@
    <partial name="_Pager" model="Model.Pager" />
</div>

@section Scripts {
    <script>
        // 096 — one listener for the confirms. The text is in data-confirm,
        // encoded by Razor and read back as plain text, so a role called
        // "Owner's team" is just a name.
        document.addEventListener('submit', function (e) {
            var form = e.target;
            if (!form || !form.getAttribute) return;
            var text = form.getAttribute('data-confirm');
            if (text && !window.confirm(text)) e.preventDefault();
        });
    </script>
}
