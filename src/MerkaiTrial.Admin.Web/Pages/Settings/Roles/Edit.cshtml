@* =====================================================================
   ROLE EDIT PAGE
   084: boxes show the role's real permissions whatever their stored
   capitalisation; saving changes only what is shown here; underscores
   allowed in the role name (sales_rep).
   ===================================================================== *@
@page "/Settings/Roles/Edit/{id:guid}"
@model MerkaiTrial.Admin.Web.Pages.Settings.Roles.EditModel
@using MerkaiTrial.Admin.Web.Pages.Settings.Roles
@{
    ViewData["Title"] = $"Edit Role: {Model.Input.DisplayName}";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-pencil" style="color: #ff6b35;"></i> Edit Role</h2>
            <p class="text-muted mb-0">Update role information and permissions</p>
        </div>
        <div>
            <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-eye"></i> View Details
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.AssignedUsers > 0)
    {
        <div class="alert alert-warning d-flex align-items-start">
            <i class="bi bi-people me-2 mt-1"></i>
            <div>
                <strong>@Model.AssignedUsers @(Model.AssignedUsers == 1 ? "person uses" : "people use") this role.</strong>
                When you save, they'll be signed out and get the new permissions when they sign back in.
            </div>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form method="post">
        <div class="row">
            <!-- Basic Info -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header" style="background-color: #ff6b35; color: white;">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Basic Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Name" class="form-label">
                                    Role Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Name" class="form-control" placeholder="sales_rep" autocomplete="off" />
                                <small class="form-text text-muted">Letters, numbers, - and _ only. Saved in lower case.</small>
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.DisplayName" class="form-label">
                                    Display Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.DisplayName" class="form-control" placeholder="Sales Representative" />
                                <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="Input.Description" class="form-label">Description</label>
                                <textarea asp-for="Input.Description" class="form-control" rows="3" 
                                          placeholder="Describe the role's purpose..."></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Permissions -->
                <div class="card mb-4">
                    <div class="card-header" style="background-color: #ff6b35; color: white;">
                        <h5 class="mb-0"><i class="bi bi-key"></i> Permissions</h5>
                    </div>
                    <div class="card-body">
                        <partial name="_RolePermissionsGrid"
                                 model="new RolePermissionsGridVm(Model.AvailableModules, Model.SelectedPermissions)" />

                        @if (Model.KeptPermissions.Any())
                        {
                            <div class="alert alert-light border mt-3 mb-0 small">
                                <div class="fw-semibold mb-1"><i class="bi bi-lock me-1"></i>Also on this role (kept as they are)</div>
                                <div class="text-muted mb-2">These aren't offered on this page, so saving won't change them.</div>
                                @foreach (var kept in Model.KeptPermissions)
                                {
                                    <div>
                                        <strong>@Model.ModuleLabel(kept.Key)</strong>:
                                        @string.Join(", ", kept.Value.Select(RolePermissionForm.ActionLabel))
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Side Panel -->
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-check-circle"></i> Actions</h5>
                    </div>
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                        <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Information</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0 small">
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success"></i>
                                System roles cannot be edited
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success"></i>
                                Role name must be unique
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-exclamation-triangle text-warning"></i>
                                Changes affect all assigned users; they're asked to sign in again
                            </li>
                            <li class="mb-0">
                                <i class="bi bi-shield-check text-success"></i>
                                Workspace admins always have every permission
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @* 084: same local scripts as Create. The CDN copies loaded a second
       jQuery on top of the layout's. *@
    <partial name="_ValidationScriptsPartial" />
}
