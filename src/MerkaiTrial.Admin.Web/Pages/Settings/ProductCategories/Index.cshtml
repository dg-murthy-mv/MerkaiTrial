@page
@using System.Linq
@model MerkaiTrial.Admin.Web.Pages.Settings.ProductCategories.IndexModel
@{
    ViewData["Title"] = "Product Categories";

    // Which form is open. Bound from ?edit={id} and ?add=true on the
    // page model rather than read out of Request.Query here, so a POST
    // that fails validation can reopen the same form by setting the
    // property — the query string is gone by then.
    //
    // IsAdding is a computed property over a STRING flag, not a bound
    // bool. The bool version silently refused "1" and this button did
    // nothing for three rounds; the page model carries the full note.
    var adding = Model.IsAdding;

    // ADDING WINS. ?add=true&edit={id} is reachable by hand, and rendering
    // both forms at once would put two sets of radio inputs with the same
    // ids on the page — at which point clicking an icon in one form moves
    // the selection in the other, because a label's for= attribute binds
    // to the FIRST matching id in the document.
    //
    // (Angle brackets are kept out of this comment on purpose: Razor
    //  parses a code block as C#, and a markup-looking token inside one
    //  is a thing to avoid rather than to rely on.)
    var editing = adding ? Guid.Empty : (Model.EditId ?? Guid.Empty);
}
@* =====================================================================
   Settings/ProductCategories/Index.cshtml — NEW (068).

   The tenant shell, so this renders under Pages/_ViewStart's "_Layout",
   which is light. No dark-theme block here on purpose — the 049 and 054
   problems both came from carrying styling between the two shells.

   ── WHY THE EDIT FORM IS A ROW AND NOT A MODAL ──────────────────────

   Because renaming a category has a consequence the person has to see
   WHILE they type: "14 products are filed under this". A modal hides
   the list it is about, so the count has to be copied into the modal
   and the row underneath stops matching what they are editing. Opening
   the form in place keeps the rest of the list, and its counts, on
   screen.

   ── WHY UP/DOWN BUTTONS AND NOT DRAG-AND-DROP ───────────────────────

   This list has eight to fifteen rows and is edited twice a year. Drag
   and drop needs a library, does not work with a keyboard without extra
   work, and is a genuine fight on a phone — which is where a shop owner
   in Rayong is most likely to be when they decide they want "Catering"
   above "Consulting".
   ===================================================================== *@

<style>
    .pc-head { display: flex; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }

    .pc-row { border: 1px solid #e5e8ec; border-radius: 10px; background: #fff; padding: .7rem .9rem; margin-bottom: .55rem; }
    .pc-row.inactive { background: #fbfcfd; }
    .pc-row.editing { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.1); }

    /* 073: the row that was just reordered. A move can land a category on
       a different page, so without this the user sees two changes at once
       — a new page AND a reshuffled list — with nothing saying which row
       they just moved. Fades out on its own; no script. */
    .pc-row.moved { border-color: #16a34a; box-shadow: 0 0 0 3px rgba(22,163,74,.14);
                    animation: pcMoved 2.4s ease-out 1; }
    @@keyframes pcMoved {
        0%   { background: #ecfdf5; }
        70%  { background: #ecfdf5; }
        100% { background: #fff; }
    }

    .pc-ico {
        width: 2.4rem; height: 2.4rem; border-radius: 9px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 1.15rem;
    }

    .pc-name { font-weight: 600; }
    .pc-meta { font-size: .78rem; color: #94a3b8; }

    /* The icon picker. A radio grid, not a <select>: the whole point is
       seeing the icons, and a dropdown of 50 class names is unusable. */
    .pc-icons { display: flex; flex-wrap: wrap; gap: .3rem; max-height: 10.5rem; overflow-y: auto;
                padding: .5rem; border: 1px solid #e5e8ec; border-radius: 9px; background: #fbfcfd; }
    .pc-icons input { position: absolute; opacity: 0; width: 0; height: 0; }
    .pc-icons label {
        width: 2.1rem; height: 2.1rem; border-radius: 7px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid #e5e8ec; background: #fff; color: #475569; font-size: 1rem;
        margin: 0;
    }
    .pc-icons label:hover { border-color: #c7cdd4; }
    .pc-icons input:checked + label { border-color: #4f46e5; color: #4f46e5; box-shadow: 0 0 0 2px rgba(79,70,229,.15); }
    .pc-icons input:focus-visible + label { outline: 2px solid #4f46e5; outline-offset: 2px; }

    /* Colour swatches, same arrangement. The free-hex box below them is
       for somebody matching a brand palette. */
    .pc-colors { display: flex; flex-wrap: wrap; gap: .35rem; }
    .pc-colors input { position: absolute; opacity: 0; width: 0; height: 0; }
    .pc-colors label {
        width: 1.75rem; height: 1.75rem; border-radius: 50%; cursor: pointer;
        border: 2px solid #fff; box-shadow: 0 0 0 1px #d7dde3; margin: 0;
    }
    .pc-colors input:checked + label { box-shadow: 0 0 0 2px #4f46e5; }
    .pc-colors input:focus-visible + label { outline: 2px solid #4f46e5; outline-offset: 2px; }

    .pc-ord { --bs-btn-padding-y: .1rem; --bs-btn-padding-x: .35rem; line-height: 1; }

    .pc-empty { padding: 2rem 1rem; text-align: center; color: #94a3b8; }
    .pc-empty i { font-size: 2rem; color: #d7dde3; display: block; margin-bottom: .5rem; }

    .pc-aside { background: #f8fafc; border: 1px solid #e5e8ec; border-radius: 10px; padding: 1rem 1.1rem; }
    .pc-aside h6 { font-size: .82rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b; }
    .pc-aside p { font-size: .85rem; color: #475569; margin-bottom: .6rem; }
</style>

<div class="pc-head">
    <div class="flex-grow-1">
        <h2 class="mb-1"><i class="bi bi-tags text-primary"></i> Product categories</h2>
        <p class="text-muted mb-0">
            How your catalogue is grouped. These are the choices on every product's
            Category field, and the icon and colour each one shows across the app.
        </p>
    </div>
    @if (Model.CanCreate && !adding)
    {
        @* "true", not "1". ?add=1 could never open this form: the page
           model bound it to a bool, and ASP.NET Core's bool binder takes
           "true"/"false" and nothing else — so the value failed to
           convert, the flag stayed false and this button did nothing at
           all. The page model now binds the flag as a string and still
           accepts "1" for links already in people's history, but the
           link the app emits says what the binder actually wants. *@
        @* 073: StateRoute carries the search, the filters AND the page,
           so opening the form from page 3 of a filtered list comes back
           to page 3 of that list. It also sets add=true. *@
        <a asp-page="./Index" asp-all-route-data="@Model.StateRoute(adding: true)" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Add category
        </a>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-start gap-2">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <span>@Model.ErrorMessage</span>
    </div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success d-flex align-items-start gap-2">
        <i class="bi bi-check-circle-fill mt-1"></i>
        <span>@Model.SuccessMessage</span>
    </div>
}

@* ── ADOPTION, said before anybody clicks ─────────────────────────────
   This is the one thing on the page that will surprise somebody if it
   is not said in advance. *@
@* 073: AllCategories, not Categories — a search that matches nothing
   would otherwise hide the one explanation on the page. *@
@if (Model.FollowingDefaults && Model.AllCategories.Any())
{
    <div class="alert alert-info d-flex gap-2 align-items-start">
        <i class="bi bi-info-circle-fill mt-1"></i>
        <div>
            <strong>These are the standard Merkai categories.</strong>
            The first time you add, rename, recolour or remove one, your workspace
            takes its own private copy of the whole list — and from then on it is
            yours to arrange however you like. Nothing you do here affects any
            other workspace.
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">

        @* ── ADD FORM ────────────────────────────────────────────── *@
        @if (adding && Model.CanCreate)
        {
            @* 073: the form posts the list state as hidden fields so the
               redirect after a save returns to the same page of the same
               filtered list. They bind on a POST because the properties
               are [BindProperty(SupportsGet = true)]. *@
            <form method="post" asp-page-handler="Add" class="pc-row editing">
                <partial name="_ListState" model="Model" />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <strong><i class="bi bi-plus-circle me-1 text-primary"></i>New category</strong>
                    <a asp-page="./Index" asp-all-route-data="@Model.StateRoute()"
                       class="btn btn-sm btn-link text-muted text-decoration-none">Cancel</a>
                </div>
                <partial name="_CategoryFields" model="Model" />
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-check-lg me-1"></i>Add category
                    </button>
                    <a asp-page="./Index" asp-all-route-data="@Model.StateRoute()"
                       class="btn btn-outline-secondary btn-sm">Cancel</a>
                </div>
            </form>
        }

        @* ── 073: search and filters ─────────────────────────────── *@
        @* Drawn whenever there is more than one category.

           My first cut only drew it past one page's worth, on the
           argument that a search box over nine rows is furniture. That
           argument is wrong here: the standard list is nine, so the
           search box would have been invisible on exactly the workspaces
           that asked for it. *@
        @if (Model.AllCategories.Count > 1)
        {
            <partial name="_ListToolbar" model="Model.Toolbar" />
        }

        @if (!string.IsNullOrEmpty(Model.ReorderBlockedReason) && Model.AllCategories.Count > 1)
        {
            @* Said once, where the arrows would have been. Silently
               dropping them would read as a permissions problem. *@
            <div class="alert alert-light border py-2 px-3 small d-flex gap-2 align-items-start">
                <i class="bi bi-arrow-down-up mt-1 text-primary"></i>
                <span>@Model.ReorderBlockedReason</span>
            </div>
        }

        @if (!Model.Categories.Any())
        {
            <div class="pc-empty">
                @if (Model.IsFiltered)
                {
                    @* Telling somebody with forty categories that they
                       have none, because they mistyped a search, is the
                       empty state getting it exactly backwards. *@
                    <i class="bi bi-search"></i>
                    <div>No category matches that search.</div>
                    <div class="small">
                        <a asp-page="./Index" asp-route-PageSize="@Model.PageSize">Clear the search and filters</a>
                        to see all @Model.AllCategories.Count.
                    </div>
                }
                else
                {
                    <i class="bi bi-tags"></i>
                    <div>No categories yet.</div>
                    <div class="small">
                        Add one and your products will have something to be filed under.
                    </div>
                }
            </div>
        }

        @for (var i = 0; i < Model.Categories.Count; i++)
        {
            var c = Model.Categories[i];
            var isEditing = editing == c.Id;

            // 073: first and last IN THE WHOLE LIST, not in this page.
            // i == 0 disabled the up arrow on the first row of EVERY page,
            // which would have made it impossible to move anything off
            // page 2.
            //
            // A // comment and not a Razor one: this is a C# statement
            // position inside the @@for body, and the 068 note at the top
            // of this file is about exactly that — a code block is parsed
            // as C#, so constructs that belong to markup do not go here.
            var isFirst = Model.IsFirstOverall(c.Id);
            var isLast  = Model.IsLastOverall(c.Id);
            var justMoved = Model.MovedId == c.Id;

            if (isEditing && Model.CanUpdate)
            {
                <form method="post" asp-page-handler="Save" class="pc-row editing">
                    <input type="hidden" asp-for="Input.Id" value="@c.Id" />
                    <partial name="_ListState" model="Model" />

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <strong><i class="bi bi-pencil me-1 text-primary"></i>Editing &ldquo;@c.Name&rdquo;</strong>
                        <a asp-page="./Index" asp-all-route-data="@Model.StateRoute()"
                           class="btn btn-sm btn-link text-muted text-decoration-none">Cancel</a>
                    </div>

                    @* ── THE RENAME WARNING ──────────────────────────
                       Shown only when there is something to warn about,
                       and it names the number. "This will rename things"
                       is not useful; "14 products" is. *@
                    @if (c.ProductCount > 0)
                    {
                        <div class="alert alert-warning py-2 px-3 small d-flex gap-2 align-items-start mb-3">
                            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                            <div>
                                <strong>@c.ProductCount @(c.ProductCount == 1 ? "product is" : "products are") filed under this.</strong>
                                If you change the name, all of them move with it — the category
                                on a product is the name itself, so nothing is left behind.
                                Quotes and invoices already issued are not touched.
                            </div>
                        </div>
                    }

                    <partial name="_CategoryFields" model="Model" />

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-check-lg me-1"></i>Save changes
                        </button>
                        <a asp-page="./Index" asp-all-route-data="@Model.StateRoute()"
                           class="btn btn-outline-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            }
            else
            {
                <div class="pc-row @(c.IsActive ? "" : "inactive") @(justMoved ? "moved" : "")">
                    <div class="d-flex align-items-center gap-3">

                        @* Reorder. Disabled at the ends rather than hidden,
                           so the row's controls do not shift position
                           between rows.

                           073: CanReorder, not CanUpdate — the arrows go
                           away entirely while a search or filter is on,
                           because "swap with the row above" has no honest
                           answer when the row above is hidden. The notice
                           above the list says so; the server refuses it
                           too, since a hidden button is not a control.

                           isFirst / isLast are now about the WHOLE list,
                           so the up arrow is live on the first row of
                           page 2 — that row really can move up, onto
                           page 1, and the handler follows it there. *@
                        @if (Model.CanReorder)
                        {
                            <div class="d-flex flex-column gap-1">
                                <form method="post" asp-page-handler="Move" asp-route-id="@c.Id" asp-route-direction="up">
                                    <partial name="_ListState" model="Model" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary pc-ord"
                                            title="Move up" aria-label="Move @c.Name up" disabled="@isFirst">
                                        <i class="bi bi-chevron-up"></i>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Move" asp-route-id="@c.Id" asp-route-direction="down">
                                    <partial name="_ListState" model="Model" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary pc-ord"
                                            title="Move down" aria-label="Move @c.Name down" disabled="@isLast">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                </form>
                            </div>
                        }

                        <div class="pc-ico" style="background-color: @c.Color;">
                            <i class="@c.Icon"></i>
                        </div>

                        <div class="flex-grow-1" style="min-width:0;">
                            <div class="pc-name">
                                @c.Name
                                @if (!c.IsActive)
                                {
                                    <span class="badge bg-secondary ms-1">Off</span>
                                }
                                @if (c.IsSystem)
                                {
                                    <span class="badge bg-light text-dark border ms-1" title="A standard Merkai category. Editing it gives your workspace its own copy of the list.">Standard</span>
                                }
                            </div>
                            <div class="pc-meta">
                                @if (c.ProductCount == 0)
                                {
                                    <text>No products</text>
                                }
                                else if (c.ProductCount == 1)
                                {
                                    <text>1 product</text>
                                }
                                else
                                {
                                    <text>@c.ProductCount products</text>
                                }
                                &nbsp;·&nbsp; <code class="pc-meta">@c.Color</code>
                            </div>
                        </div>

                        <div class="d-flex gap-1 flex-shrink-0">
                            @if (Model.CanUpdate)
                            {
                                <a asp-page="./Index" asp-all-route-data="@Model.StateRoute(editId: c.Id)"
                                   class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <form method="post" asp-page-handler="Toggle" asp-route-id="@c.Id">
                                    <partial name="_ListState" model="Model" />
                                    <button type="submit"
                                            class="btn btn-sm @(c.IsActive ? "btn-outline-secondary" : "btn-outline-success")"
                                            title="@(c.IsActive ? "Stop offering this for new products" : "Offer this again")">
                                        <i class="bi @(c.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                    </button>
                                </form>
                            }
                            @if (Model.CanDelete)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        title="Remove"
                                        data-bs-toggle="modal" data-bs-target="#pcRemove-@c.Id">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>

                @* ── REMOVE DIALOG ──────────────────────────────────
                   A modal here, unlike the edit form, because this one
                   asks a question with no default answer: where do the
                   products go? A one-click delete that quietly
                   uncategorized fourteen products would be the wrong
                   shape of convenience. *@
                @if (Model.CanDelete)
                {
                    <div class="modal fade" id="pcRemove-@c.Id" tabindex="-1"
                         aria-labelledby="pcRemoveLabel-@c.Id" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <form method="post" asp-page-handler="Remove" asp-route-id="@c.Id" class="modal-content">
                                <partial name="_ListState" model="Model" />
                                <div class="modal-header">
                                    <h5 class="modal-title" id="pcRemoveLabel-@c.Id">
                                        Remove &ldquo;@c.Name&rdquo;?
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    @if (c.ProductCount == 0)
                                    {
                                        <p class="mb-0">
                                            Nothing is filed under this category, so removing it changes
                                            nothing else. Quotes and invoices that mention it are not touched.
                                        </p>
                                    }
                                    else
                                    {
                                        <p>
                                            <strong>@c.ProductCount @(c.ProductCount == 1 ? "product is" : "products are")
                                            filed under this category.</strong>
                                            They have to go somewhere.
                                        </p>

                                        <label class="form-label" for="pcReassign-@c.Id">Move them to</label>
                                        <select class="form-select" id="pcReassign-@c.Id" name="reassignTo">
                                            <option value="">Leave them uncategorized</option>
                                            @foreach (var target in Model.ReassignTargetsFor(c.Id))
                                            {
                                                <option value="@target">@target</option>
                                            }
                                        </select>
                                        <small class="text-muted">
                                            Uncategorized is allowed — the products stay in your catalogue and
                                            can still be quoted. They simply have no category until you give
                                            them one.
                                        </small>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash me-1"></i>Remove category
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
        }
        @* ── 073: pager ──────────────────────────────────────────── *@
        <partial name="_Pager" model="Model.Pager" />

    </div>
    <div class="col-lg-4">
        <div class="pc-aside">
            <h6 class="mb-2">How these are used</h6>
            <p>
                The <strong>order</strong> here is the order of the dropdown on every
                product form. Put what you sell most at the top.
            </p>
            <p>
                <strong>Switching one off</strong> stops it being offered for new
                products without touching the ones already using it — the right move
                for a line you have stopped selling but still have history for.
            </p>
            <p class="mb-0">
                The <strong>icon and colour</strong> show on the products list, the
                product page and the catalogue picker inside a quote. They are how
                somebody scanning fifty rows finds the one they want.
            </p>
        </div>

        @if (Model.UncategorizedProductCount > 0)
        {
            <div class="pc-aside mt-3">
                <h6 class="mb-2">Uncategorized</h6>
                <p class="mb-2">
                    @Model.UncategorizedProductCount
                    @(Model.UncategorizedProductCount == 1 ? "product has" : "products have")
                    no category at all. That is allowed, but they will not appear
                    under any category filter.
                </p>
                <a asp-page="/Products/Index" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-box-seam me-1"></i>Open the catalogue
                </a>
            </div>
        }
    </div>
</div>
