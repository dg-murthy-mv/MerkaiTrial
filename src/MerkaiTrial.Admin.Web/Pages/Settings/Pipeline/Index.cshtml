@page "/Settings/Pipeline"
@using MerkaiTrial.Domain.Entities
@model MerkaiTrial.Admin.Web.Pages.Settings.Pipeline.IndexModel
@{
    ViewData["Title"] = "Pipeline Stages";

    var working  = Model.WorkingStages;
    var closing  = Model.ClosingStages;
    var retired  = Model.RetiredStages;
    var warnings = Model.ProbabilityWarnings();
}

@* =====================================================================
   PIPELINE STAGES
   Location: MerkaiTrial.Admin.Web/Pages/Settings/Pipeline/Index.cshtml

   COMPLETE FILE — replaces the existing one.

   _StageEditForm.cshtml is no longer used. Leaving it in the project does
   no harm (it still compiles), but you can delete it.

   THE STYLES AND THE SCRIPT LIVE IN THIS FILE ON PURPOSE. Both are about
   one page and nothing else, and a shared stylesheet that only one page
   reads is a file someone eventually "cleans up". The script touches no
   Bootstrap JavaScript API — the dropdowns and the modal are wired with
   data-bs attributes, which Bootstrap picks up itself whenever it loads,
   so nothing here depends on script order.
   ===================================================================== *@

<style>
    .lf-stage-wrap { max-width: 1080px; }

    .lf-stage { border-bottom: 1px solid var(--bs-border-color, #dee2e6); }
    .lf-stage:last-child { border-bottom: 0; }
    .lf-stage-retired .lf-stage-main { opacity: .62; }

    .lf-stage-main {
        display: grid;
        grid-template-columns: 30px 14px minmax(0, 1fr) 128px 76px 104px 40px;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
    }

    .lf-stage.lf-dragging { opacity: .4; }
    .lf-stage.lf-over     { border-top: 2px solid var(--bs-primary, #6366F1); }

    /* Reorder: the handle is the JavaScript path, the arrows are the
       fallback. Exactly one of the two is ever visible. */
    .lf-handle-col { display: flex; align-items: center; justify-content: center; }
    .lf-drag { display: none; background: none; border: 0; padding: 0; color: #9aa3b2; cursor: grab; line-height: 1; }
    .lf-drag:focus-visible { outline: 2px solid var(--bs-primary, #6366F1); outline-offset: 2px; border-radius: 3px; }
    .lf-drag:active { cursor: grabbing; }
    .lf-arrows { display: flex; flex-direction: column; line-height: 1; }
    .has-js .lf-drag   { display: block; }
    .has-js .lf-arrows { display: none; }

    .lf-dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }

    .lf-stage-body  { min-width: 0; }
    .lf-stage-name  { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .lf-stage-name .badge { font-weight: 500; }
    .lf-stage-desc  { font-size: 12.5px; color: #6c757d; margin-top: 2px;
                      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .lf-prob { display: flex; align-items: center; gap: 8px; }
    .lf-bar  { flex: 1; height: 6px; border-radius: 3px; background: #eceff3; overflow: hidden; }
    .lf-bar span { display: block; height: 100%; border-radius: 3px; }
    .lf-pct { font-size: 12px; color: #6c757d; width: 34px; text-align: right; }

    .lf-deals { font-size: 12.5px; }

    .lf-ways { font-size: 12px; color: #6c757d; text-decoration: none; white-space: nowrap; }
    .lf-ways:hover { text-decoration: underline; }
    .lf-ways-bad { color: #b42318; font-weight: 600; }

    /* A blocked action stays in the menu and says why. A button that
       quietly isn't there teaches nobody the rule it enforces. */
    .lf-stage-menu { min-width: 300px; }
    .lf-stage-menu form { margin: 0; }
    .lf-stage-menu .dropdown-item { white-space: normal; }
    .lf-blocked { display: block; opacity: 1; color: #adb5bd; cursor: default; }
    .lf-blocked > span  { display: block; }
    .lf-blocked > small { display: block; color: #b42318; font-size: 11.5px; margin-top: 2px; }

    .lf-stage-edit { padding: 4px 16px 18px 72px; background: #f8f9fb; }
    .lf-edit-grid  { display: grid; grid-template-columns: 76px minmax(0, 1fr) 150px; gap: 12px; }
    .lf-edit-form .form-label { font-size: 12px; margin-bottom: 4px; color: #6c757d; }

    .lf-add-row { padding: 12px 16px; }
    .lf-add-open { border: 1px dashed #c6ccd6; border-radius: 8px;
                   width: 100%; background: #fff; padding: 10px; color: #6c757d; }
    .lf-add-open:hover { border-color: var(--bs-primary, #6366F1); color: var(--bs-primary, #6366F1); }

    @@media (max-width: 900px) {
        .lf-stage-main { grid-template-columns: 30px 14px minmax(0, 1fr) 40px; }
        .lf-prob, .lf-deals, .lf-ways { display: none; }
        .lf-stage-edit { padding-left: 16px; }
        .lf-edit-grid  { grid-template-columns: 76px minmax(0, 1fr); }

        /* HTML5 drag-and-drop never fires from touch input, so on a small
           screen the handle is a control that does nothing. Put the
           arrows back — they are a form post and work everywhere. */
        .has-js .lf-drag   { display: none; }
        .has-js .lf-arrows { display: flex; }
    }
</style>

<div class="lf-stage-wrap">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="lf-page-title mb-1">Pipeline Stages</h1>
            <p class="text-muted mb-0" style="font-size:13.5px;">
                The steps a deal moves through. Name them the way your business
                actually works.
            </p>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="/Settings/PipelineRules">
            <i class="bi bi-diagram-3 me-1"></i>Sales process
        </a>
    </div>

    @* A forecast that runs backwards is wrong in a way nothing else on
       this page would ever mention. *@
    @if (warnings.Count > 0)
    {
        <div class="alert alert-warning d-flex gap-2 align-items-start">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div>
                <strong>Your likelihood ramp runs backwards.</strong>
                <div class="small mt-1">
                    @foreach (var w in warnings)
                    {
                        <div>@w</div>
                    }
                    <div class="mt-1 text-muted">
                        Weighted forecasting multiplies each deal's value by its stage
                        likelihood, so a deal moving forward and becoming less likely
                        makes your pipeline total drop for no reason.
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── WORKING STAGES ─────────────────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-kanban me-2"></i>Working stages</span>
            <span class="badge bg-secondary">@working.Count</span>
        </div>

        <div id="lf-working">
            @foreach (var s in working)
            {
                <partial name="_StageRow" model="Model.Row(s, draggable: true)" />
            }
        </div>

        @if (working.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                No working stages yet. Add the first step of your sales process below.
            </div>
        }

        @if (Model.CanUpdate)
        {
            <div class="lf-add-row border-top">
                <button type="button" class="lf-add-open" id="lf-add-open">
                    <i class="bi bi-plus-lg me-1"></i>Add a stage
                </button>

                <div id="lf-add-form" style="@(Model.AddOpen ? "" : "display:none")">
                    <form method="post" asp-page-handler="Create">
                        <div class="lf-edit-grid">
                            <div>
                                <label class="form-label">Colour</label>
                                <input type="color" name="Input.Color" value="#0EA5E9"
                                       class="form-control form-control-color" />
                            </div>
                            <div>
                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                <input type="text" name="Input.Name" class="form-control"
                                       placeholder="e.g. Site Visit" maxlength="100" required />
                            </div>
                            <div>
                                <label class="form-label">Likelihood</label>
                                <div class="input-group">
                                    <input type="number" name="Input.Probability" class="form-control"
                                           min="0" max="100" value="@Model.SuggestedProbability()" required />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-2">
                            <label class="form-label">
                                What has to be true for a deal to be here
                                <span class="text-muted fw-normal">— optional</span>
                            </label>
                            <input type="text" name="Input.Description" class="form-control"
                                   maxlength="500" placeholder="e.g. Site visited and measurements taken" />
                        </div>

                        <div class="mt-3">
                            <label class="form-label">Type</label>
                            <select name="Input.Category" class="form-select">
                                <option value="@((int)StageCategory.Open)">Working — deal still in play</option>
                                <option value="@((int)StageCategory.Won)">Won — counts as revenue</option>
                                <option value="@((int)StageCategory.Lost)">Lost — deal is over</option>
                            </select>
                            <div class="form-text">
                                This is what your reports read, so it can't be changed later.
                                A new stage is wired into your sales process automatically —
                                you can tidy the steps up afterwards.
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="lf-add-cancel">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus-lg me-1"></i>Add stage
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    @* ── CLOSING STAGES ─────────────────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-flag-fill me-2"></i>Closing stages
        </div>

        <div id="lf-closing">
            @foreach (var s in closing)
            {
                <partial name="_StageRow" model="Model.Row(s, draggable: false)" />
            }
        </div>

        <div class="card-footer small text-muted">
            Won and Lost stages drive your reports and forecasting, so they can be
            renamed and recoloured but never reordered into the middle of your
            pipeline.
        </div>
    </div>

    @* ── RETIRED ────────────────────────────────────────────────────── *@
    @if (retired.Count > 0)
    {
        <details class="card mb-4">
            <summary class="card-header" style="cursor:pointer; list-style:revert;">
                <i class="bi bi-archive me-2"></i>Retired stages
                <span class="badge bg-secondary ms-2">@retired.Count</span>
            </summary>

            <div>
                @foreach (var s in retired)
                {
                    <partial name="_StageRow" model="Model.Row(s, draggable: false)" />
                }
            </div>

            <div class="card-footer small text-muted">
                A retired stage stops being offered for new work but keeps every deal
                and every line of history that mentions it. Bring one back from its
                menu and the ways into it switch on again.
            </div>
        </details>
    }

    <div class="card">
        <div class="card-body small text-muted">
            <p class="mb-2">
                <strong>Renaming is safe.</strong> Deals stay where they are and past
                history keeps reading correctly — a stage's name and the identifier
                your deals are stored against are two different things.
            </p>
            <p class="mb-0">
                <strong>Retiring keeps the record; deleting does not.</strong> Once a
                deal has passed through a stage, that stage can only be retired —
                deleting it would leave those timeline entries pointing at a name
                that no longer resolves.
            </p>
        </div>
    </div>
</div>

@* ── MOVE DEALS ─────────────────────────────────────────────────────
   The thing this page has been telling people to do for three rounds
   without giving them any way to do it. "Move them first" was advice
   with nothing behind it: the only route was opening each deal and
   pressing a transition button, one at a time.
── *@
@if (Model.CanUpdate && Model.AnyStageBlockedByDeals)
{
    <div class="modal fade" id="lf-move-modal" tabindex="-1" aria-hidden="true"
         aria-labelledby="lf-move-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="MoveDeals">
                    <input type="hidden" name="fromStageId" id="lf-move-from" />

                    <div class="modal-header">
                        <h5 class="modal-title" id="lf-move-title">Move deals</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <p>
                            <strong id="lf-move-count">0 deals</strong> are in
                            <strong id="lf-move-name">this stage</strong>. Where should they go?
                        </p>

                        <select name="toStageId" id="lf-move-to" class="form-select" required>
                            @foreach (var t in Model.MoveTargets)
                            {
                                <option value="@t.Id" data-cat="@((int)t.Category)">@t.Name</option>
                            }
                        </select>

                        <div class="form-text mt-2">
                            Only stages of the same kind are offered. Closing or reopening a
                            deal changes its close date and its value, so that has to happen
                            on the deal itself.
                        </div>

                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" value="true"
                                   name="thenRetire" id="lf-move-retire" checked />
                            <label class="form-check-label" for="lf-move-retire">
                                Retire <span id="lf-move-name2">this stage</span> once it's empty
                            </label>
                        </div>

                        <div class="alert alert-light border mt-3 mb-0 small text-muted">
                            Every deal gets a line on its own timeline saying it was moved
                            because the stage was reorganised, so nobody later reads this as
                            sales progress that never happened. Each deal's likelihood is set
                            to the destination stage's, which keeps your weighted forecast
                            honest.
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Move them</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* Dragging posts here. One request on drop, instead of one page load per
   position the way the arrows work. *@
<form method="post" asp-page-handler="Reorder" id="lf-reorder-form" style="display:none">
    <input type="hidden" name="order" id="lf-reorder-order" />
</form>

<script>
(function () {
    'use strict';

    // Swaps the arrows for the drag handle. Done in script rather than
    // with <noscript> so the fallback is what renders if this file ever
    // throws before this line.
    document.documentElement.classList.add('has-js');

    document.addEventListener('DOMContentLoaded', function () {

        // ── inline edit ───────────────────────────────────────────────
        function closeAllEdits() {
            document.querySelectorAll('.lf-stage-edit').forEach(function (el) {
                el.style.display = 'none';
            });
        }

        document.querySelectorAll('.lf-edit-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var panel = document.getElementById('lf-edit-' + btn.dataset.for);
                if (!panel) return;

                var open = panel.style.display !== 'none';
                closeAllEdits();
                if (open) return;

                panel.style.display = '';
                var name = panel.querySelector('input[name="Input.Name"]');
                if (name) { name.focus(); name.select(); }
            });
        });

        // Cancel is an <a> back to the page so it works without script;
        // with script there is nothing to reload, so just close it.
        document.querySelectorAll('.lf-edit-cancel').forEach(function (a) {
            a.addEventListener('click', function (e) {
                e.preventDefault();
                closeAllEdits();
            });
        });

        // ── add a stage ───────────────────────────────────────────────
        var addOpen = document.getElementById('lf-add-open');
        var addForm = document.getElementById('lf-add-form');

        if (addOpen && addForm) {
            if (addForm.style.display !== 'none') addOpen.style.display = 'none';

            addOpen.addEventListener('click', function () {
                addForm.style.display = '';
                addOpen.style.display = 'none';
                var name = addForm.querySelector('input[name="Input.Name"]');
                if (name) name.focus();
            });

            var addCancel = document.getElementById('lf-add-cancel');
            if (addCancel) {
                addCancel.addEventListener('click', function () {
                    addForm.style.display = 'none';
                    addOpen.style.display = '';
                });
            }
        }

        // ── move deals ────────────────────────────────────────────────
        var moveModal = document.getElementById('lf-move-modal');

        document.querySelectorAll('.lf-move-open').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (!moveModal) return;

                var id    = btn.dataset.id;
                var name  = btn.dataset.name;
                var deals = parseInt(btn.dataset.deals || '0', 10);
                var cat   = btn.dataset.cat;

                document.getElementById('lf-move-from').value = id;
                document.getElementById('lf-move-name').textContent  = name;
                document.getElementById('lf-move-name2').textContent = '"' + name + '"';
                document.getElementById('lf-move-count').textContent =
                    deals === 1 ? '1 deal' : deals + ' deals';

                // Same category only, and never back into itself. Doing
                // this here rather than rendering a select per stage keeps
                // one modal on the page instead of twenty.
                var select = document.getElementById('lf-move-to');
                var usable = 0;

                Array.prototype.forEach.call(select.options, function (opt) {
                    var ok = opt.dataset.cat === cat && opt.value !== id;
                    opt.hidden = !ok;
                    opt.disabled = !ok;
                    if (ok && usable === 0) { opt.selected = true; usable++; }
                    else if (ok) { usable++; }
                });

                var submit = moveModal.querySelector('button[type="submit"]');
                if (submit) submit.disabled = usable === 0;

                // Bootstrap is wired through data-bs attributes everywhere
                // else on this page; here the button has to populate the
                // modal first, so it opens it by hand — guarded, because
                // this script does not depend on Bootstrap having loaded.
                if (window.bootstrap && window.bootstrap.Modal) {
                    window.bootstrap.Modal.getOrCreateInstance(moveModal).show();
                }
            });
        });

        // ── drag to reorder ───────────────────────────────────────────
        var list = document.getElementById('lf-working');
        if (!list) return;

        var rows = Array.prototype.slice.call(list.querySelectorAll('.lf-stage'));
        if (rows.length < 2) return;

        var dragging = null;
        var dropped = false;
        var orderBefore = [];

        function currentOrder() {
            return Array.prototype.map.call(
                list.querySelectorAll('.lf-stage'),
                function (el) { return el.dataset.id; });
        }

        // The dragover handler moves rows in the live DOM so the gap
        // follows the pointer. That means a cancelled drag — Escape, or
        // releasing outside the list — leaves the list reordered with no
        // browser-level undo. So remember where everything started and
        // put it back unless a real drop happened.
        function restoreOrder() {
            orderBefore.forEach(function (id) {
                var el = list.querySelector('.lf-stage[data-id="' + id + '"]');
                if (el) list.appendChild(el);
            });
        }

        function saveOrder() {
            var ids = Array.prototype.map.call(
                list.querySelectorAll('.lf-stage'),
                function (el) { return el.dataset.id; }
            ).join(',');

            document.getElementById('lf-reorder-order').value = ids;
            document.getElementById('lf-reorder-form').submit();
        }

        function rowBelow(y) {
            var others = Array.prototype.slice.call(
                list.querySelectorAll('.lf-stage:not(.lf-dragging)'));

            var closest = null;
            var closestOffset = Number.NEGATIVE_INFINITY;

            others.forEach(function (el) {
                var box = el.getBoundingClientRect();
                var offset = y - box.top - box.height / 2;
                if (offset < 0 && offset > closestOffset) {
                    closestOffset = offset;
                    closest = el;
                }
            });

            return closest;
        }

        rows.forEach(function (row) {
            var handle = row.querySelector('.lf-drag');
            if (!handle) return;

            // draggable is switched on only while the pointer is on the
            // handle. Marking the whole row draggable makes text inside
            // it unselectable and starts a drag from the edit form's
            // inputs.
            handle.addEventListener('mousedown', function () { row.draggable = true; });
            handle.addEventListener('touchstart', function () { row.draggable = true; }, { passive: true });
            document.addEventListener('mouseup', function () { row.draggable = false; });

            row.addEventListener('dragstart', function (e) {
                dragging = row;
                dropped = false;
                orderBefore = currentOrder();
                row.classList.add('lf-dragging');
                e.dataTransfer.effectAllowed = 'move';
                // Firefox refuses to start a drag without payload.
                e.dataTransfer.setData('text/plain', row.dataset.id);
            });

            row.addEventListener('dragend', function () {
                row.classList.remove('lf-dragging');
                row.draggable = false;
                list.querySelectorAll('.lf-over').forEach(function (el) {
                    el.classList.remove('lf-over');
                });

                dragging = null;

                if (dropped) saveOrder();
                else restoreOrder();     // Escape, or released off the list
            });

            // Keyboard equivalent, because a drag handle nobody can reach
            // with a keyboard is an accessibility regression dressed up
            // as an improvement.
            handle.addEventListener('keydown', function (e) {
                if (!e.altKey) return;

                if (e.key === 'ArrowUp' && row.previousElementSibling) {
                    e.preventDefault();
                    list.insertBefore(row, row.previousElementSibling);
                    saveOrder();
                } else if (e.key === 'ArrowDown' && row.nextElementSibling) {
                    e.preventDefault();
                    list.insertBefore(row.nextElementSibling, row);
                    saveOrder();
                }
            });
        });

        list.addEventListener('dragover', function (e) {
            if (!dragging) return;
            e.preventDefault();

            list.querySelectorAll('.lf-over').forEach(function (el) {
                el.classList.remove('lf-over');
            });

            var after = rowBelow(e.clientY);
            if (after) {
                after.classList.add('lf-over');
                list.insertBefore(dragging, after);
            } else {
                list.appendChild(dragging);
            }
        });

        // Only a real drop inside the list counts as "keep this order".
        list.addEventListener('drop', function (e) {
            e.preventDefault();
            dropped = true;
        });
    });
})();
</script>
