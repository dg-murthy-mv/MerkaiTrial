@page "/Settings/Pipeline"
@using MerkaiTrial.Domain.Entities
@model MerkaiTrial.Admin.Web.Pages.Settings.Pipeline.IndexModel
@{
    ViewData["Title"] = "Pipeline Stages";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="lf-page-title mb-1">Pipeline Stages</h1>
        <p class="text-muted mb-0" style="font-size:13.5px;">
            The steps a deal moves through. Name them the way your business
            actually works.
        </p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">

        <!-- Open stages -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-kanban me-2"></i>Working stages</span>
                <span class="badge bg-secondary">@Model.OpenStages.Count</span>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var s in Model.OpenStages.OrderBy(x => x.SortOrder))
                {
                    @if (Model.IsEditing(s))
                    {
                        <div class="list-group-item bg-light">
                            <partial name="_StageEditForm" model="Model" />
                        </div>
                    }
                    else
                    {
                        <div class="list-group-item @(s.IsActive ? "" : "opacity-50")">
                            <div class="d-flex align-items-center gap-3">

                                @if (Model.CanUpdate)
                                {
                                    <div class="btn-group-vertical btn-group-sm">
                                        <form method="post" asp-page-handler="Move">
                                            <input type="hidden" name="stageId" value="@s.Id" />
                                            <input type="hidden" name="direction" value="up" />
                                            <button class="btn btn-sm btn-link p-0 text-muted"
                                                    disabled="@Model.IsFirst(s)" title="Move up">
                                                <i class="bi bi-chevron-up"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Move">
                                            <input type="hidden" name="stageId" value="@s.Id" />
                                            <input type="hidden" name="direction" value="down" />
                                            <button class="btn btn-sm btn-link p-0 text-muted"
                                                    disabled="@Model.IsLast(s)" title="Move down">
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                        </form>
                                    </div>
                                }

                                <div class="flex-grow-1">
                                    <div class="fw-semibold">
                                        @s.Name
                                        @if (s.IsDefault)
                                        {
                                            <span class="badge bg-primary ms-2" title="New deals start here">
                                                <i class="bi bi-flag me-1"></i>Starts here
                                            </span>
                                        }
                                        @if (!s.IsActive)
                                        {
                                            <span class="badge bg-light text-dark border ms-2">Retired</span>
                                        }
                                    </div>
                                    <div class="small text-muted">
                                        @s.Probability% likely to close
                                        @if (s.DealCount > 0)
                                        {
                                            <span class="mx-2">·</span>
                                            <span>@s.DealCount deal@(s.DealCount == 1 ? "" : "s") here now</span>
                                        }
                                    </div>
                                </div>

                                @if (Model.CanUpdate)
                                {
                                    <div class="btn-group btn-group-sm">
                                        @if (!s.IsDefault && s.IsActive)
                                        {
                                            <form method="post" asp-page-handler="SetDefault">
                                                <input type="hidden" name="stageId" value="@s.Id" />
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        title="New deals should start here">
                                                    <i class="bi bi-flag"></i>
                                                </button>
                                            </form>
                                        }
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-page="./Index" asp-route-EditId="@s.Id">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (Model.CanDelete && s.DealCount == 0 && !s.IsDefault)
                                        {
                                            <form method="post" asp-page-handler="Delete"
                                                  onsubmit="return confirm('Remove this stage?');">
                                                <input type="hidden" name="stageId" value="@s.Id" />
                                                <button class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Closing stages -->
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-flag-fill me-2"></i>Closing stages
            </div>
            <div class="list-group list-group-flush">
                @foreach (var s in Model.ClosingStages.OrderBy(x => x.SortOrder))
                {
                    @if (Model.IsEditing(s))
                    {
                        <div class="list-group-item bg-light">
                            <partial name="_StageEditForm" model="Model" />
                        </div>
                    }
                    else
                    {
                        <div class="list-group-item @(s.IsActive ? "" : "opacity-50")">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge @Model.CategoryBadge(s.Category)">
                                    @Model.CategoryLabel(s.Category)
                                </span>

                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@s.Name</div>
                                    <div class="small text-muted">
                                        @s.Probability% likely to close
                                        @if (s.DealCount > 0)
                                        {
                                            <span class="mx-2">·</span>
                                            <span>@s.DealCount deal@(s.DealCount == 1 ? "" : "s")</span>
                                        }
                                    </div>
                                </div>

                                @if (Model.CanUpdate)
                                {
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-page="./Index" asp-route-EditId="@s.Id">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="card-footer small text-muted">
                Won and Lost stages drive your reports and forecasting, so they
                can be renamed but not removed.
            </div>
        </div>
    </div>

    <!-- Add -->
    <div class="col-lg-4">
        @if (Model.CanUpdate && !Model.EditId.HasValue)
        {
            <div class="card">
                <div class="card-header"><i class="bi bi-plus-circle me-2"></i>Add a stage</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Name" class="form-label">
                                Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.Name" class="form-control"
                                   placeholder="e.g. Site Visit" required />
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Probability" class="form-label">
                                Likelihood of closing
                            </label>
                            <div class="input-group">
                                <input asp-for="Input.Probability" type="number"
                                       class="form-control" min="0" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Input.Probability" class="text-danger"></span>
                            <div class="form-text">Used for weighted pipeline forecasting.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Category" class="form-label">Type</label>
                            <select asp-for="Input.Category" class="form-select">
                                <option value="@((int)StageCategory.Open)">Working — deal still in play</option>
                                <option value="@((int)StageCategory.Won)">Won — counts as revenue</option>
                                <option value="@((int)StageCategory.Lost)">Lost — deal is over</option>
                            </select>
                            <div class="form-text">
                                This is what your reports use, so it can't be changed later.
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-plus-lg me-1"></i>Add stage
                        </button>
                    </form>
                </div>
            </div>
        }

        <div class="card mt-3">
            <div class="card-body small text-muted">
                <p class="mb-2"><strong>Renaming is safe.</strong> Deals stay where
                they are and past history keeps reading correctly.</p>
                <p class="mb-0"><strong>Retiring keeps the record.</strong> A stage
                with deals in it can't be removed — move them first, or retire it so
                it stops being offered for new work.</p>
            </div>
        </div>
    </div>
</div>
