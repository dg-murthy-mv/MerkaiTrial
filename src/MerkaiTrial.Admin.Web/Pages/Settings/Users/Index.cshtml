@page "/Settings/Users"
@model MerkaiTrial.Admin.Web.Pages.Settings.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    var atLimit = AuthorizedPageModel.IsAtLimit(Model.Stats.TotalUsers, Model.MaxUsers);
    var state = Model.StateRoute();   // 096 — every action form carries it, so you land back here
}

@*
    FILE: MerkaiTrial.Admin.Web/Pages/Settings/Users/Index.cshtml

    Alerts are rendered globally by _Layout — not repeated here.

    086: "Reset password" emails a colleague a new reset link (the link is
    never shown here — see the page model). "Invite" now emails the invite
    as well as showing the link once.

    096: the shared _ListToolbar and _Pager (the old _Pagination partial is
    no longer used here). Every action form carries the search, page and
    size. Confirm texts are data-confirm attributes read by one listener —
    a name with an apostrophe used to break the inline confirm('…') and
    post without asking. "Last signed in" is in the workspace's own date
    format. A failed load is shown here, now.

    096b — the user id (and isActive) are hidden fields, NOT asp-route-…:
    on a form that also has asp-all-route-data, ASP.NET sets the asp-route
    value first and then REPLACES the whole route list with the state, so
    the id was silently dropped and Invite / Reset / Deactivate acted on an
    empty id. Caught by the first full test run (on Tasks → Reassign).
*@

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="lf-page-title mb-1">Users</h1>
        <p class="text-muted mb-0" style="font-size:13.5px;">
            Add colleagues to your workspace and control what they can do.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge @Model.PlanBadgeClass fs-6 px-3 py-2">@Model.PlanDisplayName</span>

        @if (Model.CanCreate && !atLimit)
        {
            <a asp-page="./Create" class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i> Add person
            </a>
        }
        else if (atLimit)
        {
            <button class="btn btn-outline-secondary" disabled
                    title="User limit reached. @Model.UpgradePrompt">
                <i class="bi bi-lock me-1"></i> User limit reached
            </button>
        }
    </div>
</div>

@* An invite link, shown once after a resend. The raw token exists only in
   this response — only its hash is stored — so it has to be copied now. *@
@if (!string.IsNullOrEmpty(Model.InviteUrl))
{
    <div class="card border-success mb-4">
        <div class="card-header bg-success text-white">
            <i class="bi bi-link-45deg"></i> New invite link for @Model.InviteForEmail
        </div>
        <div class="card-body">
            <p class="mb-2" style="font-size:13.5px;">
                @if (Model.InviteEmailed)
                {
                    <text>We've emailed it to them. Here it is as well, in case the email doesn't arrive.</text>
                }
                else
                {
                    <text>It could not be emailed — send this to them yourself.</text>
                }
                It works once and expires in 72 hours.
            </p>
            <div class="input-group mb-2">
                <input type="text" id="inviteUrl" class="form-control font-monospace"
                       value="@Model.InviteUrl" readonly onclick="this.select();" />
                <button class="btn btn-primary" type="button" onclick="copyInvite()">
                    <i class="bi bi-clipboard"></i> Copy
                </button>
            </div>
            <div id="copyConfirm" class="text-success small" style="display:none;">
                <i class="bi bi-check-circle"></i> Copied.
            </div>
            <div class="text-muted small mt-2">
                Shown once and not stored. Any previous link they were sent still works until it expires.
            </div>
        </div>
    </div>
}

<!-- Quota -->
<div class="card mb-4">
    <div class="card-body py-2">
        <div class="row align-items-center g-2">
            <div class="col-auto">
                <small class="text-muted fw-semibold text-uppercase" style="font-size:10px;letter-spacing:.06em;">
                    People
                </small>
            </div>
            <div class="col">
                @{
                    var pct = AuthorizedPageModel.QuotaPercent(Model.Stats.TotalUsers, Model.MaxUsers);
                    var barClass = AuthorizedPageModel.QuotaBarClass(Model.Stats.TotalUsers, Model.MaxUsers);
                }
                <div class="progress" style="height:8px;">
                    <div class="progress-bar @barClass" role="progressbar" style="width:@pct%"
                         aria-valuenow="@Model.Stats.TotalUsers" aria-valuemin="0"
                         aria-valuemax="@Model.MaxUsers"></div>
                </div>
            </div>
            <div class="col-auto">
                <small class="@(pct >= 90 ? "text-danger fw-bold" : "text-muted")">
                    @Model.Stats.TotalUsers / @Model.MaxUsers used
                </small>
            </div>
            @if (!string.IsNullOrEmpty(Model.UpgradePrompt))
            {
                <div class="col-auto">
                    <a href="/pricing" class="btn btn-sm btn-outline-primary py-0">
                        <i class="bi bi-arrow-up-circle me-1"></i>@Model.UpgradePrompt
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.PageError))
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <span>@Model.PageError</span>
    </div>
}

@* 096 — the shared search strip and count. *@
<partial name="_ListToolbar" model="Model.Toolbar" />

<!-- List -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-people me-2"></i>People
            <span class="badge bg-primary ms-1">@Model.Users.TotalCount</span>
        </span>
        @if (Model.Users.TotalPages > 1)
        {
            <span class="text-muted" style="font-size:12px;">Page @Model.PageNumber of @Model.Users.TotalPages</span>
        }
    </div>

    @if (!Model.Users.Items.Any())
    {
        <div class="card-body text-center py-5 text-muted">
            @if (!string.IsNullOrEmpty(Model.PageError))
            {
                <i class="bi bi-cloud-slash" style="font-size:2rem;opacity:.4;"></i>
                <p class="mt-3 mb-2">The list could not be loaded.</p>
                <a asp-page="./Index" asp-all-route-data="state" class="btn btn-sm btn-outline-secondary">Try again</a>
            }
            else if (Model.IsFiltered)
            {
                <i class="bi bi-people" style="font-size:2rem;opacity:.4;"></i>
                <p class="mt-3 mb-2">No one matches that search.</p>
                <a asp-page="./Index" asp-route-PageSize="@Model.PageSize" class="btn btn-sm btn-outline-secondary">Clear the search</a>
            }
            else
            {
                <i class="bi bi-people" style="font-size:2rem;opacity:.4;"></i>
                <p class="mt-3 mb-0">No one here yet.</p>
            }
        </div>
    }
    else
    {
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Person</th>
                        <th>Role</th>
                        <th>Last signed in</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users.Items)
                    {
                        var isSelf = user.Id == Model.CurrentUserId;
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    @user.FullName
                                    @if (isSelf)
                                    {
                                        <span class="text-muted fw-normal">(you)</span>
                                    }
                                </div>
                                <small class="text-muted">@user.Email</small>
                            </td>
                            <td>
                                @if (user.IsTenantAdmin)
                                {
                                    <span class="badge bg-warning text-dark">Administrator</span>
                                }
                                else if (user.Roles.Any())
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-secondary me-1">@role</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">No role — cannot see anything</span>
                                }
                            </td>
                            <td>
                                @if (user.LastLoginUtc.HasValue)
                                {
                                    @* 096 — the workspace's date format and timezone, not the UTC date. *@
                                    <small class="text-muted">@Model.FormatDate(user.LastLoginUtc.Value)</small>
                                }
                                else
                                {
                                    @* No login yet almost always means the invite was
                                       never used — which is why Resend sits right here. *@
                                    <small class="text-warning">Not yet — invite pending</small>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Deactivated</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (Model.CanUpdate)
                                {
                                    @if (!user.LastLoginUtc.HasValue && user.IsActive)
                                    {
                                        <form method="post" asp-page-handler="ResendInvite" asp-all-route-data="state" class="d-inline">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary"
                                                    title="Email them a new invite link">
                                                <i class="bi bi-envelope"></i> Invite
                                            </button>
                                        </form>
                                    }

                                    @* 086 — email a reset link. Not on yourself. *@
                                    @if (user.LastLoginUtc.HasValue && user.IsActive && !isSelf)
                                    {
                                        <form method="post" asp-page-handler="SendReset" asp-all-route-data="state" class="d-inline"
                                              data-confirm="Email @user.FullName a link to choose a new password? Their current password keeps working until they use it.">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                    title="Email them a link to choose a new password">
                                                <i class="bi bi-key"></i> Reset password
                                            </button>
                                        </form>
                                    }

                                    @* No action on yourself: deactivating your own
                                       account signs you out of a workspace you may be
                                       the only administrator of. *@
                                    @if (!isSelf)
                                    {
                                        @* 096 — data-confirm, not confirm('…') inside onsubmit:
                                           an apostrophe in the name broke the script, and the
                                           form then posted without asking. *@
                                        <form method="post" asp-page-handler="ToggleStatus"
                                              asp-all-route-data="state"
                                              class="d-inline"
                                              data-confirm="@(user.IsActive ? $"Deactivate {user.FullName}? They will not be able to sign in. Their leads and deals are kept." : $"Reactivate {user.FullName}?")">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                                            <button type="submit"
                                                    class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                    title="@(user.IsActive ? "Deactivate" : "Reactivate")">
                                                <i class="bi @(user.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                                @(user.IsActive ? "Deactivate" : "Reactivate")
                                            </button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile -->
        <div class="d-md-none">
            @foreach (var user in Model.Users.Items)
            {
                var isSelf = user.Id == Model.CurrentUserId;
                <div class="border-bottom p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="fw-semibold">
                                @user.FullName
                                @if (isSelf)
                                {
                                    <span class="text-muted fw-normal">(you)</span>
                                }
                            </div>
                            <small class="text-muted">@user.Email</small>
                        </div>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Deactivated</span>
                        }
                    </div>

                    <div class="mb-2">
                        @if (user.IsTenantAdmin)
                        {
                            <span class="badge bg-warning text-dark">Administrator</span>
                        }
                        else if (user.Roles.Any())
                        {
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-secondary me-1">@role</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No role assigned</span>
                        }
                    </div>

                    @if (!user.LastLoginUtc.HasValue)
                    {
                        <div class="small text-warning mb-2">Invite not yet used</div>
                    }

                    @if (Model.CanUpdate && !isSelf)
                    {
                        <div class="d-flex gap-2">
                            @if (!user.LastLoginUtc.HasValue && user.IsActive)
                            {
                                <form method="post" asp-page-handler="ResendInvite" asp-all-route-data="state" class="flex-fill">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                                        <i class="bi bi-envelope me-1"></i>Invite
                                    </button>
                                </form>
                            }
                            @if (user.LastLoginUtc.HasValue && user.IsActive)
                            {
                                <form method="post" asp-page-handler="SendReset" asp-all-route-data="state" class="flex-fill"
                                      data-confirm="Email @user.FullName a link to choose a new password?">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                                        <i class="bi bi-key me-1"></i>Reset
                                    </button>
                                </form>
                            }
                            <form method="post" asp-page-handler="ToggleStatus"
                                  asp-all-route-data="state"
                                  class="flex-fill"
                                  data-confirm="@(user.IsActive ? $"Deactivate {user.FullName}?" : $"Reactivate {user.FullName}?")">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                                <button type="submit"
                                        class="btn btn-sm w-100 @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(user.IsActive ? "Deactivate" : "Reactivate")
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* 096 — the shared pager (was the old _Pagination partial). *@
    <partial name="_Pager" model="Model.Pager" />
</div>

@section Scripts {
    <script>
        // 096 — one listener for every confirm on the page. The text lives in
        // data-confirm, encoded by Razor and read back as plain text, so a
        // name like O'Brien is just a name. The old inline confirm('…') broke
        // on it — and a throwing onsubmit lets the form post without asking.
        document.addEventListener('submit', function (e) {
            var form = e.target;
            if (!form || !form.getAttribute) return;
            var text = form.getAttribute('data-confirm');
            if (text && !window.confirm(text)) e.preventDefault();
        });

        function copyInvite() {
            const el = document.getElementById('inviteUrl');
            el.select();
            navigator.clipboard.writeText(el.value).then(() => {
                document.getElementById('copyConfirm').style.display = 'block';
            });
        }
    </script>
}
