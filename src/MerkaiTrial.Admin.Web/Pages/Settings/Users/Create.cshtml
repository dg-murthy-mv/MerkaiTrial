@page "/Settings/Users/Create"
@model MerkaiTrial.Admin.Web.Pages.Settings.Users.CreateModel
@{
    ViewData["Title"] = "Add person";
    var userCreated = !string.IsNullOrEmpty(Model.InviteUrl) || Model.InviteFailed;
}

@*
    FILE: MerkaiTrial.Admin.Web/Pages/Settings/Users/Create.cshtml

    Alerts are rendered globally by _Layout — not repeated here.
*@

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="lf-page-title mb-1">Add a person</h1>
        <p class="text-muted mb-0" style="font-size:13.5px;">
            They'll get a link to set their own password.
        </p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to users
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
    </div>
}

@* ── SUCCESS ──────────────────────────────────────────────────────────
   The raw token exists only in this response — only its hash is stored —
   so it has to be copied now. There is a Resend on the list page if it
   is lost, but saying so here would encourage closing this too early. *@
@if (!string.IsNullOrEmpty(Model.InviteUrl))
{
    <div class="card border-success mb-4">
        <div class="card-header bg-success text-white">
            <i class="bi bi-check-circle me-1"></i>
            @Model.CreatedUserName added — send them this link
        </div>
        <div class="card-body">
            <p class="mb-2" style="font-size:13.5px;">
                <strong>@Model.CreatedUserEmail</strong> has no password yet.
                This link lets them set one. It works once and expires in 72 hours.
            </p>

            <div class="input-group mb-2">
                <input type="text" id="inviteUrl" class="form-control font-monospace"
                       value="@Model.InviteUrl" readonly onclick="this.select();" />
                <button class="btn btn-primary" type="button" onclick="copyInvite()">
                    <i class="bi bi-clipboard"></i> Copy
                </button>
            </div>
            <div id="copyConfirm" class="text-success small mb-3" style="display:none;">
                <i class="bi bi-check-circle"></i> Copied.
            </div>

            <div class="d-flex gap-2">
                <a asp-page="./Index" class="btn btn-primary">Done</a>
                <a asp-page="./Create" class="btn btn-outline-secondary">Add another</a>
            </div>
        </div>
    </div>
}
else if (Model.InviteFailed)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>@Model.CreatedUserName was added, but the invite link could not be generated.</strong>
        The account exists and is correct — use <em>Invite</em> on the users list to try again.
        <div class="mt-3">
            <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">Back to users</a>
        </div>
    </div>
}

@* Told up front rather than after typing everything in. *@
@if (Model.AtLimit && !userCreated)
{
    <div class="alert alert-warning">
        <i class="bi bi-lock me-2"></i>
        <strong>You've used all @Model.MaxUsers places on your plan.</strong>
        Deactivate someone who has left, or @(Model.UpgradePrompt ?? "upgrade your plan") to add more.
        <div class="mt-3">
            <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">Back to users</a>
        </div>
    </div>
}

@if (!userCreated && !Model.AtLimit)
{
    <form method="post">
        <div class="row">
            <div class="col-lg-8">

                <div class="card mb-4">
                    <div class="card-header">
                        <i class="bi bi-person me-2"></i>Their details
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.FirstName" class="form-label">
                                    First name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.FirstName" class="form-control" autofocus />
                                <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.LastName" class="form-label">
                                    Last name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.LastName" class="form-control" />
                                <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Email" class="form-label">
                                    Email <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Email" type="email" class="form-control" />
                                @* Globally unique — UX_Users_Email_Live. One person,
                                   one workspace. *@
                                <div class="form-text">
                                    <small>They'll sign in with this. It can't already be in use.</small>
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Phone" class="form-label">Phone</label>
                                <input asp-for="Input.Phone" class="form-control" />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.JobTitle" class="form-label">Job title</label>
                                <input asp-for="Input.JobTitle" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Department" class="form-label">Department</label>
                                <input asp-for="Input.Department" class="form-control" />
                                @* Not decorative: GetSalesTeamHandler filters on
                                   Department == "Sales" for the sales team list. *@
                                <div class="form-text"><small>Use "Sales" to include them in sales reports.</small></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <i class="bi bi-shield-lock me-2"></i>What they can do
                    </div>
                    <div class="card-body">

                        <div class="form-check mb-3 pb-3 border-bottom">
                            <input asp-for="Input.IsTenantAdmin" class="form-check-input" />
                            <label asp-for="Input.IsTenantAdmin" class="form-check-label fw-semibold">
                                Make them an administrator
                            </label>
                            <div class="form-text">
                                Full access to everything here, including adding and removing people.
                                Only give this to someone who should manage the workspace.
                            </div>
                        </div>

                        <label class="form-label fw-semibold">Or give them a role</label>

                        @if (Model.AvailableRoles.Any())
                        {
                            <div class="row">
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <div class="col-md-6 mb-2">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input"
                                                   name="Input.RoleIds" value="@role.Id" />
                                            <label class="form-check-label">@role.DisplayName</label>
                                        </div>
                                    </div>
                                }
                            </div>
                            @* Worth stating: a user with neither the admin flag nor a
                               role can sign in and see nothing at all, which reads
                               like a broken account. *@
                            <div class="form-text mt-2">
                                Someone with no role and no administrator access will be able to
                                sign in but won't see anything.
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                You haven't created any roles yet.
                                <a asp-page="/Settings/Roles/Create">Create one</a>, or make this
                                person an administrator.
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-person-plus me-1"></i> Add person
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary w-100">Cancel</a>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <i class="bi bi-info-circle me-2"></i>What happens next
                    </div>
                    <div class="card-body small text-muted">
                        <ol class="mb-0 ps-3">
                            <li class="mb-2">You'll get a link to send them.</li>
                            <li class="mb-2">They open it and choose a password.</li>
                            <li class="mb-0">They sign in and see what their role allows.</li>
                        </ol>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <span>Places used</span>
                            <strong>@Model.CurrentUserCount / @Model.MaxUsers</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function copyInvite() {
            const el = document.getElementById('inviteUrl');
            el.select();
            navigator.clipboard.writeText(el.value).then(() => {
                document.getElementById('copyConfirm').style.display = 'block';
            });
        }
    </script>
}
