@* =====================================================================
   STATUS ROW
   Location: MerkaiTrial.Admin.Web/Pages/Settings/LeadStatuses/_StatusRow.cshtml

   NEW FILE (025). One leading underscore.

   One row of the status list, plus its inline edit form. Used by all
   three sections of the page — working, automatic, retired — which is
   the reason it is a partial at all.

   ALMOST EVERY ACTION IS A FORM POST. The JavaScript on the page makes
   it nicer — dragging, opening the edit form without a page load — but
   with scripting off the arrows appear, the edit form opens through
   ?EditId=, and Edit, Make-this-the-start, Retire, Restore and Delete all
   still work.

   THE ONE EXCEPTION IS "Move N leads somewhere else…", which opens a
   dialog and therefore needs script. Saying otherwise would be the more
   comfortable comment and the false one. If a no-script path is ever
   wanted it is a small page of its own rather than a modal, and the
   disabled Retire item next to it still explains the block either way.

   THE MENU RATHER THAN A ROW OF ICONS
     The old row showed a flag, a pencil and sometimes a bin, and the
     "sometimes" was the problem: a button that quietly isn't there
     teaches nobody the rule it is enforcing. A menu can hold a DISABLED
     item with the reason printed underneath it, which is how someone
     finds out that Working can't be retired because two leads are in it
     — and then finds the thing that fixes that, one item above.

   THE COUNT IS TotalLeadCount, NOT LeadCount
     LeadCount is scoped to what the current user can see, because it
     drives the Leads page tab counts. The retire and delete rules count
     every lead in the tenant. Showing the scoped number next to a
     refusal that used the unscoped one is how a page starts contradicting
     itself.
   ===================================================================== *@

@using MerkaiTrial.Domain.Entities
@using MerkaiTrial.Admin.Web.Pages.Settings.LeadStatuses
@model MerkaiTrial.Admin.Web.Pages.Settings.LeadStatuses.StatusRowVm

@{
    var s = Model.Status;
}

<div class="lf-status @(s.IsActive ? "" : "lf-status-retired")"
     data-id="@s.Id"
     data-name="@s.Name"
     data-leads="@s.TotalLeadCount"
     data-cat="@((int)s.Category)">

    <div class="lf-status-main">

        @* ── reorder ─────────────────────────────────────────────── *@
        <div class="lf-handle-col">
            @if (Model.Draggable)
            {
                <button type="button" class="lf-drag"
                        aria-label="Reorder @s.Name"
                        title="Drag to reorder — or focus this and hold Alt with the arrow keys">
                    <i class="bi bi-grip-vertical"></i>
                </button>

                <div class="lf-arrows">
                    <form method="post" asp-page-handler="Move">
                        <input type="hidden" name="statusId" value="@s.Id" />
                        <input type="hidden" name="direction" value="up" />
                        <button type="submit" class="btn btn-link btn-sm p-0 text-muted"
                                disabled="@Model.IsFirst" title="Move up">
                            <i class="bi bi-chevron-up"></i>
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Move">
                        <input type="hidden" name="statusId" value="@s.Id" />
                        <input type="hidden" name="direction" value="down" />
                        <button type="submit" class="btn btn-link btn-sm p-0 text-muted"
                                disabled="@Model.IsLast" title="Move down">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </form>
                </div>
            }
        </div>

        @* ── colour ──────────────────────────────────────────────── *@
        <span class="lf-dot" style="background:@s.Color"
              title="@s.Name is @s.Color on the leads list"></span>

        @* ── name, badges, description ───────────────────────────── *@
        <div class="lf-status-body">
            <div class="lf-status-name">
                <span class="fw-semibold">@s.Name</span>

                <span class="badge @(s.Category == LeadStatusCategory.Qualified ? "bg-success"
                                   : s.Category == LeadStatusCategory.Disqualified ? "bg-secondary"
                                   : s.Category == LeadStatusCategory.Converted ? "bg-warning text-dark"
                                   : "bg-primary")">
                    @(s.Category switch
                    {
                        LeadStatusCategory.Qualified => "Qualified",
                        LeadStatusCategory.Disqualified => "Not pursuing",
                        LeadStatusCategory.Converted => "Converted",
                        _ => "Open"
                    })
                </span>

                @if (s.IsDefault)
                {
                    <span class="badge bg-primary" title="New leads start here">
                        <i class="bi bi-flag me-1"></i>Starts here
                    </span>
                }
                @if (!s.IsActive)
                {
                    <span class="badge bg-light text-dark border">Retired</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(s.Description))
            {
                <div class="lf-status-desc">@s.Description</div>
            }
            else if (s.IsSystem)
            {
                <div class="lf-status-desc">Applied when a lead becomes a deal</div>
            }
        </div>

        @* ── score ───────────────────────────────────────────────── *@
        <div class="lf-score" title="Worth @s.Score of the 15 points a status can add to a lead's score">
            <div class="lf-bar"><span style="width:@(s.Score * 100 / 15)%; background:@s.Color"></span></div>
            <span class="lf-pts">@s.Score pt@(s.Score == 1 ? "" : "s")</span>
        </div>

        @* ── leads here ──────────────────────────────────────────── *@
        <div class="lf-leads @(s.TotalLeadCount == 0 ? "text-muted" : "")">
            @IndexModel.LeadsPhrase(s.TotalLeadCount)
        </div>

        @* ── actions ─────────────────────────────────────────────── *@
        @if (Model.CanUpdate)
        {
            <div class="dropdown lf-menu">
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        data-bs-toggle="dropdown" data-bs-auto-close="true"
                        aria-expanded="false" aria-label="Actions for @s.Name">
                    <i class="bi bi-three-dots"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end lf-status-menu">

                    @* Edit — always available. Renaming is always safe,
                       including for the system status. *@
                    <li>
                        <button type="button" class="dropdown-item lf-edit-toggle" data-for="@s.Id">
                            <i class="bi bi-pencil me-2"></i>Edit name, colour and score
                        </button>
                    </li>

                    @* Starting status — open, active, not already it. *@
                    @if (s.Category == LeadStatusCategory.Open && s.IsActive && !s.IsDefault && !s.IsSystem)
                    {
                        <li>
                            <form method="post" asp-page-handler="SetDefault">
                                <input type="hidden" name="statusId" value="@s.Id" />
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-flag me-2"></i>Make this where new leads start
                                </button>
                            </form>
                        </li>
                    }

                    @if (!s.IsSystem)
                    {
                        <li><hr class="dropdown-divider" /></li>

                        @* ── MOVE LEADS OUT ──────────────────────────
                           The item that makes the two disabled ones below
                           actionable instead of a dead end. Only offered
                           when leads are the ONLY thing in the way. *@
                        if (s.BlockedOnlyByLeads)
                        {
                            <li>
                                <button type="button" class="dropdown-item lf-move-open"
                                        data-id="@s.Id" data-name="@s.Name"
                                        data-leads="@s.TotalLeadCount" data-cat="@((int)s.Category)">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Move @IndexModel.LeadsPhrase(s.TotalLeadCount) somewhere else…
                                </button>
                            </li>
                        }

                        @* ── RETIRE / RESTORE ────────────────────────
                           Both go through the Update handler, because
                           retiring IS setting IsActive to false — a
                           separate endpoint would be a second place for
                           the "you can't retire your only qualified
                           status" rule to live.

                           No Input.Color on either form, deliberately:
                           LeadStatusDto.Color is the RESOLVED colour and
                           is never null, so posting it back would bake the
                           palette fallback into a status whose Color
                           column was legitimately empty, as a side effect
                           of pressing Retire. *@
                        if (!s.IsActive)
                        {
                            <li>
                                <form method="post" asp-page-handler="Update">
                                    <input type="hidden" name="Input.StatusId" value="@s.Id" />
                                    <input type="hidden" name="Input.Name" value="@s.Name" />
                                    <input type="hidden" name="Input.Score" value="@s.Score" />
                                    <input type="hidden" name="Input.Description" value="@s.Description" />
                                    <input type="hidden" name="Input.IsActive" value="true" />
                                    <button type="submit" class="dropdown-item text-success">
                                        <i class="bi bi-arrow-counterclockwise me-2"></i>Bring this status back
                                    </button>
                                </form>
                            </li>
                        }
                        else if (s.CanRetire)
                        {
                            <li>
                                @* The message goes in data-confirm rather
                                   than inline in the onsubmit string:
                                   Razor encodes an attribute value, so a
                                   status called "Client's Review" cannot
                                   break out of the JavaScript literal. *@
                                <form method="post" asp-page-handler="Update"
                                      data-confirm="Retire “@s.Name”? Leads already in it stay put and can still be moved on — it just stops being offered for new work."
                                      onsubmit="return confirm(this.dataset.confirm);">
                                    <input type="hidden" name="Input.StatusId" value="@s.Id" />
                                    <input type="hidden" name="Input.Name" value="@s.Name" />
                                    <input type="hidden" name="Input.Score" value="@s.Score" />
                                    <input type="hidden" name="Input.Description" value="@s.Description" />
                                    <input type="hidden" name="Input.IsActive" value="false" />
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-archive me-2"></i>Retire this status
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li>
                                <span class="dropdown-item disabled lf-blocked">
                                    <span><i class="bi bi-archive me-2"></i>Retire this status</span>
                                    <small>@s.RetireBlockedReason</small>
                                </span>
                            </li>
                        }

                        @* ── DELETE ──────────────────────────────────
                           Unlike a pipeline stage, a lead status CAN be
                           deleted once its leads have moved out. Deal
                           history stores the stage KEY, so deleting a
                           stage strands those rows; lead status history
                           lives in AuditLogs and stores the NAME, already
                           baked into the JSON. Nothing on a lead's
                           timeline breaks when the status goes. *@
                        if (Model.CanDelete)
                        {
                            if (s.CanDelete)
                            {
                                <li>
                                    <form method="post" asp-page-handler="Delete"
                                          data-confirm="Delete “@s.Name” for good? No lead is in it, so nothing is lost — and past timelines keep reading correctly, because they store the name. This cannot be undone."
                                          onsubmit="return confirm(this.dataset.confirm);">
                                        <input type="hidden" name="statusId" value="@s.Id" />
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-trash me-2"></i>Delete this status
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <span class="dropdown-item disabled lf-blocked">
                                        <span><i class="bi bi-trash me-2"></i>Delete this status</span>
                                        <small>@s.DeleteBlockedReason</small>
                                    </span>
                                </li>
                            }
                        }
                    }
                </ul>
            </div>
        }
    </div>

    @* ── inline edit ─────────────────────────────────────────────────
       Rendered for every row and hidden, so the menu can open it without
       a page load. Open server-side too, when ?EditId= names this status
       or a save bounced — which is the path that still works with
       scripting switched off.

       CATEGORY IS DELIBERATELY NOT EDITABLE. Moving a status from
       Qualified to Open would silently change what conversion allows, and
       every past report of qualified leads would mean something
       different. If a client needs a different category they add a status
       and move the leads, which is now a single action.
    ── *@
    <div class="lf-status-edit" id="lf-edit-@s.Id" style="@(Model.IsEditing ? "" : "display:none")">
        <form method="post" asp-page-handler="Update" class="lf-edit-form">
            <input type="hidden" name="Input.StatusId" value="@s.Id" />

            @* The system status can never be retired, so it posts its
               active state back unchanged and is never offered the
               choice. *@
            <input type="hidden" name="Input.IsActive" value="@(s.IsActive ? "true" : "false")" />

            <div class="lf-edit-grid">
                @* This one DOES post Input.Color, unlike the retire and
                   restore forms above — and that is the point. The picker
                   shows the resolved colour, the person looks at it and
                   presses Save, so writing it to the column is them
                   choosing it. Retiring shows no colour at all, which is
                   why posting one from there would be the app deciding on
                   their behalf. *@
                <div>
                    <label class="form-label">Colour</label>
                    <input type="color" name="Input.Color" value="@s.Color"
                           class="form-control form-control-color" title="Shown on the leads list" />
                </div>

                <div>
                    <label class="form-label">Name</label>
                    <input type="text" name="Input.Name" value="@s.Name"
                           class="form-control" maxlength="100" required />
                </div>

                <div>
                    <label class="form-label">Score points</label>
                    <div class="input-group">
                        <input type="number" name="Input.Score" value="@s.Score"
                               class="form-control" min="0" max="15" required />
                        <span class="input-group-text">/ 15</span>
                    </div>
                </div>
            </div>

            <div class="mt-2">
                <label class="form-label">
                    What has to be true for a lead to be here
                    <span class="text-muted fw-normal">— optional, shown to your team on the lead page</span>
                </label>
                <input type="text" name="Input.Description" value="@s.Description"
                       class="form-control" maxlength="500"
                       placeholder="e.g. Spoken to, budget confirmed" />
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <small class="text-muted">
                    @if (s.IsSystem)
                    {
                        <text>
                            Set automatically when a lead converts — it can be renamed
                            and recoloured, but not retired or chosen by hand.
                        </text>
                    }
                    else
                    {
                        <text>
                            Renaming is safe — leads stay where they are and past
                            timelines keep reading correctly.
                        </text>
                    }
                </small>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-secondary lf-edit-cancel"
                       data-for="@s.Id" asp-page="./Index">Cancel</a>
                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>
