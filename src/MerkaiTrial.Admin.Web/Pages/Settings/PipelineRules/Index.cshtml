@page
@model MerkaiTrial.Admin.Web.Pages.Settings.PipelineRules.IndexModel
@using MerkaiTrial.Domain.Entities
@{
    ViewData["Title"] = "Pipeline Rules";
}
@* Alerts are rendered once, globally, by _Layout.cshtml — nothing here. *@

<style>
    .rules-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem 0;
        margin: -1rem -1rem 2rem -1rem;
        border-radius: 0 0 1rem 1rem;
    }
    .rule-row { padding: 1rem 0; border-bottom: 1px solid #f1f3f5; }
    .rule-row:last-child { border-bottom: none; }
    .rule-title { font-weight: 600; color: #212529; }
    .rule-help  { font-size: 0.85rem; color: #6c757d; margin-top: 0.15rem; }
    .stage-cell { min-width: 190px; }
    .req-table th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: .04em; color: #6c757d; }
    .req-table td, .req-table th { vertical-align: middle; text-align: center; }
    .req-table td:first-child, .req-table th:first-child { text-align: left; }
    .req-na { color: #ced4da; }
</style>

<div class="container-fluid">
    <div class="rules-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="mb-3 mb-md-0">
                    <h1 class="h3 mb-1"><i class="bi bi-shield-check me-2"></i>Pipeline Rules</h1>
                    <p class="mb-0 opacity-75">What a deal needs before it can move, and who may reopen a closed one</p>
                </div>
                <div>
                    <a asp-page="/Settings/Pipeline/Index" class="btn btn-light">
                        <i class="bi bi-list-ol me-2"></i>Stages &amp; order
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.LoadFailed)
    {
        <div class="alert alert-warning d-flex gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div>
                The pipeline rules could not be loaded, so what you see below is the starting set
                rather than your workspace's. Refresh the page before changing anything —
                saving now would overwrite whatever is actually stored.
            </div>
        </div>
    }

    @if (!Model.CanEditRules)
    {
        <div class="alert alert-info d-flex gap-2" role="alert">
            <i class="bi bi-info-circle-fill mt-1"></i>
            <div>
                These are your workspace's rules, shown so you can see what applies.
                Only a workspace admin can change them.
            </div>
        </div>
    }

    @if (Model.Rules.IsDefault)
    {
        <div class="alert alert-secondary d-flex gap-2" role="alert">
            <i class="bi bi-sliders mt-1"></i>
            <div>
                These are the starting rules — nobody has changed them yet.
                Saving this page makes them your workspace's own.
            </div>
        </div>
    }
    else if (Model.Rules.UpdatedAtUtc.HasValue)
    {
        <p class="text-muted small">
            <i class="bi bi-clock-history me-1"></i>
            Last changed @Model.FormatDateTime(Model.Rules.UpdatedAtUtc.Value)
            @if (!string.IsNullOrEmpty(Model.Rules.UpdatedBy))
            {
                <text> by @Model.Rules.UpdatedBy</text>
            }
        </p>
    }

    <form method="post">
        <fieldset @(Model.CanEditRules ? "" : "disabled")>

            <!-- ============ Whole-pipeline rules ============ -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>How deals move</h5>
                </div>
                <div class="card-body py-0">

                    <div class="rule-row">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   asp-for="ForwardOnly" id="forwardOnly" />
                            <label class="form-check-label rule-title" for="forwardOnly">
                                Deals only move forward
                            </label>
                        </div>
                        <div class="rule-help">
                            A deal can't go back from a later open stage to an earlier one.
                            <strong>Most workspaces should leave this off.</strong> Reps genuinely do move a
                            deal back when a client goes quiet, and a CRM that refuses just teaches
                            them to leave the stage wrong — which costs you a worse forecast than the
                            one you were trying to protect. Closing a deal is never treated as
                            backwards, whatever order your Won and Lost stages sit in.
                        </div>
                    </div>

                </div>
            </div>

            <!-- ============ Reopening ============ -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-arrow-counterclockwise me-2"></i>Reopening a closed deal</h5>
                </div>
                <div class="card-body py-0">

                    <div class="rule-row">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   asp-for="ReopenRestrictedToManagers" id="reopenManagers" />
                            <label class="form-check-label rule-title" for="reopenManagers">
                                Only managers and admins can reopen
                            </label>
                        </div>
                        <div class="rule-help">
                            A manager of the deal owner's team, or a workspace admin — the same people
                            who approve an over-limit quote. Reopening moves a deal's value out of the
                            period it was booked in, so it is a decision worth a second pair of eyes.
                        </div>
                    </div>

                    <div class="rule-row">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   asp-for="ReopenRequiresReason" id="reopenReason" />
                            <label class="form-check-label rule-title" for="reopenReason">
                                Reopening needs a written reason
                            </label>
                        </div>
                        <div class="rule-help">
                            Kept on the deal's stage history. "Why is this back in the pipeline?" is
                            the first thing anyone asks three months later, and the answer is much
                            better written down at the time than reconstructed afterwards.
                        </div>
                    </div>

                    <div class="rule-row">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   asp-for="BlockReopenWithIssuedInvoice" id="blockInvoiced" />
                            <label class="form-check-label rule-title" for="blockInvoiced">
                                An invoiced deal can't be reopened at all
                            </label>
                        </div>
                        <div class="rule-help">
                            A won deal with an issued invoice that has not been voided stays closed.
                            The invoice is a tax document that has gone to the customer; reopening the
                            deal behind it would leave your books saying one thing and your pipeline
                            another. Void the invoice first — that has its own reason and its own
                            audit trail. <strong>Turning this off is not recommended</strong> in
                            India, Thailand, the Philippines or the UAE.
                        </div>
                    </div>

                </div>
            </div>

            <!-- ============ Per-stage entry requirements ============ -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-box-arrow-in-right me-2"></i>What each stage needs</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        Checked when a person moves a deal in. A move the system makes for you — a
                        quote being accepted, an invoice being paid in full — is not checked, because
                        the thing that triggered it is the very thing being asked about.
                    </p>

                    <div class="table-responsive">
                        <table class="table req-table align-middle">
                            <thead>
                                <tr>
                                    <th>Stage</th>
                                    <th title="A quote exists for the deal, in any state">Quote exists</th>
                                    <th title="A quote on the deal has been accepted by the customer">Accepted quote</th>
                                    <th title="The expected value is above zero">Value</th>
                                    <th title="The expected close date is filled in">Close date</th>
                                    <th title="A reason must be given for losing the deal">Lost reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.StageRules.Count; i++)
                                {
                                    var row = Model.StageRules[i];

                                    <tr>
                                        <td class="stage-cell">
                                            @* Hidden fields carry the identity of the row back. Without
                                               StageId the server has no way to tell which stage a set of
                                               checkboxes belongs to. *@
                                            <input type="hidden" asp-for="StageRules[i].StageId" />
                                            <input type="hidden" asp-for="StageRules[i].Key" />
                                            <input type="hidden" asp-for="StageRules[i].Name" />
                                            <input type="hidden" asp-for="StageRules[i].Category" />
                                            <input type="hidden" asp-for="StageRules[i].IsActive" />

                                            <strong>@row.Name</strong>
                                            <span class="badge @Model.CategoryBadge(row.Category) ms-1">
                                                @Model.CategoryLabel(row.Category)
                                            </span>
                                            @if (!row.IsActive)
                                            {
                                                <span class="badge bg-light text-muted border ms-1">retired</span>
                                            }
                                        </td>

                                        <td>
                                            <input class="form-check-input req-quote" type="checkbox"
                                                   asp-for="StageRules[i].RequiresQuote"
                                                   data-row="@i" />
                                        </td>
                                        <td>
                                            <input class="form-check-input req-accepted" type="checkbox"
                                                   asp-for="StageRules[i].RequiresAcceptedQuote"
                                                   data-row="@i" />
                                        </td>
                                        <td>
                                            <input class="form-check-input" type="checkbox"
                                                   asp-for="StageRules[i].RequiresValue" />
                                        </td>
                                        <td>
                                            <input class="form-check-input" type="checkbox"
                                                   asp-for="StageRules[i].RequiresCloseDate" />
                                        </td>
                                        <td>
                                            @* A lost reason only means anything on a Lost stage. Asking
                                               for one on an open stage would block every deal entering it
                                               for a reason nobody could give. *@
                                            @if (row.Category == StageCategory.Lost)
                                            {
                                                <input class="form-check-input" type="checkbox"
                                                       asp-for="StageRules[i].RequiresLostReason" />
                                            }
                                            else
                                            {
                                                <input type="hidden" asp-for="StageRules[i].RequiresLostReason" />
                                                <i class="bi bi-dash req-na" title="Only applies to a Lost stage"></i>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (Model.StageRules.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            This workspace has no pipeline stages yet.
                                            <a asp-page="/Settings/Pipeline/Index">Add them first</a>.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @if (Model.CanEditRules)
            {
                <div class="d-flex justify-content-end gap-2 mb-5">
                    <a asp-page="/Pipeline/Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-save me-2"></i>Save rules
                    </button>
                </div>
            }

        </fieldset>
    </form>
</div>

@section Scripts {
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // "Accepted quote" already means "a quote exists", so ticking it
        // ticks and disables the weaker one. Without this the two read as
        // a contradiction the first time someone sets both.
        function syncRow(rowIndex) {
            const accepted = document.querySelector(`.req-accepted[data-row="${rowIndex}"]`);
            const quote    = document.querySelector(`.req-quote[data-row="${rowIndex}"]`);
            if (!accepted || !quote) return;

            if (accepted.checked) {
                quote.checked = true;
                quote.disabled = true;
                quote.title = 'Included — an accepted quote is a quote.';
            } else {
                quote.disabled = false;
                quote.title = '';
            }
        }

        document.querySelectorAll('.req-accepted').forEach(cb => {
            syncRow(cb.dataset.row);
            cb.addEventListener('change', () => syncRow(cb.dataset.row));
        });

        // A disabled checkbox posts nothing, which would silently clear the
        // flag. The server folds RequiresQuote into RequiresAcceptedQuote
        // anyway, so re-enabling on submit keeps the posted form honest.
        document.querySelector('form')?.addEventListener('submit', function () {
            document.querySelectorAll('.req-quote[disabled]').forEach(cb => { cb.disabled = false; });
        });
    });
    </script>
}
