@page
@model MerkaiTrial.Admin.Web.Pages.Quotes.DetailModel
@* =====================================================================
   Quotes/Detail.cshtml
   (017) Approval panel (_QuoteApprovalPanel), status text for Pending
         approval / Approved / Revised, Send only when the quote may go
         out (Model.CanChangeStatus), Edit only for Draft/Revised/Approved.
   (018) Invoice box: a DRAFT invoice says "draft — issue it"; a void
         invoice no longer blocks creating a new one.
   ===================================================================== *@
@{
    ViewData["Title"] = $"Quote {Model.Quote?.Number}";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1.5rem 0;
        margin: -1rem -1rem 1.5rem -1rem;
        border-radius: 0 0 1rem 1rem;
    }

    .content-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        padding: 1.75rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    .quote-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-left: 4px solid #667eea;
        padding: 1.25rem 1.5rem;
        border-radius: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .quote-number {
        font-size: 1.6rem;
        font-weight: 700;
        color: #667eea;
    }

    .totals-section {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 1.25rem 1.5rem;
        margin-top: 1.5rem;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        padding: 0.4rem 0;
    }

        .total-row.grand-total {
            border-top: 2px solid #dee2e6;
            margin-top: 0.5rem;
            padding-top: 0.9rem;
            font-size: 1.5rem;
            font-weight: 700;
            color: #667eea;
        }

    .customer-link-box {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
    }

        .customer-link-box code {
            background: #dbeafe;
            color: #1e40af;
            padding: 0.4rem 0.75rem;
            border-radius: 6px;
            font-size: 0.82rem;
            word-break: break-all;
            display: block;
            margin-top: 0.5rem;
        }

    .action-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        justify-content: flex-end;
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid #e9ecef;
    }

    @@media (max-width: 575.98px) {
        .content-container {
            padding: 1rem;
        }

        .quote-header {
            padding: 1rem;
        }

        .quote-number {
            font-size: 1.2rem;
        }

        .total-row.grand-total {
            font-size: 1.15rem;
        }

        .table {
            font-size: 0.82rem;
        }

        .action-bar {
            justify-content: stretch;
        }

            .action-bar > *, .action-bar form {
                width: 100%;
            }

                .action-bar .btn, .action-bar form .btn {
                    width: 100%;
                }

        .customer-link-box .d-flex {
            flex-direction: column;
        }
    }

    @@media (min-width: 576px) and (max-width: 767.98px) {
        .content-container {
            padding: 1.25rem;
        }

        .quote-number {
            font-size: 1.35rem;
        }

        .total-row.grand-total {
            font-size: 1.25rem;
        }

        .action-bar {
            justify-content: stretch;
        }

            .action-bar > *, .action-bar form {
                flex: 1 1 calc(50% - 0.3rem);
            }

                .action-bar .btn, .action-bar form .btn {
                    width: 100%;
                }
    }
</style>

<div class="container-fluid px-2 px-md-3">

    <!-- Page Header -->
    <div class="page-header">
        <div class="container-fluid px-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h1 class="h4 mb-1">
                        <i class="bi bi-file-earmark-text me-2"></i>Quote Details
                    </h1>
                    <p class="mb-0 opacity-75 small">@Model.Quote?.Number</p>
                </div>
                <a href="/Quotes/Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
        </div>
    </div>

    <div class="content-container">

        @* Alert messages are rendered once, globally, by _Layout.cshtml — do not duplicate here. *@

        @if (Model.Quote != null)
        {
            @* Quote Accepted — Create Invoice *@
            @if (Model.Quote.Status == "Accepted" && Model.Invoice == null)
            {
                <div class="alert alert-success mb-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="mb-1">
                                <i class="bi bi-check-circle-fill me-2"></i>Quote Accepted!
                            </h6>
                            <p class="mb-0 small text-muted">
                                @* ✅ Was unconditionally "You can now create an invoice." — but the
                                   Create Invoice button beside it is gated on invoices.create, so
                                   sales_rep (Invoices read-only) read a promise it could not act on.
                                   Text now matches the same gate as the button. *@
                                @if (Model.CanUpdate && Model.UserCanCreate("invoices"))
                                {
                                    <text>Customer accepted. You can now create an invoice.</text>
                                    @if (Model.VoidInvoiceCount > 0)
                                    {
                                        <text> (The previous invoice was voided.)</text>
                                    }
                                }
                                else
                                {
                                    <text>Customer accepted this quote.</text>
                                }
                            </p>
                        </div>
                        @* ✅ Create Invoice — cross-module: needs Quotes.update AND Invoices.create *@
                        @if (Model.CanUpdate && Model.UserCanCreate("invoices"))
                        {
                            <form method="post" asp-page-handler="CreateInvoice"
                                  asp-route-id="@Model.Id" class="mb-0 flex-shrink-0">
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-receipt-cutoff me-1"></i>Create Invoice
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }

            @* Invoice exists *@
            @if (Model.Invoice != null)
            {
                <div class="alert alert-info mb-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="mb-1">
                                <i class="bi bi-receipt me-2"></i>@(Model.InvoiceIsDraft ? "Draft Invoice" : "Invoice Issued")
                            </h6>
                            <p class="mb-0 small">
                                @if (Model.InvoiceIsDraft)
                                {
                                    <text>A draft invoice exists for this quote. Open it to check the dates and issue it.</text>
                                }
                                else
                                {
                                    <text>Invoice <strong>@Model.Invoice.Number</strong> has been issued.</text>
                                }
                            </p>
                        </div>
                        <a href="/Invoices/Detail?id=@Model.Invoice.Id"
                           class="btn btn-primary btn-sm flex-shrink-0">
                            <i class="bi bi-arrow-right-circle me-1"></i>@(Model.InvoiceIsDraft ? "Open Draft" : "View Invoice")
                        </a>
                    </div>
                </div>
            }

            @* Status info — not accepted/invoiced *@
            @if (Model.Quote.Status != "Accepted" && Model.Invoice == null)
            {
                <div class="alert alert-secondary mb-3 py-2">
                    <span class="small">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>@MerkaiTrial.Admin.Web.Pages.Quotes.DetailModel.StatusLabel(Model.Quote.Status)</strong> —
                        @if (Model.Quote.Status == "Draft")
                        {
                            @if (Model.Approval?.RequiresApproval == true && Model.Approval?.IsExempt != true)
                            {
                                <text>This quote needs approval before it can be sent — see below.</text>
                            }
                            else
                            {
                                <text>Send this quote to the customer to get started.</text>
                            }
                        }
                        else if (Model.Quote.Status == "PendingApproval")
                        {
                            <text>Waiting for a manager to approve it before it can be sent.</text>
                        }
                        else if (Model.Quote.Status == "Approved")
                        {
                            <text>Approved — send it to the customer.</text>
                        }
                        else if (Model.Quote.Status == "Revised")
                        {
                            <text>Being revised. Edit it, then send it again.</text>
                        }
                        else if (Model.Quote.Status == "Sent")
                        {
                            <text>Waiting for customer response.</text>
                        }
                        else if (Model.Quote.Status == "Viewed")
                        {
                            <text>Customer has viewed the quote. Waiting for acceptance.</text>
                        }
                        else if (Model.Quote.Status == "Rejected")
                        {
                            <text>This quote was declined by the customer.</text>
                        }
                        else if (Model.Quote.Status == "Expired")
                        {
                            <text>This quote has expired.</text>
                        }
                    </span>
                </div>
            }

            @* (017) Approval panel — draws nothing when there's nothing to say *@
            <partial name="_QuoteApprovalPanel" model="Model" />

            @* Customer link — visible when Sent or Viewed *@
            @if ((Model.Quote.Status == "Sent" || Model.Quote.Status == "Viewed")
                    && !string.IsNullOrEmpty(Model.Quote.PaymentLinkUrl))
            {
                <div class="customer-link-box mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div class="flex-grow-1">
                            <div class="fw-semibold small" style="color:#1d4ed8;">
                                <i class="bi bi-link-45deg me-1"></i>Customer Quote Link
                            </div>
                            <p class="mb-1 small text-muted mt-1">
                                Share via email, Line, or WhatsApp. Customer can view and accept online.
                            </p>
                            <code id="quotePublicLink">@Model.Quote.PaymentLinkUrl</code>
                            <div class="d-flex gap-2 mt-2 flex-wrap">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        onclick="copyQuoteLink()"
                                        id="copyLinkBtn">
                                    <i class="bi bi-clipboard me-1"></i>Copy Link
                                </button>
                                <a href="@Model.Quote.PaymentLinkUrl"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i>Preview
                                </a>
                            </div>
                        </div>
                        @if (Model.Quote.Status == "Viewed")
                        {
                            <span class="badge flex-shrink-0"
                                  style="background:#dcfce7;color:#15803d;font-size:0.78rem;padding:0.4rem 0.6rem;">
                                <i class="bi bi-eye-fill me-1"></i>Viewed by customer
                            </span>
                        }
                    </div>
                </div>
            }

            <!-- Quote Meta -->
            <div class="quote-header">
                <div class="row g-2">
                    <div class="col-sm-7">
                        <div class="quote-number mb-2">@Model.Quote.Number</div>
                        <p class="mb-1 small"><strong>Deal:</strong> @Model.Quote.DealTitle</p>
                        <p class="mb-1 small"><strong>Company:</strong> @Model.Quote.CompanyName</p>
                        @if (!string.IsNullOrEmpty(Model.Quote.VerticalName))
                        {
                            <p class="mb-1 small">
                                <strong>Industry:</strong>
                                <span class="badge bg-light text-dark border ms-1">
                                    <i class="bi bi-diagram-3 me-1"></i>@Model.Quote.VerticalName
                                </span>
                            </p>
                        }
                        <p class="mb-0 small">
                            <strong>Status:</strong>
                            <span class="badge @Model.GetStatusBadgeClass(Model.Quote.Status) ms-1">
                                @MerkaiTrial.Admin.Web.Pages.Quotes.DetailModel.StatusLabel(Model.Quote.Status)
                            </span>
                        </p>
                    </div>
                    <div class="col-sm-5 text-sm-end mt-2 mt-sm-0">
                        <p class="mb-1 small"><strong>Issued:</strong> @Model.FormatDate(Model.Quote.IssueDateUtc)</p>
                        <p class="mb-1 small"><strong>Expires:</strong> @Model.FormatDate(Model.Quote.ExpiresAtUtc)</p>
                        <p class="mb-0 small"><strong>Created:</strong> @Model.FormatDate(Model.Quote.CreatedAtUtc)</p>
                    </div>
                </div>
            </div>

            <!-- Line Items -->
            <h6 class="mb-2"><i class="bi bi-list-ul me-2"></i>Line Items</h6>
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Item</th>
                            <th class="d-none d-md-table-cell">Description</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Price</th>
                            <th class="text-end d-none d-sm-table-cell">Tax</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Quote.Items.Count; i++)
                        {
                            var item = Model.Quote.Items[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>
                                    <strong>@item.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="text-muted small d-md-none">@item.Description</div>
                                    }
                                </td>
                                <td class="d-none d-md-table-cell text-muted small">@item.Description</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@Model.FormatCurrency(item.UnitPrice)</td>
                                <td class="text-end d-none d-sm-table-cell text-muted">
                                    @((item.TaxRate * 100).ToString("N0"))%
                                </td>
                                <td class="text-end fw-semibold">
                                    @Model.FormatCurrency(item.LineGrandTotal)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Totals -->
            <div class="row justify-content-end">
                <div class="col-sm-8 col-md-5">
                    <div class="totals-section">
                        <div class="total-row">
                            <span class="text-muted">Subtotal</span>
                            <strong>@Model.FormatCurrency(Model.Quote.Subtotal)</strong>
                        </div>
                        <div class="total-row">
                            <span class="text-muted">Discount</span>
                            <strong>@Model.FormatCurrency(Model.Quote.DiscountTotal)</strong>
                        </div>
                        <div class="total-row">
                            <span class="text-muted">Tax</span>
                            <strong>@Model.FormatCurrency(Model.Quote.TaxTotal)</strong>
                        </div>
                        <div class="total-row grand-total">
                            <span>Grand Total</span>
                            <strong>@Model.FormatCurrency(Model.Quote.GrandTotal)</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Attachments -->
            <div class="card shadow-sm mt-4 mb-2">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                    <h6 class="mb-0"><i class="bi bi-paperclip me-2"></i>Attachments</h6>
                    <span class="badge bg-secondary">@Model.Attachments.Count</span>
                </div>
                <div class="card-body">

                    @* ✅ Upload form — only if has update permission *@
                    @if (Model.CanUpdate)
                    {
                        <div class="mb-3 p-3 border rounded bg-light">
                            <form method="post"
                                  asp-page-handler="UploadAttachment"
                                  asp-route-id="@Model.Id"
                                  enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <div class="row g-2 align-items-end">
                                    <div class="col-12 col-sm">
                                        <input type="file" name="file" class="form-control form-control-sm"
                                               accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.webp,.txt,.csv"
                                               required />
                                        <small class="text-muted">PDF, Word, Excel, Images, CSV — max 10 MB</small>
                                    </div>
                                    <div class="col-12 col-sm-auto">
                                        <button type="submit" class="btn btn-primary btn-sm w-100">
                                            <i class="bi bi-upload me-1"></i>Upload
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }

                    @if (!Model.Attachments.Any())
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-paperclip fs-3 d-block mb-1"></i>
                            <p class="mb-0 small">No attachments yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var att in Model.Attachments)
                            {
                                <div class="list-group-item px-0 py-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi @att.FileIcon fs-4 flex-shrink-0"></i>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-semibold text-truncate small">@att.FileName</div>
                                            <div class="text-muted" style="font-size:0.75rem;">
                                                @att.FileSizeDisplay · @Model.FormatDateTime(att.CreatedAtUtc)
                                                @if (!string.IsNullOrEmpty(att.CreatedBy))
                                                {
                                                    <text> by @att.CreatedBy</text>
                                                }
                                            </div>
                                        </div>
                                        <div class="flex-shrink-0 d-flex gap-1">
                                            <a href="@att.FileUrl" target="_blank"
                                               class="btn btn-sm btn-outline-primary" title="Download">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            @* ✅ Delete attachment — only if has delete permission *@
                                            @if (Model.CanDelete)
                                            {
                                                <form method="post"
                                                      asp-page-handler="DeleteAttachment"
                                                      asp-route-id="@Model.Id"
                                                      asp-route-attachmentId="@att.Id"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Delete this attachment?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- ✅ Action Bar — role-based permission gates -->
            <div class="action-bar">

                @* Send to Customer — Draft/Revised within the rules (or admin), or Approved.
                   Model.CanChangeStatus applies the approval gate. *@
                @if (Model.Quote.Status is "Draft" or "Revised" or "Approved" && Model.CanUpdate
                     && Model.CanChangeStatus(Model.Quote.Status, "Sent"))
                {
                    <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Id">
                        <input type="hidden" name="newStatus" value="Sent" />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i>Send to Customer
                        </button>
                    </form>
                }

                @* Mark as Accepted — only if Sent/Viewed AND has update permission *@
                @if ((Model.Quote.Status == "Sent" || Model.Quote.Status == "Viewed")
                            && Model.CanUpdate)
                {
                    <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Id">
                        <input type="hidden" name="newStatus" value="Accepted" />
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle me-1"></i>Mark as Accepted
                        </button>
                    </form>
                }

                @* Revise — a rejected or expired quote can be reworked and sent again *@
                @if (Model.Quote.Status is "Expired" or "Rejected" && Model.CanUpdate && Model.Invoice == null)
                {
                    <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Id">
                        <input type="hidden" name="newStatus" value="Revised" />
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-repeat me-1"></i>Revise
                        </button>
                    </form>
                }

                @if (!Model.IsLocked)
                {
                    @* PDF download — always visible (read is enough) *@
                    <a asp-page="/Quotes/Detail"
                       asp-page-handler="DownloadPdf"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary"
                       target="_blank">
                        <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                    </a>

                    @* ✅ Edit — update permission AND an editable status (Draft/Revised/Approved) *@
                    @if (Model.CanUpdate && Model.IsEditableStatus)
                    {
                        <a asp-page="/Quotes/Edit" asp-route-id="@Model.Id"
                           class="btn btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                    }

                    @* ✅ Delete — only if has delete permission *@
                    @if (Model.CanDelete)
                    {
                        <button type="button" class="btn btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    }
                }
                else
                {
                    @* Locked — show badge; also show PDF since viewing is always allowed *@
                    <a asp-page="/Quotes/Detail"
                       asp-page-handler="DownloadPdf"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary"
                       target="_blank">
                        <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                    </a>
                    <span class="badge align-self-center px-3 py-2"
                          style="background:#e0f2fe;color:#0369a1;font-size:0.78rem;">
                        <i class="bi bi-lock-fill me-1"></i>
                        @(Model.Invoice != null ? "Invoiced — View Only" : "Accepted — View Only")
                    </span>
                }

            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>Quote not found or has been deleted.
            </div>
        }
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle me-2"></i>Delete Quote
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">Are you sure you want to delete this quote?</p>
                <p class="mb-0 fw-semibold">@Model.Quote?.Number — @Model.Quote?.DealTitle</p>
                <p class="text-muted small mt-1 mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                @* ✅ Delete confirm — requires BOTH not locked AND delete permission *@
                @if (!Model.IsLocked && Model.CanDelete)
                {
                    <form method="post" asp-page-handler="Delete"
                          asp-route-id="@Model.Id" class="d-inline">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@* Bootstrap JS is already loaded once by _Layout.cshtml — do not load it again here. *@
<script>
    // Alert auto-dismiss is handled globally by _Layout.cshtml — do not duplicate here.

    function copyQuoteLink() {
        const link = document.getElementById('quotePublicLink')?.textContent?.trim();
        if (!link) return;
        navigator.clipboard.writeText(link).then(() => {
            const btn = document.getElementById('copyLinkBtn');
            const orig = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Copied!';
            btn.classList.replace('btn-outline-primary', 'btn-success');
            setTimeout(() => {
                btn.innerHTML = orig;
                btn.classList.replace('btn-success', 'btn-outline-primary');
            }, 2000);
        });
    }
</script>
