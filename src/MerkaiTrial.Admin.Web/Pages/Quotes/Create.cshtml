@page
@using System.Globalization
@using System.Text.Json
@using MerkaiTrial.Admin.Web.Pages.Quotes
@model MerkaiTrial.Admin.Web.Pages.Quotes.CreateModel
@{
    ViewData["Title"] = "New quote";

    // productId → catalogue list price, so the editor can work out how far
    // below list a line has been discounted.
    var listPrices = (Model.Products ?? new())
        .GroupBy(p => p.Id.ToString())
        .ToDictionary(g => g.Key, g => g.First().ListPrice);

    var editor = new QuoteItemsEditorVm
    {
        FormId                = "qcForm",
        CurrencyCode          = Model.Currency,
        DefaultTaxRate        = Model.DefaultTaxRate,
        TaxLabel              = Model.DefaultTaxRateName,
        ApprovalRulesJson     = Model.ApprovalRulesJson,
        Products              = Model.Products ?? new(),
        InitialItemsJson      = "[]",
        ListPricesJson        = JsonSerializer.Serialize(listPrices),
        StartWithOneBlankLine = true
    };
}
@* =====================================================================
   Quotes/Create.cshtml   (029 — rebuild)
   Location: MerkaiTrial.Admin.Web/Pages/Quotes/Create.cshtml

   COMPLETE FILE — replaces the 017 version.

   WHAT WAS WRONG WITH THE OLD PAGE

   1. IT LOADED BOOTSTRAP AND BOOTSTRAP ICONS AGAIN from a CDN, inside
      <body>, on top of the copies _Layout.cshtml already loads in <head>.

   2. A 2rem PURPLE BANNER reading "Create Quote / Generate a quotation for
      your customer" plus a 2rem-padded card, before any of the form.

   3. THE VALIDATION WAS DECORATION. Every input carried required / min /
      max, and the buttons were type="button" with
      onclick="submitQuote(...)" calling form.submit(). form.submit() skips
      HTML5 constraint validation by specification, so none of it ever ran:
      a quantity of 0 or a 500% tax rate went straight to the API. The
      buttons are ordinary type="submit" now and the shared editor
      validates before letting the form go.

   4. THE DATE INPUTS SAT OUTSIDE THE FORM. They were in the deal card, and
      the previous round patched that with the HTML5 form="createQuoteForm"
      attribute rather than moving them. They are inside the form now, so
      there is nothing left to get wrong.

   5. THE LINE-ITEM EDITOR WAS A SECOND COPY of the one on the Edit page —
      about 300 lines of JavaScript duplicated and already drifting apart.
      Both pages now render _QuoteItemsEditor.cshtml; QuoteItemsEditorVm.cs
      lists what the two copies had done differently.

   6. "Save as Draft" AND "Send to Customer" WERE INDISTINGUISHABLE in
      weight — outline-primary next to primary, side by side. Sending a
      quote to a customer is not undoable; saving a draft is. The primary
      button is the safe one now.

   7. THE NO-DEALS CASE SAID IT TWICE: the page model puts "No deals
      available for quoting…" in TempData, which _Layout renders as a
      banner, and the page drew its own warning box under it.

   TempData alerts are rendered once, globally, by _Layout.cshtml.
   ===================================================================== *@

<style>
    .qc { max-width: 1180px; margin: 0 auto; }
    .qc-back { font-size: .82rem; color: #64748b; text-decoration: none; }
    .qc-back:hover { color: #334155; }
    .qc-head { display: flex; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin: .35rem 0 1rem; }
    .qc-title { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0; line-height: 1.2; }
    .qc-sub { font-size: .84rem; color: #64748b; margin: .2rem 0 0; }

    .qc-card { border: 1px solid #e9ecef; border-radius: 12px; background: #fff; margin-bottom: 1rem; }
    .qc-card > h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b;
                    font-weight: 650; margin: 0; padding: .7rem 1rem; border-bottom: 1px solid #f1f3f5;
                    display: flex; align-items: center; gap: .4rem; }
    .qc-card .bd { padding: .9rem 1rem; }

    .qc-facts { display: grid; grid-template-columns: auto 1fr; gap: .35rem .9rem; font-size: .86rem; }
    .qc-facts dt { color: #94a3b8; font-weight: 500; }
    .qc-facts dd { margin: 0; color: #0f172a; }

    .qc-pick { border: 1px solid #e9ecef; border-radius: 12px; background: #fff; padding: 1.5rem; }
    .qc-steps { display: flex; gap: .5rem; align-items: center; font-size: .78rem; color: #94a3b8;
                margin-bottom: .9rem; }
    .qc-steps .on { color: #4f46e5; font-weight: 650; }

    .qc-bar { display: flex; gap: .5rem; justify-content: flex-end; flex-wrap: wrap;
              border-top: 1px solid #e9ecef; padding-top: 1rem; margin-top: 1rem; }

    @@media (max-width: 575.98px) {
        .qc-title { font-size: 1.25rem; }
        .qc-bar { justify-content: stretch; }
        .qc-bar > * { flex: 1 1 100%; }
        .qc-bar .btn { width: 100%; }
    }
</style>

<div class="qc">

    <a asp-page="/Quotes/Index" class="qc-back">
        <i class="bi bi-arrow-left me-1"></i>All quotes
    </a>

    <div class="qc-head">
        <div>
            <h1 class="qc-title">New quote</h1>
            <p class="qc-sub">
                @if (Model.Deal != null)
                {
                    <text>For @Model.Deal.CompanyName — @Model.Deal.Title</text>
                }
                else
                {
                    <text>A quote is raised against a deal. Pick the deal first.</text>
                }
            </p>
        </div>
    </div>

    @* ── STEP 1: pick a deal ────────────────────────────────────── *@
    @if (Model.ShowDealSelection)
    {
        <div class="qc-pick">
            <div class="qc-steps">
                <span class="on">1. Choose a deal</span>
                <i class="bi bi-chevron-right"></i>
                <span>2. Add the lines</span>
            </div>

            @if (Model.AvailableDeals.Any())
            {
                <p class="text-muted" style="font-size:.86rem;">
                    Deals in <strong>Discovery</strong>, <strong>Qualification</strong> or
                    <strong>Proposal</strong> can be quoted. Creating the quote moves the deal
                    on to <strong>Proposal</strong>.
                </p>

                <form method="post" asp-page-handler="SelectDeal" class="row g-2 align-items-end">
                    <div class="col-md-9">
                        <label asp-for="SelectedDealId" class="form-label small text-muted mb-1">Deal</label>
                        <select asp-for="SelectedDealId" class="form-select" required>
                            <option value="">Choose a deal…</option>
                            @foreach (var d in Model.AvailableDeals)
                            {
                                <option value="@d.Value">@d.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            Continue<i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </form>

                <p class="text-muted mt-3 mb-0" style="font-size:.8rem;">
                    <i class="bi bi-lightbulb me-1"></i>
                    You can also start a quote from a deal itself — open it in the
                    <a asp-page="/Pipeline/Index">pipeline</a> and use <em>Create quote</em>.
                </p>
            }
            else
            {
                @* The "no deals available" message is already in TempData and
                   rendered by _Layout, so this says something different: what to
                   do about it. The old page repeated the same sentence in a
                   second box. *@
                <div class="text-center py-3">
                    <i class="bi bi-briefcase d-block mb-2" style="font-size:2.2rem;color:#d7dde3;"></i>
                    <div class="fw-semibold mb-1">Nothing to quote yet</div>
                    <p class="text-muted mb-3" style="font-size:.86rem;">
                        A quote needs a deal in <strong>Discovery</strong>,
                        <strong>Qualification</strong> or <strong>Proposal</strong>.
                    </p>
                    <a asp-page="/Pipeline/Index" class="btn btn-sm btn-primary">
                        <i class="bi bi-kanban me-1"></i>Open the pipeline
                    </a>
                </div>
            }
        </div>
    }

    @* ── STEP 2: build the quote ────────────────────────────────── *@
    @if (Model.Deal != null)
    {
        <form method="post" asp-page-handler="Create" id="qcForm">
            @* DealId is the route value the handler reads. Keep it posted. *@
            <input type="hidden" asp-for="DealId" />

            <div class="row g-3">
                <div class="col-lg-7">
                    <div class="qc-card">
                        <h2><i class="bi bi-briefcase"></i>Deal</h2>
                        <div class="bd">
                            <dl class="qc-facts mb-0">
                                <dt>Deal</dt>
                                <dd>@Model.Deal.Title</dd>

                                <dt>Company</dt>
                                <dd>@Model.Deal.CompanyName</dd>

                                <dt>Stage</dt>
                                <dd><span class="badge bg-primary">@Model.Deal.Stage</span></dd>

                                <dt>Owner</dt>
                                <dd>@Model.Deal.OwnerName</dd>

                                <dt>Expected value</dt>
                                <dd>@Model.FormatCurrency(Model.Deal.ExpectedValue) @Model.Currency</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="qc-card">
                        <h2><i class="bi bi-calendar-event"></i>Dates</h2>
                        <div class="bd">
                            @* INSIDE the form. The old page had these in the deal card
                               above it, outside any form, so nothing the user typed was
                               ever posted — the previous round patched it with
                               form="createQuoteForm" instead of moving them. *@
                            <div class="row g-2">
                                <div class="col-6">
                                    <label asp-for="IssueDate" class="form-label small text-muted mb-1">Issued</label>
                                    <input type="date" asp-for="IssueDate" class="form-control form-control-sm" required />
                                </div>
                                <div class="col-6">
                                    <label asp-for="ExpiryDate" class="form-label small text-muted mb-1">Expires</label>
                                    <input type="date" asp-for="ExpiryDate" class="form-control form-control-sm" required />
                                </div>
                            </div>
                            <div class="text-danger mt-2 d-none" id="qcDateErr" style="font-size:.8rem;">
                                The expiry date can't be before the issue date.
                            </div>
                            <div class="text-muted mt-2" style="font-size:.76rem;">
                                Priced in <strong>@Model.Currency</strong>, taken from the deal.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* The shared line-item editor: table, catalogue, totals, the live
               approval hint and the hidden itemsJson field. *@
            <partial name="_QuoteItemsEditor" model="editor" />

            <div class="qc-bar">
                <a asp-page="/Quotes/Index" class="btn btn-outline-secondary">Cancel</a>

                @* Plain submit buttons, so the browser validates the dates and
                   the editor's own submit listener serialises the lines. The old
                   page used type="button" + form.submit(), which skipped both.

                   The SAFE action is the primary one. Sending a quote to a
                   customer cannot be undone; saving a draft can. *@
                <button type="submit" name="sendToCustomer" value="false" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>Save as draft
                </button>
                <button type="submit" name="sendToCustomer" value="true"
                        class="btn btn-outline-primary" id="qcSend">
                    <i class="bi bi-send me-1"></i>Save &amp; send to customer
                </button>
            </div>
        </form>
    }
</div>

<script>
    (function () {
        'use strict';

        // ── 1. relabel the send button when approval will be needed ──
        // The editor raises this; nothing in the editor touches this page's
        // markup, and nothing here reaches into the editor's.
        var sendBtn = document.getElementById('qcSend');

        document.addEventListener('quote-items:approval', function (e) {
            if (!sendBtn) return;
            var d = e.detail || {};
            var needs = d.needsApproval && !d.exempt;

            sendBtn.innerHTML = needs
                ? '<i class="bi bi-send-check me-1"></i>Save &amp; submit for approval'
                : '<i class="bi bi-send me-1"></i>Save &amp; send to customer';
            sendBtn.classList.toggle('btn-warning', needs);
            sendBtn.classList.toggle('btn-outline-primary', !needs);
        });

        // ── 2. expiry must not precede issue ────────────────────────
        // Nothing checked this before, on the client or the server: you could
        // save a quote that expired before it was raised.
        var form  = document.getElementById('qcForm');
        var issue = document.getElementById('IssueDate');
        var expiry = document.getElementById('ExpiryDate');
        var dateErr = document.getElementById('qcDateErr');

        function datesOk() {
            if (!issue || !expiry || !issue.value || !expiry.value) return true;
            // Both are yyyy-MM-dd from <input type="date">, so a string compare
            // is a correct date compare and needs no parsing or timezone.
            return expiry.value >= issue.value;
        }

        function showDateError(bad) {
            if (dateErr) dateErr.classList.toggle('d-none', !bad);
            if (expiry) expiry.classList.toggle('is-invalid', bad);
        }

        if (form) {
            // Capture phase, so this runs before the editor's own submit
            // listener and a bad date stops the post either way.
            form.addEventListener('submit', function (e) {
                var bad = !datesOk();
                showDateError(bad);
                if (bad) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    if (expiry) expiry.focus();
                }
            }, true);
        }

        if (expiry) expiry.addEventListener('change', function () { showDateError(!datesOk()); });
        if (issue) issue.addEventListener('change', function () { showDateError(!datesOk()); });
    })();
</script>
