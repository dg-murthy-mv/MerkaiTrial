@page
@using System.Globalization
@using System.Text.Json
@using MerkaiTrial.Admin.Web.Pages.Quotes
@model MerkaiTrial.Admin.Web.Pages.Quotes.EditModel
@{
    ViewData["Title"] = Model.ExistingQuote == null ? "Edit quote" : $"Edit {Model.ExistingQuote.Number}";

    var eq = Model.ExistingQuote;

    // productId → catalogue list price, so the editor can work out how far
    // below list a line has been discounted.
    var listPrices = (Model.Products ?? new())
        .GroupBy(p => p.Id.ToString())
        .ToDictionary(g => g.Key, g => g.First().ListPrice);

    // The lines already on the quote. TaxRate on QuoteItemDto is a FRACTION
    // (0.18 = 18%); the editor and QuoteItemData both work in PERCENT, so it
    // is multiplied here — in one place, named — rather than by a second
    // "normalise" function inside the script.
    var seedItems = (eq?.Items ?? new()).Select(i => new
    {
        itemId       = i.Id,
        productId    = i.ProductId,
        name         = i.Name ?? string.Empty,
        description  = i.Description ?? string.Empty,
        quantity     = i.Quantity,
        unitPrice    = i.UnitPrice,
        lineDiscount = i.LineDiscount,
        taxRate      = i.TaxRate * 100m
    }).ToList();

    var editor = new QuoteItemsEditorVm
    {
        FormId                = "qxForm",
        CurrencyCode          = string.IsNullOrWhiteSpace(Model.Input.Currency)
                                  ? Model.TenantCurrencyCode : Model.Input.Currency,
        DefaultTaxRate        = Model.DefaultTaxRate,
        TaxLabel              = "Tax",
        ApprovalRulesJson     = Model.ApprovalRulesJson,
        Products              = Model.Products ?? new(),
        InitialItemsJson      = JsonSerializer.Serialize(seedItems),
        ListPricesJson        = JsonSerializer.Serialize(listPrices),
        StartWithOneBlankLine = false
    };
}
@* =====================================================================
   Quotes/Edit.cshtml   (029 — rebuild)
   Location: MerkaiTrial.Admin.Web/Pages/Quotes/Edit.cshtml

   COMPLETE FILE — replaces the 017 version.

   WHAT WAS WRONG WITH THE OLD PAGE

   1. THE PRODUCT CATALOGUE COULD BREAK THE PAGE, AND WORSE. It built each
      button as:

          onclick="addProductFromCatalog('@@product.Id',
                   '@@Html.Raw(product.Name.Replace("'", "\\'"))', …)"

      Html.Raw turns OFF encoding, and only the single quote was escaped. A
      product named   Widget "Pro"   closed the double-quoted onclick
      attribute early and put the rest of the name into the markup as
      attributes. And product.Name.Replace(…) on a product with a NULL name
      threw an NRE, so one bad catalogue row made every Edit page 500.
      The Create page had already been fixed; this one had not.

      The shared editor puts the name, description and price in data-
      attributes, which Razor encodes, and reads them in a delegated
      listener. Nothing goes into a JavaScript string.

   2. IT WAS A SECOND COPY OF CREATE'S LINE-ITEM EDITOR — about 300 lines of
      near-identical JavaScript that had already drifted in four places.
      See QuoteItemsEditorVm.cs. Both pages render _QuoteItemsEditor.cshtml
      now.

   3. THE SAME 190px PURPLE BANNER, and Bootstrap plus Bootstrap Icons
      loaded a second time from a CDN inside <body>.

   4. IT LOADED 500 DEALS ON EVERY OPEN FOR A DROPDOWN IT DIDN'T DRAW.
      LoadAvailableDealsAsync filled AvailableDeals, and the page shows the
      deal read-only because UpdateQuoteDto has no DealId. That call is gone
      from the page model this round.

   THE BIG ONE IS IN THE PAGE MODEL, NOT HERE: every save moved the issue
   and expiry dates back a day. Edit.cshtml.cs explains it.

   TempData alerts are rendered once, globally, by _Layout.cshtml.
   ===================================================================== *@

<style>
    .qx { max-width: 1180px; margin: 0 auto; }
    .qx-back { font-size: .82rem; color: #64748b; text-decoration: none; }
    .qx-back:hover { color: #334155; }
    .qx-head { display: flex; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin: .35rem 0 1rem; }
    .qx-title { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0; line-height: 1.2; }
    .qx-sub { font-size: .84rem; color: #64748b; margin: .2rem 0 0; }

    .qx-warn { display: flex; align-items: flex-start; gap: .6rem; border: 1px solid #ffe69c;
               border-left: 5px solid #ffc107; border-radius: 10px; background: #fffbf0;
               padding: .7rem 1rem; margin-bottom: 1rem; font-size: .88rem; color: #334155; }

    .qx-card { border: 1px solid #e9ecef; border-radius: 12px; background: #fff; margin-bottom: 1rem; }
    .qx-card > h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b;
                    font-weight: 650; margin: 0; padding: .7rem 1rem; border-bottom: 1px solid #f1f3f5;
                    display: flex; align-items: center; gap: .4rem; }
    .qx-card .bd { padding: .9rem 1rem; }

    .qx-facts { display: grid; grid-template-columns: auto 1fr; gap: .35rem .9rem; font-size: .86rem; }
    .qx-facts dt { color: #94a3b8; font-weight: 500; }
    .qx-facts dd { margin: 0; color: #0f172a; }

    .qx-bar { display: flex; gap: .5rem; justify-content: flex-end; flex-wrap: wrap;
              border-top: 1px solid #e9ecef; padding-top: 1rem; margin-top: 1rem; }

    @@media (max-width: 575.98px) {
        .qx-title { font-size: 1.25rem; }
        .qx-bar { justify-content: stretch; }
        .qx-bar > * { flex: 1 1 100%; }
        .qx-bar .btn { width: 100%; }
    }
</style>

@if (eq == null)
{
    <div class="qx">
        <div class="qx-card">
            <div class="text-center py-4 text-muted">
                <i class="bi bi-file-earmark-x d-block mb-2" style="font-size:2.2rem;color:#d7dde3;"></i>
                <div class="fw-semibold text-body mb-1">Quote not found</div>
                <div><a asp-page="/Quotes/Index">Back to quotes</a></div>
            </div>
        </div>
    </div>
}
else
{
<div class="qx">

    <a asp-page="/Quotes/Detail" asp-route-id="@Model.Id" class="qx-back">
        <i class="bi bi-arrow-left me-1"></i>Back to @eq.Number
    </a>

    <div class="qx-head">
        <div>
            <h1 class="qx-title">Edit @eq.Number</h1>
            <p class="qx-sub">
                <span class="badge bg-secondary">@eq.Status</span>
                <span class="ms-1">@eq.DealTitle</span>
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusWarning))
    {
        <div class="qx-warn">
            <i class="bi bi-exclamation-triangle-fill" style="color:#d39e00;"></i>
            <div>@Model.StatusWarning</div>
        </div>
    }

    <form method="post" id="qxForm">
        @* Id is the route value the handler reads. *@
        <input type="hidden" asp-for="Id" />

        @* The deal cannot change: UpdateQuoteDto carries no DealId, so the old
           editable dropdown posted a value the API threw away. It is posted as
           a hidden field only because Input.DealId is [Required] on
           QuoteEditModel — leaving it out would fail model validation on a
           field the user cannot see. *@
        <input type="hidden" asp-for="Input.DealId" />
        <input type="hidden" asp-for="Input.Currency" />

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="qx-card">
                    <h2><i class="bi bi-briefcase"></i>Deal</h2>
                    <div class="bd">
                        <dl class="qx-facts mb-0">
                            <dt>Deal</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.DealDisplay) ? "—" : Model.DealDisplay)</dd>

                            <dt>Quote</dt>
                            <dd>@eq.Number</dd>

                            <dt>Currency</dt>
                            <dd>
                                @(string.IsNullOrWhiteSpace(Model.Input.Currency)
                                    ? Model.TenantCurrencyCode : Model.Input.Currency)
                                <span class="text-muted">— set when the quote was raised</span>
                            </dd>
                        </dl>
                        <div class="text-muted mt-2" style="font-size:.76rem;">
                            <i class="bi bi-info-circle me-1"></i>
                            The deal can't be changed on an existing quote. Raise a new quote
                            against the other deal instead.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="qx-card">
                    <h2><i class="bi bi-calendar-event"></i>Dates</h2>
                    <div class="bd">
                        <div class="row g-2">
                            <div class="col-6">
                                <label asp-for="Input.IssueDate" class="form-label small text-muted mb-1">Issued</label>
                                <input type="date" asp-for="Input.IssueDate" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-6">
                                <label asp-for="Input.ExpiryDate" class="form-label small text-muted mb-1">Expires</label>
                                <input type="date" asp-for="Input.ExpiryDate" class="form-control form-control-sm" required />
                            </div>
                        </div>
                        <div class="text-danger mt-2 d-none" id="qxDateErr" style="font-size:.8rem;">
                            The expiry date can't be before the issue date.
                        </div>
                        <span asp-validation-for="Input.IssueDate" class="text-danger small"></span>
                        <span asp-validation-for="Input.ExpiryDate" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        @* The shared line-item editor, seeded with the quote's existing lines. *@
        <partial name="_QuoteItemsEditor" model="editor" />

        <div class="qx-bar">
            <a asp-page="/Quotes/Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary" id="qxSave">
                <i class="bi bi-check2 me-1"></i>Save changes
            </button>
        </div>
    </form>
</div>
}

<script>
    (function () {
        'use strict';

        // ── 1. tell the user when the save will need approval again ──
        var save = document.getElementById('qxSave');

        document.addEventListener('quote-items:approval', function (e) {
            if (!save) return;
            var d = e.detail || {};
            var needs = d.needsApproval && !d.exempt;

            save.innerHTML = needs
                ? '<i class="bi bi-shield-exclamation me-1"></i>Save — will need approval'
                : '<i class="bi bi-check2 me-1"></i>Save changes';
            save.classList.toggle('btn-warning', needs);
            save.classList.toggle('btn-primary', !needs);
        });

        // ── 2. expiry must not precede issue ────────────────────────
        var form    = document.getElementById('qxForm');
        var issue   = document.getElementById('Input_IssueDate');
        var expiry  = document.getElementById('Input_ExpiryDate');
        var dateErr = document.getElementById('qxDateErr');

        function datesOk() {
            if (!issue || !expiry || !issue.value || !expiry.value) return true;
            // Both are yyyy-MM-dd from <input type="date">, so a string compare
            // is a correct date compare — no parsing, no timezone.
            return expiry.value >= issue.value;
        }

        function showDateError(bad) {
            if (dateErr) dateErr.classList.toggle('d-none', !bad);
            if (expiry) expiry.classList.toggle('is-invalid', bad);
        }

        if (form) {
            // Capture phase, so a bad date stops the post before the editor's
            // own submit listener runs.
            form.addEventListener('submit', function (e) {
                var bad = !datesOk();
                showDateError(bad);
                if (bad) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    if (expiry) expiry.focus();
                }
            }, true);
        }

        if (expiry) expiry.addEventListener('change', function () { showDateError(!datesOk()); });
        if (issue) issue.addEventListener('change', function () { showDateError(!datesOk()); });
    })();
</script>
