@page "/Products/Detail/{id}"
@model MerkaiTrial.Admin.Web.Pages.Products.DetailModel
@{
    ViewData["Title"] = "Product Details";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" 
                 style="width: 80px; height: 80px; background-color: @Model.GetCategoryColor();">
                <i class="@Model.GetCategoryIcon() text-white" style="font-size: 2.5rem;"></i>
            </div>
            <div>
                <h2 class="mb-1">@Model.Product.Name</h2>
                <p class="text-muted mb-0">
                    <span class="badge bg-info me-2">@(Model.Product.Category ?? "Uncategorized")</span>
                    @if (Model.Product.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Edit" asp-route-id="@Model.Product.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> <span class="d-none d-sm-inline">Edit</span>
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back</span>
            </a>
        </div>
    </div>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overview">
                <i class="bi bi-info-circle"></i> Overview
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#settings">
                <i class="bi bi-gear"></i> Settings
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="overview">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-info-circle"></i> Product Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Product Name</label>
                                    <div class="fw-semibold">@Model.Product.Name</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">SKU</label>
                                    <div class="fw-semibold"><code>@(Model.Product.Sku ?? "-")</code></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Category</label>
                                    <div><span class="badge bg-info fs-6">@(Model.Product.Category ?? "Uncategorized")</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Type</label>
                                    <div><span class="badge bg-secondary fs-6">@Model.Product.Type</span></div>
                                </div>
                                <div class="col-12">
                                    <label class="text-muted small">Description</label>
                                    <div class="fw-semibold">@(Model.Product.Description ?? "No description")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="bi bi-cash-stack"></i> Pricing Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="text-muted small">List Price</label>
                                    <div class="fs-4 fw-bold text-success">@Model.FormatCurrency(Model.Product.ListPrice)</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">Currency</label>
                                    <div class="fw-semibold">@Model.TenantCurrencyName (@Model.TenantCurrencyCode)</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">Tax Rate</label>
                                    <div class="fw-semibold">@(Model.Product.TaxRate?.ToString("N2") ?? "0")%</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-graph-up"></i> Status</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="text-muted small">Status</label>
                                <div>
                                    @if (Model.Product.IsActive)
                                    {
                                        <span class="badge bg-success fs-6">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6">Inactive</span>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small">Created</label>
                                <div class="small">@Model.Product.CreatedAtUtc.ToString("MMM dd, yyyy")</div>
                                <div class="small text-muted">by @Model.Product.CreatedBy</div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a asp-page="./Edit" asp-route-id="@Model.Product.Id" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil me-1"></i>Edit Product
                                </a>
                                <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-list me-1"></i>View All Products
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="settings">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0"><i class="bi bi-gear"></i> Product Settings</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Product Type</label>
                                    <div><span class="badge bg-secondary fs-6">@Model.Product.Type</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Active Status</label>
                                    <div>
                                        @if (Model.Product.IsActive)
                                        {
                                            <span class="badge bg-success fs-6">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-6">Inactive</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a asp-page="./Edit" asp-route-id="@Model.Product.Id" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil me-1"></i>Edit Settings
                                </a>
                                <form method="post" onsubmit="return confirm('Delete this product?');">
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm w-100">
                                        <i class="bi bi-trash me-1"></i>Delete Product
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Guidelines</h6>
                        </div>
                        <div class="card-body">
                            <ul class="small mb-0 ps-3">
                                <li class="mb-2">Set to <strong>Inactive</strong> to hide from catalog</li>
                                <li class="mb-2">Change <strong>Type</strong> affects categorization</li>
                                <li>Deletion is <strong>permanent</strong></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
