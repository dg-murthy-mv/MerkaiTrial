@page "/Products/Detail/{id}"
@model MerkaiTrial.Admin.Web.Pages.Products.DetailModel
@{
    ViewData["Title"] = Model.Product.Name;
}
@* =====================================================================
   Pages/Products/Detail.cshtml — COMPLETE FILE (080).

   • "Additional details" — the product's custom fields, through the
     shared _CustomFieldValues card, under Product Information.
   • Edit, Activate/Deactivate and Delete render only for CanUpdate /
     CanDelete (every handler still checks for itself).
   • Delete is a modal; the name is rendered by Razor (encoded), never put
     into a script. When the product is part of a bundle the modal says
     the delete will be refused and offers Deactivate instead.
   • "Created" uses the workspace's date format (FormatDate).
   • The Settings tab is gone — it repeated Overview, and its "Deletion is
     permanent" was not true.
   • Messages after a redirect are rendered once, globally, by _Layout.
   ===================================================================== *@

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" 
                 style="width: 80px; height: 80px; background-color: @Model.GetCategoryColor();">
                <i class="@Model.GetCategoryIcon() text-white" style="font-size: 2.5rem;"></i>
            </div>
            <div>
                <h2 class="mb-1">@Model.Product.Name</h2>
                <p class="text-muted mb-0">
                    @* 068: shown as it is STORED. An orphaned category is
                       marked rather than hidden — hiding it would make the
                       product look uncategorized here while its Edit form
                       still carried the value. *@
                    @if (Model.Product.Category is null)
                    {
                        <span class="badge bg-light text-muted border me-2">Uncategorized</span>
                    }
                    else if (Model.IsCategoryOrphaned())
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle me-2"
                              title="No longer one of your categories">@Model.Product.Category</span>
                    }
                    else
                    {
                        <span class="badge bg-info me-2">@Model.Product.Category</span>
                    }
                    @if (Model.Product.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </p>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (Model.CanUpdate)
            {
                <a asp-page="./Edit" asp-route-id="@Model.Product.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> <span class="d-none d-sm-inline">Edit</span>
                </a>
            }
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back</span>
            </a>
        </div>
    </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-info-circle"></i> Product Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small">Product Name</label>
                                    <div class="fw-semibold">@Model.Product.Name</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">SKU</label>
                                    <div class="fw-semibold"><code>@(Model.Product.Sku ?? "-")</code></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Category</label>
                                    <div>
                                        @if (Model.Product.Category is null)
                                        {
                                            <span class="badge bg-light text-muted border fs-6">Uncategorized</span>
                                        }
                                        else
                                        {
                                            <span class="badge @(Model.IsCategoryOrphaned() ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : "bg-info") fs-6">@Model.Product.Category</span>
                                        }
                                    </div>
                                    @if (Model.IsCategoryOrphaned())
                                    {
                                        @* 068. Said plainly, with what to do about it.
                                           The product is fine; it is simply filed under
                                           something that is no longer on the list. *@
                                        <small class="text-warning-emphasis d-block mt-1">
                                            <i class="bi bi-info-circle me-1"></i>No longer one of your
                                            categories. Edit the product to pick another, or add it back
                                            under Settings &rarr; Product Categories.
                                        </small>
                                    }
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Type</label>
                                    <div><span class="badge bg-secondary fs-6">@Model.Product.Type</span></div>
                                </div>
                                <div class="col-12">
                                    <label class="text-muted small">Description</label>
                                    @if (string.IsNullOrWhiteSpace(Model.Product.Description))
                                    {
                                        <div class="text-muted">No description</div>
                                    }
                                    else
                                    {
                                        <div style="white-space: pre-line;">@Model.Product.Description</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    @* 080 — the workspace's own Product fields. Hidden entirely
                       when there are none and the person cannot add any. *@
                    <partial name="_CustomFieldValues" model="Model.CustomFieldDisplay" />

                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="bi bi-cash-stack"></i> Pricing Information</h5>
                        </div>
                        <div class="card-body">
                            @* 051: the unit and the tax classification code. A
                               price without its unit is ambiguous — ₹450 is a
                               different product per m² than per piece. *@
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="text-muted small">List Price</label>
                                    <div class="fs-4 fw-bold text-success">
                                        @Model.FormatCurrency(Model.Product.ListPrice)
                                        <span class="fs-6 fw-normal text-muted">@Model.PricedPer</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">Priced per</label>
                                    <div class="fw-semibold">@Model.UnitLabel</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">Currency</label>
                                    <div class="fw-semibold">@Model.TenantCurrencyName (@Model.TenantCurrencyCode)</div>
                                    <div class="form-text">The price above is in this currency.</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="text-muted small">Tax Rate</label>
                                    <div class="fw-semibold">@(Model.Product.TaxRate?.ToString("N2") ?? "0")%</div>
                                </div>

                                @* ── 069: PRICES IN OTHER CURRENCIES ──────────
                                   Shown only when there are any, so a
                                   single-currency workspace sees exactly the page
                                   it saw before this round.

                                   A quote takes its currency from its DEAL, so
                                   these are the prices a quote in one of these
                                   currencies will actually use. A currency NOT
                                   listed here has no price, and the quote line
                                   editor will say so rather than quietly using
                                   the @Model.TenantCurrencyCode figure — which is
                                   what it used to do. *@
                                @* ── 070: WHAT THIS BUNDLE CONTAINS ──────────
                                   A table, because the quantities line up and
                                   somebody checking a package reads down them.
                                   Shown only for a bundle.

                                   The components' own prices ARE shown here, and
                                   the total beside them — this page is for the
                                   person who sells it, not the customer. The
                                   breakdown that goes on a QUOTE carries names
                                   and quantities only; printing component prices
                                   there would invite the customer to add them up
                                   and find a different number. *@
                                @if (Model.IsBundle)
                                {
                                    <div class="col-12">
                                        <label class="text-muted small">What this bundle contains</label>
                                        @if (!Model.BundleItems.Any())
                                        {
                                            <div class="alert alert-warning py-2 px-3 small mb-0">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                This bundle is empty. A quote line raised from it would
                                                show a price with nothing under it — edit the product and
                                                add its contents.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-sm align-middle mb-1">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Product</th>
                                                            <th class="text-end">Qty</th>
                                                            <th class="text-end">Each</th>
                                                            <th class="text-end">Line</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in Model.BundleItems)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @item.ComponentName
                                                                    @if (!string.IsNullOrWhiteSpace(item.ComponentSku))
                                                                    {
                                                                        <code class="ms-1 small">@item.ComponentSku</code>
                                                                    }
                                                                    @if (!item.ComponentIsActive)
                                                                    {
                                                                        <span class="badge bg-secondary ms-1"
                                                                              title="Not sold separately any more. That is allowed — it stays in the bundle.">Inactive</span>
                                                                    }
                                                                </td>
                                                                <td class="text-end">@item.QuantityDisplay</td>
                                                                <td class="text-end text-muted">@Model.FormatCurrency(item.ComponentListPrice)</td>
                                                                <td class="text-end">@Model.FormatCurrency(item.ComponentListPrice * item.Quantity)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr class="fw-semibold">
                                                            <td colspan="3" class="text-end">Components total</td>
                                                            <td class="text-end">@Model.FormatCurrency(Model.ComponentsTotal)</td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="3" class="text-end text-muted">This bundle</td>
                                                            <td class="text-end">@Model.FormatCurrency(Model.Product.ListPrice)</td>
                                                        </tr>
                                                        @if (Model.BundleDiscountPercent is { } pct)
                                                        {
                                                            <tr class="@(pct >= 0 ? "text-success" : "text-warning-emphasis")">
                                                                <td colspan="3" class="text-end">
                                                                    @(pct >= 0 ? "Saving for the customer" : "Above the components total")
                                                                </td>
                                                                <td class="text-end fw-semibold">
                                                                    @Model.FormatCurrency(Math.Abs(Model.ComponentsTotal - Model.Product.ListPrice))
                                                                    (@Math.Abs(pct).ToString("0.#")%)
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tfoot>
                                                </table>
                                            </div>
                                            <div class="form-text">
                                                On a quote this is <strong>one line</strong> at the bundle price,
                                                with these listed in the description. The line carries the
                                                bundle's own tax rate and tax code — if these products are
                                                taxed differently, quote them separately.
                                            </div>
                                        }
                                    </div>
                                }

                                @* 070: the warning before somebody deactivates a
                                   product that other bundles depend on. Nothing
                                   else in the product would tell them. *@
                                @if (Model.Product.UsedInBundleCount > 0)
                                {
                                    <div class="col-12">
                                        <div class="alert alert-info py-2 px-3 small mb-0">
                                            <i class="bi bi-boxes me-1"></i>
                                            This product is part of
                                            <strong>@Model.Product.UsedInBundleCount
                                            @(Model.Product.UsedInBundleCount == 1 ? "bundle" : "bundles")</strong>.
                                            Deactivating it stops it being quoted on its own; the bundles keep it.
                                        </div>
                                    </div>
                                }

                                @if (Model.OtherPrices.Any())
                                {
                                    <div class="col-12">
                                        <label class="text-muted small">Prices in other currencies</label>
                                        <div class="table-responsive">
                                            <table class="table table-sm mb-1" style="max-width:28rem;">
                                                <tbody>
                                                    @foreach (var price in Model.OtherPrices)
                                                    {
                                                        <tr>
                                                            <td class="text-muted" style="width:9rem;">
                                                                @Model.CurrencyLabel(price.CurrencyCode)
                                                            </td>
                                                            <td class="fw-semibold">
                                                                @Model.FormatInCurrency(price.ListPrice, price.CurrencyCode)
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="form-text">
                                            Used by quotes raised in these currencies. A currency with no
                                            price here cannot be quoted from this product until one is set.
                                        </div>
                                    </div>
                                }
                                <div class="col-md-8">
                                    <label class="text-muted small">@Model.TaxCodeLabel</label>
                                    <div class="fw-semibold">
                                        @if (string.IsNullOrWhiteSpace(Model.Product.TaxCode))
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                        else
                                        {
                                            <code>@Model.Product.TaxCode</code>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-graph-up"></i> Status</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="text-muted small">Status</label>
                                <div>
                                    @if (Model.Product.IsActive)
                                    {
                                        <span class="badge bg-success fs-6">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6">Inactive</span>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small">Created</label>
                                <div class="small">@Model.FormatDate(Model.Product.CreatedAtUtc)</div>
                                @if (!string.IsNullOrWhiteSpace(Model.Product.CreatedBy))
                                {
                                    <div class="small text-muted">by @Model.Product.CreatedBy</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-lightning"></i> Quick actions</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                @if (Model.CanUpdate)
                                {
                                    <a asp-page="./Edit" asp-route-id="@Model.Product.Id" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil me-1"></i>Edit product
                                    </a>
                                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@Model.Product.Id" class="d-grid">
                                        @if (Model.Product.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                    title="Keeps it on existing quotes; it can no longer be added to new ones">
                                                <i class="bi bi-pause-circle me-1"></i>Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm">
                                                <i class="bi bi-play-circle me-1"></i>Activate
                                            </button>
                                        }
                                    </form>
                                }
                                <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-list me-1"></i>All products
                                </a>
                                @if (Model.CanDelete)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            data-bs-toggle="modal" data-bs-target="#deleteProductModal">
                                        <i class="bi bi-trash me-1"></i>Delete product
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
</div>

@if (Model.CanDelete)
{
    var inBundles = Model.Product.UsedInBundleCount;
    <div class="modal fade" id="deleteProductModal" tabindex="-1" aria-labelledby="deleteProductLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Product.Id" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteProductLabel">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete product
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (inBundles > 0)
                    {
                        @* The API refuses this delete; say so before the click,
                           and offer the thing that does work. *@
                        <div class="alert alert-warning small mb-0">
                            <i class="bi bi-boxes me-1"></i>
                            <strong>@Model.Product.Name</strong> is part of
                            <strong>@inBundles @(inBundles == 1 ? "bundle" : "bundles")</strong>, so it can't be deleted.
                            Take it out of @(inBundles == 1 ? "that bundle" : "those bundles") first —
                            or deactivate it, which stops it being quoted on its own and keeps the bundles intact.
                        </div>
                    }
                    else
                    {
                        <p class="mb-2">Delete <strong>@Model.Product.Name</strong>?</p>
                        <p class="text-muted small mb-0">
                            Quotes and invoices that already list it keep their lines as they are.
                            It can no longer be added to new ones.
                        </p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    @if (inBundles == 0)
                    {
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Delete product
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
}
