@page "/Products/Edit/{id}"
@using System.Linq
@model MerkaiTrial.Admin.Web.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-pencil text-warning"></i> Edit Product</h2>
            <p class="text-muted mb-0">@Model.Input.Name</p>
        </div>
        <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back</span>
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* 069: id= so _PriceGrid can hook this form's submit event. *@
    <form method="post" id="productForm">
        <input type="hidden" asp-for="Id" />
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Product Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Input.Name" class="form-label">
                                    Product Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Name" class="form-control" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Description" class="form-label">Description</label>
                                <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Sku" class="form-label">SKU</label>
                                <input asp-for="Input.Sku" class="form-control" />
                                <span asp-validation-for="Input.Sku" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Category" class="form-label">
                                    Category <span class="text-danger">*</span>
                                </label>
                                @* 068: the workspace's own categories, from
                                   Settings -> Product Categories, rather than the
                                   eight hardcoded ones. An EMPTY list is a real
                                   state — every category removed, or the API
                                   unreachable — and a dropdown with one dead
                                   placeholder in it explains nothing, so say what
                                   to do instead. *@
                                @if (Model.CategoryNames.Any())
                                {
                                    <select asp-for="Input.Category" asp-items="Model.GetCategoryOptions()" class="form-select">
                                        <option value="">-- Select Category --</option>
                                    </select>
                                }
                                else
                                {
                                    <select class="form-select" disabled>
                                        <option>No categories available</option>
                                    </select>
                                    <div class="form-text text-warning-emphasis">
                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        Your workspace has no product categories.
                                        <a asp-page="/Settings/ProductCategories/Index">Add one</a>
                                        and come back — a product needs a category.
                                    </div>
                                }
                                <span asp-validation-for="Input.Category" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><span class="text-white fw-bold fs-5">@Model.TenantCurrencySymbol</span> Pricing</h5>
                    </div>
                    <div class="card-body">
                        @* 051: "Priced per" and the tax classification code.
                           The unit is what makes a price mean something — ₹450
                           is a different product at ₹450/m² than at ₹450/unit,
                           and until this existed a quote line's quantity was a
                           bare number with no unit at all. *@
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Input.ListPrice" class="form-label">
                                    List Price <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text fw-semibold">@Model.TenantCurrencySymbol</span>
                                    <input asp-for="Input.ListPrice" class="form-control" type="number" step="0.01" min="0.01" />
                                </div>
                                <span asp-validation-for="Input.ListPrice" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Input.UnitOfMeasure" class="form-label">
                                    Priced per <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.UnitOfMeasure" asp-items="Model.GetUnitOptions()"
                                        class="form-select" id="unitOfMeasure"></select>
                                <div class="form-text" id="unitHint">
                                    What one of this product is. Quotes can use fractions — 12.5 m², 2.5 days.
                                </div>
                                <span asp-validation-for="Input.UnitOfMeasure" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                @* Currency is workspace-level — not editable per
                                   product. The price ABOVE is in this currency; see
                                   Product.ListPrice. 069 adds the other currencies
                                   in their own block below rather than making this
                                   field editable, because changing a product's
                                   currency and adding a second price are two
                                   different intentions. *@
                                <label class="form-label">Currency</label>
                                <input type="hidden" asp-for="Input.Currency" />
                                <input class="form-control bg-light" value="@Model.TenantCurrencyCode — @Model.TenantCurrencyName" readonly />
                                <div class="form-text">Set by your workspace configuration.</div>
                            </div>

                            @* ── 069: PRICES IN OTHER CURRENCIES ──────────
                               Full width, below the home price rather than
                               beside it, because it is a list that grows and
                               the three fields above it are singular.

                               WHY THIS IS HERE AND NOT ONLY ON THE EDIT PAGE:
                               a product's non-home prices are part of deciding
                               what the product IS. Making somebody save it
                               first and then come back would mean the first
                               quote raised in USD against a brand-new product
                               has no price — which is the exact hole this round
                               is closing. *@
                            <div class="col-12">
                                <label class="form-label">Prices in other currencies</label>
                                <partial name="_PriceGrid" model="Model.PriceGrid" />
                            </div>

                            @* ── 070: WHAT A BUNDLE CONTAINS ──────────────
                               Hidden unless the kind is Bundle. Shown and
                               hidden by the script at the bottom of this page
                               without a round trip, because somebody choosing
                               "Bundle" from the dropdown should not have to
                               save first to find out what that means.

                               ALWAYS RENDERED, not conditionally: the grid
                               posts a hidden field, and a field that is absent
                               from the DOM posts nothing — which the API reads
                               as "the caller said nothing about contents" and
                               leaves them alone. For a product being changed
                               FROM a bundle TO a service that is almost right,
                               and the handler clears the contents anyway, but
                               rendering it always means the browser and the
                               server agree about what an empty bundle looks
                               like. *@
                            <div class="col-12 d-none" id="bundleSection">
                                <label class="form-label">What this bundle contains</label>
                                <partial name="_BundleGrid" model="Model.BundleGrid" />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Input.TaxRate" class="form-label">Tax Rate (%)</label>
                                <input asp-for="Input.TaxRate" class="form-control" type="number" step="0.01" min="0" max="100" placeholder="e.g., 18.00" />
                                @* 051: this is no longer decorative. Until round 050
                                   the quote line always took the workspace default
                                   and ignored whatever was set here. *@
                                <div class="form-text">Used on quote lines for this product. Leave at 0 for tax-exempt.</div>
                                <span asp-validation-for="Input.TaxRate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-8">
                                <label asp-for="Input.TaxCode" class="form-label">@Model.TaxCodeLabel</label>
                                <input asp-for="Input.TaxCode" class="form-control" maxlength="20"
                                       spellcheck="false" autocapitalize="characters" placeholder="Optional" />
                                <div class="form-text">@Model.TaxCodeHint</div>
                                <span asp-validation-for="Input.TaxCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-lightning"></i> Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                            <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-gear"></i> Settings</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Input.Type" class="form-label">
                                Product Type <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Input.Type" asp-items="Model.GetTypeOptions()" class="form-select"></select>
                            @* 051: the three values come from ProductKinds now, not from
                               a string array copied into this page's model and the other
                               one's. The hint is rendered server-side for the saved kind. *@
                            <div class="form-text">@Model.KindHint</div>
                            <span asp-validation-for="Input.Type" class="text-danger small"></span>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="Input.IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Guidelines</h6>
                    </div>
                    <div class="card-body">
                        <ul class="small mb-0 ps-3">
                            <li class="mb-2">Changes apply <strong>immediately</strong> across the system</li>
                            <li class="mb-2">Update <strong>price</strong> or <strong>tax rate</strong> as needed</li>
                            <li>Set to <strong>Inactive</strong> to hide from catalog</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @* ── 070 ─────────────────────────────────────────────────────────────
       Show the bundle grid only for the Bundle kind.

       Not in _BundleGrid itself: the partial owns the grid, this page owns
       the layout, and a partial reaching out to toggle a container it does
       not render would be the kind of coupling that breaks the first time
       somebody moves the markup.

       Delegated listener on document, no inline handler — the rule round
       029 set for the quote line editor and kept since. *@
    <script>
        (function () {
            'use strict';
            var sel = document.getElementById('Input_Type');
            var box = document.getElementById('bundleSection');
            if (!sel || !box) return;

            function apply() {
                // Case-insensitive, matching ProductKinds.IsBundle on the
                // server. A value of "bundle" from an older row would
                // otherwise hide the grid on a product that has one.
                var isBundle = (sel.value || '').toLowerCase() === 'bundle';
                box.classList.toggle('d-none', !isBundle);
            }

            sel.addEventListener('change', apply);
            apply();
        })();
    </script>
}
