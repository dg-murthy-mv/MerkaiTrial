@page "/Products"
@model MerkaiTrial.Admin.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-box-seam text-primary"></i> Products</h2>
            <p class="text-muted mb-0">Manage your product catalog</p>
        </div>
        @* ✅ Plan badge *@
        <span class="badge @Model.PlanBadgeClass fs-6 px-3 py-2">
            @Model.PlanDisplayName
        </span>
        @if (Model.CanCreate)
        {
            <a asp-page="./Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> <span class="d-none d-sm-inline">Add Product</span>                
            </a>

        }
    </div>

    @* Alert messages are rendered once, globally, by _Layout.cshtml — do not duplicate here. *@

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" 
                             style="width: 60px; height: 60px; background: linear-gradient(135deg, #3b82f6, #2563eb);">
                            <i class="bi bi-box-seam text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Total Products</h6>
                            <h3 class="mb-0">@Model.Stats.TotalProducts</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" 
                             style="width: 60px; height: 60px; background: linear-gradient(135deg, #10b981, #059669);">
                            <i class="bi bi-check-circle text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Active Products</h6>
                            <h3 class="mb-0">@Model.Stats.ActiveProducts</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" 
                             style="width: 60px; height: 60px; background: linear-gradient(135deg, #f59e0b, #d97706);">
                            <span class="text-white fw-bold fs-5">@Model.TenantCurrencySymbol</span>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Total Value</h6>
                            <h3 class="mb-0">@Model.FormatCurrency(Model.Stats.TotalValue, 0)</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" 
                             style="width: 60px; height: 60px; background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                            <i class="bi bi-grid text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Categories</h6>
                            <h3 class="mb-0">@Model.Stats.CategoriesCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                <div class="col-lg-4 col-md-6">
                    <label class="form-label small fw-semibold"><i class="bi bi-search me-1"></i>Search</label>
                    <input type="text" class="form-control" name="SearchTerm" value="@Model.SearchTerm" placeholder="Product name, SKU..." />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold"><i class="bi bi-tag me-1"></i>Category</label>
                    <select class="form-select" name="CategoryFilter" asp-items="Model.GetCategoryFilterOptions()"></select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold"><i class="bi bi-toggle-on me-1"></i>Status</label>
                    <select class="form-select" name="IsActiveFilter" asp-items="Model.GetIsActiveFilterOptions()"></select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search d-md-none"></i><span class="d-none d-md-inline">Search</span>
                        </button>
                        <a asp-page="./Index" asp-route-pagesize="@Model.PageSize" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Desktop Table -->
    <div class="card border-0 shadow-sm d-none d-md-block">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>Products List
                <span class="badge bg-white text-primary ms-2">@Model.PaginatedProducts.TotalCount</span>
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Product</th>
                        <th>Category</th>
                        <th>SKU</th>
                        <th>Price</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.PaginatedProducts.Items)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center">
                                    <i class="@Model.GetCategoryIcon(product.Category) fs-4 me-3" style="color: @Model.GetCategoryColor(product.Category);"></i>
                                    <div>
                                        <strong>@product.Name</strong>
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <br /><small class="text-muted">@product.Description</small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-info">@(product.Category ?? "Uncategorized")</span></td>
                            <td><code>@(product.Sku ?? "-")</code></td>
                            <td>
                                <strong>@Model.FormatCurrency(product.ListPrice)</strong>
                                @if (product.TaxRate.HasValue)
                                {
                                    <br /><small class="text-muted">+@product.TaxRate.Value% tax</small>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@product.Type</span></td>
                            <td>
                                @if (Model.CanUpdate)
                                {
                                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@product.Id" class="d-inline">
                                        <div class="form-check form-switch mb-0" title="@(product.IsActive ? "Click to deactivate" : "Click to activate")">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   @(product.IsActive ? "checked" : "")
                                                   onchange="this.form.submit()"
                                                   style="cursor:pointer; width:2.5em; height:1.3em;" />
                                            <label class="form-check-label small @(product.IsActive ? "text-success fw-semibold" : "text-muted")">
                                                @(product.IsActive ? "Active" : "Inactive")
                                            </label>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                                        @(product.IsActive ? "Active" : "Inactive")
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="./Detail" asp-route-id="@product.Id" class="btn btn-outline-primary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (Model.CanUpdate)
                                    {
                                        <a asp-page="./Edit" asp-route-id="@product.Id" class="btn btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (Model.CanDelete)
                                    {
                                        <button type="button" class="btn btn-outline-danger" onclick="confirmDelete('@product.Id', '@product.Name')" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Cards -->
    <div class="d-md-none">
        @foreach (var product in Model.PaginatedProducts.Items)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-start mb-3">
                        <i class="@Model.GetCategoryIcon(product.Category) fs-3 me-3" style="color: @Model.GetCategoryColor(product.Category);"></i>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">@product.Name</h6>
                            <div class="d-flex gap-2 flex-wrap">
                                <span class="badge bg-info">@(product.Category ?? "Uncategorized")</span>
                                <span class="badge bg-secondary">@product.Type</span>
                                @if (Model.CanUpdate)
                                {
                                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@product.Id" class="d-inline">
                                        <button type="submit" class="badge border-0 @(product.IsActive ? "bg-success" : "bg-danger")"
                                                title="@(product.IsActive ? "Click to deactivate" : "Click to activate")"
                                                style="cursor:pointer;">
                                            @(product.IsActive ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                                        @(product.IsActive ? "Active" : "Inactive")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <small class="text-muted">Price</small>
                            <div><strong>@Model.FormatCurrency(product.ListPrice)</strong></div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">SKU</small>
                            <div><code>@(product.Sku ?? "-")</code></div>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-page="./Detail" asp-route-id="@product.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-eye me-1"></i>View Details
                        </a>
                        @if (Model.CanUpdate || Model.CanDelete)
                        {
                            <div class="btn-group">
                                @if (Model.CanUpdate)
                                {
                                    <a asp-page="./Edit" asp-route-id="@product.Id" class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                }
                                @if (Model.CanDelete)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="confirmDelete('@product.Id', '@product.Name')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.PaginatedProducts.Items.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                <p class="text-muted mb-0">No products found.</p>
            </div>
        </div>
    }

    <!-- Pagination -->
    @if (Model.PaginatedProducts.Items.Any())
    {
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <form method="get" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="CategoryFilter" value="@Model.CategoryFilter" />
                        <input type="hidden" name="IsActiveFilter" value="@Model.IsActiveFilter" />
                        <input type="hidden" name="Page" value="1" />
                        <label class="col-form-label small mb-0">Items per page:</label>
                        <select name="PageSize" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                            <option value="5" selected="@(Model.PageSize == 5)">5</option>
                            <option value="10" selected="@(Model.PageSize == 10)">10</option>
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100</option>
                        </select>
                    </form>
                    <span class="text-muted small">
                        Showing @((Model.Page - 1) * Model.PageSize + 1) to @Math.Min(Model.Page * Model.PageSize, Model.PaginatedProducts.TotalCount) of @Model.PaginatedProducts.TotalCount
                    </span>
                </div>
                <nav>
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(!Model.PaginatedProducts.HasPrevious ? "disabled" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-page="@(Model.Page - 1)" asp-route-pagesize="@Model.PageSize" asp-route-searchterm="@Model.SearchTerm" asp-route-categoryfilter="@Model.CategoryFilter" asp-route-isactivefilter="@Model.IsActiveFilter">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        </li>
                        @{
                            var start = Math.Max(1, Model.Page - 2);
                            var end = Math.Min(Model.PaginatedProducts.TotalPages, Model.Page + 2);
                            for (int i = start; i <= end; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" asp-page="./Index" asp-route-page="@i" asp-route-pagesize="@Model.PageSize" asp-route-searchterm="@Model.SearchTerm" asp-route-categoryfilter="@Model.CategoryFilter" asp-route-isactivefilter="@Model.IsActiveFilter">@i</a>
                                </li>
                            }
                        }
                        <li class="page-item @(!Model.PaginatedProducts.HasNext ? "disabled" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-page="@(Model.Page + 1)" asp-route-pagesize="@Model.PageSize" asp-route-searchterm="@Model.SearchTerm" asp-route-categoryfilter="@Model.CategoryFilter" asp-route-isactivefilter="@Model.IsActiveFilter">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<form method="post" id="deleteForm">
    <input type="hidden" name="id" id="deleteId" />
</form>

@section Scripts {
    <script>
        // Alert auto-dismiss is handled globally by _Layout.cshtml — do not duplicate here.
        function confirmDelete(id, name) {
            if (confirm(`Delete "${name}"?`)) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').action = '?handler=Delete&id=' + id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}
