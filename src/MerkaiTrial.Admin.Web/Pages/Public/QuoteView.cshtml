@page "/q/{Token}"
@model MerkaiTrial.Admin.Web.Pages.Public.QuoteViewModel
@{
    Layout   = null;   // Standalone public page — no sidebar/nav, and no
                       // _Layout, which injects ICurrentTenantService and
                       // would throw for a visitor with no tenant claim.
    ViewData["Title"] = Model.Quote != null
        ? $"Quote {Model.Quote.Number}"
        : "Quote";
}
@* =====================================================================
   Public/QuoteView.cshtml — REVISED (059).

   The only page in the product a CUSTOMER reads. Changes this round:

     - item.Quantity  ->  item.QuantityDisplay
       052 made Quantity decimal(18,4) and every line has been printing
       "2.0000" since. QuantityDisplay trims the zeros and carries the
       unit of measure, so "12.5 m²" and "3" both read correctly.

     - Tax column no longer rounds. (TaxRate * 100).ToString("N0")
       printed a 12.5% line as "13%". Model.FormatTaxRate now.

     - A per-line Discount column (055), shown only when some line
       actually has one. Without it, unit price x qty did not reach the
       line total and nothing on the page said why.

     - The header falls back to the contact when there is no company
       (053), instead of rendering a blank line.

     - The expired banner was text-warning on a white card: amber on
       white, effectively unreadable. text-warning-emphasis.

     - Dropped the ?message=accepted banner. Our own redirect never sets
       that parameter, so it was dead — and if anyone did hand-craft it,
       it stacked a second green banner on top of the IsAccepted one.
   ===================================================================== *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] — Merkai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: #f0f4ff; font-family: 'Segoe UI', sans-serif; }
        .quote-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(99,102,241,0.1);
            max-width: 920px;
            margin: 2rem auto;
            overflow: hidden;
        }
        .quote-header-bar {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: white;
            padding: 2rem 2.5rem;
        }
        .quote-body { padding: 2rem 2.5rem; }
        .quote-number { font-size: 1.6rem; font-weight: 700; }
        .company-name { font-size: 1.1rem; opacity: 0.9; }
        .contact-name { font-size: 0.9rem; opacity: 0.75; }
        .section-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #6366f1;
            margin-bottom: 0.5rem;
        }
        .totals-box {
            background: #f8f9ff;
            border: 1px solid #e0e7ff;
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
        }
        .grand-total-row {
            font-size: 1.5rem;
            font-weight: 700;
            color: #4f46e5;
            border-top: 2px solid #e0e7ff;
            padding-top: 0.75rem;
            margin-top: 0.5rem;
        }
        .action-bar {
            background: #f8f9ff;
            border-top: 1px solid #e0e7ff;
            padding: 1.5rem 2.5rem;
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            flex-wrap: wrap;
        }
        .btn-accept {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border: none;
            color: white;
            padding: 0.75rem 2rem;
            font-weight: 600;
            border-radius: 8px;
            font-size: 1rem;
        }
        .btn-accept:hover { background: #059669; color: white; }
        .btn-decline {
            background: white;
            border: 1.5px solid #ef4444;
            color: #ef4444;
            padding: 0.75rem 2rem;
            font-weight: 600;
            border-radius: 8px;
            font-size: 1rem;
        }
        .btn-decline:hover { background: #fef2f2; }
        .status-banner {
            border-radius: 10px;
            padding: 1.25rem 1.5rem;
            font-weight: 600;
            font-size: 1rem;
        }
        .validity-badge {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            border-radius: 6px;
            padding: 0.2rem 0.75rem;
            font-size: 0.85rem;
        }
        /* 065 — the seller's letterhead. Sits under the purple header on
           the white card, above the items: who it is from, then what is
           in it. Quiet on purpose — the customer came to read the prices,
           not the supplier's address, but they must be able to find it. */
        .seller {
            padding: 1.25rem 2.5rem 0;
            display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: flex-start;
        }
        .seller .lbl {
            font-size: .68rem; text-transform: uppercase; letter-spacing: .07em;
            color: #94a3b8; font-weight: 700; margin-bottom: .3rem;
        }
        .seller .nm  { font-weight: 700; color: #0f172a; font-size: .98rem; }
        .seller .ln  { color: #64748b; font-size: .84rem; line-height: 1.5; }
        .seller .tax {
            color: #0f172a; font-size: .84rem; margin-top: .35rem;
            font-weight: 600;
        }
        .seller a { color: #4f46e5; text-decoration: none; }
        .seller a:hover { text-decoration: underline; }

        /* The quantity now carries a unit ("12.5 m²"), so it must not wrap
           between the number and the unit. */
        .qty-cell { white-space: nowrap; }
        .discount-cell { white-space: nowrap; color: #059669; font-weight: 600; }
        .discount-none { color: #cbd5e1; font-weight: 400; }

        /* 067. Monospaced: a classification code is a reference number a
           customer or their accountant reads digit by digit, and a
           proportional font makes 1 / 7 and 0 / 8 work harder than they
           should at this size. */
        .tax-code-cell { white-space: nowrap; font-size: .9rem; color: #334155;
                         font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
        .tax-code-none { color: #cbd5e1; font-weight: 400; font-family: inherit; }

        @@media (max-width: 600px) {
            .quote-header-bar, .quote-body, .action-bar { padding: 1.25rem; }
            .action-bar { justify-content: stretch; }
            .action-bar form, .action-bar button { width: 100%; }
            .btn-accept, .btn-decline { width: 100%; }
        }
    </style>
</head>
<body>

@if (Model.Quote == null)
{
    <div class="quote-card mt-5">
        <div class="quote-header-bar text-center py-5">
            <i class="bi bi-exclamation-circle fs-1 mb-3 d-block"></i>
            <h2>Quote Not Found</h2>
            <p class="opacity-75">This link may be invalid or expired.</p>
        </div>
    </div>
}
else
{
    <div class="quote-card">

        <!-- ── Header ───────────────────────────────────────────────── -->
        <div class="quote-header-bar">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <div class="quote-number mb-1">@Model.Quote.Number</div>

                    @* 053: the company, or the person when the sale is
                       genuinely person-to-person. CompanyName alone left a
                       blank line on those quotes. *@
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerHeading))
                    {
                        <div class="company-name">@Model.CustomerHeading</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerSubheading))
                    {
                        <div class="contact-name">
                            <i class="bi bi-person me-1"></i>@Model.CustomerSubheading
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Quote.DealTitle))
                    {
                        <div class="opacity-75 small mt-1">Re: @Model.Quote.DealTitle</div>
                    }
                </div>
                <div class="text-end">
                    <div class="validity-badge mb-1">
                        <i class="bi bi-calendar3 me-1"></i>
                        Valid until @Model.Quote.ExpiresAtUtc.ToString("dd MMM yyyy")
                    </div>
                    <div class="small opacity-75 mt-1">
                        Issued @Model.Quote.IssueDateUtc.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Status banners ──────────────────────────────────────── -->
        @if (Model.IsAccepted)
        {
            <div class="mx-4 mt-4">
                <div class="status-banner bg-success bg-opacity-10 text-success-emphasis border border-success border-opacity-25">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    You have accepted this quote. Our team will be in touch shortly.
                </div>
            </div>
        }
        else if (Model.IsRejected)
        {
            <div class="mx-4 mt-4">
                <div class="status-banner bg-danger bg-opacity-10 text-danger-emphasis border border-danger border-opacity-25">
                    <i class="bi bi-x-circle-fill me-2"></i>
                    This quote has been declined.
                </div>
            </div>
        }
        else if (Model.IsExpired)
        {
            @* Was text-warning: amber text on a white card, which is
               almost unreadable. -emphasis is the dark variant. *@
            <div class="mx-4 mt-4">
                <div class="status-banner bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25">
                    <i class="bi bi-clock-history me-2"></i>
                    This quote has expired. Please contact us for an updated quote.
                </div>
            </div>
        }

        @* ── 065: WHO THIS IS FROM ─────────────────────────────────
           Drawn only when the workspace has filled in its Company
           Profile. Before this round the page never named the seller at
           all, so a customer had a quote for ฿25,246.65 with an Accept
           button and no idea who they were agreeing with. *@
        @if (Model.ShowSeller)
        {
            var seller = Model.Seller!;
            <div class="seller">
                <div>
                    <div class="lbl">Quote from</div>
                    <div class="nm">@seller.DisplayName</div>
                    <div class="ln">
                        @foreach (var line in seller.AddressLines())
                        {
                            @line<br />
                        }
                    </div>
                    @{ var sellerTax = seller.TaxLine(); }
                    @if (sellerTax is not null)
                    {
                        <div class="tax">@sellerTax</div>
                    }
                </div>

                @{ var sellerContact = seller.ContactLine(); }
                @if (!string.IsNullOrWhiteSpace(sellerContact))
                {
                    <div style="margin-left:auto; text-align:right;">
                        <div class="lbl">Questions?</div>
                        <div class="ln">
                            @* Each one tappable on a phone, which is where
                               a customer most often opens one of these. *@
                            @if (!string.IsNullOrWhiteSpace(seller.Phone))
                            {
                                <a href="tel:@seller.Phone">@seller.Phone</a><br />
                            }
                            @if (!string.IsNullOrWhiteSpace(seller.Email))
                            {
                                <a href="mailto:@seller.Email">@seller.Email</a><br />
                            }
                            @if (!string.IsNullOrWhiteSpace(seller.Website))
                            {
                                <span>@seller.Website</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <!-- ── Body ─────────────────────────────────────────────────── -->
        <div class="quote-body">

            <!-- Line items -->
            <div class="section-label mb-2">Items</div>
            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Item</th>
                            @* 067: a column, not a sub-line under the item name,
                               because this page is the customer's own copy of the
                               document and has to match the PDF they may print or
                               forward to their accountant. Drawn only when a line
                               has a code — the same rule the Discount column above
                               has followed since 059. *@
                            @if (Model.HasAnyLineTaxCode)
                            {
                                <th scope="col">@Model.TaxCodeLabel</th>
                            }
                            <th scope="col" class="text-center">Qty</th>
                            <th scope="col" class="text-end">Unit Price</th>
                            @if (Model.HasAnyLineDiscount)
                            {
                                <th scope="col" class="text-end">Discount</th>
                            }
                            <th scope="col" class="text-end">@Model.TaxLabel</th>
                            <th scope="col" class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Quote.Items.Count; i++)
                        {
                            var item = Model.Quote.Items[i];
                            var discount = Model.FormatLineDiscount(item);
                            <tr>
                                <td class="text-muted">@(i + 1)</td>
                                <td>
                                    <div class="fw-semibold">@item.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="text-muted small">@item.Description</div>
                                    }
                                </td>
                                @if (Model.HasAnyLineTaxCode)
                                {
                                    @* 067: an em dash where a line has no code, so
                                       the customer can tell "not classified" from a
                                       cell that failed to render. *@
                                    <td class="tax-code-cell @(item.HasTaxCode ? "" : "tax-code-none")">
                                        @(item.HasTaxCode ? item.TaxCode : "—")
                                    </td>
                                }
                                @* 052: QuantityDisplay, not Quantity. The raw
                                   decimal prints "2.0000" at scale 4. *@
                                <td class="text-center qty-cell">@item.QuantityDisplay</td>
                                <td class="text-end">
                                    @Model.FormatCurrency(item.UnitPrice)
                                </td>
                                @if (Model.HasAnyLineDiscount)
                                {
                                    <td class="text-end discount-cell @(discount == "—" ? "discount-none" : "")">
                                        @discount
                                    </td>
                                }
                                @* 059: no longer "N0" — a 12.5% line printed 13%. *@
                                <td class="text-end text-muted">
                                    @Model.FormatTaxRate(item.TaxRate)
                                </td>
                                <td class="text-end fw-semibold">
                                    @Model.FormatCurrency(item.LineGrandTotal)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Totals -->
            <div class="row justify-content-end">
                <div class="col-md-5 col-12">
                    <div class="totals-box">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Subtotal</span>
                            <span>@Model.FormatCurrency(Model.Quote.Subtotal)</span>
                        </div>
                        @if (Model.Quote.DiscountTotal > 0)
                        {
                            <div class="d-flex justify-content-between mb-1 text-success">
                                <span>Discount</span>
                                <span>-@Model.FormatCurrency(Model.Quote.DiscountTotal)</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">@Model.TaxLabel</span>
                            <span>@Model.FormatCurrency(Model.Quote.TaxTotal)</span>
                        </div>
                        <div class="d-flex justify-content-between grand-total-row">
                            <span>Total</span>
                            <span>@Model.FormatCurrency(Model.Quote.GrandTotal) @Model.Quote.Currency</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terms -->
            <div class="mt-4 pt-3 border-top text-muted small">
                <i class="bi bi-info-circle me-1"></i>
                This quote is valid until <strong>@Model.Quote.ExpiresAtUtc.ToString("dd MMMM yyyy")</strong>.
                All amounts are in <strong>@Model.Quote.Currency</strong>.
                Prices are subject to change after the validity period.
            </div>
        </div>

        <!-- ── Action bar ───────────────────────────────────────────── -->
        @* Model.CanDecide is the SAME expression the POST handlers check,
           so the button and the rule behind it cannot drift apart. The
           handlers re-read the quote regardless — a hidden button is not
           a control. *@
        @if (Model.CanDecide)
        {
            <div class="action-bar">
                <form method="post" asp-page-handler="Decline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Token" value="@Model.Token" />
                    <button type="submit" class="btn-decline"
                            onclick="return confirm('Are you sure you want to decline this quote?')">
                        <i class="bi bi-x-circle me-2"></i>Decline
                    </button>
                </form>
                <form method="post" asp-page-handler="Accept">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Token" value="@Model.Token" />
                    <button type="submit" class="btn-accept">
                        <i class="bi bi-check-circle me-2"></i>Accept Quote
                    </button>
                </form>
            </div>
        }

    </div>

    <!-- Powered by -->
    <div class="text-center text-muted small pb-4">
        Powered by <strong>Merkai CRM</strong>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
