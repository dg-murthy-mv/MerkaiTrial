@page "/q/{Token}"
@model MerkaiTrial.Admin.Web.Pages.Public.QuoteViewModel
@{
    Layout   = null;   // ✅ No layout — standalone public page, no sidebar/nav
    ViewData["Title"] = Model.Quote != null
        ? $"Quote {Model.Quote.Number}"
        : "Quote";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Merkai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: #f0f4ff; font-family: 'Segoe UI', sans-serif; }
        .quote-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(99,102,241,0.1);
            max-width: 860px;
            margin: 2rem auto;
            overflow: hidden;
        }
        .quote-header-bar {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: white;
            padding: 2rem 2.5rem;
        }
        .quote-body { padding: 2rem 2.5rem; }
        .quote-number { font-size: 1.6rem; font-weight: 700; }
        .company-name { font-size: 1.1rem; opacity: 0.9; }
        .section-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #6366f1;
            margin-bottom: 0.5rem;
        }
        .totals-box {
            background: #f8f9ff;
            border: 1px solid #e0e7ff;
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
        }
        .grand-total-row {
            font-size: 1.5rem;
            font-weight: 700;
            color: #4f46e5;
            border-top: 2px solid #e0e7ff;
            padding-top: 0.75rem;
            margin-top: 0.5rem;
        }
        .action-bar {
            background: #f8f9ff;
            border-top: 1px solid #e0e7ff;
            padding: 1.5rem 2.5rem;
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            flex-wrap: wrap;
        }
        .btn-accept {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border: none;
            color: white;
            padding: 0.75rem 2rem;
            font-weight: 600;
            border-radius: 8px;
            font-size: 1rem;
        }
        .btn-accept:hover { background: #059669; color: white; }
        .btn-decline {
            background: white;
            border: 1.5px solid #ef4444;
            color: #ef4444;
            padding: 0.75rem 2rem;
            font-weight: 600;
            border-radius: 8px;
            font-size: 1rem;
        }
        .btn-decline:hover { background: #fef2f2; }
        .status-banner {
            border-radius: 10px;
            padding: 1.25rem 1.5rem;
            font-weight: 600;
            font-size: 1rem;
        }
        .validity-badge {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            border-radius: 6px;
            padding: 0.2rem 0.75rem;
            font-size: 0.85rem;
        }
        @@media (max-width: 600px) {
            .quote-header-bar, .quote-body, .action-bar { padding: 1.25rem; }
            .action-bar { justify-content: stretch; }
            .action-bar form, .action-bar button { width: 100%; }
            .btn-accept, .btn-decline { width: 100%; }
        }
    </style>
</head>
<body>

@if (Model.Quote == null)
{
    <div class="quote-card mt-5">
        <div class="quote-header-bar text-center py-5">
            <i class="bi bi-exclamation-circle fs-1 mb-3 d-block"></i>
            <h2>Quote Not Found</h2>
            <p class="opacity-75">This link may be invalid or expired.</p>
        </div>
    </div>
}
else
{
    <div class="quote-card">

        <!-- ── Header ───────────────────────────────────────────────── -->
        <div class="quote-header-bar">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <div class="quote-number mb-1">@Model.Quote.Number</div>
                    <div class="company-name">@Model.Quote.CompanyName</div>
                    @if (!string.IsNullOrEmpty(Model.Quote.DealTitle))
                    {
                        <div class="opacity-75 small mt-1">Re: @Model.Quote.DealTitle</div>
                    }
                </div>
                <div class="text-end">
                    <div class="validity-badge mb-1">
                        <i class="bi bi-calendar3 me-1"></i>
                        Valid until @Model.Quote.ExpiresAtUtc.ToString("dd MMM yyyy")
                    </div>
                    <div class="small opacity-75 mt-1">
                        Issued @Model.Quote.IssueDateUtc.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Status banners ──────────────────────────────────────── -->
        @if (Model.IsAccepted)
        {
            <div class="mx-4 mt-4">
                <div class="status-banner bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    You have accepted this quote. Our team will be in touch shortly.
                </div>
            </div>
        }
        else if (Model.IsRejected)
        {
            <div class="mx-4 mt-4">
                <div class="status-banner bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                    <i class="bi bi-x-circle-fill me-2"></i>
                    This quote has been declined.
                </div>
            </div>
        }
        else if (Model.IsExpired)
        {
            <div class="mx-4 mt-4">
                <div class="status-banner bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">
                    <i class="bi bi-clock-history me-2"></i>
                    This quote has expired. Please contact us for an updated quote.
                </div>
            </div>
        }
        @if (Request.Query.ContainsKey("message") && Request.Query["message"] == "accepted")
        {
            <div class="mx-4 mt-4">
                <div class="status-banner bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Thank you! Your acceptance has been recorded. We will contact you soon.
                </div>
            </div>
        }

        <!-- ── Body ─────────────────────────────────────────────────── -->
        <div class="quote-body">

            <!-- Line items -->
            <div class="section-label mb-2">Items</div>
            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Item</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Quote.Items.Count; i++)
                        {
                            var item = Model.Quote.Items[i];
                            <tr>
                                <td class="text-muted">@(i + 1)</td>
                                <td>
                                    <div class="fw-semibold">@item.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="text-muted small">@item.Description</div>
                                    }
                                </td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">
                                    @Model.FormatCurrency(item.UnitPrice)
                                </td>
                                <td class="text-end text-muted">
                                    @((item.TaxRate * 100).ToString("N0"))%
                                </td>
                                <td class="text-end fw-semibold">
                                    @Model.FormatCurrency(item.LineGrandTotal)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Totals -->
            <div class="row justify-content-end">
                <div class="col-md-5 col-12">
                    <div class="totals-box">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Subtotal</span>
                            <span>@Model.FormatCurrency(Model.Quote.Subtotal)</span>
                        </div>
                        @if (Model.Quote.DiscountTotal > 0)
                        {
                            <div class="d-flex justify-content-between mb-1 text-success">
                                <span>Discount</span>
                                <span>-@Model.FormatCurrency(Model.Quote.DiscountTotal)</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Tax</span>
                            <span>@Model.FormatCurrency(Model.Quote.TaxTotal)</span>
                        </div>
                        <div class="d-flex justify-content-between grand-total-row">
                            <span>Total</span>
                            <span>@Model.FormatCurrency(Model.Quote.GrandTotal) @Model.Quote.Currency</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terms -->
            <div class="mt-4 pt-3 border-top text-muted small">
                <i class="bi bi-info-circle me-1"></i>
                This quote is valid until <strong>@Model.Quote.ExpiresAtUtc.ToString("dd MMMM yyyy")</strong>.
                All amounts are in <strong>@Model.Quote.Currency</strong>.
                Prices are subject to change after the validity period.
            </div>
        </div>

        <!-- ── Action bar ───────────────────────────────────────────── -->
        @if (!Model.IsAccepted && !Model.IsRejected && !Model.IsExpired)
        {
            <div class="action-bar">
                <form method="post" asp-page-handler="Decline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Token" value="@Model.Token" />
                    <button type="submit" class="btn-decline"
                            onclick="return confirm('Are you sure you want to decline this quote?')">
                        <i class="bi bi-x-circle me-2"></i>Decline
                    </button>
                </form>
                <form method="post" asp-page-handler="Accept">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Token" value="@Model.Token" />
                    <button type="submit" class="btn-accept">
                        <i class="bi bi-check-circle me-2"></i>Accept Quote
                    </button>
                </form>
            </div>
        }

    </div>

    <!-- Powered by -->
    <div class="text-center text-muted small pb-4">
        Powered by <strong>Merkai CRM</strong>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
