@page
@model MerkaiTrial.Admin.Web.Pages.Tasks.IndexModel
@{
    ViewData["Title"] = "Tasks";
}
@* =====================================================================
   Tasks/Index.cshtml — "My Tasks"

   094 — PHONES. The page a rep opens first each morning.
   • Done says "Done" on every screen. Below 768px it was a bare tick in a
     31px box beside a 31px reassign icon — easy to miss, easy to mis-tap.
   • On a phone (575px and narrower) the task's buttons move under its
     text, full width, instead of squeezing the subject into a narrow
     column; the filters wrap under the title.
   • "My tasks / Whole team" and the days filter wrap instead of pushing
     the header wider than the screen.

   096 — a search box (the task, or the lead / deal it is on) and a
   Leads / Deals filter, both done by the API. Every link and form carries
   them (Model.StateRoute). "Showing the first 500" when the list hit the
   API's ceiling. An empty FILTERED list says so and offers Clear.

   096b — the record id (activityId / userId / id) is a hidden field, NOT
   asp-route-…: on a form that also has asp-all-route-data, ASP.NET sets
   the asp-route value first and then REPLACES the whole route list with
   the state, so the id was silently dropped and the handler got an empty
   one (the first full test run caught it on Tasks → Reassign).
   ===================================================================== *@

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h2 class="mb-1">Tasks</h2>
        <p class="text-muted mb-0">
            @if (Model.OverdueCount > 0)
            {
                <span class="text-danger fw-semibold">@Model.OverdueCount overdue</span>
                <span class="mx-1">·</span>
            }
            <span>@Model.TodayCount due today</span>
            <span class="mx-1">·</span>
            <span>@Model.TotalCount open</span>
        </p>
    </div>

    <form method="get" class="d-flex align-items-center gap-2 flex-wrap tk-filter" id="tasksFilter">
        @if (Model.IsTenantAdmin)
        {
            <div class="btn-group" role="group">
                <a class="btn btn-sm @(Model.Scope == "mine" ? "btn-primary" : "btn-outline-primary")"
                   asp-all-route-data="@Model.StateRoute(scope: "mine")">My tasks</a>
                <a class="btn btn-sm @(Model.Scope == "all" ? "btn-primary" : "btn-outline-primary")"
                   asp-all-route-data="@Model.StateRoute(scope: "all")">Whole team</a>
            </div>
        }

        @* 096 — search the task, or the lead / deal it is on. *@
        <div class="input-group input-group-sm tk-search" style="width: 240px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" name="search" value="@Model.Search" class="form-control"
                   placeholder="Task, lead or deal" autocomplete="off" maxlength="200"
                   aria-label="Search tasks" />
        </div>

        <select name="type" class="form-select form-select-sm" style="width: auto;"
                aria-label="Filter by record type" onchange="this.form.submit()">
            <option value="" selected="@(Model.TypeFilter is null)">Leads and deals</option>
            <option value="Lead" selected="@(Model.TypeFilter == "Lead")">Leads only</option>
            <option value="Deal" selected="@(Model.TypeFilter == "Deal")">Deals only</option>
        </select>

        <select name="days" class="form-select form-select-sm" style="width: auto;"
                aria-label="Period" onchange="this.form.submit()">
            <option value="7"  selected="@(Model.Days == 7)">Next 7 days</option>
            <option value="30" selected="@(Model.Days == 30)">Next 30 days</option>
            <option value="90" selected="@(Model.Days == 90)">Next 90 days</option>
        </select>
        <input type="hidden" name="scope" value="@Model.Scope" />

        <button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-funnel me-1"></i>Filter
        </button>
        @if (Model.IsFiltered)
        {
            <a class="btn btn-sm btn-link px-1" asp-route-scope="@Model.Scope" asp-route-days="@Model.Days">Clear</a>
        }
    </form>
</div>

@* 090: no Success/Error banners here — _Layout renders TempData once. These
   two blocks drew every message a second time ("Task done." twice). Only a
   failure to load THIS page is shown here, from LoadError. *@
@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <span>@Model.LoadError</span>
    </div>
}

@if (Model.HitCeiling)
{
    @* 096 — the API stops at this many; say so rather than imply it is everything. *@
    <div class="alert alert-info py-2 px-3 small d-flex gap-2 align-items-center" role="status" id="tasksCeiling">
        <i class="bi bi-info-circle"></i>
        <span>Showing the first @Model.Ceiling tasks, soonest due first. Search, filter or choose a shorter period to see the rest.</span>
    </div>
}

@if (!Model.Groups.Any() && Model.IsFiltered && string.IsNullOrEmpty(Model.LoadError))
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-search text-muted" style="font-size: 3rem; opacity: 0.4;"></i>
            <h5 class="mt-3 mb-1">No task matches</h5>
            <p class="text-muted mb-2">Nothing in the next @Model.Days days matches that search or filter.</p>
            <a class="btn btn-sm btn-outline-secondary" asp-route-scope="@Model.Scope" asp-route-days="@Model.Days">
                Clear the search and filter
            </a>
        </div>
    </div>
}
else if (!Model.Groups.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-check2-circle text-success" style="font-size: 3.5rem; opacity: 0.4;"></i>
            <h5 class="mt-3 mb-1">Nothing due</h5>
            <p class="text-muted mb-0">
                @if (Model.Scope == "all")
                {
                    <text>No open tasks for anyone in the next @Model.Days days.</text>
                }
                else
                {
                    <text>You have no open tasks in the next @Model.Days days.</text>
                }
            </p>
            <p class="text-muted small mt-2 mb-0">
                Tasks are created from a lead or deal — open one and use the Tasks tab.
            </p>
        </div>
    </div>
}
else
{
    @foreach (var group in Model.Groups)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <span class="badge @group.BadgeClass me-2">@group.Tasks.Count</span>
                    @group.Title
                </h6>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var task in group.Tasks)
                {
                    <div class="list-group-item">
                        <div class="d-flex align-items-start gap-3 tk-row">

                            <div class="pt-1">
                                <i class="bi @Model.GetActivityIcon(task.ActivityType) fs-5
                                          @(group.Key == "overdue" ? "text-danger" : "text-muted")"></i>
                            </div>

                            <div class="flex-grow-1 min-width-0">
                                <div class="fw-semibold">@task.Subject</div>

                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <div class="text-muted small text-truncate">@task.Description</div>
                                }

                                <div class="small mt-1">
                                    <a href="@Model.RecordUrl(task)" class="text-decoration-none">
                                        <i class="bi @Model.RecordIcon(task) me-1"></i>@Model.RecordName(task)
                                    </a>
                                    <span class="text-muted mx-2">·</span>
                                    <span class="@(group.Key == "overdue" ? "text-danger" : "text-muted")">
                                        <i class="bi bi-clock me-1"></i>@Model.FormatDueDate(task.DueDate)
                                        (@Model.GetDueDescription(task.DueDate))
                                    </span>

                                    @if (!string.IsNullOrEmpty(task.AssignedToName) &&
                                         task.AssignedToUserId != Model.CurrentUserId.ToString())
                                    {
                                        <span class="text-muted mx-2">·</span>
                                        <span class="text-muted">
                                            <i class="bi bi-person me-1"></i>@task.AssignedToName
                                        </span>
                                    }
                                </div>

                                @* Reassign — inline, so a manager clearing
                                   someone's overdue list doesn't have to open
                                   every lead one at a time. *@
                                @if (Model.IsReassigning(task))
                                {
                                    <form method="post" asp-page-handler="Reassign"
                                          asp-all-route-data="@Model.StateRoute()"
                                          class="mt-2">
                                        <input type="hidden" name="activityId" value="@task.Id" />
                                        <div class="input-group input-group-sm" style="max-width: 420px;">
                                            <span class="input-group-text">Give to</span>
                                            <select name="NewAssigneeId" class="form-select" required>
                                                @foreach (var user in Model.Assignees)
                                                {
                                                    <option value="@user.UserId"
                                                            selected="@(user.UserId == task.AssignedToUserId)">
                                                        @user.Name@(user.UserId == Model.CurrentUserId.ToString() ? " (you)" : "")
                                                    </option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-primary">Save</button>
                                            <a class="btn btn-outline-secondary"
                                               asp-all-route-data="@Model.StateRoute()">Cancel</a>
                                        </div>
                                    </form>
                                }
                            </div>

                            <div class="flex-shrink-0 btn-group btn-group-sm tk-acts">
                                @if (Model.CanReassign(task) && !Model.IsReassigning(task))
                                {
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-all-route-data="@Model.StateRoute(reassignId: task.Id)"
                                       title="Reassign">
                                        <i class="bi bi-person-gear"></i>
                                    </a>
                                }
                                <form method="post" asp-page-handler="Complete"
                                      asp-all-route-data="@Model.StateRoute()">
                                    <input type="hidden" name="activityId" value="@task.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                            title="Mark as done">
                                        <i class="bi bi-check2"></i>
                                        <span class="ms-1">Done</span>
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<p class="text-muted small">
    Times shown in @Model.TenantTimezone.
</p>

<style>
    .min-width-0 { min-width: 0; }

    /* 094 — on a phone the buttons go under the task, full width. */
    @@media (max-width: 575.98px) {
        /* 096 — the search takes the filter's first line. */
        .tk-filter .tk-search { width: 100% !important; }
        .tk-filter .form-select { flex: 1 1 40%; width: auto !important; min-width: 0; }
        .tk-row { flex-wrap: wrap; }
        .tk-row > .flex-grow-1 { flex-basis: calc(100% - 2.25rem - 1rem); }
        /* The icon column is about 1.25rem plus the 1rem gap; the buttons
           line up under the text, and their width leaves room for that. */
        .tk-acts { width: calc(100% - 2.25rem); margin-left: 2.25rem; }
        .tk-acts > a, .tk-acts > form { flex: 1 1 0; }
        .tk-acts > form > .btn { width: 100%; }
    }
</style>
