@page "/Pipeline/Edit/{id}"
@using MerkaiTrial.Domain.Entities
@model MerkaiTrial.Admin.Web.Pages.Pipeline.EditModel
@{
    ViewData["Title"] = "Edit deal";
}
@* =====================================================================
   Pipeline/Edit.cshtml   (030 — rebuild)
   Location: MerkaiTrial.Admin.Web/Pages/Pipeline/Edit.cshtml

   COMPLETE FILE — replaces the 020 version.

   WHAT WAS WRONG

   1. ★ THE CURRENCY WAS A FREE DROPDOWN OF EVERY COUNTRY. The Create page
      says "Fixed to your workspace" and posts the workspace currency; this
      page offered ~200 currencies on an EXISTING deal and changed nothing
      but the label. Switching a ฿2,000,000 deal from THB to INR left the
      number alone, so its real worth jumped by a factor of about 2.6 and
      every pipeline total moved with it. The currency is read-only now and
      the page model takes it from the stored deal.

   2. ★ THE DELETE BUTTON BYPASSED THE DEAL PAGE's GUARDS — a closed deal,
      or one with an accepted quote, could be deleted from here even though
      the deal page refuses both. Fixed in Edit.cshtml.cs.

   3. ★ EVERY SAVE MOVED THE CLOSE DATE BACK A DAY. Also in
      Edit.cshtml.cs — that one is worth reading.

   4. "Created On" was @@Model.CreatedAt.ToString("MMM dd, yyyy 'at' hh:mm tt")
      on a value that had already been through .ToLocalTime() — the
      SERVER's timezone and the SERVER's culture, on a page where every
      other date goes through the tenant's. It is FormatDateTime now.

   5. A 2rem PURPLE GRADIENT BANNER reading "Edit Deal / Update deal
      information", above a 2rem-padded card.
   ===================================================================== *@

<style>
    .px { max-width: 980px; margin: 0 auto; }
    .px-back { font-size: .82rem; color: #64748b; text-decoration: none; }
    .px-back:hover { color: #334155; }
    .px-head { display: flex; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin: .35rem 0 1rem; }
    .px-title { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0; line-height: 1.2; }
    .px-sub { font-size: .84rem; color: #64748b; margin: .2rem 0 0; }

    .px-card { border: 1px solid #e9ecef; border-radius: 12px; background: #fff; margin-bottom: 1rem; }
    .px-card > h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: #64748b;
                    font-weight: 650; margin: 0; padding: .7rem 1rem; border-bottom: 1px solid #f1f3f5;
                    display: flex; align-items: center; gap: .4rem; }
    .px-card .bd { padding: 1rem; }

    .px-ro { background: #f8fafc; border: 1px solid #e9ecef; border-radius: 8px;
             padding: .55rem .8rem; color: #334155; font-weight: 500; font-size: .88rem;
             display: flex; align-items: center; justify-content: space-between;
             gap: .6rem; flex-wrap: wrap; }
    .px-lock { font-size: .74rem; color: #94a3b8; display: block; margin-bottom: .2rem; }

    .px-money { position: relative; }
    .px-money .sym { position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
                     font-weight: 650; color: #64748b; pointer-events: none; }
    .px-money input { padding-left: 34px; }

    .px-prob { display: flex; align-items: center; gap: 1rem; }
    .px-prob .v { font-size: 1.6rem; font-weight: 700; color: #4f46e5; min-width: 68px; text-align: right; }

    .px-bar { display: flex; gap: .5rem; justify-content: space-between; flex-wrap: wrap;
              border-top: 1px solid #e9ecef; padding-top: 1rem; margin-top: 1rem; }

    @@media (max-width: 575.98px) {
        .px-title { font-size: 1.25rem; }
        .px-bar { justify-content: stretch; }
        .px-bar > * { flex: 1 1 100%; }
        .px-bar .btn { width: 100%; }
    }
</style>

<div class="px">

    <a href="/Pipeline/Detail/@Model.DealId" class="px-back">
        <i class="bi bi-arrow-left me-1"></i>Back to the deal
    </a>

    <div class="px-head">
        <div>
            <h1 class="px-title">Edit deal</h1>
            <p class="px-sub">
                <span class="badge @Model.StageBadgeClass(Model.Input.Stage)">@Model.StageName(Model.Input.Stage)</span>
                <span class="ms-1">@Model.ContactName</span>
            </p>
        </div>
    </div>

    @* TempData alerts are rendered once, globally, by _Layout.cshtml. This
       block is only for ModelState errors the API added, which TempData does
       not carry. *@
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-warning d-flex gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div>
                @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        </div>
    }

    <form method="post" id="pxForm" asp-route-id="@Model.DealId">
        @* The deal's current stage, carried straight back so the API sees no
           change. Not a choice — moving a deal is the transition bar's job on
           the deal page, and OnPostAsync re-reads the stored stage anyway so a
           stale form cannot move anything. *@
        <input type="hidden" asp-for="Input.Stage" />
        @* Currency is read-only and the server takes it from the stored deal;
           this only keeps [Required] on the input model satisfied. *@
        <input type="hidden" asp-for="Input.Currency" />

        <div class="px-card">
            <h2><i class="bi bi-info-circle"></i>The basics</h2>
            <div class="bd">
                <div class="mb-3">
                    <label asp-for="Input.Title" class="form-label small text-muted mb-1">
                        Deal title <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.Title" class="form-control" required maxlength="200" />
                    <span asp-validation-for="Input.Title" class="text-danger small"></span>
                </div>
                <div class="mb-0">
                    <label asp-for="Input.Description" class="form-label small text-muted mb-1">Description</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="3" maxlength="2000"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="px-card">
            <h2><i class="bi bi-lock"></i>Fixed for this deal</h2>
            <div class="bd">
                <div class="row g-3">
                    <div class="col-md-6">
                        <span class="px-lock"><i class="bi bi-person me-1"></i>Contact</span>
                        <div class="px-ro">@Model.ContactName</div>
                        <div class="form-text" style="font-size:.74rem;">
                            A deal keeps its original contact so its history stays intact.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <span class="px-lock"><i class="bi bi-currency-exchange me-1"></i>Currency</span>
                        <div class="px-ro">
                            <span>
                                @Model.GetCurrencySymbol(Model.Input.Currency)
                                <strong class="ms-1">@Model.Input.Currency</strong>
                            </span>
                        </div>
                        @* Was an editable dropdown of every country. Changing it
                           re-labelled the deal without converting the value, so a
                           ฿2,000,000 deal became "₹2,000,000" and every pipeline
                           total moved with it. *@
                        <div class="form-text" style="font-size:.74rem;">
                            Set when the deal was created. Changing it here would relabel the
                            value without converting it.
                        </div>
                    </div>

                    <div class="col-12">
                        <span class="px-lock"><i class="bi bi-signpost-split me-1"></i>Stage</span>
                        <div class="px-ro">
                            <span>
                                <span class="badge @Model.StageBadgeClass(Model.Input.Stage) me-1">
                                    @Model.StageName(Model.Input.Stage)
                                </span>
                                @if (Model.IsClosed)
                                {
                                    <span class="text-muted small">this deal is closed</span>
                                }
                            </span>
                            <a href="/Pipeline/Detail/@Model.DealId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-signpost-split me-1"></i>Move this deal
                            </a>
                        </div>
                        <div class="form-text" style="font-size:.74rem;">
                            Deals move through the steps your workspace has set up — open the deal
                            to see what it can do next.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-card">
            <h2><i class="bi bi-graph-up-arrow"></i>Value and timing</h2>
            <div class="bd">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.ExpectedValue" class="form-label small text-muted mb-1">
                            Expected value <span class="text-danger">*</span>
                        </label>
                        <div class="px-money">
                            <span class="sym">@Model.GetCurrencySymbol(Model.Input.Currency)</span>
                            <input asp-for="Input.ExpectedValue" type="number" step="0.01" min="0.01"
                                   class="form-control" required />
                        </div>
                        <span asp-validation-for="Input.ExpectedValue" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.ExpectedCloseDate" class="form-label small text-muted mb-1">
                            Expected close date <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.ExpectedCloseDate" type="date" class="form-control" required />
                        <span asp-validation-for="Input.ExpectedCloseDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label small text-muted mb-1" for="pxProbSlider">
                            Probability of closing
                        </label>
                        <div class="px-prob">
                            <input type="range" class="form-range" min="0" max="100" id="pxProbSlider"
                                   value="@Model.Input.Probability" aria-describedby="pxProbValue" />
                            <span class="v" id="pxProbValue">@Model.Input.Probability%</span>
                        </div>
                        <input type="hidden" asp-for="Input.Probability" id="pxProb" />
                        <div class="form-text" style="font-size:.74rem;">
                            Each stage has its own default, applied whenever the deal moves. Set it here
                            only when this particular deal is more or less likely than the stage suggests.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.OwnerUserId" class="form-label small text-muted mb-1">Owner</label>
                        <select asp-for="Input.OwnerUserId" class="form-select">
                            <option value="">Choose an owner…</option>
                            @foreach (var u in Model.SalesTeam)
                            {
                                <option value="@u.Value" selected="@u.Selected">@u.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Tags" class="form-label small text-muted mb-1">
                            Tags <span class="text-muted">(comma-separated)</span>
                        </label>
                        <input asp-for="Input.Tags" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="text-muted mb-3" style="font-size:.78rem;">
            @* FormatDateTime, not .ToLocalTime().ToString(...) — the tenant's
               timezone and culture, like every other date in the app. *@
            <i class="bi bi-clock-history me-1"></i>Created @Model.FormatDateTime(Model.CreatedAtUtc)
            @if (!string.IsNullOrEmpty(Model.CreatedBy))
            {
                <text> by @Model.CreatedBy</text>
            }
        </div>

        <div class="px-bar">
            @if (Model.CanDelete && !Model.IsClosed)
            {
                <button type="button" class="btn btn-outline-danger"
                        data-bs-toggle="modal" data-bs-target="#pxDeleteModal">
                    <i class="bi bi-trash me-1"></i>Delete deal
                </button>
            }
            else
            {
                <span></span>
            }
            <div class="d-flex gap-2 flex-wrap">
                <a href="/Pipeline/Detail/@Model.DealId" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check2 me-1"></i>Save changes
                </button>
            </div>
        </div>
    </form>
</div>

@* The modal is rendered only when the button that opens it exists. The old
   page rendered it whenever CanDelete, including for a closed deal whose
   deletion the server refuses. *@
@if (Model.CanDelete && !Model.IsClosed)
{
    <div class="modal fade" id="pxDeleteModal" tabindex="-1" aria-hidden="true" aria-labelledby="pxDeleteTitle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="pxDeleteTitle">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete this deal?
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1 fw-semibold">@Model.Input.Title</p>
                    <p class="text-muted small mb-2">
                        @Model.GetCurrencySymbol(Model.Input.Currency)@Model.Input.ExpectedValue.ToString("N2")
                        · @Model.StageName(Model.Input.Stage)
                    </p>
                    <p class="text-muted small mb-0">
                        This cannot be undone. A deal with an accepted quote, or one that has
                        already closed, will be refused — close it as Lost instead.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.DealId" class="d-inline">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Delete deal
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';
            var slider = document.getElementById('pxProbSlider');
            var out = document.getElementById('pxProbValue');
            var hidden = document.getElementById('pxProb');

            if (slider) slider.addEventListener('input', function () {
                if (out) out.textContent = this.value + '%';
                if (hidden) hidden.value = this.value;
            });
        })();
    </script>
}
