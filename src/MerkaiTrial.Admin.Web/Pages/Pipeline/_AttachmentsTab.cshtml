@* =====================================================================
   ATTACHMENTS TAB
   Location: MerkaiTrial.Admin.Web/Pages/Pipeline/_AttachmentsTab.cshtml
   ===================================================================== *@
@model MerkaiTrial.Admin.Web.Pages.Pipeline.DetailModel

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-paperclip me-2"></i>Attachments</h5>
        <span class="badge bg-secondary">@Model.Attachments.Count</span>
    </div>
    <div class="card-body">

        @* ── Upload Form — only shown to roles with update permission ──── *@
        @if (Model.CanUpdate)
        {
            <div class="mb-4 p-3 border rounded bg-light">
                <h6 class="mb-3"><i class="bi bi-cloud-upload me-2"></i>Upload File</h6>
                <form method="post"
                      asp-page-handler="UploadAttachment"
                      asp-route-id="@Model.Deal.Id"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2 align-items-end flex-wrap">
                        <div class="flex-grow-1">
                            <input type="file"
                                   name="file"
                                   id="attachmentFile"
                                   class="form-control"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.webp,.txt,.csv"
                                   required />
                            <small class="text-muted">
                                PDF, Word, Excel, Images, CSV — max 10 MB
                            </small>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-upload me-2"></i>Upload
                        </button>
                    </div>
                </form>
            </div>
        }

        @* ── Attachment List ─────────────────────────────────────── *@
        @if (!Model.Attachments.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-paperclip fs-2 d-block mb-2"></i>
                <p class="mb-0">No attachments yet.</p>
                <small>Upload contracts, proposals, or other documents.</small>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var att in Model.Attachments)
                {
                    <div class="list-group-item px-0 py-3">
                        <div class="d-flex align-items-center gap-3">

                            @* File type icon *@
                            <div class="flex-shrink-0 fs-3">
                                <i class="bi @att.FileIcon"></i>
                            </div>

                            @* File info *@
                            <div class="flex-grow-1 min-width-0">
                                <div class="fw-semibold text-truncate">@att.FileName</div>
                                <small class="text-muted">
                                    @att.FileSizeDisplay
                                    &nbsp;·&nbsp;
                                    @Model.FormatDateTime(att.CreatedAtUtc)
                                    @if (!string.IsNullOrEmpty(att.CreatedBy))
                                    {
                                        <text>&nbsp;by @att.CreatedBy</text>
                                    }
                                </small>
                            </div>

                            @* Actions *@
                            <div class="flex-shrink-0 d-flex gap-2">
                                <a href="@att.FileUrl"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Download / View">
                                    <i class="bi bi-download"></i>
                                </a>
                                @if (Model.CanUpdate)
                                {
                                    <form method="post"
                                          asp-page-handler="DeleteAttachment"
                                          asp-route-id="@Model.Deal.Id"
                                          asp-route-attachmentId="@att.Id"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this attachment?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
