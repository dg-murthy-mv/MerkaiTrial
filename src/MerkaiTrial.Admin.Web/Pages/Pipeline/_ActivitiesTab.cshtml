@* =====================================================================
   DEAL ACTIVITIES TAB
   Location: MerkaiTrial.Admin.Web/Pages/Pipeline/_ActivitiesTab.cshtml

   COMPLETE FILE — replaces the existing one.

   Reads Model.Activities (ActivityDto, logs only — tasks are on the Tasks
   tab). Rows carried over from the lead this deal came from are marked
   "from lead"; they are read through Deal.LeadId, not copied.

   Dates now render via Model.FormatDateTime (tenant timezone). The old
   partial called .ToLocalTime(), which uses the SERVER timezone.
   ===================================================================== *@
@model MerkaiTrial.Admin.Web.Pages.Pipeline.DetailModel

@if (Model.CanUpdate)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h6 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Log Activity</h6>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="AddActivity" asp-route-id="@Model.Deal.Id">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ActivityInput.ActivityType" class="form-label">
                            Activity Type <span class="text-danger">*</span>
                        </label>
                        <select asp-for="ActivityInput.ActivityType" class="form-select" required>
                            <option value="">— Select Type —</option>
                            <option value="Call">📞 Call</option>
                            <option value="Email">📧 Email</option>
                            <option value="Meeting">🤝 Meeting / Demo</option>
                            <option value="WhatsApp">📱 WhatsApp</option>
                            <option value="LINE">💬 LINE</option>
                            <option value="SMS">✉️ SMS</option>
                        </select>
                        <span asp-validation-for="ActivityInput.ActivityType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ActivityInput.Duration" class="form-label">Duration (minutes)</label>
                        <input type="number" asp-for="ActivityInput.Duration" class="form-control"
                               min="1" max="480" placeholder="e.g. 30">
                        <span asp-validation-for="ActivityInput.Duration" class="text-danger"></span>
                        <small class="text-muted">Optional — 1 to 480 minutes</small>
                    </div>

                    <div class="col-12">
                        <label asp-for="ActivityInput.Subject" class="form-label">
                            Subject <span class="text-muted small">(optional)</span>
                        </label>
                        <input type="text" asp-for="ActivityInput.Subject" class="form-control"
                               placeholder="Brief description of the activity">
                        <span asp-validation-for="ActivityInput.Subject" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ActivityInput.Description" class="form-label">Notes / Details</label>
                        <textarea asp-for="ActivityInput.Description" class="form-control" rows="3"
                                  placeholder="What was discussed..."></textarea>
                        <span asp-validation-for="ActivityInput.Description" class="text-danger"></span>
                    </div>

                    @* NEW — the old page always stamped "now", so yesterday's
                       call was recorded as today. *@
                    <div class="col-md-6">
                        <label asp-for="ActivityInput.ActivityDate" class="form-label">When did it happen?</label>
                        <input type="datetime-local" asp-for="ActivityInput.ActivityDate" class="form-control">
                        <span asp-validation-for="ActivityInput.ActivityDate" class="text-danger"></span>
                        <small class="text-muted">Leave empty for now</small>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-activity me-2"></i>Log Activity
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Activity History</h6>
        <span class="badge bg-secondary">@Model.Activities.Count</span>
    </div>
    <div class="card-body">
        @if (!Model.Activities.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-activity" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mb-0 mt-2">No activities logged yet. Log your first activity above.</p>
            </div>
        }
        else
        {
            <div class="activity-timeline">
                @foreach (var activity in Model.Activities)
                {
                    <div class="activity-item mb-4">
                        <div class="activity-marker">
                            <i class="bi @Model.GetActivityIcon(activity.ActivityType)"></i>
                        </div>
                        <div class="activity-content">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="mb-1">
                                        <span class="badge bg-success me-2">@activity.ActivityType</span>
                                        @activity.Subject
                                        @if (Model.IsFromLead(activity))
                                        {
                                            <span class="badge bg-light text-dark border ms-2"
                                                  title="Logged while this was a lead">
                                                <i class="bi bi-arrow-return-right me-1"></i>from lead
                                            </span>
                                        }
                                    </h6>
                                    <small class="text-muted">
                                        <i class="bi bi-person me-1"></i>
                                        @(activity.CreatedByName ?? activity.CreatedBy)
                                        @if (activity.Duration.HasValue)
                                        {
                                            <span class="ms-2">
                                                <i class="bi bi-clock me-1"></i>@activity.Duration min
                                            </span>
                                        }
                                    </small>
                                </div>
                                <small class="text-muted text-end">
                                    @Model.GetRelativeTime(activity.ActivityDate)
                                    <br />
                                    <span class="small">@Model.FormatDateTime(activity.ActivityDate)</span>
                                </small>
                            </div>
                            @if (!string.IsNullOrEmpty(activity.Description))
                            {
                                <p class="mb-0 text-muted" style="white-space: pre-wrap;">@activity.Description</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .activity-timeline { position: relative; padding-left: 44px; }
    .activity-timeline::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 16px;
        bottom: 0;
        width: 2px;
        background-color: #dee2e6;
    }
    .activity-item { position: relative; }
    .activity-marker {
        position: absolute;
        left: -44px;
        top: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #198754;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
    }
    .activity-content {
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        border-left: 3px solid #198754;
    }
</style>
