@* =====================================================================
   DEAL TASKS TAB
   Location: MerkaiTrial.Admin.Web/Pages/Pipeline/_TasksTab.cshtml

   COMPLETE FILE — replaces the existing one.

   ⚠ Save this as  _TasksTab.cshtml  — ONE leading underscore, and
     DELETE the old file first so you don't end up with two.

   NEW: assign to a colleague, edit/reschedule, delete, and "how did it
   go?" on a completed task. Tasks carried over from the source lead are
   marked "from lead".
   ===================================================================== *@
@model MerkaiTrial.Admin.Web.Pages.Pipeline.DetailModel

@if (Model.CanUpdate)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h6 class="mb-0"><i class="bi bi-calendar-plus me-2"></i>Plan what's next</h6>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="AddTask" asp-route-id="@Model.Deal.Id">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="TaskInput.ActivityType" class="form-label">
                            Type <span class="text-danger">*</span>
                        </label>
                        <select asp-for="TaskInput.ActivityType" class="form-select" required>
                            <option value="Task">✅ To-do</option>
                            <option value="Call">📞 Call</option>
                            <option value="Email">📧 Email</option>
                            <option value="Meeting">🤝 Meeting</option>
                            <option value="WhatsApp">📱 WhatsApp</option>
                            <option value="LINE">💬 LINE</option>
                            <option value="SMS">✉️ SMS</option>
                        </select>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="TaskInput.Subject" class="form-label">
                            What needs doing? <span class="text-danger">*</span>
                        </label>
                        <input asp-for="TaskInput.Subject" type="text" class="form-control"
                               placeholder="e.g. Follow up on the revised proposal" required>
                        <span asp-validation-for="TaskInput.Subject" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="TaskInput.Description" class="form-label">Notes</label>
                        <textarea asp-for="TaskInput.Description" class="form-control" rows="2"
                                  placeholder="Additional details..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TaskInput.DueDate" class="form-label">
                            Due <span class="text-danger">*</span>
                        </label>
                        <input asp-for="TaskInput.DueDate" type="datetime-local" class="form-control" required>
                        <span asp-validation-for="TaskInput.DueDate" class="text-danger"></span>
                    </div>

                    @* Only shown when there is somebody else to assign to. *@
                    @if (Model.Assignees.Count > 1)
                    {
                        <div class="col-md-6">
                            <label asp-for="TaskInput.AssignedToUserId" class="form-label">Assign to</label>
                            <select asp-for="TaskInput.AssignedToUserId" class="form-select">
                                <option value="">Me</option>
                                @foreach (var user in Model.Assignees.Where(u => u.UserId != Model.CurrentUserId.ToString()))
                                {
                                    <option value="@user.UserId">@user.Name</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <button type="submit" class="btn btn-warning text-dark">
                        <i class="bi bi-calendar-plus me-2"></i>Create Task
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Open tasks -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="bi bi-list-check me-2"></i>Open Tasks</h6>
        <span class="badge bg-dark">@Model.OpenTasks.Count</span>
    </div>
    <div class="card-body">
        @if (!Model.OpenTasks.Any())
        {
            <div class="text-center text-muted py-3">
                <i class="bi bi-check2-circle" style="font-size: 2.5rem; opacity: 0.3;"></i>
                <p class="mb-0 mt-2">Nothing scheduled. Deals go quiet when nobody owns the next step.</p>
            </div>
        }
        else
        {
            <div class="list-group">
                @foreach (var task in Model.OpenTasks)
                {
                    var overdue = Model.IsOverdue(task);

                    <div class="list-group-item @(overdue ? "border-danger" : "")">
                        @if (Model.IsEditing(task))
                        {
                            <partial name="_EntryEditForm" />
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        @if (overdue)
                                        {
                                            <span class="badge bg-danger me-2">
                                                <i class="bi bi-exclamation-triangle me-1"></i>OVERDUE
                                            </span>
                                        }
                                        <i class="bi @Model.GetActivityIcon(task.ActivityType) me-1"></i>
                                        @task.Subject
                                        @if (Model.IsFromLead(task))
                                        {
                                            <span class="badge bg-light text-dark border ms-2">from lead</span>
                                        }
                                    </h6>

                                    @if (!string.IsNullOrEmpty(task.Description))
                                    {
                                        <p class="mb-2 text-muted small" style="white-space: pre-wrap;">@task.Description</p>
                                    }

                                    <small class="text-muted">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        @(task.DueDate.HasValue ? Model.FormatDateTime(task.DueDate.Value) : "—")
                                        <span class="@(overdue ? "text-danger" : "text-success") ms-2">
                                            (@Model.GetDueDescription(task.DueDate))
                                        </span>
                                    </small>
                                    <br />
                                    <small class="text-muted">
                                        <i class="bi bi-person me-1"></i>
                                        @(task.AssignedToName ?? "Unassigned")
                                        @if (task.AssignedToUserId == Model.CurrentUserId.ToString())
                                        {
                                            <span class="badge bg-light text-dark border ms-1">you</span>
                                        }
                                    </small>
                                </div>

                                <div class="btn-group btn-group-sm">
                                    @if (Model.CanUpdate)
                                    {
                                        <form method="post"
                                              asp-page-handler="CompleteTask"
                                              asp-route-id="@Model.Deal.Id"
                                              asp-route-activityId="@task.Id"
                                              class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check2"></i> Done
                                            </button>
                                        </form>
                                    }
                                    @if (Model.CanEditEntry(task))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-route-id="@Model.Deal.Id"
                                           asp-route-editId="@task.Id"
                                           asp-fragment="tasks"
                                           title="Edit or reschedule">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (Model.CanDeleteEntry(task))
                                    {
                                        <form method="post"
                                              asp-page-handler="DeleteEntry"
                                              asp-route-id="@Model.Deal.Id"
                                              asp-route-activityId="@task.Id"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete this task? This cannot be undone.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Completed -->
@if (Model.CompletedTasks.Any())
{
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="bi bi-check-circle-fill me-2"></i>Completed</h6>
            <span class="badge bg-light text-dark">@Model.CompletedTasks.Count</span>
        </div>
        <div class="card-body">
            <div class="list-group">
                @foreach (var task in Model.CompletedTasks.Take(10))
                {
                    <div class="list-group-item">
                        @if (Model.IsEditing(task))
                        {
                            <partial name="_EntryEditForm" />
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1 text-muted">
                                        <i class="bi @Model.GetActivityIcon(task.ActivityType) me-1"></i>
                                        <span class="text-decoration-line-through">@task.Subject</span>
                                        @if (Model.IsFromLead(task))
                                        {
                                            <span class="badge bg-light text-dark border ms-2">from lead</span>
                                        }
                                    </h6>

                                    @if (!string.IsNullOrEmpty(task.Outcome))
                                    {
                                        <p class="mb-1 small" style="white-space: pre-wrap;">
                                            <i class="bi bi-chat-quote me-1 text-muted"></i>@task.Outcome
                                        </p>
                                    }

                                    <small class="text-muted">
                                        Completed @(task.CompletedAtUtc.HasValue
                                            ? Model.FormatDateTime(task.CompletedAtUtc.Value)
                                            : "—")
                                    </small>

                                    @* "How did it go?" — optional, added after the
                                       fact, so completing stays one click. *@
                                    @if (Model.IsAddingOutcome(task))
                                    {
                                        <form method="post" asp-page-handler="SetOutcome"
                                              asp-route-id="@Model.Deal.Id"
                                              asp-route-activityId="@task.Id"
                                              class="mt-2">
                                            <div class="input-group input-group-sm">
                                                <input name="OutcomeText" class="form-control"
                                                       value="@task.Outcome"
                                                       placeholder="How did it go? e.g. Client asked for a revised price"
                                                       maxlength="2000" autofocus />
                                                <button type="submit" class="btn btn-success">Save</button>
                                                <a class="btn btn-outline-secondary"
                                                   asp-route-id="@Model.Deal.Id" asp-fragment="tasks">Cancel</a>
                                            </div>
                                        </form>
                                    }
                                    else if (Model.CanUpdate)
                                    {
                                        <a class="small text-decoration-none ms-2"
                                           asp-route-id="@Model.Deal.Id"
                                           asp-route-outcomeId="@task.Id"
                                           asp-fragment="tasks">
                                            <i class="bi bi-chat-left-text me-1"></i>
                                            @(string.IsNullOrEmpty(task.Outcome) ? "Add outcome" : "Edit outcome")
                                        </a>
                                    }
                                </div>

                                <div class="d-flex align-items-start gap-2">
                                    <span class="badge bg-success">Done</span>
                                    @if (Model.CanDeleteEntry(task))
                                    {
                                        <form method="post"
                                              asp-page-handler="DeleteEntry"
                                              asp-route-id="@Model.Deal.Id"
                                              asp-route-activityId="@task.Id"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete this task? This cannot be undone.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
