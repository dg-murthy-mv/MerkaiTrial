@page "{id:guid}"
@model MerkaiTrial.Admin.Web.Pages.Pipeline.DetailModel
@{
    ViewData["Title"] = $"Deal — {Model.Deal.Title}";
}

<div class="container-fluid py-4">

    @* Alert messages are rendered once, globally, by _Layout.cshtml — do not duplicate here. *@

    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h2 class="mb-2">@Model.Deal.Title</h2>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <span class="badge @Model.GetStageBadgeClass(Model.Deal.Stage) fs-6">
                            @Model.Deal.Stage
                        </span>
                        <span class="text-muted">•</span>
                        <strong class="text-success">
                            @Model.FormatCurrency(Model.Deal.ExpectedValue)
                        </strong>
                        @if (!string.IsNullOrEmpty(Model.Deal.CompanyName))
                        {
                            <span class="text-muted">•</span>
                            <span class="text-muted">
                                <i class="bi bi-building me-1"></i>@Model.Deal.CompanyName
                            </span>
                        }
                        <span class="text-muted">•</span>
                        <span class="text-muted">
                            <i class="bi bi-person me-1"></i><strong>@Model.Deal.OwnerName</strong>
                        </span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">

                    @* ✅ Edit — requires deal not closed AND role has update permission *@
                    @if (Model.IsEditableState && Model.CanUpdate)
                    {
                        <a asp-page="./Edit" asp-route-id="@Model.Deal.Id" class="btn btn-primary">
                            <i class="bi bi-pencil me-2"></i>Edit
                        </a>
                    }
                    @* If IsEditableState=true but no update permission → button hidden silently (viewer/read-only role) *@

                    @* ✅ Delete — requires deal not closed AND role has delete permission *@
                    @if (Model.IsDeletableState && Model.CanDelete)
                    {
                        
                            var deleteWarning = Model.HasExistingQuote
                                ? "This deal has an associated quote. Deleting it will orphan the quote. Are you sure?"
                                : "Are you sure you want to delete this deal?";
                        
                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-id="@Model.Deal.Id"
                              onsubmit="return confirm('@deleteWarning')"
                              class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-trash me-2"></i>Delete
                            </button>
                        </form>
                    }

                    @* Closed deal lock badge — shown regardless of role *@
                    @if (Model.IsClosedDeal)
                    {
                        <span class="badge align-self-center px-3 py-2"
                              style="background:@(Model.Deal.Stage is "ClosedWon" or "Won" ? "#dcfce7" : "#fee2e2");
                                     color:@(Model.Deal.Stage is "ClosedWon" or "Won" ? "#15803d" : "#b91c1c");
                                     font-size:12px;">
                            <i class="bi bi-lock-fill me-1"></i>
                            @(Model.Deal.Stage is "ClosedWon" or "Won" ? "Won — View Only" : "Lost — View Only")
                        </span>
                    }

                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Pipeline
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row">
        <div class="col-lg-8">

            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4" id="dealDetailTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="overview-tab"
                            data-bs-toggle="tab" data-bs-target="#overview"
                            type="button" role="tab">
                        <i class="bi bi-info-circle me-2"></i>Overview
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="notes-tab"
                            data-bs-toggle="tab" data-bs-target="#notes"
                            type="button" role="tab">
                        <i class="bi bi-chat-left-text me-2"></i>Notes
                        <span class="badge bg-secondary ms-1">@Model.Notes.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="activities-tab"
                            data-bs-toggle="tab" data-bs-target="#activities"
                            type="button" role="tab">
                        <i class="bi bi-activity me-2"></i>Activities
                        <span class="badge bg-secondary ms-1">@Model.Activities.Count</span>
                    </button>
                </li>
                <button class="nav-link" id="tasks-tab"
                        data-bs-toggle="tab" data-bs-target="#tasks"
                        type="button" role="tab">
                    <i class="bi bi-list-check me-2"></i>Tasks
                    @if (Model.OpenTasks.Any())
                    {
                        <span class="badge @(Model.OpenTasks.Any(t => Model.IsOverdue(t)) ? "bg-danger" : "bg-secondary") ms-1">
                            @Model.OpenTasks.Count
                        </span>
                    }
                </button>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="attachments-tab"
                            data-bs-toggle="tab" data-bs-target="#attachments"
                            type="button" role="tab">
                        <i class="bi bi-paperclip me-2"></i>Attachments
                        <span class="badge bg-secondary ms-1">@Model.Attachments.Count</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="dealDetailTabContent">
                <div class="tab-pane fade show active" id="overview" role="tabpanel">
                    <partial name="_OverviewTab" />
                </div>
                <div class="tab-pane fade" id="notes" role="tabpanel">
                    <partial name="_NotesTab" />
                </div>
                <div class="tab-pane fade" id="activities" role="tabpanel">
                    <partial name="_ActivitiesTab" />
                </div>
                <div class="tab-pane fade" id="tasks" role="tabpanel">
                    <partial name="_TasksTab" />
                </div>
                <div class="tab-pane fade" id="attachments" role="tabpanel">
                    <partial name="_AttachmentsTab" />
                </div>
            </div>
        </div>

        <!-- Right Sidebar -->
        <div class="col-lg-4">
            <partial name="_RightSidebar" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Alert auto-dismiss is handled globally by _Layout.cshtml — do not duplicate here.

        // Activate tab from URL hash
        const hash = window.location.hash;
        if (hash) {
            const tab = document.querySelector('button[data-bs-target="' + hash + '"]');
            if (tab) bootstrap.Tab.getOrCreateInstance(tab).show();
        }

        // Update URL hash on tab change
        document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(function (tab) {
            tab.addEventListener('shown.bs.tab', function (e) {
                history.pushState(null, null, e.target.getAttribute('data-bs-target'));
            });
        });
    </script>
}
