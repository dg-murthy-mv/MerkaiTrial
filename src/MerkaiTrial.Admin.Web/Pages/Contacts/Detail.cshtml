@page
@model MerkaiTrial.Admin.Web.Pages.Contacts.DetailModel
@{
    ViewData["Title"] = Model.Contact.DisplayName;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-page="./Index">Contacts</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Contact.DisplayName</li>
            </ol>
        </nav>
        <h2 class="mb-1">
            <div class="d-inline-block bg-primary bg-opacity-10 rounded-circle p-3 me-2">
                <span class="fw-bold text-primary fs-4">@Model.Contact.InitialsDisplay</span>
            </div>
            @Model.Contact.DisplayName
        </h2>
        <div class="d-flex align-items-center gap-2 mt-2">
            @if (Model.Contact.IsPrimary)
            {
                <span class="badge bg-warning text-dark">
                    <i class="bi bi-star-fill me-1"></i>Primary Contact
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.Contact.CompanyName))
            {
                <span class="text-muted">
                    <i class="bi bi-building me-1"></i>@Model.Contact.CompanyName
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.Contact.JobTitle))
            {
                <span class="text-muted">
                    <i class="bi bi-briefcase me-1"></i>@Model.Contact.JobTitle
                </span>
            }
        </div>
    </div>
    <div>
        <div class="btn-group">
            @* ✅ Edit — only if has update permission *@
            @if (Model.CanUpdate)
            {
                <a asp-page="./Edit" asp-route-id="@Model.Contact.Id" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            }
            @* ✅ Delete — only if has delete permission *@
            @if (Model.CanDelete)
            {
                <button type="button" class="btn btn-outline-danger" onclick="confirmDelete()">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            }
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
        </div>
    </div>
</div>

@* ✅ Alert messages — fixed from commented-out to TempData pattern *@
@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@successMsg</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@errorMsg</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Left Column - Main Content -->
    <div class="col-lg-8">
        <!-- Contact Information Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Contact Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small mb-1">Full Name</label>
                        <div class="fw-semibold">@Model.Contact.DisplayName</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small mb-1">Job Title</label>
                        <div class="fw-semibold">
                            @if (!string.IsNullOrEmpty(Model.Contact.JobTitle))
                            {
                                <i class="bi bi-briefcase text-primary me-1"></i>
                                @Model.Contact.JobTitle
                            }
                            else
                            {

                                <span class="text-muted">Not provided</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="text-muted small mb-1">Company</label>
                        <div class="fw-semibold">
                            @if (Model.Contact.CompanyId.HasValue && !string.IsNullOrEmpty(Model.Contact.CompanyName))
                            {
                                <a asp-page="/Companies/Detail" asp-route-id="@Model.Contact.CompanyId"
                                   class="text-decoration-none">
                                    <i class="bi bi-building text-primary me-1"></i>@Model.Contact.CompanyName
                                </a>
                            }
                            else
                            {

                                <span class="text-muted">No company assigned</span>
                            }
                        </div>
                    </div>
                </div>

                <hr class="my-3" />

                <h6 class="mb-3">Contact Details</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small mb-1">Email</label>
                        <div>
                            @if (!string.IsNullOrEmpty(Model.Contact.Email))
                            {
                                <a href="mailto:@Model.Contact.Email" class="text-decoration-none"><i class="bi bi-envelope me-1"></i>@Model.Contact.Email</a>
                            }
                            else
                            {

                                <span class="text-muted">Not provided</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small mb-1">Phone</label>
                        <div>
                            @if (!string.IsNullOrEmpty(Model.Contact.Phone))
                            {
                                <a href="tel:@Model.Contact.Phone" class="text-decoration-none"><i class="bi bi-telephone me-1"></i>@Model.Contact.Phone</a>
                            }
                            else
                            {

                                <span class="text-muted">Not provided</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small mb-1">Mobile</label>
                        <div>
                            @if (!string.IsNullOrEmpty(Model.Contact.Mobile))
                            {
                                <a href="tel:@Model.Contact.Mobile" class="text-decoration-none"><i class="bi bi-phone me-1"></i>@Model.Contact.Mobile</a>
                            }
                            else
                            {

                                <span class="text-muted">Not provided</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small mb-1">Country</label>
                        <div class="fw-semibold">@Model.ResolveCountryName(Model.Contact.Country)</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Contact.City))
                    {
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small mb-1">City</label>
                            <div class="fw-semibold">@Model.Contact.City</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Contact.Notes))
                    {
                        <div class="col-12 mb-3">
                            <label class="text-muted small mb-1">Notes</label>
                            <div class="alert alert-light border mb-0">@Model.Contact.Notes</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Associated Deals Card -->
        @if (Model.ContactDeals.Any())
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0">
                        <i class="bi bi-briefcase me-2"></i>Associated Deals
                        <span class="badge bg-primary ms-2">@Model.ContactDeals.Count</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var deal in Model.ContactDeals)
                        {
                            <a href="/Pipeline/Detail/@deal.Id" class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@deal.Title</strong>
                                        <div class="small text-muted">@deal.CompanyName</div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge @Model.GetDealStageBadgeClass(deal.Stage)">@deal.Stage</span>
                                        <div class="small text-muted mt-1">@Model.FormatCurrency(deal.ExpectedValue, 0)</div>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Timeline Card -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recent Activity</h6>
            </div>
            <div class="card-body">
                <div class="timeline">
                    <div class="timeline-item mb-3">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-2">
                                    <i class="bi bi-person-plus text-primary"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <div class="small fw-semibold">Contact Created</div>
                                <div class="small text-muted">
                                    @Model.GetRelativeTime(Model.Contact.CreatedAtUtc)
                                    @if (!string.IsNullOrEmpty(Model.Contact.CreatedBy))
                                    {
                                        <span>by @Model.Contact.CreatedBy</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (Model.Contact.UpdatedAtUtc.HasValue)
                    {
                        <div class="timeline-item">
                            <div class="d-flex">
                                <div class="flex-shrink-0">
                                    <div class="bg-info bg-opacity-10 rounded-circle p-2">
                                        <i class="bi bi-pencil text-info"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <div class="small fw-semibold">Contact Updated</div>
                                    <div class="small text-muted">
                                        @Model.GetRelativeTime(Model.Contact.UpdatedAtUtc.Value)
                                        @if (!string.IsNullOrEmpty(Model.Contact.UpdatedBy))
                                        {
                                            <span>by @Model.Contact.UpdatedBy</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Sidebar -->
    <div class="col-lg-4">

        <!-- Quick Actions Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h6 class="mb-0"><i class="bi bi-lightning me-2"></i>Quick Actions</h6>
            </div>
            <div class="card-body d-grid gap-2">
                @if (!string.IsNullOrEmpty(Model.Contact.Email))
                {
                    <a href="mailto:@Model.Contact.Email" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-envelope me-2"></i>Send Email
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.Contact.Phone))
                {
                    <a href="tel:@Model.Contact.Phone" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-telephone me-2"></i>Call Phone
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.Contact.Mobile))
                {
                    <a href="tel:@Model.Contact.Mobile" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-phone me-2"></i>Call Mobile
                    </a>
                }
                @* ✅ Edit Contact quick action — only if has update permission *@
                @if (Model.CanUpdate)
                {
                    <a asp-page="./Edit" asp-route-id="@Model.Contact.Id"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-pencil me-2"></i>Edit Contact
                    </a>
                }
            </div>
        </div>

        <!-- Status Card -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom">
                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Status</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Primary Contact</span>
                    @if (Model.Contact.IsPrimary)
                    {
                        <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> Yes</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">No</span>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Has Company</span>
                    @if (Model.Contact.CompanyId.HasValue)
                    {
                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Yes</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">No</span>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Active Deals</span>
                    <span class="badge bg-primary">@Model.Contact.DealCount</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted">Contact Methods</span>
                    <div>
                        @if (!string.IsNullOrEmpty(Model.Contact.Email))
                        {
                            <i class="bi bi-envelope text-primary me-1" title="Email available"></i>
                        }
                        @if (!string.IsNullOrEmpty(Model.Contact.Phone))
                        {
                            <i class="bi bi-telephone text-success me-1" title="Phone available"></i>
                        }
                        @if (!string.IsNullOrEmpty(Model.Contact.Mobile))
                        {
                            <i class="bi bi-phone text-success me-1" title="Mobile available"></i>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<form method="post" id="deleteForm">
    <input type="hidden" name="id" value="@Model.Contact.Id" />
</form>

@section Scripts {
    <script>
        setTimeout(function () {
            document.querySelectorAll('.alert-dismissible').forEach(function (el) {
                bootstrap.Alert.getOrCreateInstance(el).close();
            });
        }, 5000);

        function confirmDelete() {
            if (confirm('Are you sure you want to delete "@Model.Contact.DisplayName"? This cannot be undone.')) {
                document.getElementById('deleteForm').action = '?handler=Delete&id=@Model.Contact.Id';
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}
