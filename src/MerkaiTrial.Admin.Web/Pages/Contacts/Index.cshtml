@page "/Contacts"
@model MerkaiTrial.Admin.Web.Pages.Contacts.IndexModel
@{
    ViewData["Title"] = "Contacts";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-people text-primary"></i> Contacts</h2>
            <p class="text-muted mb-0">Manage your contact database</p>
        </div>
        <div class="d-flex align-items-center gap-2">

            @* ✅ Plan badge *@
            <span class="badge @Model.PlanBadgeClass fs-6 px-3 py-2">
                @Model.PlanDisplayName
            </span>

            @* ✅ Add Contact — quota + permission aware *@
            @if (!AuthorizedPageModel.IsAtLimit(Model.Stats.TotalContacts, Model.MaxContacts) && Model.CanCreate)
            {
                <a asp-page="./Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    <span class="d-none d-sm-inline"> Add Contact</span>
                </a>
            }
            else if (AuthorizedPageModel.IsAtLimit(Model.Stats.TotalContacts, Model.MaxContacts))
            {
                <button class="btn btn-outline-secondary" disabled
                        title="Contact limit reached. @Model.UpgradePrompt">
                    <i class="bi bi-lock me-1"></i>Contact Limit Reached
                </button>
            }
            @* No else — if no create permission, button is simply hidden *@

        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-3">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#3b82f6,#2563eb);">
                            <i class="bi bi-people text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Total Contacts</h6>
                            <h3 class="mb-0">@Model.Stats.TotalContacts</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#f59e0b,#d97706);">
                            <i class="bi bi-star-fill text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Primary Contacts</h6>
                            <h3 class="mb-0">@Model.Stats.PrimaryContacts</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#10b981,#059669);">
                            <i class="bi bi-building text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">With Company</h6>
                            <h3 class="mb-0">@Model.Stats.ContactsWithCompany</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#8b5cf6,#7c3aed);">
                            <i class="bi bi-briefcase text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Active Companies</h6>
                            <h3 class="mb-0">@Model.Stats.ActiveCompanies</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ✅ Contact quota progress bar *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-2">
            <div class="row align-items-center g-2">
                <div class="col-auto">
                    <small class="text-muted fw-semibold text-uppercase" style="font-size:10px;letter-spacing:.06em;">
                        Contact Quota
                    </small>
                </div>
                <div class="col">
                    @{
                        var contactPct = AuthorizedPageModel.QuotaPercent(Model.Stats.TotalContacts, Model.MaxContacts);
                        var barClass = AuthorizedPageModel.QuotaBarClass(Model.Stats.TotalContacts, Model.MaxContacts);
                    }
                    <div class="progress" style="height:8px;">
                        <div class="progress-bar @barClass"
                             role="progressbar"
                             style="width:@contactPct%"
                             aria-valuenow="@Model.Stats.TotalContacts"
                             aria-valuemin="0"
                             aria-valuemax="@Model.MaxContacts">
                        </div>
                    </div>
                </div>
                <div class="col-auto">
                    <small class="@(contactPct >= 90 ? "text-danger fw-bold" : "text-muted")">
                        @Model.Stats.TotalContacts / @Model.MaxContacts used
                    </small>
                </div>
                @if (!string.IsNullOrEmpty(Model.UpgradePrompt))
                {
                    <div class="col-auto">
                        <a href="/pricing" class="btn btn-sm btn-outline-primary py-0">
                            <i class="bi bi-arrow-up-circle me-1"></i>@Model.UpgradePrompt
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Search -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                <div class="col-lg-4 col-md-6">
                    <label class="form-label small fw-semibold">
                        <i class="bi bi-search me-1"></i>Search
                    </label>
                    <input type="text" class="form-control" name="SearchTerm"
                           value="@Model.SearchTerm" placeholder="Name, email, phone..." />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold">
                        <i class="bi bi-building me-1"></i>Company
                    </label>
                    <select class="form-select" name="CompanyFilter"
                            asp-items="Model.GetCompanyFilterOptions()"></select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold">
                        <i class="bi bi-star me-1"></i>Primary Status
                    </label>
                    <select class="form-select" name="IsPrimaryFilter"
                            asp-items="Model.GetIsPrimaryFilterOptions()"></select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search d-md-none"></i>
                            <span class="d-none d-md-inline">Search</span>
                        </button>
                        <a asp-page="./Index" asp-route-pagesize="@Model.PageSize"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Desktop Table -->
    <div class="card border-0 shadow-sm d-none d-md-block">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>Contacts List
                <span class="badge bg-white text-primary ms-2">@Model.PaginatedContacts.TotalCount</span>
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Contact</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contact in Model.PaginatedContacts.Items)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                        <span class="fw-bold text-primary">@contact.InitialsDisplay</span>
                                    </div>
                                    <div>
                                        <strong>@contact.DisplayName</strong>
                                        @if (contact.IsPrimary)
                                        {
                                            <i class="bi bi-star-fill text-warning ms-1" title="Primary Contact"></i>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>@Model.GetCompanyName(contact.CompanyId)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(contact.Email))
                                {
                                    <a href="mailto:@contact.Email" class="text-decoration-none">@contact.Email</a>
                                }
                                else
                                {

                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(contact.Phone))
                                {
                                    <a href="tel:@contact.Phone" class="text-decoration-none">@contact.Phone</a>
                                }
                                else if (!string.IsNullOrEmpty(contact.Mobile))
                                {
                                    <a href="tel:@contact.Mobile" class="text-decoration-none">@contact.Mobile</a>
                                }
                                else
                                {

                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (contact.IsPrimary)
                                {
                                    <span class="badge bg-warning">Primary</span>
                                }
                            </td>

                            @* ✅ Actions — role-based permission *@
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">

                                    @* View — always visible *@
                                    <a asp-page="./Detail" asp-route-id="@contact.Id"
                                       class="btn btn-outline-primary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @* Edit — only if has update permission *@
                                    @if (Model.CanUpdate)
                                    {
                                        <a asp-page="./Edit" asp-route-id="@contact.Id"
                                           class="btn btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }

                                    @* Delete — only if has delete permission *@
                                    @if (Model.CanDelete)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-danger"
                                                onclick="confirmDelete('@contact.Id', '@contact.DisplayName')"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Cards -->
    <div class="d-md-none">
        @foreach (var contact in Model.PaginatedContacts.Items)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                            <span class="fw-bold text-primary">@contact.InitialsDisplay</span>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0">@contact.DisplayName</h6>
                            <small class="text-muted">@Model.GetCompanyName(contact.CompanyId)</small>
                        </div>
                        @if (contact.IsPrimary)
                        {
                            <span class="badge bg-warning">Primary</span>
                        }
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-12">
                            <small class="text-muted">Email</small>
                            <div>
                                @if (!string.IsNullOrEmpty(contact.Email))
                                {
                                    <a href="mailto:@contact.Email" class="text-decoration-none">@contact.Email</a>
                                }
                                else
                                {

                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <small class="text-muted">Phone</small>
                            <div>
                                @if (!string.IsNullOrEmpty(contact.Phone))
                                {
                                    <a href="tel:@contact.Phone" class="text-decoration-none">@contact.Phone</a>
                                }
                                else if (!string.IsNullOrEmpty(contact.Mobile))
                                {
                                    <a href="tel:@contact.Mobile" class="text-decoration-none">@contact.Mobile</a>
                                }
                                else
                                {

                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>
                    </div>

                    @* ✅ Mobile actions — role-based permission *@
                    <div class="d-grid gap-2">
                        <a asp-page="./Detail" asp-route-id="@contact.Id"
                           class="btn btn-primary btn-sm">
                            <i class="bi bi-eye me-1"></i>View Details
                        </a>
                        @if (Model.CanUpdate || Model.CanDelete)
                        {
                            <div class="btn-group">
                                @if (Model.CanUpdate)
                                {
                                    <a asp-page="./Edit" asp-route-id="@contact.Id"
                                       class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                }
                                @if (Model.CanDelete)
                                {
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            onclick="confirmDelete('@contact.Id', '@contact.DisplayName')">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                }
                            </div>
                        }
                    </div>

                </div>
            </div>
        }
    </div>

    @if (!Model.PaginatedContacts.Items.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                <p class="text-muted mb-3">No contacts found.</p>
                @if (Model.CanCreate &&
                            !AuthorizedPageModel.IsAtLimit(Model.Stats.TotalContacts, Model.MaxContacts))
                {
                    <a asp-page="./Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Add First Contact
                    </a>
                }
            </div>
        </div>
    }

    <!-- Pagination -->
    @if (Model.PaginatedContacts.Items.Any())
    {
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <form method="get" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="CompanyFilter" value="@Model.CompanyFilter" />
                        <input type="hidden" name="IsPrimaryFilter" value="@Model.IsPrimaryFilter" />
                        <input type="hidden" name="Page" value="1" />
                        <label class="col-form-label small mb-0">Items per page:</label>
                        <select name="PageSize" class="form-select form-select-sm"
                                style="width:auto;" onchange="this.form.submit()">
                            <option value="5" selected="@(Model.PageSize == 5)">5</option>
                            <option value="10" selected="@(Model.PageSize == 10)">10</option>
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100</option>
                        </select>
                    </form>
                    <span class="text-muted small">
                        Showing @((Model.Page - 1) * Model.PageSize + 1)
                        to @Math.Min(Model.Page * Model.PageSize, Model.PaginatedContacts.TotalCount)
                        of @Model.PaginatedContacts.TotalCount
                    </span>
                </div>
                <nav>
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(!Model.PaginatedContacts.HasPrevious ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-pagesize="@Model.PageSize"
                               asp-route-searchterm="@Model.SearchTerm"
                               asp-route-companyfilter="@Model.CompanyFilter"
                               asp-route-isprimaryfilter="@Model.IsPrimaryFilter">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        </li>
                        @{
                            var start = Math.Max(1, Model.Page - 2);
                            var end = Math.Min(Model.PaginatedContacts.TotalPages, Model.Page + 2);
                            for (int i = start; i <= end; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link"
                                       asp-page="./Index"
                                       asp-route-page="@i"
                                       asp-route-pagesize="@Model.PageSize"
                                       asp-route-searchterm="@Model.SearchTerm"
                                       asp-route-companyfilter="@Model.CompanyFilter"
                                       asp-route-isprimaryfilter="@Model.IsPrimaryFilter">@i</a>
                                </li>
                            }
                        }
                        <li class="page-item @(!Model.PaginatedContacts.HasNext ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-pagesize="@Model.PageSize"
                               asp-route-searchterm="@Model.SearchTerm"
                               asp-route-companyfilter="@Model.CompanyFilter"
                               asp-route-isprimaryfilter="@Model.IsPrimaryFilter">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<form method="post" id="deleteForm">
    <input type="hidden" name="id" id="deleteId" />
</form>

@section Scripts {
    <script>
        setTimeout(function () {
            document.querySelectorAll('.alert').forEach(a => new bootstrap.Alert(a).close());
        }, 5000);

        function confirmDelete(id, name) {
            if (confirm(`Delete "${name}"?`)) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').action = '?handler=Delete&id=' + id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}
