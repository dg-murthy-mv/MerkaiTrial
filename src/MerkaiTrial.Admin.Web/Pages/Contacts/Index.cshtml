@page "/Contacts"
@using MerkaiTrial.Application.Configuration
@model MerkaiTrial.Admin.Web.Pages.Contacts.IndexModel
@{
    ViewData["Title"] = "Contacts";
}
@* =====================================================================
   Contacts/Index.cshtml

   076 — custom fields on the list (Round B) and the shared list
   components from 072:

   • _ListToolbar for search, Company, Primary and the count; _Pager for
     paging. The hand-built search card and pager are gone. Everything is
     in the URL.
   • Up to four custom fields as columns ("Show on the list" in
     Settings → Custom Fields), and as extra lines on the mobile cards.
   • _CustomFieldFilterPanel under the toolbar: filter on any active
     custom field. Its inputs join the toolbar's form (FormId), so one
     Filter button applies everything.
   • An empty FILTERED list says so and offers to clear, instead of
     "No contacts found" with an Add button — telling somebody with 400
     contacts that they have none, because a filter matched nothing, is
     the empty state getting it backwards.
   • The delete dialog carries the list state, so a delete returns to
     the same page of the same filtered list.

   Kept from 075a: no TempData banners here (_Layout renders them), no
   auto-dismiss timer, and the contact's name never goes inside script —
   the delete buttons carry it as a data- attribute and the dialog writes
   it with textContent.
   ===================================================================== *@

<style>
    .ct-cf { max-width: 14rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ct-cf-head { white-space: nowrap; }
    .ct-cf-head i { opacity: .55; }
</style>

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1"><i class="bi bi-people text-primary"></i> Contacts</h2>
            <p class="text-muted mb-0">Manage your contact database</p>
        </div>
        <div class="d-flex align-items-center gap-2">

            <span class="badge @Model.PlanBadgeClass fs-6 px-3 py-2">
                @Model.PlanDisplayName
            </span>

            @if (!AuthorizedPageModel.IsAtLimit(Model.Stats.TotalContacts, Model.MaxContacts) && Model.CanCreate)
            {
                <a asp-page="./Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    <span class="d-none d-sm-inline"> Add Contact</span>
                </a>
            }
            else if (Model.CanCreate && AuthorizedPageModel.IsAtLimit(Model.Stats.TotalContacts, Model.MaxContacts))
            {
                <button class="btn btn-outline-secondary" disabled
                        title="Contact limit reached. @Model.UpgradePrompt">
                    <i class="bi bi-lock me-1"></i>Contact Limit Reached
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.PageError))
    {
        <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <span>@Model.PageError</span>
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-3">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#3b82f6,#2563eb);">
                            <i class="bi bi-people text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Total Contacts</h6>
                            <h3 class="mb-0">@Model.Stats.TotalContacts</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#f59e0b,#d97706);">
                            <i class="bi bi-star-fill text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Primary Contacts</h6>
                            <h3 class="mb-0">@Model.Stats.PrimaryContacts</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#10b981,#059669);">
                            <i class="bi bi-building text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">With Company</h6>
                            <h3 class="mb-0">@Model.Stats.ContactsWithCompany</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:60px;height:60px;background:linear-gradient(135deg,#8b5cf6,#7c3aed);">
                            <i class="bi bi-briefcase text-white fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1 small">Active Companies</h6>
                            <h3 class="mb-0">@Model.Stats.ActiveCompanies</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Contact quota *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-2">
            <div class="row align-items-center g-2">
                <div class="col-auto">
                    <small class="text-muted fw-semibold text-uppercase" style="font-size:10px;letter-spacing:.06em;">
                        Contact Quota
                    </small>
                </div>
                <div class="col">
                    @{
                        var contactPct = AuthorizedPageModel.QuotaPercent(Model.Stats.TotalContacts, Model.MaxContacts);
                        var barClass = AuthorizedPageModel.QuotaBarClass(Model.Stats.TotalContacts, Model.MaxContacts);
                    }
                    <div class="progress" style="height:8px;">
                        <div class="progress-bar @barClass"
                             role="progressbar"
                             style="width:@contactPct%"
                             aria-valuenow="@Model.Stats.TotalContacts"
                             aria-valuemin="0"
                             aria-valuemax="@Model.MaxContacts">
                        </div>
                    </div>
                </div>
                <div class="col-auto">
                    <small class="@(contactPct >= 90 ? "text-danger fw-bold" : "text-muted")">
                        @Model.Stats.TotalContacts / @Model.MaxContacts used
                    </small>
                </div>
                @if (!string.IsNullOrEmpty(Model.UpgradePrompt))
                {
                    <div class="col-auto">
                        <a href="/pricing" class="btn btn-sm btn-outline-primary py-0">
                            <i class="bi bi-arrow-up-circle me-1"></i>@Model.UpgradePrompt
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── 076: search, filters, count ───────────────────────────────── *@
    <partial name="_ListToolbar" model="Model.Toolbar" />
    <partial name="_CustomFieldFilterPanel" model="Model.CustomFilters" />

    @if (!Model.PaginatedContacts.Items.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                @if (Model.IsFiltered)
                {
                    <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-2">No contact matches these filters.</p>
                    <a asp-page="./Index" asp-route-PageSize="@Model.PageSize" class="btn btn-outline-secondary btn-sm">
                        Clear the search and filters
                    </a>
                }
                else
                {
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                    <p class="text-muted mb-3">No contacts yet.</p>
                    @if (Model.CanCreate &&
                         !AuthorizedPageModel.IsAtLimit(Model.Stats.TotalContacts, Model.MaxContacts))
                    {
                        <a asp-page="./Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>Add First Contact
                        </a>
                    }
                }
            </div>
        </div>
    }
    else
    {
        <!-- Desktop Table -->
        <div class="card border-0 shadow-sm d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Contact</th>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Phone</th>
                            @foreach (var col in Model.ListColumns)
                            {
                                <th class="ct-cf-head">
                                    <i class="bi @CustomFieldTypes.Icon(col.FieldType) me-1" aria-hidden="true"></i>@col.Label
                                </th>
                            }
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contact in Model.PaginatedContacts.Items)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                            <span class="fw-bold text-primary">@contact.InitialsDisplay</span>
                                        </div>
                                        <div>
                                            <a asp-page="./Detail" asp-route-id="@contact.Id"
                                               class="fw-semibold text-decoration-none text-reset">@contact.DisplayName</a>
                                            @if (contact.IsPrimary)
                                            {
                                                <i class="bi bi-star-fill text-warning ms-1" title="Primary Contact"></i>
                                            }
                                            @if (!string.IsNullOrEmpty(contact.JobTitle))
                                            {
                                                <div class="small text-muted">@contact.JobTitle</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(contact.CompanyName))
                                    {
                                        @contact.CompanyName
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(contact.Email))
                                    {
                                        <a href="mailto:@contact.Email" class="text-decoration-none">@contact.Email</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(contact.Phone))
                                    {
                                        <a href="tel:@contact.Phone" class="text-decoration-none">@contact.Phone</a>
                                    }
                                    else if (!string.IsNullOrEmpty(contact.Mobile))
                                    {
                                        <a href="tel:@contact.Mobile" class="text-decoration-none">@contact.Mobile</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                @foreach (var col in Model.ListColumns)
                                {
                                    var shown = Model.ColumnValue(contact, col);
                                    <td class="ct-cf" title="@shown">
                                        @if (string.IsNullOrEmpty(shown))
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else if (col.FieldType == CustomFieldTypes.Checkbox)
                                        {
                                            <i class="bi bi-check-lg text-success" aria-label="Yes"></i>
                                        }
                                        else
                                        {
                                            @shown
                                        }
                                    </td>
                                }

                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-page="./Detail" asp-route-id="@contact.Id"
                                           class="btn btn-outline-primary" title="View" aria-label="View @contact.DisplayName">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (Model.CanUpdate)
                                        {
                                            <a asp-page="./Edit" asp-route-id="@contact.Id"
                                               class="btn btn-outline-warning" title="Edit" aria-label="Edit @contact.DisplayName">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }

                                        @if (Model.CanDelete)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    data-delete-contact
                                                    data-contact-id="@contact.Id"
                                                    data-contact-name="@contact.DisplayName"
                                                    title="Delete" aria-label="Delete @contact.DisplayName">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Mobile Cards -->
        <div class="d-md-none">
            @foreach (var contact in Model.PaginatedContacts.Items)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                <span class="fw-bold text-primary">@contact.InitialsDisplay</span>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0">@contact.DisplayName</h6>
                                <small class="text-muted">@(string.IsNullOrEmpty(contact.CompanyName) ? "No Company" : contact.CompanyName)</small>
                            </div>
                            @if (contact.IsPrimary)
                            {
                                <span class="badge bg-warning text-dark">Primary</span>
                            }
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-12">
                                <small class="text-muted">Email</small>
                                <div>
                                    @if (!string.IsNullOrEmpty(contact.Email))
                                    {
                                        <a href="mailto:@contact.Email" class="text-decoration-none">@contact.Email</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </div>
                            </div>
                            <div class="col-12">
                                <small class="text-muted">Phone</small>
                                <div>
                                    @if (!string.IsNullOrEmpty(contact.Phone))
                                    {
                                        <a href="tel:@contact.Phone" class="text-decoration-none">@contact.Phone</a>
                                    }
                                    else if (!string.IsNullOrEmpty(contact.Mobile))
                                    {
                                        <a href="tel:@contact.Mobile" class="text-decoration-none">@contact.Mobile</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </div>
                            </div>
                            @foreach (var col in Model.ListColumns)
                            {
                                var shown = Model.ColumnValue(contact, col);
                                if (string.IsNullOrEmpty(shown)) { continue; }
                                <div class="col-6">
                                    <small class="text-muted">@col.Label</small>
                                    <div class="text-truncate">@shown</div>
                                </div>
                            }
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-page="./Detail" asp-route-id="@contact.Id"
                               class="btn btn-primary btn-sm">
                                <i class="bi bi-eye me-1"></i>View Details
                            </a>
                            @if (Model.CanUpdate || Model.CanDelete)
                            {
                                <div class="btn-group">
                                    @if (Model.CanUpdate)
                                    {
                                        <a asp-page="./Edit" asp-route-id="@contact.Id"
                                           class="btn btn-outline-warning btn-sm">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>
                                    }
                                    @if (Model.CanDelete)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                data-delete-contact
                                                data-contact-id="@contact.Id"
                                                data-contact-name="@contact.DisplayName">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ONE pager for both layouts. Rendering it inside each would put
           two copies of its page-size select (id="lpPageSize") on the
           page, and a label binds to the FIRST matching id. *@
        <div class="card border-0 shadow-sm mt-2">
            <partial name="_Pager" model="Model.Pager" />
        </div>
    }
</div>

@if (Model.CanDelete)
{
    <div class="modal fade" id="deleteContactModal" tabindex="-1" aria-labelledby="deleteContactLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page-handler="Delete" class="modal-content">
                <input type="hidden" name="id" id="deleteContactId" />
                @* The list state, so the redirect returns to the same page
                   of the same filtered list. *@
                @foreach (var keep in Model.StateRoute())
                {
                    <input type="hidden" name="@keep.Key" value="@keep.Value" />
                }
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteContactLabel">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete contact
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Delete <strong id="deleteContactName"></strong>?</p>
                    <p class="text-muted small mb-0">The contact is removed from lists and searches.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete contact
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        // One delegated listener. The id and name come from data-
        // attributes and the name is written with textContent, so a
        // contact's name is only ever data, never script.
        (function () {
            'use strict';
            var modalEl = document.getElementById('deleteContactModal');
            if (!modalEl) return;

            document.addEventListener('click', function (e) {
                var btn = e.target.closest ? e.target.closest('[data-delete-contact]') : null;
                if (!btn) return;

                document.getElementById('deleteContactId').value = btn.getAttribute('data-contact-id') || '';
                document.getElementById('deleteContactName').textContent = btn.getAttribute('data-contact-name') || 'this contact';
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });
        })();
    </script>
}
