@* =====================================================================
   FILE: MerkaiTrial.Admin.Web/Pages/Account/ForgotPassword.cshtml
   ===================================================================== *@
@page
@model MerkaiTrial.Admin.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
}

@if (Model.Submitted)
{
    @* Identical whether or not the account exists — the page must not
       confirm which email addresses are registered. *@
    <h1>Reset requested</h1>
    <p class="auth-sub">
        If that email address has an account, your MadeeVision contact will send
        you a reset link shortly. Links expire after 72 hours.
    </p>

    <div class="auth-foot">
        <a asp-page="/Account/Login">Back to sign in</a>
    </div>
}
else
{
    <h1>Reset your password</h1>
    <p class="auth-sub">
        Tell us your email address and we'll arrange a reset link for you.
    </p>

    <form method="post">
        <div class="field">
            <label asp-for="Email">Email address</label>
            <input asp-for="Email" type="email" autocomplete="username"
                   autofocus spellcheck="false" placeholder="you@company.com" />
            <span asp-validation-for="Email" class="validation-message"></span>
        </div>

        <button type="submit" class="btn-primary">Request reset link</button>
    </form>

    <div class="auth-foot">
        <a asp-page="/Account/Login">Back to sign in</a>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}