@* =====================================================================
   FILE: MerkaiTrial.Admin.Web/Pages/Account/ForgotPassword.cshtml

   086: the reset link is now EMAILED. The confirmation reads the same
   whether or not the address has an account — it must never tell a
   stranger which addresses are registered.
   ===================================================================== *@
@page
@model MerkaiTrial.Admin.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
}

@if (Model.Submitted)
{
    <h1>Check your email</h1>
    <p class="auth-sub">
        If <strong>@Model.Email</strong> has a Merkai account, we've sent it a link to
        choose a new password. The link works once and expires in @Model.LifetimeText.
    </p>

    <div class="alert alert-ok" role="status">
        It usually arrives within a minute. Not there? Check your spam or junk folder.
    </div>

    <div class="auth-foot">
        Still nothing after a few minutes? Your workspace administrator can send you a
        new link from <strong>Settings → Users</strong>.
        <br />
        <span style="display:inline-block;margin-top:.6rem;">
            <a asp-page="/Account/ForgotPassword">Try a different address</a>
            &nbsp;·&nbsp;
            <a asp-page="/Account/Login">Back to sign in</a>
        </span>
    </div>
}
else
{
    <h1>Reset your password</h1>
    <p class="auth-sub">
        Enter the email address you sign in with and we'll email you a link to choose a
        new password.
    </p>

    <form method="post" id="forgotForm">
        <div class="field">
            <label asp-for="Email">Email address</label>
            <input asp-for="Email" type="email" autocomplete="username"
                   autofocus spellcheck="false" placeholder="you@company.com" />
            <span asp-validation-for="Email" class="validation-message"></span>
        </div>

        <button type="submit" class="btn-primary" id="forgotSubmit">Email me a reset link</button>
    </form>

    <div class="auth-foot">
        Remembered it? <a asp-page="/Account/Login">Back to sign in</a>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // One request per press — a double click would send two emails.
        (function () {
            var form = document.getElementById('forgotForm');
            if (!form) return;
            form.addEventListener('submit', function () {
                if (window.jQuery && jQuery(form).valid && !jQuery(form).valid()) return;
                var btn = document.getElementById('forgotSubmit');
                btn.disabled = true;
                btn.textContent = 'Sending…';
            });
        })();
    </script>
}
