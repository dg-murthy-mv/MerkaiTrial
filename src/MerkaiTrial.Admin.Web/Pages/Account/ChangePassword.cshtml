
@* =====================================================================
   FILE: MerkaiTrial.Admin.Web/Pages/Account/ChangePassword.cshtml
   ===================================================================== *@
@page
@model MerkaiTrial.Admin.Web.Pages.Account.ChangePasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Change password";
}

<h1>@(Model.IsForced ? "Set a new password" : "Change your password")</h1>

<p class="auth-sub">
    @if (Model.IsForced)
    {
        <text>
            Your account was set up with a temporary password. Choose your own
            before continuing.
        </text>
    }
    else
    {
        <text>Choose a new password for your account.</text>
    }
</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}

<form method="post">
    <div class="field">
        <label asp-for="CurrentPassword">Current password</label>
        <input asp-for="CurrentPassword" type="password"
               autocomplete="current-password" autofocus />
        <span asp-validation-for="CurrentPassword" class="validation-message"></span>
    </div>

    <div class="field">
        <label asp-for="NewPassword">New password</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" />
        <span class="field-hint">At least 12 characters.</span>
        <span asp-validation-for="NewPassword" class="validation-message"></span>
    </div>

    <div class="field">
        <label asp-for="ConfirmPassword">Confirm new password</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
    </div>

    <div style="height:.75rem;"></div>
    <button type="submit" class="btn-primary">Save new password</button>
</form>

<div class="auth-foot">
    You'll be signed out and asked to sign in again with your new password.
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

