@page
@model MerkaiTrial.Admin.Web.Pages.Account.SetPasswordModel
@{
    Layout = "_AuthLayout";
    var isInvite = string.Equals(Model.Purpose, "Invite", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isInvite ? "Choose a password" : "Reset password";
}

@*
    FILE: MerkaiTrial.Admin.Web/Pages/Account/SetPassword.cshtml

    Serves both the invite flow and the password reset flow — same form,
    different framing, chosen by the Purpose query value.

    The token travels in the URL and is round-tripped through hidden fields
    so the POST can re-validate it. It identifies the user; it is not access.
*@

@if (!Model.TokenValid)
{
    <h1>This link no longer works</h1>
    <p class="auth-sub">
        Invite and reset links are single-use and expire after 72 hours.
    </p>

    <div class="alert alert-error" role="alert">
        @(Model.ErrorMessage ?? "This link is invalid or has expired.")
    </div>

    <div class="auth-foot">
        Ask your MadeeVision contact for a new link, or
        <a asp-page="/Account/Login">return to sign in</a>.
    </div>
}
else
{
    <h1>@(isInvite ? "Choose a password" : "Set a new password")</h1>
    <p class="auth-sub">
        @if (isInvite)
        {
            <text>Your Merkai workspace is ready. Set a password to finish signing in.</text>
        }
        else
        {
            <text>Choose a new password for your account.</text>
        }
    </p>

    @if (!string.IsNullOrEmpty(Model.UserEmail))
    {
        <div class="field">
            <label>Account</label>
            @* Read-only, and posted nowhere — the token determines the user,
               never a form field the browser could alter. *@
            <input type="text" value="@Model.UserEmail" readonly disabled
                   style="background:var(--wash);color:var(--muted);" />
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post">
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Purpose" />

        <div class="field">
            <label asp-for="NewPassword">New password</label>
            <input asp-for="NewPassword" type="password"
                   autocomplete="new-password" autofocus />
            <span class="field-hint">
                At least 12 characters. A short phrase you'll remember beats a
                short password with symbols in it.
            </span>
            <span asp-validation-for="NewPassword" class="validation-message"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword">Confirm password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
        </div>

        <div style="height:.5rem;"></div>
        <button type="submit" class="btn-primary">
            @(isInvite ? "Set password and continue" : "Save new password")
        </button>
    </form>

    <div class="auth-foot">
        Setting a password signs out any other active sessions on this account.
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
