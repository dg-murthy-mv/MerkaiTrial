@page
@model MerkaiTrial.Admin.Web.Pages.Account.DeniedModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "No access";
}

<h1>You don't have access to that</h1>
<p class="auth-sub">
    Your account doesn't have permission for this area. If you think it should,
    ask your workspace administrator to update your role.
</p>

<div class="auth-foot">
    <a asp-page="/Dashboard">Back to dashboard</a>
</div>