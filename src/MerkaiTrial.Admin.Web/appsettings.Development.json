  // ─────────────────────────────────────────────────────────────────────
  // PERFORMANCE FIX 2026-08-03 — see the matching note in the WebApi
  // appsettings.Development.json. Same cause, same fix.
  //
  // Admin.Web emitted 6790 [DBG] lines in a single 11-minute session.
  // /Pipeline/Detail took 20.1s; the SQL underneath it was under 200ms.
  //
  //   1. MinimumLevel Debug -> Information.
  //   2. Console sink restricted to Warning (the VS debugger makes every
  //      console write cost ~300ms).
  //
  // "Request starting/finished ... NNNNms" stays at Information so page
  // timings remain measurable from the file log.
  // ─────────────────────────────────────────────────────────────────────
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "restrictedToMinimumLevel": "Warning" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  }
}
