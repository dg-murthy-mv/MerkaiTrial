{
  "ConnectionStrings": {
    "Default": "#{AdminWebProdConnectionString}#"
  },
  "DevelopmentTenantContext": {
    "Enabled": false
  },
  "WebApi": {
    "BaseUrl": "#{WebApiProdBaseUrl}#"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Warning",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  }
}
