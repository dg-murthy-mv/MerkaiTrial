  // ── Email ───────────────────────────────────────────────────────────
  // ONE block. There used to be two; the other one set "From", which is
  // not a property EmailOptions has, so it was read and discarded.
  //
  // AppBaseUrl is where the CUSTOMER's /q/{token} link points, so it must
  // be ADMIN.WEB's address — the site that serves that page — not this
  // API's. Locally that is https://localhost:5093, which is what your own
  // request log shows. In production it is the public Admin.Web host.
  //
  // RedirectAllTo IS A DEVELOPMENT SAFETY VALVE. Every email goes to this
  // address instead of its real recipient, with the intended address kept
  // in the subject line. That is why the QUO-0008 test landed in your
  // Gmail rather than at wora@phuketmarine.th.
  //
  // ⚠ IT MUST BE EMPTY OR ABSENT IN PRODUCTION. Left set, every customer
  // quote in the system is delivered to one inbox and no customer ever
  // receives anything — and nothing anywhere reports a failure, because
  // from Resend's point of view every send succeeded.
  "Email": {
    "FromAddress": "noreply@madeevision.com",
    "FromName": "Merkai CRM",
    "AppBaseUrl": "https://localhost:5093",
    "RedirectAllTo": "dgmurthy007@gmail.com"
  },

  "OutboundWorker": {
    "IdleSecondsBetweenPolls": 15,
    "BatchSize": 20
  },

  // ── Serilog ─────────────────────────────────────────────────────────
  // 062: MinimumLevel is now an object rather than the bare string
  // "Information", so it can carry an Override. Both shapes are valid;
  // the object form is the only one that takes per-source levels.
  //
  // WHY Microsoft.AspNetCore.Hosting.Diagnostics IS TURNED DOWN
  //
  //   It writes "Request starting …" and "Request finished …" for every
  //   request, with the FULL URL. For the public quote page that URL is
  //     https://localhost:61091/api/quotes/public/9JGgqZBbZwdAXuu…
  //   and that token is the entire security of the customer's link —
  //   anyone who can read the log can open the quote and accept it as
  //   them. 061 masked the four places OUR code logged the token; these
  //   lines come from the framework and were still printing it in full.
  //
  //   Nothing is lost by silencing them: UseSerilogRequestLogging()
  //   already writes one line per completed request with the method,
  //   path, status and elapsed time, which is why it exists. These two
  //   were duplicates of it.
  //
  // System.Net.Http.HttpClient IS DELIBERATELY NOT OVERRIDDEN HERE.
  //   This host's outbound calls go to api.resend.com and Meta — no
  //   tokens in those URLs, and "POST https://api.resend.com/emails →
  //   200" is exactly the line you want when an email does not arrive.
  //   Admin.Web is the opposite case and overrides it; see its own file.
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  },

  "Vertical": "Generic",
  "UseCompatStages": true
}
