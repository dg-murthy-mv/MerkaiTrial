{
  "ConnectionStrings": {
    "Default": "#{WebApiProdConnectionString}#"
  },
  "Email": {
    "From": "quotes@madeevision.com"
  },
  "DevelopmentTenantContext": {
    "Enabled": false
  },
  "CountryPacks": {
    "IN": { "DefaultProvider": "Razorpay" },
    "TH": { "DefaultProvider": "PromptPay" },
    "PH": { "DefaultProvider": "Xendit" }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Warning",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  },
  "Vertical": "Generic",
  "UseCompatStages": true
}
