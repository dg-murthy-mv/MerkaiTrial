  // ─────────────────────────────────────────────────────────────────────
  // PERFORMANCE FIX 2026-08-03
  //
  // Measured: GET /api/deals/{id} took 7862ms, of which 186ms was SQL.
  // The remaining ~7.7s was the logger. Proof from the 2026-08-03 log —
  // these are consecutive statements that do no real work between them:
  //
  //   11:35:41.482  No information found on request ...   +778ms
  //   11:35:41.796  Attempting to select an output formatter   +314ms
  //   11:35:42.034  Attempting to select the first formatter   +238ms
  //   11:35:42.280  Selected output formatter                  +246ms
  //   11:35:42.680  Executing OkObjectResult                   +400ms
  //
  // Selecting a formatter costs microseconds. The elapsed time IS the
  // cost of writing each log line.
  //
  // Two changes:
  //   1. MinimumLevel Debug -> Information. Cuts ~4000 writes per run.
  //   2. Console sink restricted to Warning. Under the Visual Studio
  //      debugger every console write marshals synchronously to the IDE,
  //      which is what made each write cost ~300ms. The file still gets
  //      everything at Information.
  //
  // Deliberately NOT overriding "Microsoft.AspNetCore" to Warning: the
  // "Request starting/finished ... NNNNms" lines come from
  // Microsoft.AspNetCore.Hosting at Information, and those are the timing
  // data we measure with. Likewise "Executed DbCommand (NNms)" plus the
  // full SQL text is Information, so query visibility is retained.
  //
  // For a clean measurement also start WITHOUT the debugger (Ctrl+F5).
  // ─────────────────────────────────────────────────────────────────────
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "restrictedToMinimumLevel": "Warning" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  },
  "Vertical": "Generic",
  "UseCompatStages": true
}
